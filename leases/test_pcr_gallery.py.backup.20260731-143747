import io
import json
import tempfile
from datetime import timedelta

from PIL import Image

from django.contrib.auth import get_user_model
from django.core.files.uploadedfile import SimpleUploadedFile
from django.test import TestCase, override_settings
from django.urls import reverse
from django.utils import timezone

from leases.models import Lease
from leases.models_pcr import PCRPhoto, PropertyConditionReport
from properties.models import Property, Unit
from tenants.models import Tenant


def _image_upload(name="pcr-photo.jpg", size=(640, 360)):
    buffer = io.BytesIO()
    Image.new("RGB", size, "orange").save(buffer, format="JPEG")
    return SimpleUploadedFile(name, buffer.getvalue(), content_type="image/jpeg")


class PCRGalleryRegressionTests(TestCase):
    @classmethod
    def setUpClass(cls):
        cls._media_directory = tempfile.TemporaryDirectory()
        cls._media_override = override_settings(
            MEDIA_ROOT=cls._media_directory.name
        )
        cls._media_override.enable()
        super().setUpClass()

    @classmethod
    def tearDownClass(cls):
        super().tearDownClass()
        cls._media_override.disable()
        cls._media_directory.cleanup()

    def setUp(self):
        self.user = get_user_model().objects.create_superuser(
            username="pcr-gallery-admin",
            email="pcr-gallery@example.test",
            password="test-password",
        )
        property_obj = Property.objects.create(
            property_name="PCR Gallery Property",
            owner_name="Test Owner",
            owner_cnic="61101-1111111-1",
            type="Residential",
            property_type="Building",
            total_units=1,
        )
        unit = Unit.objects.create(property=property_obj, unit_number="PCR-1")
        tenant = Tenant.objects.create(
            first_name="PCR",
            last_name="Tenant",
            cnic="61101-2222222-2",
        )
        self.lease = Lease.objects.create(
            tenant=tenant,
            unit=unit,
            start_date=timezone.localdate(),
            end_date=timezone.localdate() + timedelta(days=335),
            monthly_rent=25000,
        )
        self.pcr = PropertyConditionReport.objects.create(lease=self.lease)
        self.client.force_login(self.user)

    def test_upload_uses_the_pcr_lease_for_image_and_thumbnail_paths(self):
        response = self.client.post(
            reverse("leases:pcr_photo_upload", args=[self.lease.pk]),
            {"photos": _image_upload()},
        )

        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(), {"ok": True})
        photo = PCRPhoto.objects.get(pcr=self.pcr)
        prefix = f"leases/pcr/{self.lease.pk}/photos/"
        self.assertTrue(photo.image.name.startswith(prefix))
        self.assertTrue(photo.thumbnail.name.startswith(f"{prefix}thumbs/"))
        self.assertTrue(photo.image_exists)
        self.assertTrue(photo.thumbnail_exists)

    def test_standalone_gallery_keeps_masonry_and_reload_fallback(self):
        PCRPhoto.objects.create(
            pcr=self.pcr,
            image=_image_upload("portrait.jpg", size=(360, 640)),
            sort_order=10,
        )

        response = self.client.get(
            reverse("leases:pcr_gallery", args=[self.lease.pk])
        )

        self.assertEqual(response.status_code, 200)
        self.assertContains(response, "data-masonry-grid")
        self.assertContains(response, "data-masonry-item")
        self.assertContains(response, "tms-masonry-grid.js")
        self.assertContains(response, "window.location.reload()")

    def test_reorder_and_delete_endpoints_preserve_gallery_actions(self):
        first = PCRPhoto.objects.create(
            pcr=self.pcr,
            image=_image_upload("first.jpg"),
            sort_order=10,
        )
        second = PCRPhoto.objects.create(
            pcr=self.pcr,
            image=_image_upload("second.jpg"),
            sort_order=20,
        )

        reorder_response = self.client.post(
            reverse("leases:pcr_photo_reorder", args=[self.lease.pk]),
            data=json.dumps({"photo_ids": [second.pk, first.pk]}),
            content_type="application/json",
        )

        self.assertEqual(reorder_response.status_code, 200)
        self.assertEqual(
            list(
                self.pcr.photos.order_by("sort_order").values_list("pk", flat=True)
            ),
            [second.pk, first.pk],
        )

        delete_response = self.client.post(
            reverse("leases:pcr_photo_delete", args=[second.pk])
        )

        self.assertEqual(delete_response.status_code, 200)
        self.assertFalse(PCRPhoto.objects.filter(pk=second.pk).exists())
