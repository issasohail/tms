{% extends 'base.html' %}
{% block content %}
<style>
  .declaration-editor {
    min-height: 250px;
    overflow-y: hidden;
    resize: vertical;
    line-height: 1.45;
    font-family: "Times New Roman", Times, serif;
  }
  .layout-setting-card .form-label { font-weight: 600; }
  .placeholder-list code { white-space: nowrap; }
</style>
<div class="container py-3" style="max-width:1180px">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h3 class="mb-1">Lease Parties Declaration</h3>
      <div class="text-muted">Edit the proposer and seconder wording used in both PDF and Word agreement packages.</div>
    </div>
  </div>

  <form method="post" class="card card-body shadow-sm">{% csrf_token %}
    <div class="mb-3">
      <label class="form-label fw-bold">Page heading</label>
      {{ form.heading }}
    </div>

    <div class="mb-3">
      <label class="form-label fw-bold">Proposer declaration</label>
      {{ form.proposer_declaration }}
    </div>

    <div class="mb-3">
      <label class="form-label fw-bold">Seconder declaration</label>
      {{ form.seconder_declaration }}
    </div>

    <div class="mb-3">
      <label class="form-label fw-bold">Optional footer text</label>
      {{ form.footer_text }}
    </div>

    <div class="alert alert-light border small mb-3 placeholder-list">
      <strong>Available placeholders:</strong><br>
      {% verbatim %}<code>{{ tenant_name }}</code>, <code>{{ tenant_cnic }}</code>,
      <code>{{ property_unit }}</code>, <code>{{ lease_start_date }}</code>, <code>{{ lease_end_date }}</code>,
      <code>{{ proposer_name }}</code>, <code>{{ proposer_cnic }}</code>, <code>{{ proposer_relationship }}</code>,
      <code>{{ seconder_name }}</code>, <code>{{ seconder_cnic }}</code>, <code>{{ seconder_relationship }}</code>.{% endverbatim %}
    </div>

    <div class="d-flex flex-wrap gap-4 mb-3">
      <label class="form-check-label">{{ form.show_phone }} Show phone number in details</label>
      <label class="form-check-label">{{ form.show_thumb_impression }} Show thumb-impression lines</label>
    </div>

    <div class="border rounded p-3 mb-3 layout-setting-card">
      <h5 class="mb-1">Legal Agreement Layout</h5>
      <p class="text-muted small mb-3">
        Reserve values are in inches and apply only when <strong>Print on Legal Page</strong> is selected.
        The QR width and height define a bottom-right box on agreement page 1. Agreement text may continue in the space to its left but cannot overlap the box.
        Clause spacing is measured in points and is reduced automatically only when needed to keep the agreement within three pages.
      </p>
      <div class="row g-3">
        <div class="col-md-6 col-xl-3">
          <label class="form-label">First-page top reserve</label>
          {{ form.legal_first_page_top_reserve }}
          {% if form.legal_first_page_top_reserve.errors %}<div class="text-danger small">{{ form.legal_first_page_top_reserve.errors }}</div>{% endif %}
        </div>
        <div class="col-md-6 col-xl-3">
          <label class="form-label">QR reserve width</label>
          {{ form.legal_qr_reserve_width }}
          {% if form.legal_qr_reserve_width.errors %}<div class="text-danger small">{{ form.legal_qr_reserve_width.errors }}</div>{% endif %}
        </div>
        <div class="col-md-6 col-xl-3">
          <label class="form-label">QR reserve height</label>
          {{ form.legal_qr_reserve_height }}
          {% if form.legal_qr_reserve_height.errors %}<div class="text-danger small">{{ form.legal_qr_reserve_height.errors }}</div>{% endif %}
        </div>
        <div class="col-md-6 col-xl-3">
          <label class="form-label">Page-2 CNIC bottom reserve</label>
          {{ form.legal_identity_bottom_reserve }}
          {% if form.legal_identity_bottom_reserve.errors %}<div class="text-danger small">{{ form.legal_identity_bottom_reserve.errors }}</div>{% endif %}
        </div>
        <div class="col-md-6 col-xl-3">
          <label class="form-label">Legal clause spacing (pt)</label>
          {{ form.legal_clause_spacing }}
          {% if form.legal_clause_spacing.errors %}<div class="text-danger small">{{ form.legal_clause_spacing.errors }}</div>{% endif %}
        </div>
      </div>
    </div>

    <div><button class="btn btn-primary"><i class="fas fa-save"></i> Save Lease Parties Template</button></div>
  </form>
</div>
<script>
(function () {
  function autoGrow(textarea) {
    textarea.style.height = 'auto';
    textarea.style.height = Math.max(250, textarea.scrollHeight + 4) + 'px';
  }
  document.querySelectorAll('textarea[name="proposer_declaration"], textarea[name="seconder_declaration"]').forEach(function (textarea) {
    textarea.classList.add('declaration-editor');
    autoGrow(textarea);
    textarea.addEventListener('input', function () { autoGrow(textarea); });
  });
})();
</script>
{% endblock %}
