{% extends "base.html" %}

{% block title %}Meter Check Groups{% endblock %}

{% block content %}
{% include "smart_meter/meterbar.html" %}
<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h2 class="mb-0"><i class="fas fa-scale-balanced text-info me-2"></i>Meter Check Groups</h2>
      <small class="text-muted">Compare each audit meter with its downstream billing meters.</small>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-sm btn-outline-secondary" href="{% url 'smart_meter:meter_list' %}">Meters</a>
      <a class="btn btn-sm btn-primary" href="{% url 'smart_meter:meter_check_group_add' %}">
        <i class="fas fa-plus me-1"></i>New Check Group
      </a>
    </div>
  </div>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Property</th>
            <th>Check / Audit Meter</th>
            <th>Active Billing Meters</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for group in groups %}
            <tr>
              <td class="fw-semibold">{{ group.name }}</td>
              <td>{{ group.property.property_name }}</td>
              <td>
                <span class="badge bg-info text-dark">{{ group.check_meter.meter_number }}</span>
                {% if group.check_meter.unit %}<small class="text-muted ms-1">{{ group.check_meter.unit.unit_number }}</small>{% endif %}
              </td>
              <td>{{ group.active_billing_meters.count }}</td>
              <td>
                {% if group.is_active %}<span class="badge bg-success">Active</span>{% else %}<span class="badge bg-secondary">Inactive</span>{% endif %}
              </td>
              <td class="text-end">
                <a class="btn btn-sm btn-primary" href="{% url 'smart_meter:meter_check_group_detail' group.pk %}">View</a>
                <a class="btn btn-sm btn-outline-secondary" href="{% url 'smart_meter:meter_check_group_edit' group.pk %}">Edit</a>
              </td>
            </tr>
          {% empty %}
            <tr><td colspan="6" class="text-center text-muted py-4">No check groups yet.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
