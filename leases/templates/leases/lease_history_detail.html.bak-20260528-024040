{% extends 'base.html' %}
{% load humanize %}

{% block content %}
<div class="container mt-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0">Lease History #{{ history.renewal_number }}</h2>
    <div class="d-flex gap-1">
      <a href="{% url 'leases:lease_history_edit' lease.pk history.pk %}" class="btn btn-primary btn-sm">Edit</a>
      <a href="{% url 'leases:edit_clauses' lease.pk %}?history={{ history.pk }}" class="btn btn-success btn-sm">Edit Clauses</a>
      <a href="{% url 'leases:renewal_agreement' lease.pk history.pk %}" class="btn btn-outline-primary btn-sm">Generate PDF</a>
      <a href="{% url 'leases:renewal_upload_signed' lease.pk history.pk %}" class="btn btn-outline-secondary btn-sm">Upload Signed</a>
      <a href="{% url 'leases:history_media_page' lease.pk history.pk %}" class="btn btn-outline-dark btn-sm">Media</a>
      <a href="{% url 'leases:lease_renewals' lease.pk %}" class="btn btn-secondary btn-sm">Back</a>
    </div>
  </div>

  {% if is_active_history %}
    <div class="alert alert-warning py-2">
      This is the active/current history. Its financial values control the master lease and recurring charges.
    </div>
  {% endif %}

  <div class="card mb-3">
    <div class="card-header bg-dark text-white py-2 px-3">Lease, Tenant & Unit</div>
    <div class="card-body">
      <div class="row row-cols-1 row-cols-md-3 g-2 small">
        <div><strong>Lease:</strong> #{{ lease.id }}</div>
        <div><strong>Status:</strong> {% if history.is_original %}Original Lease{% else %}Renewal{% endif %}</div>
        <div><strong>History Number:</strong> #{{ history.renewal_number }}</div>
        <div><strong>Tenant:</strong> {{ lease.tenant.get_full_name }}</div>
        <div><strong>Building:</strong> {{ lease.unit.property.property_name }}</div>
        <div><strong>Unit:</strong> {{ lease.unit.unit_number }}</div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header bg-dark text-white py-2 px-3">Period & Charges</div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <table class="table table-sm table-bordered mb-0">
            <tbody>
              <tr><th>Start Date</th><td>{{ history.start_date|date:"M d, Y" }}</td></tr>
              <tr><th>End Date</th><td>{{ history.end_date|date:"M d, Y" }}</td></tr>
              <tr><th>Agreement Date</th><td>{{ history.agreement_date|date:"M d, Y"|default:"-" }}</td></tr>
              <tr><th>Monthly Rent</th><td class="text-end">{{ history.monthly_rent|default:0|money:0 }}</td></tr>
              <tr><th>Society Maintenance</th><td class="text-end">{{ history.society_maintenance|default:0|money:0 }}</td></tr>
              <tr><th>Water Charges</th><td class="text-end">{{ history.water_charges|default:0|money:0 }}</td></tr>
              <tr><th>Internet Charges</th><td class="text-end">{{ history.internet_charges|default:0|money:0 }}</td></tr>
              <tr class="table-light"><th>Total Monthly Charges</th><td class="text-end fw-bold">{{ history.total_monthly_amount|default:0|money:0 }}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="col-md-6">
          <table class="table table-sm table-bordered mb-0">
            <tbody>
              <tr><th>Agreement Charges</th><td class="text-end">{{ history.agreement_charges|default:0|money:0 }}</td></tr>
              <tr><th>Security Deposit</th><td class="text-end">{{ history.security_deposit|default:0|money:0 }}</td></tr>
              <tr><th>Witness 1 Name</th><td>{{ history.witness1_name|default:"-" }}</td></tr>
              <tr><th>Witness 1 CNIC</th><td>{{ history.witness1_cnic|default:"-" }}</td></tr>
              <tr><th>Witness 2 Name</th><td>{{ history.witness2_name|default:"-" }}</td></tr>
              <tr><th>Witness 2 CNIC</th><td>{{ history.witness2_cnic|default:"-" }}</td></tr>
              <tr>
                <th>Police Verification</th>
                <td>
                  <span class="badge bg-{% if history.police_verification_status == 'verified' %}success{% elif history.police_verification_status == 'rejected' %}danger{% elif history.police_verification_status == 'pending' or history.police_verification_status == 'follow_up' %}warning text-dark{% else %}secondary{% endif %}">
                    {{ history.get_police_verification_status_display }}
                  </span>
                </td>
              </tr>
              <tr><th>Police Verified Date</th><td>{{ history.police_verification_date|date:"M d, Y"|default:"-" }}</td></tr>
              <tr><th>Police Follow-up</th><td>{{ history.police_verification_follow_up_date|date:"M d, Y"|default:"-" }}</td></tr>
              <tr>
                <th>Police Document</th>
                <td>
                  {% if history.police_verification_document %}
                    <a href="{{ history.police_verification_document.url }}" target="_blank">View</a>
                  {% else %}-{% endif %}
                </td>
              </tr>
              <tr><th>Created</th><td>{{ history.created_at|date:"M d, Y H:i" }}{% if history.created_by %} by {{ history.created_by }}{% endif %}</td></tr>
              <tr><th>Updated</th><td>{{ history.updated_at|date:"M d, Y H:i" }}{% if history.updated_by %} by {{ history.updated_by }}{% endif %}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      {% if history.notes %}
        <div class="mt-3 small"><strong>Notes:</strong> {{ history.notes|linebreaksbr }}</div>
      {% endif %}
      {% if history.police_verification_remarks %}
        <div class="mt-2 small"><strong>Police Remarks:</strong> {{ history.police_verification_remarks|linebreaksbr }}</div>
      {% endif %}
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header bg-dark text-white py-2 px-3">Agreement Clauses</div>
    <div class="card-body p-0">
      <table class="table table-sm table-striped mb-0">
        <tbody>
          {% for clause in history.clauses.all %}
            <tr>
              <th style="width:80px">#{{ clause.clause_number }}</th>
              <td>{{ clause.template_text|linebreaksbr }}</td>
            </tr>
          {% empty %}
            <tr><td class="text-muted p-3">No clauses copied for this history.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header bg-dark text-white py-2 px-3">Files & PDFs</div>
    <div class="card-body small">
      <div class="row row-cols-1 row-cols-md-3 g-2">
        <div><strong>Generated Agreement PDF:</strong>
          {% if history.generated_agreement_pdf %}<a href="{{ history.generated_agreement_pdf.url }}" target="_blank">View</a>{% else %}<span class="text-muted">None</span>{% endif %}
        </div>
        <div><strong>Tenant Signed PDF:</strong>
          {% if history.signed_copy %}<a href="{{ history.signed_copy.url }}" target="_blank">View</a>{% else %}<span class="text-muted">None</span>{% endif %}
        </div>
        <div><strong>Condition PDF:</strong> <span class="text-muted">Phase 3 file link pending</span></div>
      </div>
      <hr>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="fw-bold">Condition Photos / Uploaded Files</div>
        <a href="{% url 'leases:history_media_page' lease.pk history.pk %}" class="btn btn-primary btn-sm">Manage Media</a>
      </div>
      {% if media_files %}
        <ul class="mb-0">
          {% for media in media_files %}
            <li><a href="{{ media.file.url }}" target="_blank">{{ media.title|default:media.file.name }}</a>{% if media.description %} - {{ media.description }}{% endif %}</li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="text-muted">No uploaded files found for this lease yet.</div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
