{# templates/leases/_pcr_gallery.html #}
{% load static %}
<link rel="stylesheet" href="{% static 'css/tms-masonry-grid.css' %}">
<div class="pcr-panel" data-lease-id="{{ lease.id }}">
  <style>
    .pcr-panel { max-width: 980px; }
    .pcr-toolbar { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-bottom:10px; }
    .pcr-upload-form { display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
    .pcr-grid { --tms-masonry-min:150px; --tms-masonry-gap:10px; }
    .pcr-card { border:1px solid #e5e7eb; border-radius:7px; background:#fff; overflow:hidden; }
    .pcr-card.dragging { opacity:.55; }
    .pcr-img-wrap { width:100%; background:#f8fafc; position:relative; }
    .pcr-img { width:100%; height:auto; object-fit:contain; display:block; }
    .pcr-missing { color:#6b7280; font-size:12px; text-align:center; padding:12px; }
    .pcr-missing-badge { position:absolute; top:6px; right:6px; font-size:10px; }
    .pcr-card-body { padding:7px; }
    .pcr-room { font-size:12px; font-weight:700; color:#111827; }
    .pcr-meta { font-size:11px; color:#6b7280; }
    .pcr-comment { font-size:11px; color:#374151; overflow-wrap:anywhere; }
    .pcr-actions { display:flex; flex-wrap:wrap; gap:5px; padding:7px; border-top:1px solid #f1f5f9; }
    .pcr-drag-handle { cursor:grab; touch-action:none; }
    @media (max-width: 480px) {
      .pcr-toolbar, .pcr-upload-form { align-items:stretch; }
      .pcr-upload-form input[type=file] { width:100%; }
    }
  </style>

  <div class="pcr-toolbar no-print">
    <form class="pcr-upload-form" data-pcr-upload action="{% url 'leases:pcr_photo_upload' lease.id %}" method="post" enctype="multipart/form-data">
      {% csrf_token %}
      <input class="form-control form-control-sm" type="file" name="photos" multiple accept="image/*">
      <input class="form-control form-control-sm" type="text" name="room" placeholder="Room/area" style="max-width:130px;">
      <input class="form-control form-control-sm" type="text" name="comment" placeholder="Comment" style="max-width:180px;">
      <button class="btn btn-sm btn-primary" type="submit">Upload Photos</button>
    </form>
    <button class="btn btn-sm btn-outline-secondary" type="button" data-pcr-save>Save Sort Order</button>
  </div>

  <div id="pcr-photo-grid"
       class="pcr-grid tms-masonry-grid"
       data-masonry-grid
       data-reorder-url="{% url 'leases:pcr_photo_reorder' lease.id %}">
    {% for p in photos|default:pcr.photos.all %}
      <div class="pcr-card" data-masonry-item draggable="true" data-photo-id="{{ p.id }}">
        <div class="pcr-img-wrap">
          {% if p.display_image_url %}
            <img src="{{ p.display_image_url }}" class="pcr-img" alt="PCR photo" loading="lazy">
          {% else %}
            <div class="pcr-missing">Photo file missing</div>
            <span class="badge bg-warning text-dark pcr-missing-badge">file missing</span>
          {% endif %}
        </div>
        <div class="pcr-card-body">
          <div class="d-flex align-items-center gap-1">
            <button class="btn btn-light btn-sm pcr-drag-handle" type="button" title="Drag to reorder">↕</button>
            <div>
              <div class="pcr-room">{{ p.room|default:"Area" }}</div>
              <div class="pcr-meta">{{ p.taken_at|date:"Y-m-d H:i" }}</div>
            </div>
          </div>
          {% if p.comment %}<div class="pcr-comment mt-1">{{ p.comment }}</div>{% endif %}
        </div>
        <div class="pcr-actions no-print">
          <button class="btn btn-danger btn-sm" type="button" data-pcr-delete="{{ p.id }}">Delete</button>
          {% if p.original_image_url %}
            <a class="btn btn-secondary btn-sm" target="_blank" rel="noopener" href="{{ p.original_image_url }}">View</a>
          {% else %}
            <button class="btn btn-secondary btn-sm" type="button" disabled>Missing</button>
          {% endif %}
        </div>
      </div>
    {% empty %}
      <div class="text-muted" data-masonry-item>No photos yet.</div>
    {% endfor %}
  </div>
</div>

<script src="{% static 'js/tms-masonry-grid.js' %}"></script>
<script>
(function() {
  const root = document.currentScript.closest('.pcr-panel') || document.querySelector('.pcr-panel');
  if (!root || root.dataset.bound === '1') return;
  root.dataset.bound = '1';

  const csrf = '{{ csrf_token }}';
  const galleryBox = document.getElementById('pcr-gallery');
  const grid = root.querySelector('#pcr-photo-grid');

  async function reloadGallery() {
    if (galleryBox && galleryBox.dataset.url) {
      const response = await fetch(galleryBox.dataset.url, {headers:{'X-Requested-With':'XMLHttpRequest'}});
      galleryBox.innerHTML = await response.text();
      galleryBox.querySelectorAll('script').forEach(function(oldScript) {
        const script = document.createElement('script');
        Array.from(oldScript.attributes).forEach(function(attr) {
          script.setAttribute(attr.name, attr.value);
        });
        script.text = oldScript.text;
        oldScript.parentNode.replaceChild(script, oldScript);
      });
    }
  }

  window.pcrDelete = window.pcrDelete || async function(id) {
    if (!confirm('Delete this photo?')) return;
    const url = "{% url 'leases:pcr_photo_delete' 0 %}".replace('/0/','/'+id+'/');
    const response = await fetch(url, {method:'POST', headers:{'X-CSRFToken': csrf}});
    if (response.ok) await reloadGallery();
    else alert('Delete failed');
  };

  root.addEventListener('click', function(event) {
    const del = event.target.closest('[data-pcr-delete]');
    if (del) window.pcrDelete(del.dataset.pcrDelete);
    if (event.target.closest('[data-pcr-save]')) saveOrder();
  });

  const uploadForm = root.querySelector('[data-pcr-upload]');
  if (uploadForm) {
    uploadForm.addEventListener('submit', async function(event) {
      event.preventDefault();
      const response = await fetch(uploadForm.action, {
        method: 'POST',
        body: new FormData(uploadForm),
        headers: {'X-CSRFToken': csrf, 'X-Requested-With':'XMLHttpRequest'}
      });
      if (response.ok) await reloadGallery();
      else alert(await response.text() || 'Upload failed');
    });
  }

  let dragged = null;
  if (grid) {
    grid.addEventListener('dragstart', function(event) {
      const card = event.target.closest('.pcr-card');
      if (!card) return;
      dragged = card;
      card.classList.add('dragging');
      event.dataTransfer.effectAllowed = 'move';
    });
    grid.addEventListener('dragend', function() {
      if (dragged) dragged.classList.remove('dragging');
      dragged = null;
    });
    grid.addEventListener('dragover', function(event) {
      event.preventDefault();
      const after = getAfterElement(grid, event.clientY);
      if (!dragged) return;
      if (after == null) grid.appendChild(dragged);
      else grid.insertBefore(dragged, after);
    });

    grid.addEventListener('pointerdown', function(event) {
      const handle = event.target.closest('.pcr-drag-handle');
      if (!handle) return;
      dragged = handle.closest('.pcr-card');
      if (!dragged) return;
      dragged.classList.add('dragging');
      handle.setPointerCapture?.(event.pointerId);
    });
    grid.addEventListener('pointermove', function(event) {
      if (!dragged) return;
      const after = getAfterElement(grid, event.clientY);
      if (after == null) grid.appendChild(dragged);
      else if (after !== dragged) grid.insertBefore(dragged, after);
    });
    grid.addEventListener('pointerup', function() {
      if (dragged) dragged.classList.remove('dragging');
      dragged = null;
    });
    grid.addEventListener('pointercancel', function() {
      if (dragged) dragged.classList.remove('dragging');
      dragged = null;
    });
  }

  function getAfterElement(container, y) {
    const cards = [...container.querySelectorAll('.pcr-card:not(.dragging)')];
    return cards.reduce(function(closest, child) {
      const box = child.getBoundingClientRect();
      const offset = y - box.top - box.height / 2;
      if (offset < 0 && offset > closest.offset) return {offset: offset, element: child};
      return closest;
    }, {offset: Number.NEGATIVE_INFINITY}).element;
  }

  async function saveOrder() {
    if (!grid) return;
    const ids = [...grid.querySelectorAll('.pcr-card')].map(card => card.dataset.photoId);
    const response = await fetch(grid.dataset.reorderUrl, {
      method: 'POST',
      headers: {'Content-Type':'application/json', 'X-CSRFToken': csrf},
      body: JSON.stringify({photo_ids: ids})
    });
    if (!response.ok) alert(await response.text() || 'Sort save failed');
  }
})();
</script>
