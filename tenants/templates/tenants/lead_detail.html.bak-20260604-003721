{% extends 'base.html' %}

{% block content %}
<div class="container-fluid px-2 px-md-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-0">{{ lead.get_full_name }}</h3>
            <div class="text-muted small">{{ lead.get_lead_status_display }}</div>
        </div>
        <div class="d-flex gap-2">
            <a href="{% url 'tenants:lead_vacancy_whatsapp' lead.pk %}" class="btn btn-success btn-sm">Vacancy WhatsApp</a>
            <a href="{% url 'tenants:lead_update' lead.pk %}" class="btn btn-primary btn-sm">Edit</a>
            <a href="{% url 'tenants:tenant_detail' lead.pk %}" class="btn btn-outline-primary btn-sm">Tenant View</a>
            <a href="{% url 'tenants:lead_list' %}" class="btn btn-outline-secondary btn-sm">Back</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">{{ lead.phone|default:"-" }}</dd>
                <dt class="col-sm-3">WhatsApp</dt><dd class="col-sm-9">{{ lead.whatsapp_number|default:"-" }}</dd>
                <dt class="col-sm-3">Interested In</dt>
                <dd class="col-sm-9">
                    {% for item in lead.interested_in.all %}
                        <span class="badge bg-info text-dark">{{ item.name }}</span>
                    {% empty %}-{% endfor %}
                </dd>
                <dt class="col-sm-3">Interested Building</dt><dd class="col-sm-9">{{ lead.interested_building|default:"-" }}</dd>
                <dt class="col-sm-3">Interested Unit</dt><dd class="col-sm-9">{{ lead.interested_unit|default:"-" }}</dd>
                <dt class="col-sm-3">Budget</dt><dd class="col-sm-9">{{ lead.budget|default:"-" }}</dd>
                <dt class="col-sm-3">Family Size</dt><dd class="col-sm-9">{{ lead.family_size|default:"-" }}</dd>
                <dt class="col-sm-3">Source</dt><dd class="col-sm-9">{{ lead.source|default:"-" }}</dd>
                <dt class="col-sm-3">Next Follow-up</dt><dd class="col-sm-9">{{ lead.next_follow_up_date|default:"-" }}</dd>
                <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">{{ lead.notes|default:"-" }}</dd>
            </dl>
        </div>
    </div>
</div>
{% endblock %}
