<script>
document.addEventListener("DOMContentLoaded", function () {
    const buildingTypeOptions = JSON.parse(document.getElementById("buildingTypeOptions").textContent || "[]");
    const unitStatusOptions = [
        {value: "vacant", label: "Vacant", badgeClass: "bg-primary"},
        {value: "occupied", label: "Occupied", badgeClass: "bg-success"},
        {value: "maintenance", label: "Maintenance", badgeClass: "bg-danger"}
    ];
    const bulkFieldLabels = {
        monthly_rent: "monthly rent",
        society_maintenance: "society maintenance",
        water_charges: "water charges",
        internet_charges: "internet charges",
        security_requires: "security text",
        security_deposit_amount: "security deposit amount"
    };
    const bulkModalElement = document.getElementById("unitBulkUpdateModal");
    const bulkMessage = document.getElementById("unitBulkUpdateMessage");
    const bulkConfirm = document.getElementById("unitBulkUpdateConfirm");
    let bulkUpdateContext = null;

    if (bulkConfirm) {
        bulkConfirm.addEventListener("click", function () {
            if (!bulkUpdateContext) return;
            const context = bulkUpdateContext;
            bulkConfirm.disabled = true;
            bulkConfirm.textContent = "Applying...";
            saveUnitField(context.unitId, context.field, context.value, true)
                .then(function (payload) {
                    document.querySelectorAll(
                        `.unit-inline-edit[data-field="${context.field}"][data-property-id="${context.propertyId}"]`
                    ).forEach(function (span) {
                        span.textContent = payload.new_value || "-";
                    });
                    bootstrap.Modal.getOrCreateInstance(bulkModalElement).hide();
                })
                .catch(function (error) {
                    alert(error.message);
                })
                .finally(function () {
                    bulkConfirm.disabled = false;
                    bulkConfirm.textContent = "Apply to all units";
                    bulkUpdateContext = null;
                });
        });
    }

    const selectAll = document.getElementById('select-all');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('input[name="selected_units"]');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });
    }

    document.querySelectorAll("td[data-editable='true']").forEach(td => {
        td.addEventListener("dblclick", function () {
            const field = td.dataset.field;
            const id = td.dataset.id;
            const current = td.innerText.trim();

            const input = document.createElement("input");
            input.type = "text";
            input.value = current;
            input.className = "form-control";
            td.innerHTML = "";
            td.appendChild(input);
            input.focus();

            input.addEventListener("blur", function () {
                fetch("{% url 'properties:unit_inline_update' %}", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRFToken": getCookie("csrftoken")
                    },
                    body: JSON.stringify({
                        id: id,
                        field: field,
                        value: input.value
                    })
                }).then(res => res.json()).then(data => {
                    td.innerText = data.new_value || input.value;
                }).catch(err => {
                    console.error(err);
                    td.innerText = current;
                });
            });
        });
    });

    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });
    document.querySelectorAll(".unit-public-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            toggleBooleanStatus(span, "show_publicly");
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") toggleBooleanStatus(span, "show_publicly");
        });
    });
    document.querySelectorAll(".unit-smart-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            toggleBooleanStatus(span, "is_smart_meter");
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") toggleBooleanStatus(span, "is_smart_meter");
        });
    });
    document.querySelectorAll(".unit-building-type-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            startBuildingTypeEdit(span);
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") startBuildingTypeEdit(span);
        });
    });
    document.querySelectorAll(".unit-status-edit").forEach(function (span) {
        span.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
            startUnitStatusEdit(span);
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                startUnitStatusEdit(span);
            }
        });
    });

    document.querySelectorAll(".unit-inline-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            startUnitTextEdit(span);
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") startUnitTextEdit(span);
        });
    });

    const vacantSummaryButton = document.getElementById("vacantSummaryMessageBtn");
    if (vacantSummaryButton) {
        vacantSummaryButton.addEventListener("click", function () {
            vacantSummaryButton.disabled = true;
            fetch(vacantSummaryButton.dataset.summaryUrl, {
                headers: {"X-Requested-With": "XMLHttpRequest"}
            })
            .then(function (response) {
                return response.json().then(function (payload) {
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.error || "Could not build vacant summary.");
                    }
                    return payload;
                });
            })
            .then(function (payload) {
                window.open(payload.whatsapp_url, "_blank");
            })
            .catch(function (error) {
                alert(error.message);
            })
            .finally(function () {
                vacantSummaryButton.disabled = false;
            });
        });
    }

    function startUnitStatusEdit(span) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";
        const previousValue = span.dataset.currentValue || "vacant";
        const previousHtml = span.innerHTML;
        const select = document.createElement("select");
        select.className = "form-select form-select-sm unit-status-select";
        select.innerHTML = unitStatusOptions.map(function (item) {
            return `<option value="${item.value}" ${item.value === previousValue ? "selected" : ""}>${item.label}</option>`;
        }).join("");
        select.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
        });
        span.replaceWith(select);
        select.focus();
        let finished = false;

        function finish(save) {
            if (finished) return;
            finished = true;
            if (!save) {
                select.replaceWith(span);
                span.dataset.editing = "0";
                return;
            }
            select.disabled = true;
            saveUnitField(span.dataset.unitId, "status", select.value)
                .then(function (payload) {
                    updateStatusBadge(span, payload.value || select.value, payload.new_value);
                    select.replaceWith(span);
                })
                .catch(function (error) {
                    alert(error.message);
                    span.dataset.currentValue = previousValue;
                    span.innerHTML = previousHtml;
                    select.replaceWith(span);
                })
                .finally(function () {
                    span.dataset.editing = "0";
                });
        }

        select.addEventListener("change", function () { finish(true); });
        select.addEventListener("blur", function () { finish(true); });
        select.addEventListener("keydown", function (event) {
            if (event.key === "Escape") finish(false);
            if (event.key === "Enter") finish(true);
        });
    }

    function updateStatusBadge(span, value, label) {
        const option = unitStatusOptions.find(function (item) {
            return item.value === value;
        }) || unitStatusOptions[0];
        span.dataset.currentValue = option.value;
        span.classList.remove("bg-primary", "bg-success", "bg-danger", "bg-warning", "text-dark", "text-wrap");
        span.classList.add(option.badgeClass);
        span.innerHTML = `${escapeHtml(label || option.label)}<i class="fas fa-chevron-down ms-1 unit-status-caret"></i>`;
    }

    function startBuildingTypeEdit(span) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";
        const previousValue = span.dataset.currentValue || "";
        const previousText = span.textContent.trim();
        const select = document.createElement("select");
        select.className = "form-select form-select-sm";
        select.innerHTML = '<option value="">-</option>' + buildingTypeOptions.map(function (item) {
            return `<option value="${item.id}" ${String(item.id) === String(previousValue) ? "selected" : ""}>${escapeHtml(item.name)}</option>`;
        }).join("");
        span.replaceWith(select);
        select.focus();
        let finished = false;

        function finish(save) {
            if (finished) return;
            finished = true;
            if (!save) {
                select.replaceWith(span);
                span.dataset.editing = "0";
                return;
            }
            select.disabled = true;
            saveUnitField(span.dataset.unitId, "building_type", select.value)
                .then(function (payload) {
                    span.dataset.currentValue = select.value;
                    span.textContent = payload.new_value || "-";
                    select.replaceWith(span);
                })
                .catch(function (error) {
                    alert(error.message);
                    span.dataset.currentValue = previousValue;
                    span.textContent = previousText || "-";
                    select.replaceWith(span);
                })
                .finally(function () {
                    span.dataset.editing = "0";
                });
        }

        select.addEventListener("change", function () { finish(true); });
        select.addEventListener("blur", function () { finish(true); });
        select.addEventListener("keydown", function (event) {
            if (event.key === "Escape") finish(false);
        });
    }

    function startUnitTextEdit(span) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";
        const previousText = span.textContent.trim();
        const input = document.createElement("input");
        input.type = "text";
        input.className = "form-control form-control-sm";
        input.value = previousText === "-" ? "" : previousText;
        span.replaceWith(input);
        input.focus();
        input.select();
        let finished = false;

        function finish(save) {
            if (finished) return;
            finished = true;
            if (!save) {
                input.replaceWith(span);
                span.dataset.editing = "0";
                return;
            }
            saveUnitField(span.dataset.unitId, span.dataset.field, input.value)
                .then(function (payload) {
                    span.textContent = payload.new_value || "-";
                    input.replaceWith(span);
                    showBulkUpdateOffer(span, input.value, payload);
                })
                .catch(function (error) {
                    alert(error.message);
                    span.textContent = previousText || "-";
                    input.replaceWith(span);
                })
                .finally(function () {
                    span.dataset.editing = "0";
                });
        }

        input.addEventListener("blur", function () { finish(true); });
        input.addEventListener("keydown", function (event) {
            if (event.key === "Enter") finish(true);
            if (event.key === "Escape") finish(false);
        });
    }

    function showBulkUpdateOffer(span, value, payload) {
        if (!payload.offer_bulk || !bulkModalElement || !bulkMessage) return;
        bulkUpdateContext = {
            unitId: span.dataset.unitId,
            field: span.dataset.field,
            value: value,
            propertyId: String(payload.property_id)
        };
        const fieldLabel = bulkFieldLabels[span.dataset.field] || "value";
        bulkMessage.textContent =
            `The ${fieldLabel} was updated for this unit. Apply ${payload.new_value || "-"} ` +
            `to all ${payload.property_unit_count} units in ${payload.property_name}?`;
        bootstrap.Modal.getOrCreateInstance(bulkModalElement).show();
    }

    function toggleBooleanStatus(span, field) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";

        const currentValue = span.dataset.currentValue === "true";
        const newValue = !currentValue;

        saveUnitField(span.dataset.unitId, field, newValue ? "true" : "false")
            .then(function () {
                span.dataset.currentValue = newValue ? "true" : "false";
                span.textContent = newValue ? "Yes" : "No";
                span.classList.toggle("bg-success", newValue);
                span.classList.toggle("bg-secondary", !newValue);
            })
            .catch(function (error) {
                alert(error.message);
            })
            .finally(function () {
                span.dataset.editing = "0";
            });
    }

    function saveUnitField(id, field, value, applyToProperty) {
        return fetch("{% url 'properties:unit_inline_update' %}", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-CSRFToken": getCookie("csrftoken"),
                "X-Requested-With": "XMLHttpRequest"
            },
            body: JSON.stringify({
                id: id,
                field: field,
                value: value,
                apply_to_property: Boolean(applyToProperty)
            })
        }).then(function (response) {
            return response.json().then(function (payload) {
                if (!response.ok || !payload.success) {
                    throw new Error(payload.error || "Could not save unit.");
                }
                return payload;
            });
        });
    }

    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== "") {
            const cookies = document.cookie.split(";");
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + "=")) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }

    function escapeHtml(value) {
        return String(value || "").replace(/[&<>"']/g, function (char) {
            return {"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"}[char];
        });
    }

    function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#096;");
    }
});

    
</script>
