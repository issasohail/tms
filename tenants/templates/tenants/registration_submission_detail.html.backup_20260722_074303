{% extends 'base.html' %}

{% block title %}Review Tenant Registration{% endblock %}

{% block content %}
<div class="container-fluid mt-3 px-2 px-lg-3 registration-review-page">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="mb-1 fs-5">Review Registration - {{ submission.tenant.get_full_name }}</h2>
      <div class="small text-muted">
        Submitted {{ submission.submitted_at|date:"M d, Y H:i" }} ·
        <span class="badge bg-{% if submission.status == 'pending' %}warning text-dark{% elif submission.status == 'approved' %}success{% else %}secondary{% endif %}">{{ submission.get_status_display }}</span>
      </div>
    </div>
    <div class="d-flex gap-2">
      {% if can_edit_submission %}<a href="{% url 'tenants:registration_submission_edit' submission.pk %}" class="btn btn-primary btn-sm">Edit Submission</a>{% endif %}
      <a href="{% url 'tenants:registration_submission_list' %}" class="btn btn-secondary btn-sm">Back</a>
    </div>
  </div>

  <div class="registration-hero card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
      <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="registration-doc-strip">
          {% for document in identity_documents %}
            <div class="registration-doc-item {% if document.field == 'photo' %}registration-doc-photo{% endif %}">
              {% if document.submitted_url %}
                <a href="{{ document.submitted_url }}" target="_blank" rel="noopener">
                  <img src="{{ document.submitted_url }}" alt="Submitted {{ document.label }}">
                </a>
                <span class="badge bg-success registration-doc-source">Submitted</span>
              {% elif document.submitted_missing %}
                <div class="registration-doc-empty text-danger">File missing from storage</div>
                <span class="badge bg-danger registration-doc-source">Missing</span>
              {% elif document.current_url %}
                <a href="{{ document.current_url }}" target="_blank" rel="noopener">
                  <img src="{{ document.current_url }}" alt="Current {{ document.label }}">
                </a>
                <span class="badge bg-secondary registration-doc-source">Current</span>
              {% else %}
                <div class="registration-doc-empty">No file submitted</div>
              {% endif %}
              <div class="registration-doc-label">{{ document.label }}</div>
            </div>
          {% endfor %}
        </div>

        <div class="flex-grow-1 min-w-0">
          <h2 class="fs-4 mb-1">{{ submission.tenant.get_full_name }}</h2>
          <div class="small text-muted mb-2">
            {{ submission.tenant.cnic|format_cnic|default:"No CNIC" }} &middot;
            {% include "tenants/_whatsapp_phone_link.html" with phone=submission.tenant.phone label=submission.tenant.phone name=submission.tenant.get_full_name only %}
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge bg-{% if submission.status == 'pending' %}warning text-dark{% elif submission.status == 'approved' %}success{% else %}secondary{% endif %}">{{ submission.get_status_display }}</span>
            <span class="small text-muted">Submitted {{ submission.submitted_at|date:"M d, Y H:i" }}</span>
            <span class="badge {% if submission_change_count %}bg-info text-dark{% else %}bg-light text-dark border{% endif %}">{{ submission_change_count }} change{{ submission_change_count|pluralize }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <form method="post" action="{% url 'tenants:registration_submission_review' submission.pk %}" class="col-xl-9">
      {% csrf_token %}<input type="hidden" name="action" value="approve_and_create_lease">
      <div class="card">
        <div class="card-header bg-dark text-white py-2 px-3 d-flex justify-content-between align-items-center">
          <span>Tenant Changes</span>
          <span class="badge {% if submission_change_count %}bg-warning text-dark{% else %}bg-success{% endif %}">
            {{ submission_change_count }} change{{ submission_change_count|pluralize }}
          </span>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0 registration-compare-table ld-review-table">
              <thead>
                <tr>
                  <th>Field</th>
                  <th>Current Value</th>
                  <th>Submitted Value</th>
                  <th class="text-center">Result</th>
                </tr>
              </thead>
              <tbody>
                {% for row in submission_comparison %}
                  <tr class="{% if row.changed %}table-warning{% endif %}">
                    <th>{{ row.label }}</th>
                    <td>
                      {% if row.existing_url %}<a href="{{ row.existing_url }}" target="_blank" rel="noopener"><img src="{{ row.existing_url }}" class="comparison-photo" alt="Current {{ row.label }}"></a><br>{% endif %}
                      {% if row.is_phone %}{% include "tenants/_whatsapp_phone_link.html" with phone=row.existing label=row.existing name=submission.tenant.get_full_name only %}{% else %}<span class="{% if row.changed %}old-value{% endif %}">{{ row.existing|default:"-" }}</span>{% endif %}
                    </td>
                    <td>
                      {% if row.submitted_url %}<a href="{{ row.submitted_url }}" target="_blank" rel="noopener"><img src="{{ row.submitted_url }}" class="comparison-photo" alt="Submitted {{ row.label }}"></a><br>{% endif %}
                      {% if row.is_phone %}{% include "tenants/_whatsapp_phone_link.html" with phone=row.submitted label=row.submitted name=submission.tenant.get_full_name only %}{% else %}<span class="{% if row.changed %}new-value{% endif %}">{{ row.submitted|default:"-" }}</span>{% endif %}
                    </td>
                    <td class="text-center">
                      {% if row.changed and can_apply_submission %}
                        <select class="form-select form-select-sm result-decision" name="decision_{{ row.field }}" data-update-target="updated_{{ row.field }}" required>
                          <option value="">Select result…</option>
                          <option value="keep_existing">Keep current value</option>
                          <option value="accept_submitted">Use submitted value</option>
                          {% if row.can_update_submitted %}<option value="update_submitted">Update submitted value</option>{% endif %}
                        </select>
                        {% if row.can_update_submitted %}
                          <input type="{{ row.input_type }}" class="form-control form-control-sm mt-1 submitted-update-input" id="updated_{{ row.field }}" name="updated_{{ row.field }}" value="{{ row.submitted_raw }}" aria-label="Updated {{ row.label }}" hidden disabled>
                        {% endif %}
                      {% elif row.changed %}<span class="badge bg-warning text-dark">Changed</span>{% else %}<span class="badge bg-light text-secondary border">Unchanged</span>{% endif %}
                    </td>
                  </tr>
                {% empty %}
                  <tr><td colspan="4" class="text-muted text-center py-3">No submitted tenant fields.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header bg-dark text-white py-2 px-3">Family Members and Other People</div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0 ld-review-table">
              <thead>
                <tr>
                  <th>Role</th>
                  <th>Submitted</th>
                  <th>Existing Match</th>
                  <th>Detected Changes</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {% for person in pending_people %}
                  <tr class="{% if person.proposed_updates %}table-warning{% endif %}">
                    <td>{{ person.get_role_display }}</td>
                    <td>
                      <strong>{{ person.first_name }} {{ person.last_name }}</strong><br>
                      <small>{{ person.cnic|format_cnic|default:"No CNIC" }} · {% include "tenants/_whatsapp_phone_link.html" with phone=person.phone label=person.phone name=person.first_name only %}</small>
                      <div class="person-photo-row mt-1">
                        {% if person.photo %}<a href="{{ person.photo.url }}" target="_blank" rel="noopener"><img src="{{ person.photo.url }}" class="person-photo" alt="Submitted photo" title="Submitted photo"></a>{% endif %}
                        {% if person.cnic_front %}<a href="{{ person.cnic_front.url }}" target="_blank" rel="noopener"><img src="{{ person.cnic_front.url }}" class="person-document" alt="Submitted CNIC front" title="Submitted CNIC front"></a>{% endif %}
                        {% if person.cnic_back %}<a href="{{ person.cnic_back.url }}" target="_blank" rel="noopener"><img src="{{ person.cnic_back.url }}" class="person-document" alt="Submitted CNIC back" title="Submitted CNIC back"></a>{% endif %}
                      </div>
                    </td>
                    <td>
                      {% if person.matched_tenant %}
                        <a href="{% url 'tenants:tenant_detail' person.matched_tenant.pk %}"><strong>{{ person.matched_tenant.get_full_name }}</strong></a><br>
                        <small>{{ person.matched_tenant.cnic|format_cnic|default:"No CNIC" }}</small>
                        {% if person.matched_tenant.phone and person.matched_tenant.phone != person.phone %}<br><small>Existing: {% include "tenants/_whatsapp_phone_link.html" with phone=person.matched_tenant.phone label=person.matched_tenant.phone name=person.matched_tenant.get_full_name only %}</small>{% endif %}
                        {% if person.matched_tenant.photo %}<br><a href="{{ person.matched_tenant.photo.url }}" target="_blank" rel="noopener"><img src="{{ person.matched_tenant.photo.url }}" class="person-photo mt-1" alt="Current photo" title="Current photo"></a>{% endif %}
                      {% else %}
                        <span class="badge bg-info text-dark">New person</span>
                      {% endif %}
                    </td>
                    <td>
                      {% for field, change in person.proposed_updates.items %}
                        <div class="change-line">
                          <strong>{{ field|title }}:</strong>
                          <span class="old-value">{{ change.existing|default:"None" }}</span>
                          <span aria-hidden="true">→</span>
                          <span class="new-value">{{ change.submitted|default:"Empty" }}</span>
                        </div>
                      {% empty %}
                        {% if person.matched_tenant %}<span class="text-muted">No field changes detected.</span>{% else %}<span class="text-info">All information is new.</span>{% endif %}
                      {% endfor %}
                    </td>
                    <td><span class="badge bg-light text-dark border">{{ person.get_status_display }}</span></td>
                  </tr>
                {% empty %}
                  <tr><td colspan="5" class="text-muted text-center py-3">No family-member, proposer, seconder, or witness changes were captured in this submission.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header bg-dark text-white py-2 px-3">Pending Vehicle Submissions</div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0 ld-review-table">
              <thead><tr><th>Type</th><th>Registration #</th><th>Owner</th><th>Status</th><th>Note</th></tr></thead>
              <tbody>
                {% for vehicle in pending_vehicle_submissions %}
                  <tr><td>{{ vehicle.vehicle_type.name }}</td><td>{{ vehicle.registration_number }}</td><td>{{ vehicle.owner_name|default:"-" }}</td><td>{{ vehicle.get_status_display }}</td><td class="small {% if vehicle.duplicate_warning %}text-danger fw-bold{% else %}text-muted{% endif %}">{{ vehicle.duplicate_warning|default:"Waiting for lease assignment before approval." }}</td></tr>
                {% empty %}
                  <tr><td colspan="5" class="text-muted text-center py-3">No vehicle submissions.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      {% if can_apply_submission %}
      <div class="card mt-3">
        <div class="card-header bg-dark text-white py-2 px-3">Create Lease</div>
        <div class="card-body">
          <p class="small text-muted mb-2">Select only the property and unit now. Rent, dates, deposits, and other agreement details can be reviewed from Lease Detail after creation.</p>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label small mb-1" for="registrationProperty">Property</label>
              <select class="form-select form-select-sm" id="registrationProperty" name="property" required>
                <option value="">Select property…</option>
                {% for property in properties %}<option value="{{ property.pk }}">{{ property.property_name }}</option>{% endfor %}
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small mb-1" for="registrationUnit">Unit</label>
              <select class="form-select form-select-sm" id="registrationUnit" name="unit" required disabled>
                <option value="">Select property first…</option>
                {% for unit in units %}<option value="{{ unit.pk }}" data-property="{{ unit.property_id }}">{{ unit.unit_number }}</option>{% endfor %}
              </select>
            </div>
          </div>
          {% if cnic_conflict %}
            <div class="alert alert-danger py-2 small mt-3 mb-2">Submitted CNIC belongs to Tenant #{{ cnic_conflict.pk }} — {{ cnic_conflict.get_full_name }}.</div>
            <label class="form-check mb-2"><input class="form-check-input" type="radio" name="collision_action" value="merge" required> <span class="form-check-label small">Merge the registration shell into Tenant #{{ cnic_conflict.pk }}</span></label>
          {% endif %}
          <button class="btn btn-success btn-sm mt-2" type="submit">Approve and Create Lease</button>
        </div>
      </div>
      {% endif %}
    </form>

    <div class="col-xl-3">
      <div class="card mb-3">
        <div class="card-header bg-dark text-white py-2 px-3">Review</div>
        <div class="card-body">
          {% if can_edit_submission %}<form method="post" action="{% url 'tenants:registration_submission_review' submission.pk %}">
            {% csrf_token %}
            <input type="hidden" name="action" value="save_review">
            {% for field in form %}
              <div class="mb-2">
                <label class="form-label small mb-1" for="{{ field.id_for_label }}">{{ field.label }}</label>
                {{ field }}
                {% for error in field.errors %}<div class="text-danger small">{{ error }}</div>{% endfor %}
              </div>
            {% endfor %}
            <button type="submit" class="btn btn-primary btn-sm">Save Review</button>
          </form>{% else %}<div class="text-muted small">This submission is read-only.</div>{% endif %}
        </div>
      </div>
      {% if cnic_conflict and can_edit_submission %}
      <div class="card mb-3">
        <div class="card-header bg-danger text-white py-2 px-3">Reject CNIC Conflict</div>
        <div class="card-body">
          <div class="small text-danger mb-2">Submitted CNIC belongs to Tenant #{{ cnic_conflict.pk }}. Reject here instead of merging it during approval.</div>
          <form method="post" action="{% url 'tenants:registration_submission_review' submission.pk %}">
            {% csrf_token %}<input type="hidden" name="action" value="reject_collision">
            <label class="form-label small">Rejection reason</label><textarea class="form-control form-control-sm mb-2" name="rejection_reason" required></textarea>
            <button class="btn btn-danger btn-sm" type="submit">Reject Submission</button>
          </form>
        </div>
      </div>
      {% endif %}
      <div class="card mb-3">
        <div class="card-header bg-dark text-white py-2 px-3">Recent Audit Trail</div>
        <div class="card-body py-2">
          {% for entry in audit_entries %}
            <div class="small border-bottom py-1">
              <strong>{{ entry.action|title }}</strong> by {{ entry.edited_by|default:"System" }}<br>
              <span class="text-muted">{{ entry.edited_at|date:"M d, Y H:i" }} · {{ entry.changes|length }} changed item{{ entry.changes|length|pluralize }}</span>
            </div>
          {% empty %}<div class="small text-muted">No review edits recorded yet.</div>{% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_css %}
<style>
  .registration-review-page .registration-compare-table th:first-child { min-width: 150px; }
  .registration-review-page .old-value { color: #b42318; text-decoration: line-through; }
  .registration-review-page .new-value { color: #067647; font-weight: 700; }
  .registration-review-page .comparison-photo { width: 90px; height: 68px; object-fit: contain; border: 1px solid #d0d5dd; border-radius: 6px; background: #fff; }
  .registration-review-page .person-photo-row { display: flex; align-items: center; gap: .35rem; flex-wrap: wrap; }
  .registration-review-page .person-photo { width: 58px; height: 58px; object-fit: cover; border: 1px solid #d0d5dd; border-radius: 6px; }
  .registration-review-page .person-document { width: 78px; height: 58px; object-fit: contain; border: 1px solid #d0d5dd; border-radius: 6px; background: #fff; }
  .registration-review-page .change-line { margin-bottom: .2rem; white-space: normal; }
  .registration-review-page .registration-doc-strip { display:flex; gap:.6rem; align-items:stretch; }
  .registration-review-page .registration-doc-item { position:relative; width:132px; }
  .registration-review-page .registration-doc-item img,
  .registration-review-page .registration-doc-empty { width:132px; height:92px; object-fit:contain; border:1px solid #d0d5dd; border-radius:8px; background:#f8fafc; }
  .registration-review-page .registration-doc-photo img,
  .registration-review-page .registration-doc-photo .registration-doc-empty { object-fit:cover; }
  .registration-review-page .registration-doc-empty { display:flex; align-items:center; justify-content:center; padding:.5rem; text-align:center; color:#667085; font-size:.72rem; }
  .registration-review-page .registration-doc-label { text-align:center; margin-top:.25rem; font-size:.7rem; font-weight:700; text-transform:uppercase; color:#344054; }
  .registration-review-page .registration-doc-source { position:absolute; top:5px; right:5px; font-size:.6rem; }
  .registration-review-page .result-decision { min-width: 190px; }
  .registration-review-page .submitted-update-input { min-width: 190px; }
  @media (max-width: 991.98px) {
    .registration-review-page .registration-doc-strip { width:100%; }
    .registration-review-page .registration-doc-item,
    .registration-review-page .registration-doc-item img,
    .registration-review-page .registration-doc-empty { width:100%; min-width:0; }
    .registration-review-page .registration-doc-item { flex:1 1 0; }
    .registration-review-page .ld-review-table thead { display:none; }
    .registration-review-page .ld-review-table tbody,
    .registration-review-page .ld-review-table tr,
    .registration-review-page .ld-review-table td,
    .registration-review-page .ld-review-table th { display:block; width:100%; }
    .registration-review-page .ld-review-table tr { border:1px solid #d0d5dd; margin:.5rem; width:calc(100% - 1rem); border-radius:.4rem; overflow:hidden; }
  }
</style>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.registration-review-page .result-decision').forEach(function (select) {
    function toggleUpdateInput() {
      var input = document.getElementById(select.dataset.updateTarget || '');
      if (!input) return;
      var show = select.value === 'update_submitted';
      input.hidden = !show;
      input.disabled = !show;
      input.required = show;
    }
    select.addEventListener('change', toggleUpdateInput);
    toggleUpdateInput();
  });

  var propertySelect = document.getElementById('registrationProperty');
  var unitSelect = document.getElementById('registrationUnit');
  if (propertySelect && unitSelect) {
    propertySelect.addEventListener('change', function () {
      var propertyId = propertySelect.value;
      unitSelect.value = '';
      unitSelect.disabled = !propertyId;
      Array.from(unitSelect.options).forEach(function (option, index) {
        if (index === 0) return;
        option.hidden = option.dataset.property !== propertyId;
        option.disabled = option.hidden;
      });
      unitSelect.options[0].textContent = propertyId ? 'Select unit…' : 'Select property first…';
    });
  }
});
</script>
{% endblock %}
