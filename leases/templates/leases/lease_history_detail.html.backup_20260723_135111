{% extends 'base.html' %}
{% load humanize %}

{% block content %}
<style>
/* =====================================================
   DESIGN A — LEFT-RAIL NAVIGATION
   lease_history_detail.html
   ===================================================== */
#lh-shell {
  display: flex;
  height: calc(100vh - 56px);
  overflow: hidden;
  background: #eef1f7;
  font-size: .82rem;

  position: relative;
  width: 100vw;
  margin-left: calc(-50vw + 50%);
  max-width: 100vw;
  box-sizing: border-box;
}

/* Rail */
.lh-rail {
  width: 48px; flex-shrink: 0; background: #131929;
  display: flex; flex-direction: column; align-items: center;
  padding: 10px 0 8px; gap: 2px;
}
.lh-rail-logo {
  width: 32px; height: 32px; background: #2856c8; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 800; color: #fff; margin-bottom: 10px;
}
.lh-rail-icon {
  width: 34px; height: 34px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  color: #5a6e9a; font-size: 16px; cursor: pointer;
}
.lh-rail-icon:hover, .lh-rail-icon.on { background: #1e2e52; color: #93b4e8; }
.lh-rail-sep { width: 22px; height: 1px; background: #1e2e52; margin: 4px 0; }

/* Sidebar */
.lh-sidebar {
  width: 185px; flex-shrink: 0; background: #fff;
  border-right: 1px solid #e2e6f0; display: flex; flex-direction: column;
}
.lh-sb-header { padding: 12px; border-bottom: 1px solid #eef0f6; }
.lh-sb-title  { font-size: .78rem; font-weight: 700; color: #1a1f35; }
.lh-sb-sub    { font-size: .65rem; color: #8a96b4; }

.lh-history-num {
  background: #f0f5ff; border: 1px solid #dde6f8;
  border-radius: 6px; padding: 5px 9px; margin-top: 8px;
  display: flex; align-items: center; gap: 6px;
}
.lh-history-num-label { font-size: .62rem; font-weight: 700; color: #8a96b4; text-transform: uppercase; letter-spacing: .05em; }
.lh-history-num-val   { font-size: 1.1rem; font-weight: 700; color: #2856c8; }

.lh-badge {
  display: inline-flex; align-items: center; gap: 3px;
  font-size: .65rem; font-weight: 700; padding: 2px 7px; border-radius: 99px;
}
.lh-badge-orig   { background: #dcfce7; color: #166534; }
.lh-badge-renew  { background: #dbeafe; color: #1e40af; }
.lh-badge-active { background: #fef9c3; color: #854d0e; }

.lh-nav-item {
  display: flex; align-items: center; gap: 7px;
  padding: 7px 12px; font-size: .78rem; color: #5a6480;
  border-left: 2px solid transparent; text-decoration: none;
}
.lh-nav-item:hover { background: #f6f8ff; color: #2856c8; text-decoration: none; }
.lh-nav-item.on    { color: #2856c8; background: #f0f5ff; border-color: #2856c8; font-weight: 600; }
.lh-nav-item i     { font-size: 14px; }
.lh-nav-badge { margin-left: auto; font-size: .6rem; font-weight: 700; padding: 1px 5px; border-radius: 99px; background: #e8eeff; color: #2856c8; }

/* Main */
.lh-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

.lh-topbar {
  background: #fff; border-bottom: 1px solid #e2e6f0;
  padding: 6px 14px; display: flex; align-items: center;
  justify-content: space-between; gap: 8px; flex-shrink: 0; flex-wrap: wrap;
}
.lh-breadcrumb { font-size: .72rem; color: #8a96b4; display: flex; align-items: center; gap: 4px; }
.lh-breadcrumb strong { color: #1a1f35; }
.lh-tb-right { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

.lh-content { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 10px 12px; }

/* Alert */
.lh-alert {
  background: #fef9c3; border: 1px solid #fde047;
  border-left: 4px solid #ca8a04; border-radius: 7px;
  padding: 8px 12px; margin-bottom: 8px;
  font-size: .78rem; color: #854d0e;
  display: flex; align-items: center; gap: 7px;
}

/* Cards */
.lh-card {
  background: #fff; border: 1px solid #e2e6f0;
  border-radius: 10px; overflow: hidden; margin-bottom: 8px;
}
.lh-card-head {
  padding: 6px 12px; display: flex; align-items: center; gap: 7px;
  border-bottom: 1px solid #eef0f6; background: #1a1f35;
}
.lh-card-head i      { font-size: 13px; color: #7eb3f5; }
.lh-card-title       { font-size: .72rem; font-weight: 700; color: #c8d4f0; text-transform: uppercase; letter-spacing: .06em; }
.lh-card-sub         { margin-left: auto; font-size: .68rem; color: #7eb3f5; }
.lh-card-body        { padding: 10px 12px; }

/* Two-col layout for period & charges */
.lh-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.lh-two-col > * { min-width: 0; }

/* KV rows */
.lh-kv-table { width: 100%; border-collapse: collapse; }
.lh-kv-table tr { border-bottom: 1px solid #f0f2f6; }
.lh-kv-table tr:last-child { border-bottom: none; }
.lh-kv-table th {
  font-size: .7rem; font-weight: 700; color: #8a96b4;
  text-transform: uppercase; letter-spacing: .04em;
  padding: 5px 8px; text-align: left; width: 38%; white-space: nowrap;
  background: #fafbff;
}
.lh-kv-table td {
  font-size: .8rem; color: #1a1f35; padding: 5px 8px; text-align: right; font-weight: 500;
}
.lh-kv-table td.lh-left { text-align: left; }
.lh-kv-table tr.lh-total th,
.lh-kv-table tr.lh-total td { background: #f0f5ff; font-weight: 700; color: #1e40af; }

/* Police verification status */
.lh-police-badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: .72rem; font-weight: 700; padding: 3px 10px; border-radius: 99px;
}
.lh-police-verified  { background: #dcfce7; color: #166534; }
.lh-police-rejected  { background: #fee2e2; color: #991b1b; }
.lh-police-pending   { background: #fef9c3; color: #854d0e; }
.lh-police-follow_up { background: #fef9c3; color: #854d0e; }
.lh-police-none      { background: #f1f5f9; color: #64748b; }

/* Notes block */
.lh-notes-block {
  background: #f8fafc; border: 1px solid #e2e6f0; border-radius: 6px;
  padding: 8px 10px; font-size: .78rem; color: #4a5568; line-height: 1.5;
  margin-top: 6px;
}
.lh-notes-label { font-size: .65rem; font-weight: 700; color: #8a96b4; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 3px; }

/* Bottom nav (mobile) */
.lh-bottom-nav {
  display: none;
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #131929; border-top: 1px solid #1e2e52;
  z-index: 100; height: 52px;
  justify-content: space-around; align-items: center;
}
.lh-bottom-tab {
  display: flex; flex-direction: column; align-items: center; gap: 1px;
  color: #5a6e9a; font-size: .58rem; padding: 4px 6px; border-radius: 8px;
}
.lh-bottom-tab i { font-size: 18px; }
.lh-bottom-tab.on { color: #7eb3f5; background: #1e2e52; }

/* ===================== RESPONSIVE ===================== */
@media (max-width: 991px) {
  #lh-shell { height: auto; overflow: visible; flex-direction: column; }
  .lh-rail  { width: 100%; flex-direction: row; height: 44px; padding: 0 8px; gap: 4px; overflow-x: auto; }
  .lh-rail-logo { margin-bottom: 0; margin-right: 6px; }
  .lh-rail-sep { display: none; }
  .lh-sidebar { width: 100%; border-right: none; border-bottom: 1px solid #e2e6f0; }
  .lh-two-col { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .lh-rail { display: none; }
  .lh-content { padding: 8px; }
  .lh-two-col { grid-template-columns: 1fr; }
  #lh-shell { padding-bottom: 52px; }
  .lh-bottom-nav { display: flex !important; }
}

/* Match the compact Lease History Edit layout. */
#lh-shell {
  display: block;
  width: min(100%, 1320px);
  max-width: none;
  height: auto;
  min-height: 0;
  margin: 0 auto;
  padding: 14px 12px 24px;
  overflow: visible;
  background: transparent;
  font-size: .86rem;
  box-sizing: border-box;
}
.lh-rail,
.lh-sidebar,
.lh-bottom-nav { display: none !important; }
.lh-main {
  display: block;
  overflow: visible;
  min-width: 0;
}
.lh-topbar {
  background: #fff;
  border: 1px solid #e2e6f0;
  border-radius: 10px;
  padding: 12px 14px;
  box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
}
.lh-title-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.lh-title-icon {
  width: 38px;
  height: 38px;
  border-radius: 9px;
  background: #1a1f35;
  color: #7eb3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 18px;
}
.lh-title {
  margin: 0;
  color: #172033;
  font-size: 1.08rem;
  font-weight: 750;
  line-height: 1.2;
}
.lh-subtitle {
  margin-top: 2px;
  color: #7a869f;
  font-size: .76rem;
}
.lh-content {
  padding: 0;
  overflow: visible;
}
.lh-summary {
  margin-top: 10px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}
.lh-stat {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 8px 10px;
  min-width: 0;
}
.lh-stat-label {
  color: #8a96b4;
  font-size: .64rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
}
.lh-stat-value {
  margin-top: 3px;
  color: #1a1f35;
  font-size: .84rem;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lh-alert {
  margin: 10px 0 0;
  border-radius: 8px;
  padding: 9px 12px;
}
.lh-card {
  margin: 10px 0 0;
  box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
}
.lh-card-head { padding: 8px 12px; }
.lh-card-title { font-weight: 800; }
.lh-card-body { padding: 12px; }
.lh-overview-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 8px 16px;
}
.lh-overview-third { grid-column: span 2; }
.lh-overview-full { grid-column: span 2; }
.lh-overview-half { grid-column: span 2; }
.lh-overview-label {
  font-size: .65rem;
  font-weight: 800;
  color: #8a96b4;
  text-transform: uppercase;
  letter-spacing: .05em;
}
.lh-overview-value {
  margin-top: 2px;
  font-size: .85rem;
  color: #1a1f35;
  font-weight: 600;
}
.lh-inline-display {
  display: block;
  min-height: 24px;
  color: #2856c8;
  cursor: pointer;
  border-radius: 5px;
  padding: 3px 5px;
  margin: -3px -5px;
}
.lh-inline-display:hover,
.lh-inline-display:focus {
  background: #eef4ff;
  color: #1747b5;
  outline: none;
}
.lh-inline-editor { display: none; }
.lh-inline-cell.is-editing .lh-inline-display { display: none; }
.lh-inline-cell.is-editing .lh-inline-editor { display: block; }
.lh-inline-editor .form-control,
.lh-inline-editor .form-select {
  width: 100%;
  min-height: 29px;
  padding: .2rem .4rem;
  font-size: .78rem;
}
.lh-inline-editor .form-check-input {
  width: 1rem;
  height: 1rem;
  margin: .2rem 0;
}
.lh-inline-status {
  margin-left: auto;
  font-size: .68rem;
  font-weight: 600;
  text-transform: none;
  letter-spacing: 0;
}
@media (max-width: 991px) {
  #lh-shell { padding: 12px 10px 22px; }
  .lh-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lh-two-col { grid-template-columns: 1fr; }
}
@media (max-width: 576px) {
  #lh-shell { padding: 10px 8px 18px; }
  .lh-topbar { align-items: flex-start; }
  .lh-tb-right { width: 100%; }
  .lh-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lh-stat-wide-mobile { grid-column: 1 / -1; }
  .lh-overview-tenant { grid-column: 1 / -1; }
  .lh-overview-location { grid-column: span 3; }
  .lh-tb-right .btn i { display: none; }
  .lh-tb-right .btn { flex: 1; }
  .lh-kv-table tr.lh-witness-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }
  .lh-kv-table tr.lh-witness-row th,
  .lh-kv-table tr.lh-witness-row td {
    display: block;
    width: 100%;
    min-width: 0;
    text-align: left;
  }
  .lh-kv-table tr.lh-witness-row th {
    padding-bottom: 2px;
  }
  .lh-kv-table tr.lh-witness-row td {
    padding-top: 4px;
    padding-bottom: 7px;
  }
}
</style>

<div id="lh-shell">

  {# Rail #}
  <div class="lh-rail">
    <div class="lh-rail-logo">TMS</div>
    <div class="lh-rail-icon"><i class="ti ti-file-text"></i></div>
    <div class="lh-rail-icon on"><i class="ti ti-history"></i></div>
    <div class="lh-rail-sep"></div>
    <div class="lh-rail-icon"><i class="ti ti-photo"></i></div>
    <div class="lh-rail-icon"><i class="ti ti-shield-check"></i></div>
  </div>

  {# Sidebar #}
  <div class="lh-sidebar">
    <div class="lh-sb-header">
      <div class="lh-sb-title">{{ lease.tenant.get_full_name }}</div>
      <div class="lh-sb-sub">{{ lease.unit.property.property_name }} · {{ lease.unit.unit_number }}</div>
      <div class="lh-history-num">
        <div>
          <div class="lh-history-num-label">History</div>
          <div class="lh-history-num-val">#{{ history.renewal_number }}</div>
        </div>
        <div style="margin-left:auto;">
          {% if history.is_original %}
            <span class="lh-badge lh-badge-orig">Original</span>
          {% else %}
            <span class="lh-badge lh-badge-renew">Renewal</span>
          {% endif %}
          {% if is_active_history %}
            <span class="lh-badge lh-badge-active">Active</span>
          {% endif %}
        </div>
      </div>
    </div>

    <a href="{% url 'leases:edit_clauses' lease.pk %}?history={{ history.pk }}" class="lh-nav-item">
      <i class="ti ti-file-invoice"></i>Agreement
    </a>
    <a href="{% url 'leases:lease_history_edit' lease.pk history.pk %}" class="lh-nav-item">
      <i class="ti ti-edit"></i>Edit History
    </a>
    <a href="{% url 'leases:lease_renewals' lease.pk %}" class="lh-nav-item on">
      <i class="ti ti-history"></i>All History
    </a>
    <a href="{% url 'leases:photos_page' lease.pk %}" class="lh-nav-item">
      <i class="ti ti-photo"></i>Condition Photos
    </a>
    <div style="border-top:1px solid #eef0f6;"></div>
    <a href="{% url 'leases:lease_update' lease.pk %}" class="lh-nav-item">
      <i class="ti ti-arrow-left"></i>Back to Lease
    </a>
  </div>

  {# Main #}
  <div class="lh-main">

    <div class="lh-topbar">
      <div class="lh-title-wrap">
        <div class="lh-title-icon"><i class="ti ti-history"></i></div>
        <div>
          <h2 class="lh-title">Lease History #{{ history.renewal_number }}</h2>
          <div class="lh-subtitle">
            Lease #{{ lease.id }}{% if lease.tenant %} &bull; {{ lease.tenant.get_full_name }}{% endif %}
          </div>
        </div>
      </div>
      <div class="lh-tb-right">
        {% if history.is_original %}
          <span class="lh-badge lh-badge-orig">Original Lease</span>
        {% else %}
          <span class="lh-badge lh-badge-renew">Renewal</span>
        {% endif %}
        {% if is_active_history %}
          <span class="lh-badge lh-badge-active"><i class="ti ti-circle-check"></i> Active History</span>
        {% endif %}
        <a href="{% url 'leases:edit_clauses' lease.pk %}?history={{ history.pk }}" class="btn btn-sm btn-success lh-agreement-action">
          <i class="ti ti-file-invoice"></i> Agreement
        </a>
        <a href="{% url 'leases:lease_history_edit' lease.pk history.pk %}" class="btn btn-sm btn-primary">
          <i class="ti ti-edit"></i> Edit
        </a>
        <a href="{% url 'leases:photos_page' lease.pk %}" class="btn btn-sm btn-dark">
          <i class="ti ti-photo"></i> Photos
        </a>
        <a href="{% url 'leases:lease_renewals' lease.pk %}" class="btn btn-sm btn-secondary">
          <i class="ti ti-arrow-left"></i> Back
        </a>
      </div>
    </div>

    <div class="lh-summary">
      <div class="lh-stat lh-stat-wide-mobile">
        <div class="lh-stat-label">Property / Unit</div>
        <div class="lh-stat-value">{{ lease.unit.property.property_name }} - {{ lease.unit.unit_number }}</div>
      </div>
      <div class="lh-stat lh-stat-wide-mobile">
        <div class="lh-stat-label">History Period</div>
        <div class="lh-stat-value">{{ history.start_date|date:"M d, Y" }} to {{ history.end_date|date:"M d, Y" }}</div>
      </div>
      <div class="lh-stat">
        <div class="lh-stat-label">Total Monthly Charges</div>
        <div class="lh-stat-value" id="historyDetailTotalChip">{{ history.total_monthly_amount|default:0|money:0 }}</div>
      </div>
      <div class="lh-stat">
        <div class="lh-stat-label">Agreement Date</div>
        <div class="lh-stat-value">{{ history.agreement_date|date:"M d, Y"|default:"-" }}</div>
      </div>
    </div>

    <div class="lh-content">

      {# Lease / Tenant / Unit summary #}
      <div class="lh-card">
        <div class="lh-card-head">
          <i class="ti ti-home"></i>
          <span class="lh-card-title">Lease, Tenant &amp; Unit</span>
        </div>
        <div class="lh-card-body">
          <div class="lh-overview-grid">
            <div class="lh-overview-third">
              <div style="font-size:.65rem;font-weight:700;color:#9aa4c0;text-transform:uppercase;letter-spacing:.05em;">Lease</div>
              <div style="font-size:.85rem;color:#1a1f35;font-weight:600;">#{{ lease.id }}</div>
            </div>
            <div class="lh-overview-third">
              <div style="font-size:.65rem;font-weight:700;color:#9aa4c0;text-transform:uppercase;letter-spacing:.05em;">Status</div>
              <div>{% if history.is_original %}<span class="lh-badge lh-badge-orig">Original Lease</span>{% else %}<span class="lh-badge lh-badge-renew">Renewal</span>{% endif %}</div>
            </div>
            <div class="lh-overview-third">
              <div style="font-size:.65rem;font-weight:700;color:#9aa4c0;text-transform:uppercase;letter-spacing:.05em;">History #</div>
              <div style="font-size:.85rem;color:#2856c8;font-weight:700;">#{{ history.renewal_number }}</div>
            </div>
            <div class="lh-overview-third lh-overview-tenant">
              <div style="font-size:.65rem;font-weight:700;color:#9aa4c0;text-transform:uppercase;letter-spacing:.05em;">Tenant</div>
              <div style="font-size:.85rem;color:#1a1f35;font-weight:500;">{{ lease.tenant.get_full_name }}</div>
            </div>
            <div class="lh-overview-third lh-overview-location">
              <div style="font-size:.65rem;font-weight:700;color:#9aa4c0;text-transform:uppercase;letter-spacing:.05em;">Building</div>
              <div style="font-size:.85rem;color:#1a1f35;">{{ lease.unit.property.property_name }}</div>
            </div>
            <div class="lh-overview-third lh-overview-location">
              <div style="font-size:.65rem;font-weight:700;color:#9aa4c0;text-transform:uppercase;letter-spacing:.05em;">Unit</div>
              <div style="font-size:.85rem;color:#1a1f35;">{{ lease.unit.unit_number }}</div>
            </div>
          </div>
        </div>
      </div>

      {# Period & Charges #}
      <form id="historyInlineForm" method="post" action="{% url 'leases:lease_history_edit' lease.pk history.pk %}" novalidate>
        {% csrf_token %}
        <input type="hidden" name="confirm_active_financial" value="1">
      <div class="lh-card">
        <div class="lh-card-head">
          <i class="ti ti-calendar"></i>
          <span class="lh-card-title">Period &amp; Charges</span>
          <span class="lh-inline-status" id="historyInlineStatus"></span>
        </div>
        <div class="lh-card-body">
          <div class="lh-two-col">
            {# Left: financials #}
            <table class="lh-kv-table">
              <tr>
                <th>Start Date</th>
                <td class="lh-inline-cell" data-inline-field="start_date" data-display-type="date"><span class="lh-inline-display" tabindex="0">{{ history.start_date|date:"M d, Y" }}</span><div class="lh-inline-editor">{{ inline_form.start_date }}</div></td>
              </tr>
              <tr>
                <th>End Date</th>
                <td class="lh-inline-cell" data-inline-field="end_date" data-display-type="date"><span class="lh-inline-display" tabindex="0">{{ history.end_date|date:"M d, Y" }}</span><div class="lh-inline-editor">{{ inline_form.end_date }}</div></td>
              </tr>
              <tr>
                <th>Agreement Date</th>
