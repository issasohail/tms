{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}Tenant Management System{% endblock %}</title>

  <!-- Favicons -->
  <link rel="icon" href="{% static 'images/favicon.ico' %}">
  <link rel="icon" type="image/png" sizes="32x32" href="{% static 'images/favicon-32x32.png' %}">
  <link rel="icon" type="image/png" sizes="16x16" href="{% static 'images/favicon-16x16.png' %}">
  <link rel="apple-touch-icon" href="{% static 'images/apple-touch-icon.png' %}">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Flatpickr -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

  <!-- Select2 + Bootstrap 5 theme -->
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

  <!-- Font Awesome 5 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  <!-- App CSS -->
  <link rel="stylesheet" href="{% static 'leases/css/base.css' %}">
  <link rel="stylesheet" href="{% static 'leases/css/style.css' %}">
  <link rel="stylesheet" href="{% static 'css/tenant_table.css' %}">
  <link rel="stylesheet" href="{% static 'css/styles.css' %}">

  <script>
    window.TMS_CURRENCY_CODE   = "{{ GLOBAL_SETTINGS.currency_code|default:'PKR'|escapejs }}";
    window.TMS_CURRENCY_SYMBOL = "{{ CURRENCY_SYMBOL|default:'Rs.'|escapejs }}";
    window.TMS_COUNTRY_CODE    = "{{ GLOBAL_SETTINGS.country_code|default:'+92'|escapejs }}";
    window.tmsFormatMoney = function (value, options) {
      const opts    = options || {};
      const decimals = opts.decimals ?? 2;
      const symbol  = opts.symbol || window.TMS_CURRENCY_SYMBOL || "";
      const number  = Number(value || 0);
      return symbol + " " + number.toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    };
  </script>

  <style>
    /* ============================================================
       BASE — Global responsive + action-button system
       ============================================================ */

    /* Remove top margin on container directly after navbar */
    nav.navbar + .container,
    nav.navbar + main.container { margin-top: 0 !important; }

    /* Very small screens */
    @media (max-width: 360px) {
      nav.navbar { padding-top: .2rem !important; padding-bottom: .2rem !important; }
      body, .btn, .form-select, .form-control, table { font-size: .72rem; }
    }

    /* ---- Action-button variables ---- */
    :root {
      --action-btn-px:   .35rem;
      --action-btn-py:   .28rem;
      --action-btn-minw: 2rem;
      --action-btn-gap:  .2rem;
      --action-group-mt: 0;
      --action-group-mr: 0;
      --action-group-mb: 0;
      --action-group-ml: 0;
    }
    .actions-wrap {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--action-btn-gap);
      width: 100%;
      margin: var(--action-group-mt) var(--action-group-mr) var(--action-group-mb) var(--action-group-ml);
    }
    .actions-wrap .action-btn {
      flex: 1 1 0;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-width: var(--action-btn-minw);
      padding: var(--action-btn-py) var(--action-btn-px) !important;
      line-height: 1.1;
      text-align: center;
      white-space: nowrap;
    }
    .table .actions-wrap { min-width: 110px; }

    /* ---- Navbar mobile drawer ---- */
    /*
      The navbar uses Bootstrap's built-in collapse toggler.
      On mobile the hamburger shows; on md+ all links are visible.
      No extra JS needed beyond Bootstrap.
    */
    .navbar-dark .navbar-nav .nav-link { font-size: 12px; padding: .35rem .6rem; }
    .navbar-dark .navbar-nav .nav-link:hover { color: #fff; }

    /* ---- Global card defaults ---- */
    .card { border: 0.5px solid #e5e7eb; border-radius: 8px; }
    .card .card-header { border-radius: 8px 8px 0 0 !important; }

    /* ---- Responsive table wrapper ---- */
    .table-responsive { -webkit-overflow-scrolling: touch; }

    /* ---- Alerts ---- */
    .alert { font-size: 13px; }

    /* ============================================================
       VIEWPORT DEBUGGER BAR  (toggle in settings)
       ============================================================ */
    .viewport-bar {
      position: fixed;
      left: .75rem; right: .75rem; bottom: .55rem;
      z-index: 1080;
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: .75rem;
      padding: .45rem .75rem;
      border: 1px solid rgba(33,37,41,.18);
      border-radius: .5rem;
      background: rgba(255,255,255,.96);
      box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.18);
      font-size: .78rem;
      color: #212529;
    }
    body.show-viewport-bar .viewport-bar { display: flex; }
    .viewport-bar__track {
      position: relative;
      flex: 1 1 auto;
      height: .5rem;
      min-width: 6rem;
      border-radius: 999px;
      background: linear-gradient(90deg,#198754 0 20%,#0d6efd 20% 55%,#ffc107 55% 80%,#dc3545 80% 100%);
      overflow: hidden;
    }
    .viewport-bar__marker {
      position: absolute;
      top: 50%; left: 0;
      width: .75rem; height: .75rem;
      border-radius: 50%;
      background: #212529;
      border: 2px solid #fff;
      transform: translate(-50%,-50%);
      box-shadow: 0 0 0 1px rgba(0,0,0,.25);
    }
    @media (max-width: 420px) {
      .viewport-bar { left: .4rem; right: .4rem; bottom: .4rem; padding: .38rem .5rem; font-size: .7rem; }
      .viewport-bar__track { min-width: 4.5rem; }
    }
  </style>

  {% block extra_css %}{% endblock %}
</head>
<body>

  <!-- ============================================================
       NAVBAR  — Bootstrap 5 responsive collapse
       ============================================================ -->
  <nav class="navbar navbar-expand-md navbar-dark bg-dark px-3 py-2">
    <a class="navbar-brand fw-semibold" href="/">TMS</a>

    <!-- Hamburger toggler for mobile -->
    <button class="navbar-toggler border-0 ms-auto" type="button"
            data-bs-toggle="collapse" data-bs-target="#tmsNav"
            aria-controls="tmsNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="tmsNav">
      {% include 'partials/navbar.html' %}

      <!-- Viewport debugger toggle (right side) -->
      <div class="ms-md-auto d-flex align-items-center gap-2 mt-2 mt-md-0">
        <div class="form-check form-switch mb-0">
          <input class="form-check-input js-viewport-toggle" type="checkbox" id="viewportToggle" role="switch">
          <label class="form-check-label text-secondary" for="viewportToggle" style="font-size: 11px;">Viewport</label>
        </div>
        <a href="{% url 'leases:lease_list' %}" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size: 11px;">
          + Payment
        </a>
        <a href="{% url 'leases:lease_list' %}" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 11px;">
          + Lease
        </a>
        <a href="{% url 'leases:lease_list' %}" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;">
          + Invoice
        </a>
        <a href="#" class="btn btn-sm btn-warning py-0 px-2" style="font-size: 11px;">
          💡 Suggestions
        </a>
        <a href="{% url 'logout' %}" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size: 11px;">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Django messages -->
  {% if messages %}
    {% for message in messages %}
      <div class="alert alert-{{ message.tags }} alert-dismissible fade show mb-0" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {% endfor %}
  {% endif %}

  <!-- Main container — no top padding; pages manage their own -->
  <div class="container-fluid px-0">
    {% block content %}{% endblock %}
  </div>

  <!-- Viewport debug bar -->
  <div class="viewport-bar no-print" aria-live="polite">
    <strong>Viewport</strong>
    <div class="viewport-bar__track" aria-hidden="true">
      <span class="viewport-bar__marker" id="viewportMarker"></span>
    </div>
    <span id="viewportSize">0 × 0</span>
  </div>

  <footer class="mt-5 py-3 bg-light border-top">
    <div class="container text-center">
      <p class="mb-0 text-muted small">Tenant Management System &copy; {% now "Y" %}</p>
    </div>
  </footer>

  <!-- ============================================================
       SCRIPTS
       ============================================================ -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="https://unpkg.com/htmx.org@1.9.12"></script>

  {% block extra_js %}{% endblock %}

  <script>
    /* Auto-dismiss alerts after 5s + init Select2 */
    document.addEventListener('DOMContentLoaded', function () {
      setTimeout(function () {
        document.querySelectorAll('.alert').forEach(function (el) {
          if (window.bootstrap?.Alert) new bootstrap.Alert(el).close();
        });
      }, 5000);

      if (window.$?.fn?.select2) {
        $('#tenant-select').select2({ theme: 'bootstrap-5', placeholder: "Search Tenant", allowClear: true });
        $('#unit-select').select2({ theme: 'bootstrap-5', placeholder: "Search Unit",   allowClear: true });
      }
    });
  </script>

  <!-- Viewport debugger -->
  <script>
    (function () {
      const KEY     = 'tmsViewportBar';
      const toggles = Array.from(document.querySelectorAll('.js-viewport-toggle'));
      const sizeEl  = document.getElementById('viewportSize');
      const marker  = document.getElementById('viewportMarker');

      function enabled()          { return localStorage.getItem(KEY) === '1'; }
      function setEnabled(value) {
        localStorage.setItem(KEY, value ? '1' : '0');
        document.body.classList.toggle('show-viewport-bar', value);
        toggles.forEach(t => { t.checked = value; });
        update();
      }
      function update() {
        if (!sizeEl || !marker) return;
        const w = window.innerWidth  || document.documentElement.clientWidth  || 0;
        const h = window.innerHeight || document.documentElement.clientHeight || 0;
        sizeEl.textContent = w + ' × ' + h;
        marker.style.left  = Math.max(0, Math.min(100, (w / 1440) * 100)) + '%';
      }

      document.addEventListener('DOMContentLoaded', function () {
        toggles.forEach(t => t.addEventListener('change', function () { setEnabled(this.checked); }));
        setEnabled(enabled());
      });
      window.addEventListener('resize', update);
      window.addEventListener('orientationchange', update);
    })();
  </script>

  <!-- Receipt viewer modal (reusable) -->
  <div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12 col-md-9">
              <img id="receiptMain" src="" alt="Receipt" class="img-fluid w-100 rounded border" style="max-height:75vh;object-fit:contain;">
            </div>
            <div class="col-12 col-md-3">
              <div id="receiptThumbs" class="d-flex flex-wrap gap-2"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer justify-content-between">
          <small class="text-muted">Click a thumbnail to switch</small>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      function openGallery(urls) {
        const main   = document.getElementById('receiptMain');
        const thumbs = document.getElementById('receiptThumbs');
        if (!urls || !urls.length || !main || !thumbs) return;
        main.src = urls[0];
        thumbs.innerHTML = '';
        urls.forEach(u => {
          const img = document.createElement('img');
          img.src = u;
          img.className = 'img-thumbnail';
          img.style.cssText = 'width:80px;height:80px;object-fit:cover;cursor:pointer;';
          img.addEventListener('click', () => main.src = u);
          thumbs.appendChild(img);
        });
        if (window.bootstrap?.Modal)
          new bootstrap.Modal(document.getElementById('receiptModal')).show();
        else
          window.open(urls[0], '_blank');
      }

      document.addEventListener('click', function (e) {
        const a = e.target.closest('.view-receipt');
        if (!a) return;
        e.preventDefault();
        openGallery((a.dataset.urls || '').split('|').filter(Boolean));
      }, false);
    })();
  </script>

  <!-- HTMX CSRF -->
  <script>
    document.body.addEventListener('htmx:configRequest', (e) => {
      const m = document.cookie.match(/(^|; )csrftoken=([^;]*)/);
      if (m) e.detail.headers['X-CSRFToken'] = m[2];
    });
  </script>

</body>
</html>
