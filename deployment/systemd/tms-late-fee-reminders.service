[Unit]
Description=TMS due late-fee reminders
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ivs
WorkingDirectory=/home/ivs/apps/tms
EnvironmentFile=-/home/ivs/apps/tms/.env
ExecStart=/home/ivs/apps/tms/.venv/bin/python /home/ivs/apps/tms/manage.py send_late_fee_reminders
StandardOutput=journal
StandardError=journal

# Before installation, compare User/EnvironmentFile with:
# systemctl cat tms-kirayas.service tms-billing-worker.service
