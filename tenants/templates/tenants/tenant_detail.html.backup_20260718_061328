{% extends 'base.html' %}
{% load static humanize money_tags tenant_filters %}

{% block title %}{{ tenant }}{% endblock %}

{% block content %}
<div class="tenant-detail-compact" id="tenantDetailTop">
  <div class="td-top-tools mb-2">
    <label for="tenantJumpSelect" class="visually-hidden">Search tenant</label>
    <select id="tenantJumpSelect" class="form-select form-select-sm td-tenant-jump" data-placeholder="Search tenant">
      <option value=""></option>
    </select>
  </div>

  {# ========================= HERO / TOP SUMMARY ========================= #}
  <div class="td-hero card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
      <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="td-mobile-id-strip">
          <div class="td-doc-replace-zone" data-tenant-document-zone data-field="photo">
            {% if tenant.photo %}
              <a href="{{ tenant.photo.url }}" data-fancybox="tenant-documents" data-caption="Tenant Photo" class="td-avatar-wrap text-decoration-none">
                <img src="{{ tenant.photo.url }}" alt="Tenant Photo" class="td-avatar" data-document-preview="photo">
              </a>
            {% else %}
              <div class="td-avatar td-avatar-empty" data-document-preview="photo"><i class="fas fa-user"></i></div>
            {% endif %}
            {% if can_inline_update_tenant %}
              <button class="td-doc-replace-btn" type="button" data-document-replace="photo">Replace</button>
              <input class="td-doc-replace-input" type="file" accept="image/*" data-document-input="photo">
            {% endif %}
          </div>
          <div class="td-mobile-docs">
            <div class="td-mobile-doc-item td-doc-replace-zone" data-tenant-document-zone data-field="cnic_front">
              {% if tenant.cnic_front %}
                <a href="{{ tenant.cnic_front.url }}" data-fancybox="tenant-mobile-documents" data-caption="CNIC Front">
                  <img src="{{ tenant.cnic_front.url }}" alt="CNIC Front" data-document-preview="cnic_front">
                </a>
              {% else %}
                <div class="td-mobile-doc-empty" data-document-preview="cnic_front">No Front</div>
              {% endif %}
              {% if can_inline_update_tenant %}
                <button class="td-doc-replace-btn" type="button" data-document-replace="cnic_front">Replace</button>
                <input class="td-doc-replace-input" type="file" accept="image/*" data-document-input="cnic_front">
              {% endif %}
            </div>
            <div class="td-mobile-doc-item td-doc-replace-zone" data-tenant-document-zone data-field="cnic_back">
              {% if tenant.cnic_back %}
                <a href="{{ tenant.cnic_back.url }}" data-fancybox="tenant-mobile-documents" data-caption="CNIC Back">
                  <img src="{{ tenant.cnic_back.url }}" alt="CNIC Back" data-document-preview="cnic_back">
                </a>
              {% else %}
                <div class="td-mobile-doc-empty" data-document-preview="cnic_back">No Back</div>
              {% endif %}
              {% if can_inline_update_tenant %}
                <button class="td-doc-replace-btn" type="button" data-document-replace="cnic_back">Replace</button>
                <input class="td-doc-replace-input" type="file" accept="image/*" data-document-input="cnic_back">
              {% endif %}
            </div>
          </div>
        </div>

        <div class="td-hero-main flex-grow-1 min-w-0">
          <h2 class="td-title mb-2">{{ tenant.first_name|add:" "|add:tenant.last_name }}</h2>

          <div class="td-hero-meta">
            <span class="td-property-unit-line"><i class="fas fa-home text-muted me-1"></i>
              {% if tenant.lease and tenant.lease.unit %}
                <a href="{% url 'leases:lease_detail' tenant.lease.pk %}" class="text-decoration-none">
                  <strong>Property:</strong> {{ tenant.lease.unit.property.property_name|default:"-" }}
                  <strong class="ms-2">Unit:</strong> {{ tenant.lease.unit.unit_number|default:"-" }}
                </a>
              {% else %}
                <strong>Property / Unit:</strong> -
              {% endif %}
            </span>
            <span><i class="far fa-calendar-alt text-muted me-1"></i> <strong>Lease:</strong>
              {% if tenant.lease %}
                <a href="{% url 'leases:lease_detail' tenant.lease.pk %}" class="text-decoration-none">
                  {% if tenant.lease.start_date %}{{ tenant.lease.start_date|date:"M d, Y" }}{% else %}-{% endif %}
                  -
                  {% if tenant.lease.end_date %}{{ tenant.lease.end_date|date:"M d, Y" }}{% else %}-{% endif %}
                </a>
              {% else %}-{% endif %}
            </span>
          </div>

          <div class="td-balance-line mt-2">
            <a href="#tenantLeases" class="td-balance text-decoration-none {% if tenant.current_balance > 0 %}text-danger{% else %}text-success{% endif %}">
              Balance: {{ tenant.current_balance|default:0|money:2 }}
            </a>
            <span class="badge td-badge bg-{% if tenant.is_active %}success{% else %}secondary{% endif %}">
              {% if tenant.is_active %}Active{% else %}Inactive{% endif %}
            </span>
          </div>

          <div class="td-lead-interest mt-2">
            <span class="td-label me-2">Lead Interest:</span>
            <span class="td-interest-wrap">
              {% for item in tenant.interested_in.all %}
                <span class="td-interest-pill">{{ item.name }}</span>
              {% empty %}
                <span class="text-muted small">-</span>
              {% endfor %}
            </span>
          </div>
        </div>

        <div class="td-hero-actions d-flex flex-wrap gap-2 justify-content-end">
          <a href="/payments/create/?tenant={{ tenant.id }}{% if tenant.lease %}&lease={{ tenant.lease.id }}{% endif %}" class="btn btn-sm btn-success">
            <i class="fas fa-money-bill-wave me-1"></i> <span class="td-label-desktop">Record Payment</span><span class="td-label-mobile">Payment</span>
          </a>
          {% include "whatsapp/_dropdown.html" with phone=tenant.phone object_type="tenant" object_id=tenant.pk %}
          {% if tenant.pk %}
            <a href="{% url 'tenants:tenant_update' tenant.pk %}" class="btn btn-sm btn-outline-primary">
              <i class="fas fa-pen me-1"></i> <span class="td-label-desktop">Edit Tenant</span><span class="td-label-mobile">Edit</span>
            </a>
          {% endif %}
          <button class="btn btn-sm btn-outline-secondary" onclick="history.back()">
            <i class="fas fa-arrow-left me-1"></i> <span class="td-label-desktop">Go Back</span><span class="td-label-mobile">Back</span>
          </button>
          {% if registration_link %}
            <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#registrationLinkBox">
              <i class="fas fa-link me-1"></i> Registration Link
            </button>
          {% endif %}
          {% if family_target_lease_count == 1 %}
            {% for lease_option in family_target_leases %}
              <a class="btn btn-sm btn-outline-success" href="{% url 'leases:lease_detail' lease_option.pk %}?open_family_add=1#ld-tab-family">
                <i class="fas fa-users me-1"></i> <span class="td-label-desktop">Add Family to Lease</span><span class="td-label-mobile">Add Family</span>
              </a>
            {% endfor %}
          {% elif family_target_lease_count > 1 %}
            <button class="btn btn-sm btn-outline-success" type="button" data-bs-toggle="modal" data-bs-target="#addFamilyLeaseSelectModal">
              <i class="fas fa-users me-1"></i> <span class="td-label-desktop">Add Family to Lease</span><span class="td-label-mobile">Add Family</span>
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if registration_link %}
    <div class="collapse mb-3 {% if request.GET.show_registration %}show{% endif %}" id="registrationLinkBox">
      <div class="card border-0 shadow-sm">
        <div class="card-body py-2">
          <div class="input-group input-group-sm tenant-reg-link-group">
            <span class="input-group-text fw-semibold">Tenant Update Link</span>
            <input id="tenantRegistrationLink" type="text" class="form-control text-break" value="{{ registration_link }}" readonly onclick="this.select();">
            <button class="btn btn-outline-primary" type="button" data-copy-target="#tenantRegistrationLink">
              <i class="far fa-copy me-1"></i> Copy
            </button>
            <a class="btn btn-outline-success {% if not registration_whatsapp_url %}disabled{% endif %}" target="_blank" rel="noopener" href="{{ registration_whatsapp_url|default:'#' }}">
              <i class="fab fa-whatsapp me-1"></i> WhatsApp
            </a>
            <a href="{{ registration_link }}" target="_blank" rel="noopener" class="btn btn-outline-dark">
              <i class="fas fa-external-link-alt me-1"></i> Open
            </a>
            <a href="{% url 'tenants:registration_submission_list' %}" class="btn btn-outline-secondary">
              <i class="far fa-list-alt me-1"></i> Submissions
            </a>
          </div>
          <div class="form-text">Public link expires after {{ registration_link_days }} days. Submitted changes require admin approval.</div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if family_target_lease_count > 1 %}
    <div class="modal fade" id="addFamilyLeaseSelectModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header py-2">
            <h6 class="modal-title">Select Lease</h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="alert alert-light border small mb-2">
              There is more than one lease. Please select the lease where you want to add the family members.
            </div>
            <div class="list-group">
              {% for lease_option in family_target_leases %}
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                   href="{% url 'leases:lease_detail' lease_option.pk %}?open_family_add=1#ld-tab-family">
                  <span>
                    <strong>{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }}</strong>
                    <span class="d-block small text-muted">{{ lease_option.start_date|date:"M d, Y" }} - {{ lease_option.end_date|date:"M d, Y"|default:"Ongoing" }}</span>
                  </span>
                  <span class="badge bg-light text-dark border">{{ lease_option.get_status_display }}</span>
                </a>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if family_target_leases %}
    <div class="modal fade" id="tenantVehicleAddModal" tabindex="-1" aria-labelledby="tenantVehicleAddModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <form method="post" enctype="multipart/form-data" action="{% url 'tenants:tenant_vehicle_add' tenant.pk %}">
            {% csrf_token %}
            <div class="modal-header py-2">
              <h5 class="modal-title h6" id="tenantVehicleAddModalLabel">Add Vehicle</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-2">
                <div class="col-12">
                  <label class="form-label small mb-1">Lease</label>
                  <select name="lease" class="form-select form-select-sm">
                    {% for lease_option in family_target_leases %}
                      <option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-6">
                  <label class="form-label small mb-1">Vehicle Type</label>
                  <select name="vehicle_type" class="form-select form-select-sm" required>
                    <option value="">Select type</option>
                    {% for vehicle_type in vehicle_types %}
                      <option value="{{ vehicle_type.pk }}">{{ vehicle_type.name }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-6"><label class="form-label small mb-1">Registration #</label><input name="registration_number" class="form-control form-control-sm" required></div>
                <div class="col-6"><label class="form-label small mb-1">Make</label><input name="make" class="form-control form-control-sm"></div>
                <div class="col-6"><label class="form-label small mb-1">Model</label><input name="model" class="form-control form-control-sm"></div>
                <div class="col-6"><label class="form-label small mb-1">Color</label><input name="color" class="form-control form-control-sm"></div>
                <div class="col-6"><label class="form-label small mb-1">Year</label><input name="year" type="number" min="1900" class="form-control form-control-sm"></div>
                <div class="col-6"><label class="form-label small mb-1">Owner</label><input name="owner_name" class="form-control form-control-sm"></div>
                <div class="col-6"><label class="form-label small mb-1">Owner CNIC</label><input name="owner_cnic" class="form-control form-control-sm"></div>
                <div class="col-6"><label class="form-label small mb-1">Parking</label><input name="parking_slot" class="form-control form-control-sm"></div>
                <div class="col-6"><label class="form-label small mb-1">Vehicle Photo</label><input name="vehicle_photo" type="file" accept="image/*" class="form-control form-control-sm"></div>
                <div class="col-12"><label class="form-label small mb-1">Registration Book</label><input name="registration_book_photo" type="file" accept="image/*,.pdf" class="form-control form-control-sm"></div>
              </div>
            </div>
            <div class="modal-footer py-2">
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-success btn-sm">Save Vehicle</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  {% endif %}

  <nav class="td-section-pills mb-3" aria-label="Tenant detail sections">
    <a href="#tenantContactInfo">Contact Info</a>
    <a href="#tenantAddressInfo">Addresses</a>
    <a href="#tenantInvoices">Invoice</a>
    <a href="#tenantPayments">Payment</a>
    <a href="#tenantFamily">Family</a>
    <a href="#tenantVehicles">Vehicle</a>
    <a href="#tenantLeases">Leases</a>
  </nav>

  {# ====================== DOCUMENTS + PERSONAL + ADDRESSES ====================== #}
  <div class="row g-3 align-items-start mb-3">
    <div class="col-12 col-xl-3">
      <div class="card td-card td-side-summary-card shadow-sm">
        <div class="card-header">
          <h6 class="mb-0"><i class="fas fa-layer-group text-secondary me-2"></i>Vehicle &amp; Lease</h6>
        </div>
        <div class="card-body py-2">

          {# --- Vehicles --- #}
          <div class="td-side-subhead">
            <span><i class="fas fa-car me-2"></i>Vehicles <strong class="td-side-count">{{ tenant_vehicles|length }}</strong></span>
            {% if family_target_leases %}
              <button class="btn btn-sm btn-outline-primary py-0" type="button" data-bs-toggle="modal" data-bs-target="#tenantVehicleAddModal">Add</button>
            {% endif %}
          </div>

          {% if tenant_vehicles %}
            <div class="td-side-mini-list mb-3">
              {% for vehicle in tenant_vehicles %}
                <div class="td-side-mini-card">
                  <div class="td-side-mini-photo">
                    {% if vehicle.vehicle_photo %}
                      <a href="{{ vehicle.vehicle_photo.url }}" data-fancybox="tenant-vehicles" data-caption="{{ vehicle }}">
                        <img src="{{ vehicle.vehicle_photo.url }}" alt="{{ vehicle }}">
                      </a>
                    {% else %}
                      <span><i class="fas fa-car"></i></span>
                    {% endif %}
                  </div>
                  <div class="td-side-mini-detail">
                    <div class="td-side-mini-title">
                      {{ vehicle.vehicle_type.name|default:"Vehicle" }} <span>{{ vehicle.registration_number }}</span>
                    </div>
                    <div class="td-side-mini-muted">
                      {{ vehicle.color|default:"-" }}{% if vehicle.make or vehicle.model %}, {{ vehicle.make|default:"-" }}{% if vehicle.model %} / {{ vehicle.model }}{% endif %}{% endif %}
                    </div>
                    <div class="td-side-mini-actions">
                      <a href="{% url 'leases:lease_vehicle_edit' vehicle.lease.pk vehicle.pk %}" class="btn btn-sm btn-outline-primary">Edit</a>
                      <form method="post" action="{% url 'leases:lease_vehicle_delete' vehicle.lease.pk vehicle.pk %}" onsubmit="return confirm('Remove this vehicle from active list? History will be preserved.');">
                        {% csrf_token %}
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                      </form>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="mb-0 small text-muted">No vehicles recorded.</p>
          {% endif %}

          <hr class="td-side-divider">

          {# --- Leases --- #}
          <div class="td-side-subhead">
            <span><i class="far fa-building me-2"></i>Leases <strong class="td-side-count">{{ leases|length }}</strong></span>
            <a class="btn btn-sm btn-outline-primary py-0" href="{% url 'leases:lease_create' %}?tenant={{ tenant.id }}">Add</a>
          </div>

          {% if leases %}
            <div class="td-side-mini-list">
              {% for lease in leases %}
                <div class="td-side-mini-lease">
                  <div class="td-side-mini-lease-top">
                    <a href="{% url 'leases:lease_detail' lease.pk %}" class="text-decoration-none">
                      {{ lease.unit.property.property_name|default:"-" }} / {{ lease.unit.unit_number|default:"-" }}
                    </a>
                    <span class="badge bg-{% if lease.is_active %}success{% else %}secondary{% endif %}">
                      {% if lease.is_active %}Active{% else %}Inactive{% endif %}
                    </span>
                  </div>
                  <div class="td-side-mini-muted">
                    {{ lease.start_date|date:"M d, Y" }} - {{ lease.end_date|date:"M d, Y"|default:"Ongoing" }}
                  </div>
                  <div class="td-side-mini-money">
                    <span>Monthly: {{ lease.get_total_payment|money:2 }}</span>
                    <span>Total: {{ lease.tenant_detail_total_balance|default:0|money:2 }}</span>
                  </div>
                  <div class="td-side-mini-actions">
                    <a href="{% url 'leases:lease_detail' lease.pk %}" class="btn btn-sm btn-primary">Detail</a>
                    <a href="{% url 'leases:lease_ledger_by_pk' lease.pk %}" class="btn btn-sm btn-dark">Ledger</a>
                    <a href="{% url 'payments:payment_create' %}?tenant={{ tenant.id }}&lease={{ lease.id }}" class="btn btn-sm btn-outline-primary">Add</a>
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="td-side-total-balance">
              <span>Total Lease Balance</span>
              <strong>{{ leases_total_balance|default:0|money:2 }}</strong>
            </div>
          {% else %}
            <p class="mb-0 small text-muted">No leases found.</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-9">
      <div class="card td-card shadow-sm mb-3" id="tenantContactInfo">
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
          <h6 class="mb-0"><i class="far fa-user text-secondary me-2"></i>Personal Information</h6>
          <a href="#tenantDetailTop" class="td-scroll-top">Top</a>
        </div>
        <div class="card-body p-0">
          <div class="td-info-grid td-info-grid-6">

            {# Row 1 #}
            <div>
              <span>CNIC</span>
              <strong>{{ tenant.cnic|format_cnic|default:"-" }}</strong>
            </div>
            <div>
              <span>DOB / Gender</span>
              <strong>
                {% if tenant.date_of_birth %}{{ tenant.date_of_birth|date:"M d, Y" }}{% else %}-{% endif %}
                {% if tenant.get_gender_display %}, {{ tenant.get_gender_display }}{% endif %}
              </strong>
            </div>
            <div>
              <span>Occupation</span>
              <strong>{{ tenant.occupation|default:"-" }}</strong>
            </div>
            <div>
              <span>Nationality</span>
              <strong>{{ tenant.nationality|default:"-" }}</strong>
            </div>
            <div>
              <span>Family Members</span>
              <strong>{{ tenant.number_of_family_member|default:"-" }}</strong>
            </div>
            <div>
              <span>City / Province</span>
              <strong>
                {{ tenant.city|default:"-" }}{% if tenant.province %}, {{ tenant.province }}{% endif %}
              </strong>
            </div>

            {# Row 2 #}
            <div>
              <span>Email</span>
              <strong>{{ tenant.email|default:"-" }}</strong>
            </div>
            <div>
              <span>Phone (All)</span>
              <strong class="td-phone-stack">
                {% include "tenants/_whatsapp_phone_link.html" with phone=tenant.phone label=tenant.phone name=tenant.get_full_name only %}
                {% if tenant.phone2 %}<br>{% include "tenants/_whatsapp_phone_link.html" with phone=tenant.phone2 label=tenant.phone2 name=tenant.get_full_name only %}{% endif %}
                {% if tenant.phone3 %}<br>{% include "tenants/_whatsapp_phone_link.html" with phone=tenant.phone3 label=tenant.phone3 name=tenant.get_full_name only %}{% endif %}
              </strong>
            </div>
            <div>
              <span>Employer</span>
              <strong>
                {{ tenant.employer_name|default:"-" }}
                {% if tenant.employer_phone %}
                  <br>{% include "tenants/_whatsapp_phone_link.html" with phone=tenant.employer_phone label=tenant.employer_phone name=tenant.employer_name only %}
                {% endif %}
              </strong>
            </div>
            <div>
              <span>Emergency Contact</span>
              <strong>
                {{ tenant.emergency_contact_name|default:"-" }}
                {% if tenant.emergency_contact_relation %} ({{ tenant.emergency_contact_relation }}){% endif %}
                {% if tenant.emergency_contact_phone %}
                  <br>{% include "tenants/_whatsapp_phone_link.html" with phone=tenant.emergency_contact_phone label=tenant.emergency_contact_phone name=tenant.emergency_contact_name only %}
                {% endif %}
              </strong>
            </div>
            <div>
              <span>Reference 1</span>
              <strong>
                {{ tenant.reference_name_1|default:"-" }}
                {% if tenant.reference_relation_1 %} ({{ tenant.reference_relation_1 }}){% endif %}
                {% if tenant.reference_phone_1 %}
                  <br>{% include "tenants/_whatsapp_phone_link.html" with phone=tenant.reference_phone_1 label=tenant.reference_phone_1 name=tenant.reference_name_1 only %}
                {% endif %}
              </strong>
            </div>
            <div>
              <span>Reference 2</span>
              <strong>
                {{ tenant.reference_name_2|default:"-" }}
                {% if tenant.reference_relation_2 %} ({{ tenant.reference_relation_2 }}){% endif %}
                {% if tenant.reference_phone_2 %}
                  <br>{% include "tenants/_whatsapp_phone_link.html" with phone=tenant.reference_phone_2 label=tenant.reference_phone_2 name=tenant.reference_name_2 only %}
                {% endif %}
              </strong>
            </div>
          </div>
        </div>
      </div>

      <div class="card td-card shadow-sm" id="tenantAddressInfo">
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
          <h6 class="mb-0"><i class="fas fa-map-marker-alt text-secondary me-2"></i>Addresses & Notes</h6>
          <a href="#tenantDetailTop" class="td-scroll-top">Top</a>
        </div>
        <div class="card-body p-0">
          <div class="td-address-grid">
            <div>
              <span>Temporary Address</span>
              <strong>{{ tenant.temporary_address|default:"-" }}</strong>
            </div>
            <div>
              <span>Permanent Address</span>
              <strong>{{ tenant.permanent_address|default:"-" }}</strong>
            </div>
            <div>
              <span>Working Address</span>
              <strong>{{ tenant.working_address|default:"-" }}</strong>
            </div>
            <div>
              <span>Notes</span>
              <strong>{{ tenant.notes|default:"-" }}</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ====================== INVOICES / PAYMENTS / LEASES ====================== #}
  <div class="row g-3 mb-3">
    <div class="col-12 col-xl-4" id="tenantInvoices">
      <div class="card td-card shadow-sm h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
