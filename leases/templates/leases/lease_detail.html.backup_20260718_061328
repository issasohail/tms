<div class="modal fade" id="endLeaseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <form id="endLeaseForm" method="post" action="{% url 'leases:lease_end_action' lease.pk %}">
        {% csrf_token %}
        {% firstof lease.unit.building_type.inspection_incomplete_charge lease.unit.interest_type.inspection_incomplete_charge lease.unit.inspection_incomplete_charge as moveout_inspection_default %}
        {% firstof lease.unit.building_type.key_card_not_returned_charge lease.unit.interest_type.key_card_not_returned_charge lease.unit.key_card_not_returned_charge as moveout_key_default %}
        <input type="hidden" name="action" id="endLeaseAction" value="preview">
        <input type="hidden" name="inspection_complete" id="endLeaseInspectionAnswer" value="">
        <input type="hidden" name="keys_returned" id="endLeaseKeysAnswer" value="">
        <input type="hidden" name="inspection_charge" id="endLeaseInspectionCharge" value="{{ moveout_inspection_default }}">
        <input type="hidden" name="key_charge" id="endLeaseKeyCharge" value="{{ moveout_key_default }}">
        <div class="modal-header py-2">
          <h5 class="modal-title">End Lease &amp; Post Final Settlement</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-warning py-2 small">
            This ends the lease, prorates this month's rent and regular charges, posts electricity/other charges,
            applies held security to the balance, and records any remaining refund as pending.
          </div>
          <div class="row g-2">
            <div class="col-6 col-md-4 end-lease-field">
              <label class="form-label small mb-1">Lease End Date</label>
              <input type="date" name="end_date" class="form-control form-control-sm" value="{% now 'Y-m-d' %}" required>
            </div>
            <div class="col-6 col-md-4 end-lease-field">
              <label class="form-label small mb-1">Final Electricity (optional)</label>
              <input type="number" name="final_electric_amount" class="form-control form-control-sm" min="0" step="0.01" placeholder="Auto from smart meter">
              <div class="form-text">Leave blank for smart-meter calculation.</div>
            </div>
            <div class="col-6 col-md-4 end-lease-field">
              <label class="form-label small mb-1">Other Final Charge</label>
              <input type="number" name="other_amount" class="form-control form-control-sm" min="0" step="0.01" value="0">
            </div>
            <div class="col-6 col-md-6 end-lease-field">
              <label class="form-label small mb-1">Other Charge Description</label>
              <input type="text" name="other_description" class="form-control form-control-sm" maxlength="160" placeholder="Keys, cleaning, repairs, etc.">
            </div>
            <div class="col-6 col-md-6 end-lease-field">
              <label class="form-label small mb-1">Internal Notes</label>
              <input type="text" name="notes" class="form-control form-control-sm" maxlength="250" placeholder="Notice received / settlement notes">
            </div>
            <div class="col-6 col-md-12 end-lease-field">
              <label class="form-label small mb-1">Invoices After Lease End Date</label>
              <select name="future_invoice_action" class="form-select form-select-sm">
                <option value="cancel" selected>Cancel future invoices (recommended; keep audit record)</option>
                <option value="keep">Keep and approve future invoices as valid charges</option>
              </select>
              <div class="form-text">The preview will list every invoice dated after the selected end date.</div>
            </div>
            <div class="col-12">
              <label class="form-check-label small">
                <input type="checkbox" name="send_whatsapp" value="1" class="form-check-input me-1" checked>
                Send final-bill WhatsApp to tenant and settlement information to accounts staff
              </label>
            </div>
          </div>

          <div id="endLeaseError" class="alert alert-danger py-2 mt-3 mb-0 d-none"></div>
          <details class="mt-2 small" id="endLeaseDebugDetails">
            <summary class="btn btn-sm btn-secondary py-0"><span id="endLeaseDebugToggleLabel">Show Debug</span></summary>
            <pre id="endLeaseDebug" class="bg-light border rounded p-2 mt-1 mb-0" style="white-space:pre-wrap;max-height:130px;overflow:auto;">JavaScript has not loaded. Clicking Review will use the server fallback.</pre>
          </details>
          <div id="endLeasePreview" class="mt-3 d-none">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <strong>Invoices Included in Settlement Review</strong>
              <span id="endLeaseDays" class="badge bg-secondary"></span>
            </div>
            <div id="endLeaseFutureInvoices" class="border rounded p-2 small mb-2"></div>
            <div class="table-responsive border rounded">
              <table class="table table-sm mb-0 small">
                <tbody>
                  <tr><th>Total lease balance</th><th class="text-end" id="endLeaseGross"></th></tr>
                  <tr><th>Security applied</th><th class="text-end" id="endLeaseSecurity"></th></tr>
                  <tr id="endLeaseOutcomeRow"><th id="endLeaseOutcomeLabel">Tenant payable</th><th class="text-end" id="endLeaseOutcomeValue"></th></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm" id="endLeasePreviewBtn" onclick="if (window.reviewEndLeaseSettlement) { return window.reviewEndLeaseSettlement(event); } return true;">Review Settlement</button>
          <button type="submit" class="btn btn-danger btn-sm d-none" id="endLeaseConfirmBtn">Confirm &amp; End Lease</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="endLeaseChecklistPrompt" class="d-none" style="position:fixed;inset:0;z-index:1095;background:rgba(0,0,0,.45);padding:1rem;">
