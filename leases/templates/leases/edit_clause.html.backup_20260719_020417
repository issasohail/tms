    function scrollPreviewToClause(clauseId) {
        const clauseEl = document.querySelector(`.clause[data-clause-id="${clauseId}"]`);
        if (!clauseEl) return;

        clauseEl.scrollIntoView({ behavior: "smooth", block: "center" });

        clauseEl.classList.add("preview-highlight");
        setTimeout(() => clauseEl.classList.remove("preview-highlight"), 900);
    }

    // init + bind events
    textareas.forEach(textarea => {
        autoResize(textarea);

        const clauseId = textarea.id.split('_')[1];

        textarea.addEventListener('focus', () => {
        activeTextarea = textarea;
        scrollPreviewToClause(clauseId);
        });

        textarea.addEventListener('input', function() {
        autoResize(this);
        updatePreview(clauseId, this.value);
        });
    });

    const placeholderSearch = document.getElementById('clausePlaceholderSearch');
    const placeholderButtons = Array.from(document.querySelectorAll('.placeholder-token'));

    placeholderButtons.forEach(btn => {
        btn.addEventListener('click', function() {
        const textarea = activeTextarea || document.querySelector('.clause-editor');
        if (!textarea) return;

        const token = this.dataset.token;
        const start = textarea.selectionStart || 0;
        const end = textarea.selectionEnd || 0;
        textarea.value = textarea.value.slice(0, start) + token + textarea.value.slice(end);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + token.length;
        autoResize(textarea);
        updatePreview(textarea.id.split('_')[1], textarea.value);
        });
    });

    placeholderSearch?.addEventListener('input', function() {
        const term = this.value.trim().toLowerCase();
        placeholderButtons.forEach(btn => {
        const searchableText = (btn.dataset.search || btn.dataset.token || '').toLowerCase();
        btn.classList.toggle('d-none', term && !searchableText.includes(term));
        });
    });
    });
