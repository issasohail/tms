                  <span class="td-mobile-sn">{{ forloop.counter }}</span>
                  <span class="td-mobile-date">{% if invoice.issue_date %}{{ invoice.issue_date|date:"M d, Y" }}{% else %}-{% endif %}</span>
                  <a href="{% url 'invoices:invoice_detail' invoice.pk %}" class="td-mobile-amount text-decoration-none">{{ invoice.amount|money:2 }}</a>
                </div>
              {% endfor %}
              {% if invoices|length > 5 %}
                <button class="btn btn-sm btn-outline-secondary td-more-btn" type="button" data-bs-toggle="collapse" data-bs-target=".td-more-invoices">More</button>
