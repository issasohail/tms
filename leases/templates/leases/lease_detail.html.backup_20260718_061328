  }).catch(() => {
    window.prompt('Copy maintenance link:', link);
  });
});

document.getElementById('copyTenantRegistrationLinkBtn')?.addEventListener('click', function () {
  const input = document.getElementById('leaseTenantRegistrationLink');
  const link = input?.value || '';
  if (!link) return;
  const button = this;
  const original = button.innerHTML;
  const showCopied = function () {
    button.innerHTML = '<i class="fas fa-check"></i> Copied';
    setTimeout(function () { button.innerHTML = original; }, 1600);
  };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(link).then(showCopied).catch(function () {
      input.select();
      document.execCommand('copy');
      showCopied();
    });
  } else {
    input.select();
    document.execCommand('copy');
    showCopied();
  }
});

document.querySelectorAll('[data-doc-category-url]').forEach(function (select) {
  const editor = select.closest('.ld-file-category-editor');
  const display = editor?.querySelector('.ld-file-category-display');
  const showDisplay = function () {
    select.classList.add('d-none');
    display?.classList.remove('d-none');
  };
  display?.addEventListener('click', function () {
    this.classList.add('d-none');
    select.classList.remove('d-none');
    select.focus();
  });
  select.addEventListener('blur', function () {
    if (!this.disabled) showDisplay();
  });
  select.addEventListener('change', function () {
    const data = new FormData();
    const csrf = document.querySelector('[name=csrfmiddlewaretoken]')?.value || '';
    data.append('category', this.value);
    this.disabled = true;
    fetch(this.dataset.docCategoryUrl, {
      method: 'POST',
      headers: {'X-CSRFToken': csrf, 'X-Requested-With': 'XMLHttpRequest'},
      body: data
    }).then(function (response) {
      if (!response.ok) throw new Error('Category update failed.');
      return response.json();
    }).then(function (payload) {
      if (!payload.ok) throw new Error(payload.error || 'Category update failed.');
      if (display) display.textContent = payload.category_label || select.options[select.selectedIndex]?.text || '';
      showDisplay();
    }).catch(function (error) {
      alert(error.message);
      window.location.reload();
    }).finally(() => {
      this.disabled = false;
    });
  });
});
</script>
{% endblock %}
