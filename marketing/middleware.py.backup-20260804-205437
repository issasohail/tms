from urllib.parse import urlsplit

from django.conf import settings
from django.http import HttpResponsePermanentRedirect, HttpResponseRedirect


TMS_LEGACY_UI_PREFIXES = (
    "/accounts",
    "/building-types",
    "/documents",
    "/expenses",
    "/handyman",
    "/invoices",
    "/lease-document-categories",
    "/lease-relationship-types",
    "/leases",
    "/maintenance",
    "/notifications",
    "/payment-methods",
    "/payments",
    "/pending-approvals",
    "/properties",
    "/reports",
    "/settings",
    "/smart-meter",
    "/suggestions",
    "/tenant-interest-types",
    "/tenants",
    "/unit-autocomplete",
    "/utilities",
)


def _matches_prefix(path, prefix):
    return path == prefix or path.startswith(f"{prefix}/")


class MarketingHostMiddleware:
    """Select the public-only URLconf for Kirayas without changing request paths."""

    def __init__(self, get_response):
        self.get_response = get_response

    def __call__(self, request):
        host = request.get_host().split(":", 1)[0].lower()
        public_host = getattr(settings, "MARKETING_PUBLIC_HOST", "kirayas.com")

        if host == f"www.{public_host}":
            canonical = urlsplit(
                getattr(
                    settings,
                    "MARKETING_PUBLIC_BASE_URL",
                    f"https://{public_host}",
                )
            )
            location = f"{canonical.scheme}://{canonical.netloc}{request.get_full_path()}"
            return HttpResponsePermanentRedirect(location)

        # Keep the authenticated application on the same canonical domain at
        # /tms/, while all other paths use the public marketing URLconf.
        is_tms_path = request.path_info == "/tms" or request.path_info.startswith("/tms/")
        normalized_path = request.path_info.rstrip("/") or "/"
        special_tms_paths = {
            "/dashboard": "/tms/",
            "/login": "/tms/accounts/login/",
            "/logout": "/tms/accounts/logout/",
        }
        legacy_tms_path = any(
            _matches_prefix(normalized_path, prefix)
            for prefix in TMS_LEGACY_UI_PREFIXES
        )

        # `/whatsapp/` is the public marketing contact link and the exact
        # webhook path is used by Meta. Other WhatsApp management pages belong
        # to the authenticated TMS application.
        if _matches_prefix(normalized_path, "/whatsapp") and normalized_path not in {
            "/whatsapp",
            "/whatsapp/webhook",
        }:
            legacy_tms_path = True

        if host == public_host and (
            normalized_path in special_tms_paths or legacy_tms_path
        ):
            canonical = urlsplit(
                getattr(
                    settings,
                    "MARKETING_PUBLIC_BASE_URL",
                    f"https://{public_host}",
                )
            )
            if normalized_path in special_tms_paths:
                target_path = special_tms_paths[normalized_path]
                query_string = request.META.get("QUERY_STRING", "")
                if query_string:
                    target_path = f"{target_path}?{query_string}"
            else:
                target_path = f"/tms{request.get_full_path()}"
            location = f"{canonical.scheme}://{canonical.netloc}{target_path}"
            return HttpResponseRedirect(
                location,
                preserve_request=request.method not in {"GET", "HEAD"},
            )
        if host == public_host and not is_tms_path:
            request.urlconf = "tms.marketing_urls"

        return self.get_response(request)
