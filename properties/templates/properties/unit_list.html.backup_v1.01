{% extends 'base.html' %}
{% load render_table from django_tables2 %}
{% load static %}
<link rel="stylesheet" href="{% static 'properties/css/tables.css' %}">

{% block title %}Units{% endblock %}


{% block content %}
<div class="unit-page-header d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Units</h2>
    <div class="unit-page-actions d-flex gap-2">
        <a href="{% url 'properties:unit_create' %}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add Unit
        </a>
        <button type="button"
                class="btn btn-success"
                id="vacantSummaryMessageBtn"
                data-summary-url="{% url 'properties:unit_vacant_summary_message' %}?{{ request.GET.urlencode }}">
            <i class="fab fa-whatsapp me-1"></i> Vacant Summary
        </button>
        
        {% include "includes/export_buttons.html" %}
    </div>
</div>

<!-- Filter form -->
<div class="card unit-filter-card mb-4">
    <div class="card-body p-3">
        <form method="get" class="unit-filter-row">
            <div class="unit-filter-field unit-filter-property">
                <label for="id_property" class="form-label">Property</label>
                <select name="property" id="id_property" class="form-select">
                    <option value="">All Properties</option>
                    {% for property in all_properties %}
                        <option value="{{ property.id }}"
                            {% if request.GET.property|stringformat:"s" == property.id|stringformat:"s" %}selected{% endif %}>
                            {{ property.property_name }} - ({{ property.unit_count }} units)
                        </option>
                    {% empty %}
                        <option value="">No properties available</option>
                    {% endfor %}
                </select>
            </div>
            <div class="unit-filter-field unit-filter-status">
                <label for="id_status" class="form-label">Status</label>
                <select name="status" id="id_status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="vacant" {% if current_status == "vacant" %}selected{% endif %}>Vacant</option>
                    <option value="occupied" {% if current_status == "occupied" %}selected{% endif %}>Occupied</option>
                    <option value="ending_soon" {% if current_status == "ending_soon" %}selected{% endif %}>Lease Ending Soon</option>
                    <option value="maintenance" {% if current_status == "maintenance" %}selected{% endif %}>Maintenance / Disabled</option>
                </select>
            </div>
            <div class="unit-filter-buttons">
                <button type="submit" class="btn btn-primary">Filter</button>
                {% if request.GET.property or request.GET.status %}
                    <a href="?" class="btn btn-outline-secondary">Clear</a>
                {% endif %}
            </div>
        </form>
    </div>
</div>


    {% csrf_token %}
{# Desktop: sticky, bold list header is enabled by the shared opt-in class. #}
<div class="table-responsive unit-table-wrap desktop-sticky-list">
    {% render_table table %}
</div>
{{ building_type_options|json_script:"buildingTypeOptions" }}

<div class="modal fade" id="unitBulkUpdateModal" tabindex="-1" aria-labelledby="unitBulkUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title fs-6" id="unitBulkUpdateModalLabel">Apply to this property?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body small" id="unitBulkUpdateMessage"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">This unit only</button>
                <button type="button" class="btn btn-primary btn-sm" id="unitBulkUpdateConfirm">Apply to all units</button>
            </div>
        </div>
    </div>
</div>

{% include "properties/includes/vacant_notice_modal.html" %}


    {% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    @media (min-width: 1200px) {
        body:has(.unit-page-header) main.container,
        body:has(.unit-page-header) .container {
            max-width: 1500px !important;
        }
    }
    .unit-page-header {
        gap: 12px;
    }
    .unit-page-actions {
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .unit-page-actions .btn,
    .unit-page-actions .dropdown-toggle {
        white-space: nowrap;
    }
    .unit-filter-card {
        border: 0;
        border-radius: 8px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.08);
    }
    .unit-filter-card .form-label {
        margin-bottom: 4px;
        font-size: 12px;
        font-weight: 600;
        color: #475569;
    }
    .unit-filter-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 2px;
        -webkit-overflow-scrolling: touch;
    }
    .unit-filter-field {
        flex: 0 0 auto;
    }
    .unit-filter-property {
        width: min(430px, 42vw);
        min-width: 260px;
    }
    .unit-filter-status {
        width: min(320px, 30vw);
        min-width: 210px;
    }
    .unit-filter-buttons {
        display: flex;
        flex: 0 0 auto;
        gap: 8px;
        align-items: flex-end;
    }
    .unit-filter-card .btn {
        min-height: 38px;
    }
    .unit-table-wrap {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    .unit-table-wrap table {
        margin-bottom: 0;
        min-width: 1280px;
        table-layout: auto;
        font-size: 14px !important;
    }
    .unit-table-wrap th,
    .unit-table-wrap td {
        padding: 8px 10px;
        vertical-align: middle;
        white-space: nowrap;
    }
    .unit-table-wrap th {
        font-size: 11px;
        text-transform: uppercase;
        color: #475569;
        background: #f8fafc;
    }
    .unit-table-wrap td:nth-child(3),
    .unit-table-wrap td:nth-child(4),
    .unit-table-wrap td:nth-child(10) {
        white-space: normal;
    }
    .unit-table-wrap td:nth-child(2),
    .unit-table-wrap th:nth-child(2) {
        position: sticky;
        left: 0;
        z-index: 2;
        background: inherit;
        box-shadow: 1px 0 0 #dee2e6;
    }
    .unit-table-wrap th:nth-child(2) {
        z-index: 3;
        background: #f8fafc;
    }
    .unit-table-wrap th:nth-child(1),
    .unit-table-wrap td:nth-child(1) {
        width: 48px;
        min-width: 48px;
        max-width: 48px;
    }
    .unit-table-wrap th:nth-child(2),
    .unit-table-wrap td:nth-child(2) {
        width: 112px;
        min-width: 112px;
        max-width: 112px;
    }
    .unit-table-wrap th:nth-child(3),
    .unit-table-wrap td:nth-child(3) {
        width: 82px;
        min-width: 82px;
        max-width: 92px;
    }
    .unit-table-wrap th:nth-child(4),
    .unit-table-wrap td:nth-child(4) {
        width: 135px;
        min-width: 135px;
        max-width: 145px;
    }
    .unit-table-wrap th:nth-child(5),
    .unit-table-wrap td:nth-child(5),
    .unit-table-wrap th:nth-child(9),
    .unit-table-wrap td:nth-child(9) {
        width: 74px;
        min-width: 74px;
        max-width: 78px;
    }
    .unit-table-wrap th:nth-child(6),
    .unit-table-wrap td:nth-child(6) {
        width: 132px;
        min-width: 132px;
        max-width: 136px;
    }
    .unit-table-wrap th:nth-child(7),
    .unit-table-wrap td:nth-child(7) {
        width: 96px;
        min-width: 96px;
        max-width: 100px;
    }
    .unit-table-wrap th:nth-child(8),
    .unit-table-wrap td:nth-child(8) {
        width: 112px;
        min-width: 112px;
        max-width: 116px;
    }
    .unit-table-wrap th:nth-child(10),
    .unit-table-wrap td:nth-child(10) {
        width: 132px;
        min-width: 132px;
        max-width: 138px;
    }
    .unit-table-wrap th:nth-child(11),
    .unit-table-wrap td:nth-child(11) {
        width: 90px;
        min-width: 90px;
        max-width: 90px;
        text-align: center;
        white-space: normal;
        word-break: break-word;
        overflow-wrap: anywhere;
        line-height: 1.15;
    }
    .unit-table-wrap th:nth-child(12),
    .unit-table-wrap td:nth-child(12) {
        width: 72px;
        min-width: 60px;
        max-width: 60px;
        text-align: center;
        white-space: nowrap;
    }

    .unit-table-wrap th:nth-child(13),
    .unit-table-wrap td:nth-child(13) {
        width: 168px;
        min-width: 168px;
        max-width: 168px;
    }
    .unit-inline-edit,
    .unit-building-type-edit,
    .unit-status-edit,
    .unit-smart-edit,
    .unit-public-edit,
    .lead-phone-text {
        display: inline-block;
        min-width: 52px;
        padding: 2px 4px;
        border-radius: 4px;
        cursor: pointer;
    }
    .unit-inline-edit:hover,
    .unit-building-type-edit:hover,
    .unit-status-edit:hover,
    .unit-smart-edit:hover,
    .unit-public-edit:hover,
    .lead-phone-text:hover {
        background: #eef5ff;
        box-shadow: inset 0 0 0 1px #b6d4fe;
    }
    .unit-building-type-edit {
        min-width: 120px;
    }
    .unit-status-edit {
        min-width: 78px;
        border: 0;
        white-space: normal;
        line-height: 1.2;
    }
    .unit-status-caret {
        font-size: 0.65em;
        opacity: 0.75;
    }
    .unit-status-select {
        min-width: 126px;
        font-size: 0.78rem;
    }
    .actions-wrap {
        white-space: nowrap;
        justify-content: center;
    }
    .table td.unit-actions-cell,
    .table th.unit-actions-cell {
        overflow: visible;
        text-overflow: clip;
        position: sticky;
        right: 0;
        z-index: 4;
        min-width: 168px;
        background: #fff;
        box-shadow: -1px 0 0 #dee2e6;
    }
    .table th.unit-actions-cell {
        z-index: 5;
        background: #f8fafc;
    }
    .unit-actions-cell .actions-wrap {
        gap: 4px !important;
    }
    .unit-actions-cell .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        min-width: 34px;
        height: 28px;
        padding: 0;
        flex: 0 0 auto;
    }
    .unit-actions-cell .action-btn .btn-text {
        display: none;
    }
    .actions-wrap .btn,
    .vacant-leads-table .btn {
        white-space: nowrap;
    }
    .vacant-leads-table th,
    .vacant-leads-table td {
        vertical-align: middle;
    }
    @media (max-width: 991.98px) {
        .unit-page-header {
            align-items: flex-start !important;
            flex-direction: column;
        }
        .unit-page-actions {
            justify-content: flex-start;
            width: 100%;
        }
        .unit-filter-card {
            margin-bottom: 14px !important;
        }
        .unit-filter-card .card-body {
            padding: 12px !important;
        }
        .unit-filter-property {
            width: 320px;
            min-width: 320px;
        }
        .unit-filter-status {
            width: 230px;
            min-width: 230px;
        }
        .unit-table-wrap table {
            min-width: 980px;
            font-size: 13px !important;
        }
        .unit-table-wrap th,
        .unit-table-wrap td {
            padding: 7px 8px;
        }
    }
    @media (max-width: 575.98px) {
        /*
           Small-screen layout only.
           Desktop/tablet styles and all JavaScript are unchanged.

           Visible mobile table columns are:
           1 = SN
           2 = Unit
           5 = Rent
           11 = Status
           12 = Actions

           Tweak these values for 360px/iPhone only.
        */
        :root {
            --unit-mobile-font-size: 0.68rem;

            /* Fixed mobile column widths */
            --unit-mobile-sn-width: 22px;
            --unit-mobile-rent-width: 48px;
            --unit-mobile-status-width: 58px;
            --unit-mobile-actions-width: 96px;

            /* Unit column uses the remaining space automatically */
            --unit-mobile-cell-pad-y: 3px;
            --unit-mobile-cell-pad-x: 2px;

            /* Action button controls */
            --unit-mobile-action-btn-size: 18px;
            --unit-mobile-action-icon-size: 9px;
            --unit-mobile-action-gap: 1px;
        }

        .unit-page-header {
            gap: 7px;
            margin-bottom: 8px !important;
        }
        .unit-page-header h2 {
            font-size: 1.25rem;
            line-height: 1.1;
        }

        /* Keep Add Unit, Vacant Summary and Export in one line */
        .unit-page-actions {
            display: grid !important;
            grid-template-columns: 30fr 43fr 27fr;
            gap: 4px !important;
            width: 100%;
        }
        .unit-page-actions .btn,
        .unit-page-actions .dropdown,
        .unit-page-actions .dropdown-toggle {
            width: 100%;
            min-width: 0;
        }
        .unit-page-actions .btn,
        .unit-page-actions .dropdown-toggle {
            min-height: 29px;
            padding: 4px 3px;
            font-size: 0.65rem;
            line-height: 1.1;
        }
        .unit-page-actions .btn i,
        .unit-page-actions .dropdown-toggle i {
            margin-right: 2px !important;
            font-size: 0.68rem;
        }

        /* Keep Property, Status and Filter icon in one line */
        .unit-filter-card {
            margin-left: -4px;
            margin-right: -4px;
            margin-bottom: 9px !important;
        }
        .unit-filter-card .card-body {
            padding: 7px !important;
        }
        .unit-filter-card .form-label {
            display: none;
        }
        .unit-filter-row {
            display: grid;
            grid-template-columns: minmax(0, 42fr) minmax(0, 42fr) 38px;
            gap: 5px;
            overflow: hidden;
            padding-bottom: 0;
            width: 100%;
        }
        .unit-filter-field,
        .unit-filter-property,
        .unit-filter-status,
        .unit-filter-buttons {
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
        }
        .unit-filter-buttons {
            display: block;
        }
        .unit-filter-card .form-select {
            min-height: 31px;
            height: 31px;
            padding: 4px 22px 4px 6px;
            font-size: 0.66rem;
            line-height: 1.05;
        }
        .unit-filter-buttons .btn[type="submit"] {
            width: 100%;
            min-width: 0;
            min-height: 31px;
            height: 31px;
            margin-top: 0;
            padding: 0;
            font-size: 0;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .unit-filter-buttons .btn[type="submit"]::before {
            content: "\f0b0";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            font-size: 0.78rem;
        }
        .unit-filter-buttons .btn-outline-secondary {
            display: none;
        }

        /* No horizontal scrolling on 360px */
        .unit-table-wrap {
            margin-left: -8px;
            margin-right: -8px;
            border-left: 0;
            border-right: 0;
            border-radius: 0;
            overflow-x: hidden;
        }
        .unit-table-wrap table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
            font-size: var(--unit-mobile-font-size) !important;
        }
        .unit-table-wrap th,
        .unit-table-wrap td {
            padding: var(--unit-mobile-cell-pad-y) var(--unit-mobile-cell-pad-x) !important;
            white-space: normal;
            overflow-wrap: normal;
            word-break: normal;
            line-height: 1.1;
            vertical-align: middle;
        }
        .unit-table-wrap th {
            font-size: 0.58rem;
            letter-spacing: 0;
            text-transform: uppercase;
            text-align: center;
        }

        /* Hide desktop-only columns on mobile. Keep only: SN, Unit, Rent, Status, Actions. */
        .unit-table-wrap th:nth-child(3),
        .unit-table-wrap td:nth-child(3),
        .unit-table-wrap th:nth-child(4),
        .unit-table-wrap td:nth-child(4),
        .unit-table-wrap th:nth-child(6),
        .unit-table-wrap td:nth-child(6),
        .unit-table-wrap th:nth-child(7),
        .unit-table-wrap td:nth-child(7),
        .unit-table-wrap th:nth-child(8),
        .unit-table-wrap td:nth-child(8),
        .unit-table-wrap th:nth-child(9),
        .unit-table-wrap td:nth-child(9),
        .unit-table-wrap th:nth-child(10),
        .unit-table-wrap td:nth-child(10) {
            display: none !important;
        }

        /* Fixed-width mobile columns */
        .unit-table-wrap th:nth-child(1),
        .unit-table-wrap td:nth-child(1) {
            width: var(--unit-mobile-sn-width) !important;
            min-width: var(--unit-mobile-sn-width) !important;
            max-width: var(--unit-mobile-sn-width) !important;
            text-align: center;
            white-space: nowrap !important;
            overflow: hidden !important;
        }

        .unit-table-wrap th:nth-child(2),
        .unit-table-wrap td:nth-child(2) {
            position: static !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            box-shadow: none !important;
            background: inherit;
        }

        .unit-table-wrap th:nth-child(5),
        .unit-table-wrap td:nth-child(5) {
            width: var(--unit-mobile-rent-width) !important;
            min-width: var(--unit-mobile-rent-width) !important;
            max-width: var(--unit-mobile-rent-width) !important;
            text-align: center;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: clip;
        }

        .unit-table-wrap th:nth-child(11),
        .unit-table-wrap td:nth-child(11) {
            width: var(--unit-mobile-status-width) !important;
            min-width: var(--unit-mobile-status-width) !important;
            max-width: var(--unit-mobile-status-width) !important;
            text-align: center;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: clip;
        }

        /* Action column: force fixed width so Django Tables2 / Bootstrap cannot shrink it */
        .unit-table-wrap th:nth-child(13),
        .unit-table-wrap td:nth-child(13),
        .table th.unit-actions-cell,
        .table td.unit-actions-cell {
            position: static !important;
            width: var(--unit-mobile-actions-width) !important;
            min-width: var(--unit-mobile-actions-width) !important;
            max-width: var(--unit-mobile-actions-width) !important;
            box-shadow: none !important;
            background: inherit;
            overflow: visible !important;
            white-space: nowrap !important;
            text-align: center;
        }

        /* Cleaner mobile headers */
        .unit-table-wrap th:nth-child(1),
        .unit-table-wrap th:nth-child(2),
        .unit-table-wrap th:nth-child(5),
        .unit-table-wrap th:nth-child(11),
        .unit-table-wrap th:nth-child(12) {
            font-size: 0 !important;
            white-space: nowrap !important;
        }
        .unit-table-wrap th:nth-child(1)::after {
            content: "SN";
            font-size: 0.58rem;
        }
        .unit-table-wrap th:nth-child(2)::after {
            content: "UNIT";
            font-size: 0.58rem;
        }
        .unit-table-wrap th:nth-child(5)::after {
            content: "RENT";
            font-size: 0.58rem;
        }
        .unit-table-wrap th:nth-child(11)::after {
            content: "STATUS";
            font-size: 0.52rem;
        }
        .unit-table-wrap th:nth-child(13)::after {
            content: "ACTION";
            font-size: 0.52rem;
        }

        /* Unit text: compact wrapping */
        .unit-table-wrap td:nth-child(2) {
            font-size: 0.65rem;
            line-height: 1.08;
            overflow-wrap: anywhere;
        }
        .unit-table-wrap td:nth-child(2) a {
            display: inline-block;
            max-width: 100%;
            overflow-wrap: anywhere;
            line-height: 1.08;
        }

        /* Status stays compact */
        .unit-table-wrap td:nth-child(11),
        .unit-table-wrap td:nth-child(11) a,
        .unit-table-wrap td:nth-child(11) span,
        .unit-table-wrap td:nth-child(11) .badge {
            font-size: 0.58rem !important;
            line-height: 1.05;
            white-space: nowrap !important;
        }

        /* Four filled action buttons on one line */
        .unit-actions-cell .actions-wrap,
        .actions-wrap {
            display: flex !important;
            flex-wrap: nowrap !important;
            justify-content: center;
            align-items: center;
            gap: var(--unit-mobile-action-gap) !important;
            white-space: nowrap !important;
        }
        .unit-actions-cell .action-btn,
        .actions-wrap .action-btn {
            width: var(--unit-mobile-action-btn-size) !important;
            min-width: var(--unit-mobile-action-btn-size) !important;
            max-width: var(--unit-mobile-action-btn-size) !important;
            height: var(--unit-mobile-action-btn-size) !important;
            min-height: var(--unit-mobile-action-btn-size) !important;
            padding: 0 !important;
            margin: 0 !important;
            border-radius: 4px;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            flex: 0 0 var(--unit-mobile-action-btn-size) !important;
        }
        .unit-actions-cell .action-btn i,
        .actions-wrap .action-btn i {
            font-size: var(--unit-mobile-action-icon-size) !important;
            line-height: 1;
            margin: 0 !important;
        }
        .unit-actions-cell .action-btn .btn-text,
        .actions-wrap .action-btn .btn-text {
            display: none !important;
        }

        /* Pagination also uses small-screen font size */
        .pagination,
        .pagination .page-link,
        .page-link,
        .page-item {
            font-size: var(--unit-mobile-font-size) !important;
        }
        .pagination .page-link {
            padding: 0.25rem 0.45rem !important;
            min-height: 28px;
        }
    }
    @media (max-width: 380px) {
        :root {
            --unit-mobile-font-size: 0.66rem;
            --unit-mobile-sn-width: 22px;
            --unit-mobile-rent-width: 48px;
            --unit-mobile-status-width: 56px;
            --unit-mobile-actions-width: 96px;
            --unit-mobile-action-btn-size: 18px;
            --unit-mobile-action-icon-size: 9px;
            --unit-mobile-action-gap: 1px;
        }
        .unit-page-actions {
            grid-template-columns: 30fr 43fr 27fr;
        }
        .unit-page-actions .btn,
        .unit-page-actions .dropdown-toggle {
            font-size: 0.64rem;
        }
    }
    @media (max-width: 767.98px) {
        .unit-page-header {
            padding: 2px 0 0;
        }
        .unit-page-actions {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 6px !important;
        }
        .unit-page-actions .btn,
        .unit-page-actions .dropdown-toggle {
            border-radius: 7px;
            min-height: 34px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .unit-filter-card {
            border-radius: 8px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.10);
        }
        .unit-filter-row {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 42px;
            gap: 7px;
        }
        .unit-table-wrap {
            border: 0;
            background: transparent;
            overflow: visible;
            margin-left: 0;
            margin-right: 0;
        }
        .unit-table-wrap table,
        .unit-table-wrap tbody,
        .unit-table-wrap tr,
        .unit-table-wrap td {
            display: block;
            width: 100% !important;
            min-width: 0 !important;
            max-width: none !important;
        }
        .unit-table-wrap table {
            border: 0 !important;
            background: transparent;
            table-layout: auto !important;
        }
        .unit-table-wrap thead {
            display: none;
        }
        .unit-table-wrap tbody tr {
            margin-bottom: 10px;
            padding: 10px;
            border: 1px solid #d8e2ee;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        }
        .unit-table-wrap tbody tr:nth-child(even) {
            background: #fbfdff;
        }
        .unit-table-wrap th,
        .unit-table-wrap td,
        .table td.unit-actions-cell,
        .table th.unit-actions-cell {
            position: static !important;
            box-shadow: none !important;
            border: 0 !important;
            background: transparent !important;
        }
        .unit-table-wrap td {
            display: flex !important;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 30px;
            padding: 5px 0 !important;
            font-size: 0.78rem !important;
            line-height: 1.2;
            white-space: normal !important;
            overflow: visible !important;
        }
        .unit-table-wrap td::before {
            flex: 0 0 78px;
            color: #64748b;
            content: "";
            font-size: 0.64rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .unit-table-wrap td:nth-child(1),
        .unit-table-wrap td:nth-child(4),
        .unit-table-wrap td:nth-child(6),
        .unit-table-wrap td:nth-child(7),
        .unit-table-wrap td:nth-child(8),
        .unit-table-wrap td:nth-child(9),
        .unit-table-wrap td:nth-child(10) {
            display: none !important;
        }
        .unit-table-wrap td:nth-child(2) {
            padding-top: 0 !important;
            font-size: 1rem !important;
            font-weight: 700;
            border-bottom: 1px solid #edf2f7 !important;
            margin-bottom: 4px;
        }
        .unit-table-wrap td:nth-child(2)::before {
            content: "Unit";
        }
        .unit-table-wrap td:nth-child(3)::before {
            content: "Property";
        }
        .unit-table-wrap td:nth-child(5)::before {
            content: "Rent";
        }
        .unit-table-wrap td:nth-child(11)::before {
            content: "Status";
        }
        .unit-table-wrap td:nth-child(12)::before {
            content: "Smart";
        }
        .unit-table-wrap td:nth-child(13)::before {
            content: "Public";
        }
        .unit-table-wrap td.unit-actions-cell::before {
            content: "Actions";
        }
        .unit-table-wrap td:nth-child(2) a {
            color: #0f172a;
            text-decoration: none;
            overflow-wrap: anywhere;
        }
        .unit-table-wrap td:nth-child(11),
        .unit-table-wrap td:nth-child(11) a,
        .unit-table-wrap td:nth-child(11) span,
        .unit-table-wrap td:nth-child(11) .badge {
            font-size: 0.72rem !important;
            white-space: normal !important;
        }
        .unit-status-edit {
            min-width: 94px;
            padding: 5px 8px;
            text-align: center;
        }
        .unit-status-select {
            width: 132px;
            min-width: 132px;
        }
        .unit-actions-cell .actions-wrap,
        .actions-wrap {
            justify-content: flex-end;
            gap: 5px !important;
            width: 100%;
        }
        .unit-actions-cell .action-btn,
        .actions-wrap .action-btn {
            width: 30px !important;
            min-width: 30px !important;
            max-width: 30px !important;
            height: 28px !important;
            min-height: 28px !important;
            border-radius: 7px;
        }
        .unit-actions-cell .action-btn i,
        .actions-wrap .action-btn i {
            font-size: 0.78rem !important;
        }
    }
    @media (min-width: 768px) and (max-width: 991.98px) {
        .unit-table-wrap {
            border-radius: 8px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        }
        .unit-table-wrap table {
            min-width: 1080px;
        }
        .unit-table-wrap th,
        .unit-table-wrap td {
            padding: 7px 8px;
        }
    }

    /* Unit-list charge and inventory layout. Class selectors keep this stable
       when columns are added or reordered. */
    .unit-table-wrap table {
        min-width: 1940px;
    }
    .unit-table-wrap .charge-col {
        width: 112px;
        min-width: 112px;
        max-width: 126px;
    }
    .unit-table-wrap .security-text-col {
        min-width: 118px;
        max-width: 132px;
        white-space: normal;
    }
    .unit-table-wrap .inventory-col {
        width: 260px;
        min-width: 260px;
        max-width: 260px;
        white-space: normal;
    }
    .inventory-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
        margin-bottom: 3px;
    }
    .inventory-chip,
    .inventory-more {
        display: inline-block;
        padding: 2px 5px;
        border: 1px solid #dbe4ee;
        border-radius: 999px;
        background: #f8fafc;
        color: #334155;
        font-size: 0.68rem;
        line-height: 1.2;
    }
    .inventory-more {
        background: #eef5ff;
        color: #0d6efd;
    }
    .inventory-manage-link {
        font-size: 0.68rem;
        white-space: nowrap;
    }
    .unit-inline-edit {
        font-variant-numeric: tabular-nums;
    }
    .unit-inline-edit + .form-control,
    .charge-col .form-control {
        min-width: 96px;
    }

    @media (max-width: 991.98px) {
        .unit-filter-row {
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) auto;
            gap: 8px;
            width: 100%;
            overflow: visible;
        }
        .unit-filter-field,
        .unit-filter-property,
        .unit-filter-status {
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
        }
        .unit-filter-buttons {
            display: flex;
        }
        .unit-filter-card .form-select {
            width: 100%;
        }
        .unit-table-wrap {
            border: 0;
            background: transparent;
            box-shadow: none;
            overflow: visible;
        }
        .unit-table-wrap table,
        .unit-table-wrap tbody,
        .unit-table-wrap tr,
        .unit-table-wrap td {
            display: block;
            width: 100% !important;
            min-width: 0 !important;
            max-width: none !important;
        }
        .unit-table-wrap table {
            min-width: 0 !important;
            border: 0 !important;
            background: transparent;
        }
        .unit-table-wrap thead {
            display: none;
        }
        .unit-table-wrap tbody {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }
        .unit-table-wrap tbody tr {
            margin: 0;
            padding: 12px;
            border: 1px solid #d8e2ee;
            border-radius: 9px;
            background: #fff !important;
            box-shadow: 0 7px 18px rgba(15, 23, 42, 0.08);
        }
        .unit-table-wrap td,
        .table td.unit-actions-cell {
            position: static !important;
            display: flex !important;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            min-height: 30px;
            padding: 5px 0 !important;
            border: 0 !important;
            background: transparent !important;
            box-shadow: none !important;
            white-space: normal !important;
            text-align: right;
        }
        .unit-table-wrap tbody td:first-child,
        .unit-table-wrap td.building-type-col,
        .unit-table-wrap td.meter-col {
            display: none !important;
        }
        .unit-table-wrap td::before {
            flex: 0 0 104px;
            color: #64748b;
            font-size: 0.64rem;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
        }
        .unit-table-wrap td.unit-number-col {
            align-items: center;
            padding-top: 0 !important;
            margin-bottom: 4px;
            border-bottom: 1px solid #edf2f7 !important;
            font-size: 1rem !important;
            font-weight: 700;
        }
        .unit-number-col::before { content: "Unit" !important; }
        .property-col::before { content: "Property" !important; }
        .rent-col::before { content: "Monthly rent" !important; }
        .maintenance-col::before { content: "Maintenance" !important; }
        .water-col::before { content: "Water" !important; }
        .internet-col::before { content: "Internet" !important; }
        .security-text-col::before { content: "Security text" !important; }
        .security-amount-col::before { content: "Security amount" !important; }
        .inventory-col::before { content: "Amenities" !important; }
        .status-col::before { content: "Status" !important; }
        .smart-col::before { content: "Smart meter" !important; }
        .public-col::before { content: "Public" !important; }
        .unit-actions-cell::before { content: "Actions" !important; }
        .unit-table-wrap td.inventory-col {
            align-items: flex-start;
        }
        .inventory-col > div,
        .inventory-col > span,
        .inventory-col > a {
            max-width: calc(100% - 116px);
        }
        .inventory-summary {
            justify-content: flex-end;
        }
        .unit-actions-cell .actions-wrap {
            justify-content: flex-end;
        }
    }

    @media (max-width: 767.98px) {
        .unit-table-wrap tbody {
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
        }
    }

    @media (max-width: 575.98px) {
        .unit-filter-card {
            margin-left: 0;
            margin-right: 0;
        }
        .unit-filter-card .form-label {
            display: block;
        }
        .unit-filter-row {
            grid-template-columns: minmax(0, 1fr);
            gap: 7px;
        }
        .unit-filter-buttons {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 7px;
        }
        .unit-filter-buttons .btn[type="submit"] {
            width: auto;
            min-height: 34px;
            height: auto;
            font-size: 0.72rem;
        }
        .unit-filter-buttons .btn[type="submit"]::before {
            margin-right: 5px;
        }
        .unit-filter-buttons .btn-outline-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .unit-filter-buttons .btn:only-child {
            grid-column: 1 / -1;
        }
        .unit-table-wrap td.unit-col,
        .unit-table-wrap td.charge-col,
        .unit-table-wrap td.inventory-col,
        .unit-table-wrap td.status-col,
        .unit-table-wrap td.smart-col,
        .unit-table-wrap td.public-col,
        .unit-table-wrap td.unit-actions-cell {
            display: flex !important;
            width: 100% !important;
            min-width: 0 !important;
            max-width: none !important;
        }
        .unit-table-wrap td.building-type-col,
        .unit-table-wrap td.meter-col {
            display: none !important;
        }
        .unit-table-wrap td::before {
            flex-basis: 98px;
        }
        .inventory-col > div,
        .inventory-col > span,
        .inventory-col > a {
            max-width: calc(100% - 108px);
        }
        .unit-table-wrap td.charge-col,
        .unit-table-wrap td.charge-col .unit-inline-edit {
            font-size: 0.78rem !important;
            line-height: 1.2;
            white-space: normal !important;
        }
    }
</style>
{% endblock %}
{% block extra_js %}
<script>
document.addEventListener("DOMContentLoaded", function () {
    const buildingTypeOptions = JSON.parse(document.getElementById("buildingTypeOptions").textContent || "[]");
    const unitStatusOptions = [
        {value: "vacant", label: "Vacant", badgeClass: "bg-primary"},
        {value: "occupied", label: "Occupied", badgeClass: "bg-success"},
        {value: "maintenance", label: "Maintenance", badgeClass: "bg-danger"}
    ];
    const bulkFieldLabels = {
        monthly_rent: "monthly rent",
        society_maintenance: "society maintenance",
        water_charges: "water charges",
        internet_charges: "internet charges",
        security_requires: "security text",
        security_deposit_amount: "security deposit amount"
    };
    const bulkModalElement = document.getElementById("unitBulkUpdateModal");
    const bulkMessage = document.getElementById("unitBulkUpdateMessage");
    const bulkConfirm = document.getElementById("unitBulkUpdateConfirm");
    let bulkUpdateContext = null;

    if (bulkConfirm) {
        bulkConfirm.addEventListener("click", function () {
            if (!bulkUpdateContext) return;
            const context = bulkUpdateContext;
            bulkConfirm.disabled = true;
            bulkConfirm.textContent = "Applying...";
            saveUnitField(context.unitId, context.field, context.value, true)
                .then(function (payload) {
                    document.querySelectorAll(
                        `.unit-inline-edit[data-field="${context.field}"][data-property-id="${context.propertyId}"]`
                    ).forEach(function (span) {
                        span.textContent = payload.new_value || "-";
                    });
                    bootstrap.Modal.getOrCreateInstance(bulkModalElement).hide();
                })
                .catch(function (error) {
                    alert(error.message);
                })
                .finally(function () {
                    bulkConfirm.disabled = false;
                    bulkConfirm.textContent = "Apply to all units";
                    bulkUpdateContext = null;
                });
        });
    }

    const selectAll = document.getElementById('select-all');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('input[name="selected_units"]');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });
    }

    document.querySelectorAll("td[data-editable='true']").forEach(td => {
        td.addEventListener("dblclick", function () {
            const field = td.dataset.field;
            const id = td.dataset.id;
            const current = td.innerText.trim();

            const input = document.createElement("input");
            input.type = "text";
            input.value = current;
            input.className = "form-control";
            td.innerHTML = "";
            td.appendChild(input);
            input.focus();

            input.addEventListener("blur", function () {
                fetch("{% url 'properties:unit_inline_update' %}", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRFToken": getCookie("csrftoken")
                    },
                    body: JSON.stringify({
                        id: id,
                        field: field,
                        value: input.value
                    })
                }).then(res => res.json()).then(data => {
                    td.innerText = data.new_value || input.value;
                }).catch(err => {
                    console.error(err);
                    td.innerText = current;
                });
            });
        });
    });

    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });
    document.querySelectorAll(".unit-public-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            toggleBooleanStatus(span, "show_publicly");
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") toggleBooleanStatus(span, "show_publicly");
        });
    });
    document.querySelectorAll(".unit-smart-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            toggleBooleanStatus(span, "is_smart_meter");
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") toggleBooleanStatus(span, "is_smart_meter");
        });
    });
    document.querySelectorAll(".unit-building-type-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            startBuildingTypeEdit(span);
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") startBuildingTypeEdit(span);
        });
    });
    document.querySelectorAll(".unit-status-edit").forEach(function (span) {
        span.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
            startUnitStatusEdit(span);
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                startUnitStatusEdit(span);
            }
        });
    });

    document.querySelectorAll(".unit-inline-edit").forEach(function (span) {
        span.addEventListener("click", function () {
            startUnitTextEdit(span);
        });
        span.addEventListener("keydown", function (event) {
            if (event.key === "Enter") startUnitTextEdit(span);
        });
    });

    const vacantSummaryButton = document.getElementById("vacantSummaryMessageBtn");
    if (vacantSummaryButton) {
        vacantSummaryButton.addEventListener("click", function () {
            vacantSummaryButton.disabled = true;
            fetch(vacantSummaryButton.dataset.summaryUrl, {
                headers: {"X-Requested-With": "XMLHttpRequest"}
            })
            .then(function (response) {
                return response.json().then(function (payload) {
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.error || "Could not build vacant summary.");
                    }
                    return payload;
                });
            })
            .then(function (payload) {
                window.open(payload.whatsapp_url, "_blank");
            })
            .catch(function (error) {
                alert(error.message);
            })
            .finally(function () {
                vacantSummaryButton.disabled = false;
            });
        });
    }

    function startUnitStatusEdit(span) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";
        const previousValue = span.dataset.currentValue || "vacant";
        const previousHtml = span.innerHTML;
        const select = document.createElement("select");
        select.className = "form-select form-select-sm unit-status-select";
        select.innerHTML = unitStatusOptions.map(function (item) {
            return `<option value="${item.value}" ${item.value === previousValue ? "selected" : ""}>${item.label}</option>`;
        }).join("");
        select.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
        });
        span.replaceWith(select);
        select.focus();
        let finished = false;

        function finish(save) {
            if (finished) return;
            finished = true;
            if (!save) {
                select.replaceWith(span);
                span.dataset.editing = "0";
                return;
            }
            select.disabled = true;
            saveUnitField(span.dataset.unitId, "status", select.value)
                .then(function (payload) {
                    updateStatusBadge(span, payload.value || select.value, payload.new_value);
                    select.replaceWith(span);
                })
                .catch(function (error) {
                    alert(error.message);
                    span.dataset.currentValue = previousValue;
                    span.innerHTML = previousHtml;
                    select.replaceWith(span);
                })
                .finally(function () {
                    span.dataset.editing = "0";
                });
        }

        select.addEventListener("change", function () { finish(true); });
        select.addEventListener("blur", function () { finish(true); });
        select.addEventListener("keydown", function (event) {
            if (event.key === "Escape") finish(false);
            if (event.key === "Enter") finish(true);
        });
    }

    function updateStatusBadge(span, value, label) {
        const option = unitStatusOptions.find(function (item) {
            return item.value === value;
        }) || unitStatusOptions[0];
        span.dataset.currentValue = option.value;
        span.classList.remove("bg-primary", "bg-success", "bg-danger", "bg-warning", "text-dark", "text-wrap");
        span.classList.add(option.badgeClass);
        span.innerHTML = `${escapeHtml(label || option.label)}<i class="fas fa-chevron-down ms-1 unit-status-caret"></i>`;
    }

    function startBuildingTypeEdit(span) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";
        const previousValue = span.dataset.currentValue || "";
        const previousText = span.textContent.trim();
        const select = document.createElement("select");
        select.className = "form-select form-select-sm";
        select.innerHTML = '<option value="">-</option>' + buildingTypeOptions.map(function (item) {
            return `<option value="${item.id}" ${String(item.id) === String(previousValue) ? "selected" : ""}>${escapeHtml(item.name)}</option>`;
        }).join("");
        span.replaceWith(select);
        select.focus();
        let finished = false;

        function finish(save) {
            if (finished) return;
            finished = true;
            if (!save) {
                select.replaceWith(span);
                span.dataset.editing = "0";
                return;
            }
            select.disabled = true;
            saveUnitField(span.dataset.unitId, "building_type", select.value)
                .then(function (payload) {
                    span.dataset.currentValue = select.value;
                    span.textContent = payload.new_value || "-";
                    select.replaceWith(span);
                })
                .catch(function (error) {
                    alert(error.message);
                    span.dataset.currentValue = previousValue;
                    span.textContent = previousText || "-";
                    select.replaceWith(span);
                })
                .finally(function () {
                    span.dataset.editing = "0";
                });
        }

        select.addEventListener("change", function () { finish(true); });
        select.addEventListener("blur", function () { finish(true); });
        select.addEventListener("keydown", function (event) {
            if (event.key === "Escape") finish(false);
        });
    }

    function startUnitTextEdit(span) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";
        const previousText = span.textContent.trim();
        const input = document.createElement("input");
        input.type = "text";
        input.className = "form-control form-control-sm";
        input.value = previousText === "-" ? "" : previousText;
        span.replaceWith(input);
        input.focus();
        input.select();
        let finished = false;

        function finish(save) {
            if (finished) return;
            finished = true;
            if (!save) {
                input.replaceWith(span);
                span.dataset.editing = "0";
                return;
            }
            saveUnitField(span.dataset.unitId, span.dataset.field, input.value)
                .then(function (payload) {
                    span.textContent = payload.new_value || "-";
                    input.replaceWith(span);
                    showBulkUpdateOffer(span, input.value, payload);
                })
                .catch(function (error) {
                    alert(error.message);
                    span.textContent = previousText || "-";
                    input.replaceWith(span);
                })
                .finally(function () {
                    span.dataset.editing = "0";
                });
        }

        input.addEventListener("blur", function () { finish(true); });
        input.addEventListener("keydown", function (event) {
            if (event.key === "Enter") finish(true);
            if (event.key === "Escape") finish(false);
        });
    }

    function showBulkUpdateOffer(span, value, payload) {
        if (!payload.offer_bulk || !bulkModalElement || !bulkMessage) return;
        bulkUpdateContext = {
            unitId: span.dataset.unitId,
            field: span.dataset.field,
            value: value,
            propertyId: String(payload.property_id)
        };
        const fieldLabel = bulkFieldLabels[span.dataset.field] || "value";
        bulkMessage.textContent =
            `The ${fieldLabel} was updated for this unit. Apply ${payload.new_value || "-"} ` +
            `to all ${payload.property_unit_count} units in ${payload.property_name}?`;
        bootstrap.Modal.getOrCreateInstance(bulkModalElement).show();
    }

    function toggleBooleanStatus(span, field) {
        if (span.dataset.editing === "1") return;
        span.dataset.editing = "1";

        const currentValue = span.dataset.currentValue === "true";
        const newValue = !currentValue;

        saveUnitField(span.dataset.unitId, field, newValue ? "true" : "false")
            .then(function () {
                span.dataset.currentValue = newValue ? "true" : "false";
                span.textContent = newValue ? "Yes" : "No";
                span.classList.toggle("bg-success", newValue);
                span.classList.toggle("bg-secondary", !newValue);
            })
            .catch(function (error) {
                alert(error.message);
            })
            .finally(function () {
                span.dataset.editing = "0";
            });
    }

    function saveUnitField(id, field, value, applyToProperty) {
        return fetch("{% url 'properties:unit_inline_update' %}", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-CSRFToken": getCookie("csrftoken"),
                "X-Requested-With": "XMLHttpRequest"
            },
            body: JSON.stringify({
                id: id,
                field: field,
                value: value,
                apply_to_property: Boolean(applyToProperty)
            })
        }).then(function (response) {
            return response.json().then(function (payload) {
                if (!response.ok || !payload.success) {
                    throw new Error(payload.error || "Could not save unit.");
                }
                return payload;
            });
        });
    }

    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== "") {
            const cookies = document.cookie.split(";");
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + "=")) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }

    function escapeHtml(value) {
        return String(value || "").replace(/[&<>"']/g, function (char) {
            return {"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"}[char];
        });
    }

    function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#096;");
    }
});

    
</script>
{% include "properties/includes/vacant_notice_scripts.html" %}
{% endblock %}
