{% extends "base.html" %}
{% load humanize %}

{% block content %}
<div class="container py-3" style="max-width:960px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-1">End Lease Settlement Review</h4>
      <div class="text-muted">Lease #{{ lease.pk }} &middot; {{ lease.tenant.get_full_name }} &middot; {{ lease.unit }}</div>
    </div>
    <a href="{% url 'leases:lease_detail' lease.pk %}" class="btn btn-secondary btn-sm">Back</a>
  </div>

  <div class="alert alert-info py-2">
    Server fallback review is active. This page is shown when the modal JavaScript cannot complete.
  </div>

  <div class="card mb-3">
    <div class="card-header fw-semibold">Invoices after {{ result.end_date }}</div>
    <div class="card-body">
      {% if result.review_invoices %}
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Invoice</th><th>Date</th><th>Status</th><th class="text-end">Amount</th><th></th></tr></thead>
            <tbody>
              {% for invoice in result.review_invoices %}
              <tr>
                <td>#{{ invoice.invoice_number }}</td><td>{{ invoice.issue_date }}</td>
                <td>{{ invoice.get_status_display }}</td><td class="text-end">Rs. {{ invoice.amount|floatformat:2|intcomma }}</td>
                <td><a class="btn btn-sm btn-outline-primary" href="{% url 'invoices:invoice_detail' invoice.pk %}">Detail</a></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="text-muted">No invoices exist after the selected lease end date.</div>
      {% endif %}
    </div>
  </div>

  <div class="card mb-3"><div class="card-body p-0"><table class="table table-sm mb-0">
    <tr><th>Total lease balance</th><th class="text-end">Rs. {{ result.gross_balance|floatformat:2|intcomma }}</th></tr>
    <tr><th>Security applied</th><th class="text-end">Rs. {{ result.security_applied|floatformat:2|intcomma }}</th></tr>
    {% if result.amount_payable > 0 %}<tr class="table-warning"><th>Tenant payable</th><th class="text-end">Rs. {{ result.amount_payable|floatformat:2|intcomma }}</th></tr>
    {% elif result.refund_due > 0 %}<tr class="table-success"><th>Refund due</th><th class="text-end">Rs. {{ result.refund_due|floatformat:2|intcomma }}</th></tr>
    {% else %}<tr class="table-success"><th>Account settled</th><th class="text-end">Rs. 0.00</th></tr>{% endif %}
  </table></div></div>

  <form method="post" action="{% url 'leases:lease_end_action' lease.pk %}" class="d-flex justify-content-end gap-2">
    {% csrf_token %}
    <input type="hidden" name="action" value="confirm">
    <input type="hidden" name="end_date" value="{{ result.end_date|date:'Y-m-d' }}">
    <input type="hidden" name="final_electric_amount" value="{{ form_values.final_electric_amount|default_if_none:'' }}">
    <input type="hidden" name="other_amount" value="{{ form_values.other_amount|default_if_none:'0' }}">
    <input type="hidden" name="other_description" value="{{ form_values.other_description }}">
    <input type="hidden" name="notes" value="{{ form_values.notes }}">
    <input type="hidden" name="future_invoice_action" value="{{ result.future_invoice_action }}">
    {% if form_values.send_whatsapp %}<input type="hidden" name="send_whatsapp" value="1">{% endif %}
    <a href="{% url 'leases:lease_detail' lease.pk %}" class="btn btn-secondary">Cancel</a>
    <button type="submit" class="btn btn-danger">Confirm &amp; End Lease</button>
  </form>
</div>
{% endblock %}
