{% load lease_tags %}

<style>
    .and-separator { display:flex; align-items:center; justify-content:center; width:10%; font-weight:bold; }
    {% if legal_page %}
    @page {
        size: legal;
        margin: 0.55in 0.55in {{ legal_identity_bottom_reserve|default:"3.10" }}in 0.55in;
    }
    @page :first {
        size: legal;
        margin-top: {{ legal_first_page_top_reserve|default:"4.80" }}in;
        margin-left: 0.55in;
        margin-right: 0.55in;
        margin-bottom: 0.55in;
    }
    {% else %}
    @page { size: letter; margin: 0.5in; }
    {% endif %}

    .agreement-preview { font-family:"Times New Roman", Times, serif; text-align:justify; text-justify:inter-word; }
    .text-center, .agreement-title { text-align:center; }
    .agreement-title { margin:0 0 0.16in 0; }
    .agreement-preview p, .agreement-preview .clause { text-align:justify; text-justify:inter-word; }
    .agreement-preview .text-center { text-align:center; }
    .stamp-qr-reserve { display:none; }
    {% if legal_page %}
    @media print {
        .stamp-qr-reserve {
            display:block;
            float:right;
            width:{{ legal_qr_reserve_width|default:"4.00" }}in;
            height:{{ legal_qr_reserve_height|default:"2.00" }}in;
            margin-left:0.18in;
            margin-top:0.12in;
        }
    }
    {% endif %}
    .authorized-occupants-table{width:100%;border-collapse:collapse;margin:6px 0}.authorized-occupants-table td{border:1px solid #777;padding:5px;width:25%;vertical-align:top;font-size:10px;line-height:1.25}
    .signature-section table { margin-bottom: 4px !important; }
    .signature-section td { vertical-align: top; }
    .signature-section p { margin: 0 !important; line-height: 1.05; }
    .signature-section { margin-top: 18px !important; }
    .signature-section .footer { text-align: left !important; margin-top: 4px !important; }
    .clause-initial { float:right; white-space:nowrap; margin-left:10px; font-size:9pt; font-weight:bold; }
</style>

<div id="agreement-doc" class="agreement-preview">

    <h2 class="text-center agreement-title">RENT AGREEMENT</h2>
    <p class="text-center">This RENT AGREEMENT is made at Islamabad on this {{ agreement_date|date:"d-m-Y" }} BETWEEN </p>
    
    <div class="parties-section mt-4">

        <p>
            <strong>{{ lease.unit.property.owner_prefix }} {{ lease.unit.property.owner_name }} {{lease.unit.property.relation}}
             {{lease.unit.property.owner_father_name}}</strong> holding CNIC NO.<strong> {{ lease.unit.property.owner_cnic|format_cnic }}</strong> R/O
        {{ lease.unit.property.owner_address }} (Hereinafter called "Owner") of the <strong>ONE PART. through
         {{ lease.unit.property.caretaker_prefix }} {{ lease.unit.property.caretaker_name }} {{lease.unit.property.caretaker_relation}} 
         {{lease.unit.property.caretaker_father_name}}</strong> holding CNIC NO.<strong> {{ lease.unit.property.caretaker_cnic|format_cnic }}</strong> R/O
        {{ lease.unit.property.caretaker_address }}.
        
        <strong>AND</strong><br>
       
        <strong>{{ lease.tenant.prefix }} {{ lease.tenant.get_full_name_agreement }}</strong> holding CNIC NO. <strong>{{ lease.tenant.cnic|format_cnic }}</strong> R/O
        {{ lease.tenant.address }} (Hereinafter called "Tenant")

        
         <strong>WHEREAS</strong> the Owner is the lawful owner and in possession of 
        <strong>{{ lease.unit.unit_number }}, located at {{ lease.unit.property.full_address }},</strong>
        and has agreed to rent out {{ lease.unit.unit_number }} to the Tenant and the Tenant 
        has also agreed to take the same on the following terms and conditions.
    </p>
    </div>
    
    <div class="clauses-section mt-4">
        
        
        {% for clause in clauses %}
        {% with clause_text=clause.template_text|replace_placeholders:lease %}
            {% if clause.clause_number == 4 %}
            {# ALWAYS show clause 4 #}
            <div class="clause" data-clause-id="{{ clause.id }}">
                <strong>{{ clause.clause_number }}.</strong>
                <span class="clause-text">{{ clause_text|safe }}</span>
                {% if legal_page %}<span class="clause-initial">Tenant Initial: ________</span>{% endif %}
            </div>

            {% elif "SECURITY_INSTALLMENT" in clause.template_text %}
            {% if lease.security_installment_1_amount or lease.security_installment_2_amount %}
                <div class="clause" data-clause-id="{{ clause.id }}">
                <strong>{{ clause.clause_number }}.</strong>
                <span class="clause-text">{{ clause_text|safe }}</span>
                {% if legal_page %}<span class="clause-initial">Tenant Initial: ________</span>{% endif %}
                </div>
            {% endif %}

            {% else %}
            <div class="clause" data-clause-id="{{ clause.id }}">
                <strong>{{ clause.clause_number }}.</strong>
                <span class="clause-text">{{ clause_text|safe }}</span>
                {% if legal_page %}<span class="clause-initial">Tenant Initial: ________</span>{% endif %}
            </div>
            {% endif %}
        {% endwith %}
        {% if clause.clause_number == 2 %}
            <div class="stamp-qr-reserve"></div>
        {% endif %}
        {% endfor %}


    </div>
    
    <div class="signature-section" style="font-family: 'Times New Roman', Times, serif; font-size: 14px;">
    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="width: 50%; padding-right: 20px;">
                <p>_________________________</p>
                <p><strong>Owner:</strong> {{ lease.unit.property.owner_name }}</p>
                <p><strong>CNIC:</strong> {{ lease.unit.property.owner_cnic|format_cnic }}</p>
            </td>
            <td style="width: 50%; padding-left: 20px;">
                <p>_________________________</p>
                <p><strong>Tenant:</strong>  {{ lease.tenant.get_full_name }}</p>
                <p><strong>CNIC:</strong> {{ lease.tenant.cnic|format_cnic }}</p>
            </td>
        </tr>
    </table>

    

    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="width: 50%; padding-right: 20px;">
                <p>_________________________</p>
                <p><strong>Witness 1:</strong> {% if history.witness1_tenant %}{{ history.witness1_tenant.get_full_name }}{% elif lease.witness1_tenant %}{{ lease.witness1_tenant.get_full_name }}{% else %}_________________________{% endif %}</p>
                <p><strong>CNIC:</strong> {% if history.witness1_tenant %}{{ history.witness1_tenant.cnic|format_cnic }}{% elif lease.witness1_tenant %}{{ lease.witness1_tenant.cnic|format_cnic }}{% else %}_________________________{% endif %}</p>
                <p><strong>Phone:</strong> {% if history.witness1_tenant %}{{ history.witness1_tenant.phone|format_phone|default:"_________________________" }}{% elif lease.witness1_tenant %}{{ lease.witness1_tenant.phone|format_phone|default:"_________________________" }}{% else %}_________________________{% endif %}</p>
            </td>
            <td style="width: 50%; padding-left: 20px;">
                <p>_________________________</p>
                <p><strong>Witness 2:</strong> {% if history.witness2_tenant %}{{ history.witness2_tenant.get_full_name }}{% elif lease.witness2_tenant %}{{ lease.witness2_tenant.get_full_name }}{% else %}_________________________{% endif %}</p>
                <p><strong>CNIC:</strong> {% if history.witness2_tenant %}{{ history.witness2_tenant.cnic|format_cnic }}{% elif lease.witness2_tenant %}{{ lease.witness2_tenant.cnic|format_cnic }}{% else %}_________________________{% endif %}</p>
                <p><strong>Phone:</strong> {% if history.witness2_tenant %}{{ history.witness2_tenant.phone|format_phone|default:"_________________________" }}{% elif lease.witness2_tenant %}{{ lease.witness2_tenant.phone|format_phone|default:"_________________________" }}{% else %}_________________________{% endif %}</p>
            </td>
        </tr>
    </table>

    <div class="footer" style="text-align: center; margin-top: 15px;">
        <p>Generated at: {% now "d M Y" %}.</p>
    </div>
    </div>
</div>
