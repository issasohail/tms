{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const form = document.getElementById('historyInlineForm');
  if (!form) return;

  const status = document.getElementById('historyInlineStatus');
  const cells = Array.from(form.querySelectorAll('.lh-inline-cell'));
  const totalChip = document.getElementById('historyDetailTotalChip');
  const totalRow = document.getElementById('historyDetailTotalMonthly');
  let activeCell = null;
  let saving = false;

  function setStatus(message, isError) {
    status.textContent = message || '';
    status.classList.toggle('text-danger', Boolean(isError));
    status.classList.toggle('text-success', Boolean(message && !isError));
  }

  function money(value) {
    const amount = Number.parseFloat(value);
    return 'Rs. ' + new Intl.NumberFormat('en-US', {maximumFractionDigits: 0}).format(Number.isFinite(amount) ? amount : 0);
  }

  function formattedDate(value) {
    if (!value) return '—';
    const parts = value.split('-').map(Number);
    if (parts.length !== 3 || parts.some(Number.isNaN)) return value;
    return new Intl.DateTimeFormat('en-US', {month: 'short', day: '2-digit', year: 'numeric'}).format(
      new Date(parts[0], parts[1] - 1, parts[2])
    );
  }

  function editorFor(cell) {
    return cell.querySelector('.lh-inline-editor input, .lh-inline-editor select, .lh-inline-editor textarea');
  }

  function displayValue(cell) {
    const editor = editorFor(cell);
    const type = cell.dataset.displayType;
    if (!editor) return '—';
    if (type === 'currency') return money(editor.value);
    if (type === 'date') return formattedDate(editor.value);
    if (type === 'checkbox') return editor.checked ? 'Yes' : 'No';
    if (type === 'select') return editor.selectedOptions[0]?.value ? editor.selectedOptions[0].text : '—';
    return editor.value.trim() || '—';
  }

  function updateTotal() {
    const total = ['monthly_rent', 'society_maintenance', 'water_charges', 'internet_charges'].reduce(function (sum, name) {
      const value = Number.parseFloat(form.elements[name]?.value);
      return sum + (Number.isFinite(value) ? value : 0);
    }, 0);
    const label = money(total);
    if (totalChip) totalChip.textContent = label;
    if (totalRow) totalRow.textContent = label;
  }

  function closeCell(cell, updateDisplay) {
    if (!cell) return;
    if (updateDisplay) cell.querySelector('.lh-inline-display').textContent = displayValue(cell);
    cell.classList.remove('is-editing');
    if (activeCell === cell) activeCell = null;
  }

  function beginEdit(cell) {
    if (saving || cell.classList.contains('is-editing')) return;
    if (activeCell && activeCell !== cell) {
      saveCell(activeCell).then(function (saved) { if (saved) beginEdit(cell); });
      return;
    }
    activeCell = cell;
    cell.classList.add('is-editing');
    const editor = editorFor(cell);
    if (!editor) return;
    if (editor.tagName === 'SELECT' && window.jQuery && jQuery.fn.select2) {
      const $editor = jQuery(editor);
      if (!$editor.hasClass('select2-hidden-accessible')) {
        $editor.select2({theme: 'bootstrap-5', width: '100%', allowClear: true});
      }
      $editor.select2('open');
    } else {
      editor.focus();
      if (editor.select && editor.type !== 'date') editor.select();
    }
  }

  async function saveCell(cell) {
    if (!cell || saving) return false;
    saving = true;
    setStatus('Saving…', false);
    const data = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'X-CSRFToken': data.get('csrfmiddlewaretoken') || '',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: data
      });
      const result = await response.json();
      if (!response.ok || !result.ok) {
        const fieldErrors = result.errors?.[cell.dataset.inlineField] || [];
        throw new Error(fieldErrors[0]?.message || result.message || 'Could not save lease history.');
      }
      closeCell(cell, true);
      updateTotal();
      const updated = document.getElementById('historyUpdatedAt');
      if (updated && result.updated_at) updated.textContent = result.updated_at + ' by {{ request.user|escapejs }}';
      setStatus('Saved', false);
      window.setTimeout(function () { if (status.textContent === 'Saved') status.textContent = ''; }, 1400);
      return true;
    } catch (error) {
      setStatus(error.message, true);
      editorFor(cell)?.focus();
      return false;
    } finally {
      saving = false;
    }
  }

  cells.forEach(function (cell) {
    const display = cell.querySelector('.lh-inline-display');
    const editor = editorFor(cell);
    display.addEventListener('click', function () { beginEdit(cell); });
    display.addEventListener('keydown', function (event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        beginEdit(cell);
      }
    });
    if (!editor) return;
    if (['monthly_rent', 'society_maintenance', 'water_charges', 'internet_charges'].includes(cell.dataset.inlineField)) {
      editor.addEventListener('input', updateTotal);
    }
    if (editor.type === 'checkbox' || editor.tagName === 'SELECT') {
      editor.addEventListener('change', function () { saveCell(cell); });
      editor.addEventListener('blur', function () {
        window.setTimeout(function () {
          if (cell.classList.contains('is-editing') && !saving) saveCell(cell);
        }, 120);
      });
      if (editor.tagName === 'SELECT' && window.jQuery) {
        jQuery(editor).off('select2:close.historyInline').on('select2:close.historyInline', function () {
          window.setTimeout(function () {
            if (cell.classList.contains('is-editing') && !saving) saveCell(cell);
          }, 120);
        });
      }
    } else {
      editor.addEventListener('blur', function () {
        window.setTimeout(function () {
          if (cell.classList.contains('is-editing') && !cell.querySelector('.lh-inline-editor').contains(document.activeElement)) {
            saveCell(cell);
          }
        }, 120);
      });
      editor.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeCell(cell, false);
        } else if (event.key === 'Enter' && editor.tagName !== 'TEXTAREA') {
          event.preventDefault();
          saveCell(cell);
        } else if (event.key === 'Enter' && editor.tagName === 'TEXTAREA' && (event.ctrlKey || event.metaKey)) {
          event.preventDefault();
          saveCell(cell);
        }
      });
    }
  });

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    if (activeCell) saveCell(activeCell);
  });
  updateTotal();
});
</script>
{% endblock %}
