{% extends 'base.html' %}

{% block title %}{{ property.property_name }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>{{ property.property_name }}</h2>
    <div>
        <button class="btn btn-outline-secondary me-2" onclick="history.back()">Go Back</button>
        <a href="{% url 'properties:property_update' property.pk %}" class="btn btn-secondary me-2">Edit</a>
        <a href="{% url 'properties:property_media' property.pk %}" class="btn btn-outline-primary me-2">Photos</a>
        <a href="{% url 'properties:property_delete' property.pk %}" class="btn btn-danger">Delete</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Property Details</h5>
        <p class="card-text"><strong>Address:</strong>
            {{ property.property_address1 }},
            {{ property.property_address2 }},
            {{ property.property_city }},
            {{ property.property_state }} {{ property.property_zipcode }}
        </p>
        <div class="row g-2 small mb-2">
            <div class="col-6 col-md-3">
                <div class="border rounded p-2 h-100">
                    <div class="text-muted">Actual Units</div>
                    <div class="fw-bold">{{ actual_total_units }}</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="border rounded p-2 h-100">
                    <div class="text-muted">Configured Units</div>
                    <div class="fw-bold">{{ configured_total_units }}</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="border rounded p-2 h-100">
                    <div class="text-muted">Occupied</div>
                    <div class="fw-bold text-success">{{ occupied_units_count }}</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="border rounded p-2 h-100">
                    <div class="text-muted">Vacant</div>
                    <div class="fw-bold text-warning">{{ vacant_units_count }}</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="border rounded p-2 h-100">
                    <div class="text-muted">Maintenance</div>
                    <div class="fw-bold text-info">{{ maintenance_units_count }}</div>
                </div>
            </div>
        </div>
        {% if property.description %}
        <p class="card-text"><strong>Description:</strong> {{ property.description }}</p>
        {% endif %}
        <div class="row g-2 small mt-2">
            <div class="col-12 col-md-6">
                <div class="border rounded p-2 h-100">
                    <div class="fw-bold mb-1">Owner Information</div>
                    {% if property.owner_photo %}
                        <a href="{{ property.owner_photo.url }}" target="_blank" class="d-inline-block mb-2">
                            <img src="{{ property.owner_photo.url }}" alt="Owner photo" class="rounded border" style="width:80px;height:80px;object-fit:cover;">
                        </a>
                    {% endif %}
                    <div><strong>Name:</strong> {{ property.owner_name|default:"-" }}</div>
                    <div><strong>Father Name:</strong> {{ property.owner_father_name|default:"-" }}</div>
                    <div><strong>CNIC:</strong> {{ property.owner_cnic|format_cnic|default:"-" }}</div>
                    <div><strong>Phone:</strong> {{ property.owner_phone|format_phone|default:"-" }}</div>
                    <div><strong>Address:</strong> {{ property.owner_address|default:"-" }}</div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="border rounded p-2 h-100">
                    <div class="fw-bold mb-1">Police Verification Address</div>
                    <div><strong>House #:</strong> {{ property.house_no|default:"-" }}</div>
                    <div><strong>Street #:</strong> {{ property.street_no|default:"-" }}</div>
                    <div><strong>Colony:</strong> {{ property.colony|default:"-" }}</div>
                    <div><strong>Road:</strong> {{ property.road|default:"-" }}</div>
                    <div><strong>Covered Area Type:</strong> {{ property.covered_area_type|default:"-" }}</div>
                    <div><strong>Police Station:</strong> {{ property.police_station|default:"-" }}</div>
                    <div><strong>Division:</strong> {{ property.police_division|default:"-" }}</div>
                    <div><strong>Circle:</strong> {{ property.police_circle|default:"-" }}</div>
                    <div><strong>Zila:</strong> {{ property.zila|default:"-" }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Property / Building Photos</h5>
        <a href="{% url 'properties:property_media' property.pk %}" class="btn btn-sm btn-primary">Manage Photos</a>
    </div>
    <div class="card-body">
        {% if media_files %}
            <div class="row g-2">
                {% for media in media_files %}
                    <div class="col-6 col-md-2">
                        {% if media.file_type == "image" %}
                            <a href="{{ media.display_url }}" target="_blank" rel="noopener">
                                <img src="{% if media.thumbnail %}{{ media.thumbnail.url }}{% else %}{{ media.display_url }}{% endif %}" class="img-fluid rounded border" alt="{{ media.description|default:media.original_filename }}" style="height:90px; width:100%; object-fit:cover;">
                            </a>
                        {% else %}
                            <a href="{{ media.file.url }}" target="_blank" rel="noopener" class="d-flex align-items-center justify-content-center border rounded text-decoration-none small" style="height:90px;">
                                {{ media.get_file_type_display }}
                            </a>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted mb-0">No photos uploaded.</p>
        {% endif %}
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Inventory</h5>
                <a href="{% url 'leases:inventory_manage' 'property' property.pk %}" class="btn btn-sm btn-outline-primary">Manage</a>
            </div>
            <div class="card-body py-2">
                {% for item in effective_inventory %}
                    <span class="badge bg-light text-dark border me-1 mb-1">{{ item.item.name }}: {{ item.quantity }}</span>
                {% empty %}<span class="text-muted">No inventory configured.</span>{% endfor %}
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Motorcycle Parking</h5>
                <a href="{% url 'leases:parking_manage' 'property' property.pk %}" class="btn btn-sm btn-outline-primary">Manage</a>
            </div>
            <div class="card-body py-2 small">
                <strong>{% if parking_enabled %}Enabled{% else %}Disabled{% endif %}</strong>
                &middot; Rs. {{ parking_monthly_rate|floatformat:0 }}/month
                &middot; Rs. {{ parking_penalty|floatformat:0 }} penalty
                {% if parking_spaces %}<div class="mt-1">{% for space in parking_spaces %}<span class="badge bg-secondary me-1">{{ space.label }}</span>{% endfor %}</div>{% endif %}
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5>Units</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>S.N #</th>
                        <th>Unit Number</th>
                        <th>Size</th>
                        <th>Bed/Bath</th>
                        <th>Monthly Rent</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for unit in units %}
                    <tr>
                        <td>{{ forloop.counter}}</td>
                        <td>{{ unit.unit_number }}</td>
                        <td>{{ unit.size }}</td>
                        <td>{{ unit.bedrooms }}BR/{{ unit.bathrooms }}BA</td>
                        <td>{{ unit.monthly_rent|money:2 }}</td>
                        <td>
                            {% if unit.has_ending_soon_lease_history or unit.has_ending_soon_lease %}
                                <span class="badge bg-warning text-dark text-wrap" style="line-height:1.2;">
                                    <strong>Ending Soon</strong><br>
                                    <small>{{ unit.active_lease_history_end_date|default:unit.active_lease_end_date|date:"M d, Y" }}</small>
                                </span>
                            {% elif unit.has_active_lease_history or unit.has_active_lease %}
                                <span class="badge bg-success">Occupied</span>
                            {% elif unit.status == "maintenance" %}
                                <span class="badge bg-danger">Maintenance</span>
                            {% else %}
                                <span class="badge bg-primary">Vacant</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{% url 'properties:unit_detail' unit.pk %}" class="btn btn-sm btn-primary">View</a>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="6">No units found</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
