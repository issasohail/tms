                 placeholder="Reason for reopening the lease">
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-danger">Rollback &amp; Re-open End Lease</button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endif %}

