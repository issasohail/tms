<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
(function () {
  const rows = document.getElementById("familyMemberRows");
  const template = document.getElementById("familyMemberTemplate");
  const addButton = document.getElementById("addFamilyMember");

  function renumber() {
    rows.querySelectorAll(".family-member-card").forEach(function (card, index) {
      const num = card.querySelector(".member-num");
      if (num) num.textContent = index + 1;
      card.querySelectorAll("[data-field]").forEach(function (field) {
        field.name = "family-" + index + "-" + field.dataset.field;
      });
    });
  }

  if (rows && template && addButton) {
    addButton.addEventListener("click", function () {
      rows.appendChild(template.content.cloneNode(true));
      renumber();
    });
    rows.addEventListener("click", function (event) {
      const remove = event.target.closest(".remove-family-member");
      if (!remove) return;
      remove.closest(".family-member-card").remove();
      renumber();
    });
  }

  const vehicleRows = document.getElementById("vehicleRows");
  const vehicleTemplate = document.getElementById("vehicleTemplate");
  const addVehicleButton = document.getElementById("addVehicle");
  const vehicleTotalForms = document.getElementById("vehicleTotalForms");

  function renumberVehicles() {
    if (!vehicleRows) return;
    const cards = vehicleRows.querySelectorAll(".vehicle-row-card");
    cards.forEach(function (card, index) {
      const num = card.querySelector(".vehicle-num");
      if (num) num.textContent = index + 1;
      card.querySelectorAll("[data-vehicle-field]").forEach(function (field) {
        field.name = "vehicle-" + index + "-" + field.dataset.vehicleField;
      });
      const removeButton = card.querySelector(".remove-vehicle");
      if (removeButton) removeButton.style.display = cards.length <= 1 ? "none" : "inline-flex";
    });
    if (vehicleTotalForms) vehicleTotalForms.value = cards.length;
  }

  if (vehicleRows && vehicleTemplate && addVehicleButton) {
    addVehicleButton.addEventListener("click", function () {
      vehicleRows.appendChild(vehicleTemplate.content.cloneNode(true));
      renumberVehicles();
    });
    vehicleRows.addEventListener("click", function (event) {
      const remove = event.target.closest(".remove-vehicle");
      if (!remove) return;
      const cards = vehicleRows.querySelectorAll(".vehicle-row-card");
      if (cards.length <= 1) return;
      remove.closest(".vehicle-row-card").remove();
      renumberVehicles();
    });
    renumberVehicles();
  }

  document.querySelectorAll(".image-upload-container input[type='file']").forEach(function (input) {
    input.addEventListener("change", function () {
      const file = input.files && input.files[0];
      if (!file) return;
      const container = input.closest(".image-upload-container");
      const reader = new FileReader();
      reader.onload = function (event) {
        let preview = container.querySelector("img.public-file-preview");
        const placeholder = container.querySelector(".placeholder-icon");
        if (!preview) {
          preview = document.createElement("img");
          preview.className = "public-file-preview";
          preview.style.cssText = "width:100%;height:100%;object-fit:cover;position:absolute;inset:0;";
          if (placeholder) placeholder.replaceWith(preview);
          else container.insertBefore(preview, container.firstChild);
        }
        preview.src = event.target.result;
      };
      reader.readAsDataURL(file);
    });
  });

  document.querySelectorAll(".public-tenant-page input:not([type='checkbox']):not([type='radio']):not([type='file']), .public-tenant-page select, .public-tenant-page textarea").forEach(function(el) {
    if (!el.classList.contains("field-control")) el.classList.add("field-control");
  });
  document.querySelectorAll(".td-address-grid textarea").forEach(function(el) { el.setAttribute("rows", "5"); });

  const registrationForm = document.getElementById("tenantRegistrationForm");
  if (registrationForm) {
    registrationForm.addEventListener("submit", function () {
      document.querySelectorAll('#tenantRegistrationForm button[type="submit"], #tenantRegistrationForm input[type="submit"], [form="tenantRegistrationForm"][type="submit"]').forEach(function (button) {
        button.disabled = true;
        button.setAttribute("aria-disabled", "true");
      });
    });
  }

  function smartTitle(value) {
    const keep = new Set(["USA", "UAE", "UK", "USD", "CAD", "EUR", "PKR"]);
    return (value || "").trim().replace(/\s+/g, " ").replace(/[A-Za-z]+/g, function(word) {
      const upper = word.toUpperCase();
      if (keep.has(upper)) return upper;
      const lower = word.toLowerCase();
      if (lower.startsWith("mc") && lower.length > 2) return "Mc" + lower.charAt(2).toUpperCase() + lower.slice(3);
      return lower.charAt(0).toUpperCase() + lower.slice(1);
    });
  }

  document.addEventListener("blur", function(event) {
    const el = event.target;
    if (!el || !el.classList || !el.classList.contains("auto-titlecase")) return;
    el.value = smartTitle(el.value);
  }, true);
})();
</script>
