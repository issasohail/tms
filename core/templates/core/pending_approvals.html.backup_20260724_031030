{% extends "base.html" %}
{% block title %}Pending Approvals{% endblock %}
{% block content %}
<style>
  .pending-approval-table {
    table-layout: fixed;
  }
  .pending-approval-table th,
  .pending-approval-table td {
    vertical-align: middle;
  }
  .pending-created { width: 104px; }
  .pending-phone { width: 152px; }
  .pending-photo { width: 54px; }
  .pending-attachment { width: 118px; }
  .pending-move { width: 145px; }
  .pending-tenant { width: 135px; }
  .pending-property { width: 168px; }
  .pending-status { width: 122px; }
  .pending-handyman { width: 150px; }
  .pending-details { width: 160px; }
  .pending-maintenance-details { width: 175px; }
  .pending-review { width: 174px; }
  .pending-created-date,
  .pending-created-time { display: block; }
  .pending-created-time { color: #6c757d; font-size: .72rem; }
  .pending-nowrap {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pending-status-line,
  .pending-review-line {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    white-space: nowrap;
  }
  .pending-family-photo {
    width: 34px;
    height: 34px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid #d8dee6;
    background: #f3f4f6;
  }
  .pending-attachment-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .3rem;
  }
  .pending-attachment-thumb,
  .pending-attachment-video {
    width: 52px;
    height: 42px;
    object-fit: cover;
    border: 1px solid #d8dee6;
    border-radius: .3rem;
    background: #f3f4f6;
  }
  .pending-move-form {
    display: flex;
    align-items: center;
    gap: .3rem;
  }
  .pending-move-form .form-select {
    min-width: 0;
    font-size: .7rem;
  }
  .pending-maintenance-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    align-items: center;
    gap: .25rem .35rem;
  }
  .pending-maintenance-actions .pending-approval-action {
    display: contents !important;
  }
  .pending-maintenance-actions .btn {
    font-size: .65rem;
  }
  .pending-approval-feedback {
    position: fixed;
    top: 72px;
    right: 18px;
    z-index: 1080;
    max-width: 420px;
  }
  .pending-filter-card .form-label {
    font-size: .75rem;
    margin-bottom: .2rem;
    color: #5f6670;
  }
  .pending-filter-actions {
    padding-top: 1.35rem;
  }
  @media (max-width: 991.98px) {
    .pending-filter-actions { padding-top: 0; }
    .table-responsive { overflow-x: visible; }
    .pending-approval-table,
    .pending-approval-table tbody {
      display: block;
      width: 100%;
    }
    .pending-approval-table thead { display: none; }
    .pending-approval-table tr[data-pending-row] {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: .5rem;
      border: 1px solid #d8dee6;
      border-radius: .5rem;
      overflow: hidden;
      background: var(--bs-body-bg, #fff);
      box-shadow: 0 1px 3px rgba(0, 0, 0, .05);
    }
    .pending-approval-table tr[data-pending-row] > td {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
      width: auto !important;
      padding: .4rem .5rem;
      border: 0;
      border-bottom: 1px solid #edf0f3;
    }
    .pending-approval-table tr[data-pending-row] > td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: .14rem;
      color: #6c757d;
      font-size: .63rem;
      font-weight: 700;
      line-height: 1;
      text-transform: uppercase;
    }
    .pending-approval-table .pending-details,
    .pending-approval-table .pending-handyman,
    .pending-approval-table .pending-attachment,
    .pending-approval-table .pending-move {
      grid-column: 1 / -1;
    }
    .pending-approval-table .pending-status,
    .pending-approval-table .pending-review {
      min-height: 70px;
    }
    .pending-status-line,
    .pending-review-line { flex-wrap: wrap; }
    .pending-maintenance-actions {
      grid-template-columns: repeat(2, minmax(58px, max-content));
    }
    .pending-empty-row,
    .pending-empty-row > td {
      display: block;
      width: 100%;
    }
  }
  @media (max-width: 575.98px) {
    .container-fluid.py-3 { padding-left: .5rem; padding-right: .5rem; }
    .pending-approval-table tr[data-pending-row] { margin: .4rem; }
    .pending-approval-table tr[data-pending-row] > td { padding: .35rem .4rem; }
    .pending-review-line .btn { padding: .2rem .4rem; font-size: .72rem; }
  }
</style>
<div class="container-fluid py-3" style="max-width:1400px;">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
      <h4 class="mb-0">Pending Approvals</h4>
      <div class="text-muted small">Review current pending items or search previous approval records.</div>
    </div>
  </div>

  <div class="card shadow-sm pending-filter-card mb-3">
    <div class="card-body py-2">
      <form method="get" class="row g-2 align-items-end" id="pendingApprovalFilters">
        <div class="col-12 col-lg-3">
          <label class="form-label" for="approvalSearch">Search anywhere</label>
          <input class="form-control form-control-sm" id="approvalSearch" name="q" type="search" value="{{ approval_filters.search }}" placeholder="Phone, tenant, property, unit, reference..." autocomplete="off">
        </div>
        <div class="col-6 col-sm-6 col-lg-2">
          <label class="form-label" for="approvalType">Approval Type</label>
          <select class="form-select form-select-sm" id="approvalType" name="approval_type">
            {% for value, label in approval_type_choices %}
              <option value="{{ value }}" {% if approval_filters.approval_type == value %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-6 col-sm-6 col-lg-2">
          <label class="form-label" for="approvalProperty">Property</label>
          <select class="form-select form-select-sm pending-select2" id="approvalProperty" name="property" data-placeholder="All Properties">
            <option value="">All Properties</option>
            {% for property in filter_properties %}
              <option value="{{ property.pk }}" {% if approval_filters.property_id == property.pk %}selected{% endif %}>{{ property.property_name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-6 col-sm-6 col-lg-2">
          <label class="form-label" for="approvalUnit">Unit</label>
          <select class="form-select form-select-sm pending-select2" id="approvalUnit" name="unit" data-placeholder="All Units">
            <option value="">All Units</option>
            {% for unit in filter_units %}
              <option value="{{ unit.pk }}" {% if approval_filters.unit_id == unit.pk %}selected{% endif %}>{{ unit.property.property_name }} / {{ unit.unit_number }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-6 col-sm-6 col-lg-2">
          <label class="form-label" for="approvalStatus">Status</label>
          <select class="form-select form-select-sm" id="approvalStatus" name="status">
            {% for value, label in status_choices %}
              <option value="{{ value }}" {% if approval_filters.status == value %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-6 col-sm-6 col-lg-2">
          <label class="form-label" for="approvalDateRange">Date</label>
          <select class="form-select form-select-sm" id="approvalDateRange" name="date_range">
            {% for value, label in date_range_choices %}
              <option value="{{ value }}" {% if approval_filters.date_range == value %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-6 col-sm-6 col-lg-2 pending-custom-date">
          <label class="form-label" for="approvalDateFrom">From</label>
          <input class="form-control form-control-sm" id="approvalDateFrom" name="date_from" type="date" value="{{ approval_filters.date_from_value }}">
        </div>
        <div class="col-6 col-sm-6 col-lg-2 pending-custom-date">
          <label class="form-label" for="approvalDateTo">To</label>
          <input class="form-control form-control-sm" id="approvalDateTo" name="date_to" type="date" value="{{ approval_filters.date_to_value }}">
        </div>
        <div class="col-12 col-lg-auto pending-filter-actions d-flex gap-2">
          <button class="btn btn-sm btn-primary" type="submit">Apply Filters</button>
          <a class="btn btn-sm btn-outline-secondary" href="{% url 'core:pending_approvals' %}">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <div class="row g-3">
    {% for section in visible_sections %}
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-header py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="fw-semibold">{{ section.title }} <span class="badge bg-warning text-dark pending-section-count">{{ section.count }}</span></div>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0 pending-approval-table">
              <thead class="table-light">
                <tr>
                  <th style="width:44px;">SN</th>
                  <th class="pending-created">Created</th>
                  <th class="pending-phone">Phone</th>
                  {% if section.kind == "family" %}<th class="pending-photo">Photo</th>{% endif %}
                  {% if section.kind == "media" %}<th class="pending-attachment">Attachment</th>{% endif %}
                  <th class="pending-tenant">Tenant</th>
                  <th class="pending-property">Property / Unit</th>
                  <th class="pending-details {% if section.kind == 'maintenance' %}pending-maintenance-details{% endif %}">Details</th>
                  {% if section.kind == "maintenance" %}<th class="pending-handyman">Handyman</th>{% endif %}
                  <th class="pending-status">Status</th>
                  {% if section.kind == "media" %}<th class="pending-move">Move To</th>{% endif %}
                  <th class="pending-review">Review</th>
                </tr>
              </thead>
              <tbody>
                {% for row in section.items %}
                  {% with item=row.object %}
                  <tr data-pending-row>
                    <td class="pending-sn" data-label="SN">{{ forloop.counter }}</td>
                    {% if section.kind == "registration" %}
                      <td class="pending-nowrap pending-created" data-label="Created" title="{{ item.submitted_at|date:'M d, Y H:i' }}">
                        <span class="pending-created-date">{{ item.submitted_at|date:"M d, Y" }}</span>
                        <span class="pending-created-time">{{ item.submitted_at|date:"H:i" }}</span>
                      </td>
                      <td class="pending-nowrap pending-phone" data-label="Phone" title="{{ item.tenant.phone|format_phone:GLOBAL_SETTINGS.country_code|default:'-' }}">
                        {% with wa_number=item.tenant.phone|whatsapp_phone_digits:GLOBAL_SETTINGS.country_code %}
                          {% if wa_number %}<a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener" title="Send WhatsApp message">{{ item.tenant.phone|format_phone:GLOBAL_SETTINGS.country_code }}</a>{% else %}-{% endif %}
                        {% endwith %}
                      </td>
                    {% else %}
                      <td class="pending-nowrap pending-created" data-label="Created" title="{{ item.created_at|date:'M d, Y H:i' }}">
                        <span class="pending-created-date">{{ item.created_at|date:"M d, Y" }}</span>
                        <span class="pending-created-time">{{ item.created_at|date:"H:i" }}</span>
                      </td>
                      <td class="pending-nowrap pending-phone" data-label="Phone" title="{{ item.phone|format_phone:GLOBAL_SETTINGS.country_code|default:'-' }}">
                        {% with wa_number=item.phone|whatsapp_phone_digits:GLOBAL_SETTINGS.country_code %}
                          {% if wa_number %}<a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener" title="Send WhatsApp message">{{ item.phone|format_phone:GLOBAL_SETTINGS.country_code }}</a>{% else %}-{% endif %}
                        {% endwith %}
                      </td>
                    {% endif %}
                    {% if section.kind == "family" %}
                      <td class="pending-photo" data-label="Photo">
                        {% if item.photo %}
                          <a href="{{ row.urls.photo }}" target="_blank"><img src="{{ row.urls.photo }}" class="pending-family-photo" alt=""></a>
                        {% else %}
                          <span class="text-muted small">-</span>
                        {% endif %}
                      </td>
                    {% endif %}
                    {% if section.kind == "media" %}
                      <td class="pending-attachment" data-label="Attachment">
                        <div class="pending-attachment-list">
                          {% for preview in row.media_previews %}
                            {% if preview.preview_kind == "image" %}
                              <a href="{{ preview.file_url }}" target="_blank" rel="noopener" title="{{ preview.filename }}">
                                <img src="{{ preview.file_url }}" class="pending-attachment-thumb" alt="{{ preview.filename }}">
                              </a>
                            {% elif preview.preview_kind == "video" %}
                              <video src="{{ preview.file_url }}" class="pending-attachment-video" controls preload="metadata" title="{{ preview.filename }}"></video>
                            {% elif preview.preview_kind == "pdf" %}
                              <a href="{{ preview.file_url }}" target="_blank" rel="noopener" class="btn btn-xs btn-outline-danger py-1 px-2" title="{{ preview.filename }}">PDF</a>
                            {% elif preview.file_url %}
                              <a href="{{ preview.file_url }}" target="_blank" rel="noopener" class="btn btn-xs btn-outline-primary py-1 px-2" title="{{ preview.filename }}">Open</a>
                            {% endif %}
                          {% empty %}
                            <span class="text-muted small">No file</span>
                          {% endfor %}
                        </div>
                      </td>
                    {% endif %}
                    <td class="pending-nowrap pending-tenant" data-label="Tenant" title="{% if item.tenant %}{{ item.tenant }}{% elif item.lease %}{{ item.lease.tenant }}{% else %}-{% endif %}">
                      {% if item.tenant %}{{ item.tenant|truncatechars:15 }}{% elif item.lease %}{{ item.lease.tenant|truncatechars:15 }}{% else %}-{% endif %}
                    </td>
                    <td class="pending-nowrap pending-property" data-label="Property / Unit" title="{{ row.property_unit_label }}">
                      {{ row.property_unit_label }}
                    </td>
                    <td class="pending-details {% if section.kind == 'maintenance' %}pending-maintenance-details{% endif %}" data-label="Details">
                      {% if item.amount %}Rs. {{ item.amount }}{% endif %}
                      {% if item.issue_type %}{{ item.issue_type }}{% endif %}
                      {% if item.purpose %}{{ item.get_purpose_display }}{% endif %}
                      {% if item.target_kind %}<span class="badge bg-info text-dark ms-1">{{ item.get_target_kind_display }}</span>{% endif %}
                      {% if item.pending_group_count > 1 %}<span class="badge bg-primary ms-1">{{ item.pending_group_count }} linked files</span>{% endif %}
                      {% if item.submitted_by_staff %}<span class="text-muted small d-block">Submitted by {{ item.submitted_by_staff.get_username }}</span>{% endif %}
                      {% if item.proposed_terms %}<span class="text-muted">{{ item.proposed_terms|truncatechars:90 }}</span>{% endif %}
                      {% if item.monthly_rent %}Rent: Rs. {{ item.monthly_rent }}{% endif %}
                      {% if item.description %}<span class="text-muted">{{ item.description|truncatechars:90 }}</span>{% endif %}
                      {% if section.kind == "family" %}
                        <span class="badge {% if item.action == 'remove' %}bg-danger{% else %}bg-primary{% endif %} me-1">{{ item.get_action_display }}</span>
                        {{ item.first_name }} {{ item.last_name }}
                        {% if item.relationship_type %}<span class="text-muted">({{ item.relationship_type.name }})</span>{% endif %}
                      {% endif %}
                      {% if section.kind == "police" %}
                        <span class="badge bg-info text-dark me-1">{{ item.get_source_display }}</span>
                        {{ item.original_filename|default:item.file.name|truncatechars:60 }}
                      {% endif %}
                      {% if section.kind == "registration" %}
                        Tenant profile update
                        {% with people_count=item.pending_people.count %}
                          {% if people_count %}<span class="badge bg-info text-dark ms-1">{{ people_count }} family/person update{{ people_count|pluralize }}</span>{% endif %}
                        {% endwith %}
                      {% endif %}
                    </td>
                    {% if section.kind == "maintenance" %}
                      <td class="pending-handyman" data-label="Handyman">
                        <select name="handyman" form="maintenance-approval-{{ item.pk }}" class="form-select form-select-sm" aria-label="Assign handyman">
                          <option value="">Select handyman</option>
                          {% for handyman in active_handymen %}
                            <option value="{{ handyman.pk }}">{{ handyman.full_name }}{% if handyman.is_preferred %} ★{% endif %}</option>
                          {% endfor %}
                        </select>
                      </td>
                    {% endif %}
                    <td class="pending-status" data-label="Status">
                      <div class="{% if section.kind == 'maintenance' %}pending-maintenance-actions{% else %}pending-status-line{% endif %}">
                        <span class="badge {% if item.status == 'approved' or item.status == 'active' %}bg-success{% elif item.status == 'rejected' %}bg-danger{% elif item.status == 'pending' or item.status == 'pending_approval' or item.status == 'confirmed' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">{{ item.get_status_display }}</span>
                        {% if section.kind != "registration" and item.status == "pending" or section.kind != "registration" and item.status == "pending_approval" or section.kind != "registration" and item.status == "confirmed" %}
                          <form method="post" action="{{ row.urls.approve }}" class="d-inline pending-approval-action" data-action="approve" {% if section.kind == "maintenance" %}id="maintenance-approval-{{ item.pk }}"{% endif %}>
                            {% csrf_token %}
                            {% if section.kind == "maintenance" %}
                              <button type="submit" name="notify_mode" value="" class="btn btn-xs btn-success py-0 px-1">Approve</button>
                              <button type="submit" name="notify_mode" value="api" class="btn btn-xs btn-success py-0 px-1">API</button>
                              <button type="submit" name="notify_mode" value="manual" class="btn btn-xs btn-outline-success py-0 px-1">Manual</button>
                            {% else %}
                              <button type="submit" class="btn btn-xs btn-success py-0 px-1">Approve</button>
                            {% endif %}
                          </form>
                        {% endif %}
                      </div>
                    </td>
                    {% if section.kind == "media" %}
                      <td class="pending-move" data-label="Move To">
                        {% if item.status == "pending" %}
                          <form method="post" action="{{ row.urls.approve }}" class="pending-approval-action pending-move-form" data-action="move">
                            {% csrf_token %}
                            <select name="media_destination" class="form-select form-select-sm" aria-label="Move media to">
                              <option value="maintenance">Maintenance</option>
                              <option value="payment_receipt">WhatsApp Payments</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Move</button>
                          </form>
                        {% else %}
                          <span class="text-muted small">Reviewed</span>
                        {% endif %}
                      </td>
                    {% endif %}
                    <td class="pending-review" data-label="Review">
                      <div class="pending-review-line">
                      <a class="btn btn-sm btn-outline-primary" href="{{ row.urls.detail }}">{% if section.kind == "registration" %}Review{% else %}Detail{% endif %}</a>
                      {% if section.kind != "registration" and item.status == "pending" or section.kind != "registration" and item.status == "pending_approval" or section.kind != "registration" and item.status == "confirmed" %}
                        <form method="post" action="{{ row.urls.reject }}" class="d-inline pending-approval-action" data-action="reject">
                          {% csrf_token %}
                          <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                      {% endif %}
                      </div>
                    </td>
                  </tr>
                  {% endwith %}
                {% empty %}
                  <tr class="pending-empty-row"><td colspan="{% if section.kind == 'media' %}10{% elif section.kind == 'family' or section.kind == 'maintenance' %}9{% else %}8{% endif %}" class="text-muted text-center py-3">No items match the selected filters.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {% empty %}
      <div class="col-12">
        <div class="alert alert-light border shadow-sm text-center py-4 mb-0">
          <div class="fw-semibold">No approvals match the selected filters.</div>
          <div class="text-muted small mt-1">Change the status or date filter to view other records.</div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
<div id="pendingApprovalFeedback" class="pending-approval-feedback" aria-live="polite"></div>
<script>
(function () {
  const feedback = document.getElementById("pendingApprovalFeedback");
  const filterForm = document.getElementById("pendingApprovalFilters");
  const typeFilter = document.getElementById("approvalType");
  const statusFilter = document.getElementById("approvalStatus");
  const propertyFilter = document.getElementById("approvalProperty");
  const unitFilter = document.getElementById("approvalUnit");
  const searchFilter = document.getElementById("approvalSearch");
  const dateRange = document.getElementById("approvalDateRange");
  const customDateFields = document.querySelectorAll(".pending-custom-date");
  const customDateInputs = document.querySelectorAll(".pending-custom-date input");

  function updateCustomDateVisibility() {
    const show = dateRange && dateRange.value === "custom";
    customDateFields.forEach(function (field) {
      field.classList.toggle("d-none", !show);
      const input = field.querySelector("input");
      if (input) input.disabled = !show;
    });
  }

  updateCustomDateVisibility();

  function submitFilters() {
    if (filterForm) filterForm.requestSubmit();
  }

  if (typeFilter) typeFilter.addEventListener("change", submitFilters);
  if (statusFilter) statusFilter.addEventListener("change", submitFilters);
  if (propertyFilter) {
    propertyFilter.addEventListener("change", function () {
      if (unitFilter) unitFilter.value = "";
      submitFilters();
    });
  }
  if (unitFilter) unitFilter.addEventListener("change", submitFilters);
  let searchTimer = null;
  if (searchFilter) {
    searchFilter.addEventListener("input", function () {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(submitFilters, 500);
    });
  }
  if (dateRange) {
    dateRange.addEventListener("change", function () {
      updateCustomDateVisibility();
      if (dateRange.value !== "custom") submitFilters();
    });
  }
  customDateInputs.forEach(function (input) {
    input.addEventListener("change", function () {
      const values = Array.from(customDateInputs).map(function (field) { return field.value; });
      if (dateRange && dateRange.value === "custom" && values.every(Boolean)) submitFilters();
    });
  });

  if (window.jQuery && window.jQuery.fn && window.jQuery.fn.select2) {
    const $filters = window.jQuery(".pending-select2");
    $filters.select2({theme: "bootstrap-5", width: "100%"});
    window.jQuery(document).on("select2:open", function () {
      window.setTimeout(function () {
        const input = document.querySelector(".select2-container--open .select2-search__field");
        if (input) input.focus();
      }, 0);
    });
  }

  function renumberRows(card) {
    if (!card) return;
    card.querySelectorAll("tbody tr[data-pending-row] .pending-sn").forEach(function (cell, index) {
      cell.textContent = String(index + 1);
    });
  }

  function showFeedback(message, ok) {
    feedback.innerHTML = "";
    const alert = document.createElement("div");
    alert.className = "alert " + (ok ? "alert-success" : "alert-danger") + " shadow-sm py-2 px-3";
    alert.textContent = message;
    feedback.appendChild(alert);
    window.setTimeout(function () { alert.remove(); }, 5000);
  }

  document.addEventListener("submit", async function (event) {
    const form = event.target.closest("form.pending-approval-action");
    if (!form) return;
    event.preventDefault();

    const submitter = event.submitter;
    const formData = new FormData(form);
    if (submitter && submitter.name) formData.set(submitter.name, submitter.value);
    const buttons = form.querySelectorAll("button");
    buttons.forEach(function (button) { button.disabled = true; });

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: {"X-Requested-With": "XMLHttpRequest", "Accept": "application/json"},
        credentials: "same-origin"
      });
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.message || "The update could not be completed.");

      const row = form.closest("tr[data-pending-row]");
      const card = form.closest(".card");
      if (row) row.remove();
      if (card) {
        renumberRows(card);
        const badge = card.querySelector(".pending-section-count");
        if (badge) badge.textContent = Math.max(0, Number(badge.textContent || 0) - 1);
        const tbody = card.querySelector("tbody");
        if (tbody && !tbody.querySelector("tr[data-pending-row]")) {
          const empty = document.createElement("tr");
          empty.className = "pending-empty-row";
          empty.innerHTML = '<td colspan="9" class="text-muted text-center py-3">No pending items.</td>';
          tbody.appendChild(empty);
        }
      }
      showFeedback(data.message || "Updated.", true);
      if (data.redirect_url) window.open(data.redirect_url, "_blank", "noopener");
    } catch (error) {
      buttons.forEach(function (button) { button.disabled = false; });
      showFeedback(error.message || "The update could not be completed.", false);
    }
  });
})();
</script>
{% endblock %}
