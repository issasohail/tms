{% extends 'base.html' %}

{% block title %}Unit Photo Share Link{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Unit Photo Share Link</h2>
        <div class="text-muted small">{{ unit.property.property_name }} - Unit {{ unit.unit_number }}</div>
    </div>
    <a href="{{ back_url }}" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">48-hour secure link</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">This link expires after {{ expires_hours }} hours and only shows active unit photos through a protected view.</p>
        <label class="form-label">Share URL</label>
        <div class="input-group">
            <input type="text" class="form-control" value="{{ share_url }}" readonly>
            <a href="{{ share_url }}" target="_blank" rel="noopener" class="btn btn-primary">Open</a>
        </div>
        <form method="get" action="{% url 'properties:unit_media_share_link' unit.pk %}" class="mt-3">
            <button type="submit" class="btn btn-outline-primary btn-sm">Regenerate Link</button>
        </form>
    </div>
</div>
{% endblock %}
