    </div>
  </div>
</template>

<script>
(function () {
  const rows = document.getElementById('familyMemberRows');
  const template = document.getElementById('familyMemberTemplate');
  const addButton = document.getElementById('addFamilyMember');
  function renumber() {
    rows.querySelectorAll('.family-member-card').forEach(function (card, index) {
      const num = card.querySelector('.member-num');
      if (num) num.textContent = index + 1;
      card.querySelectorAll('[data-field]').forEach(function (field) {
        field.name = 'family-' + index + '-' + field.dataset.field;
      });
    });
  }
  if (rows && template && addButton) {
    addButton.addEventListener('click', function () { rows.appendChild(template.content.cloneNode(true)); renumber(); });
    rows.addEventListener('click', function (event) {
      const remove = event.target.closest('.remove-family-member');
      if (!remove) return;
      remove.closest('.family-member-card').remove();
      renumber();
    });
  }
  document.querySelectorAll('.image-upload-container input[type="file"]').forEach(function (input) {
    input.addEventListener('change', function () {
      const file = input.files && input.files[0];
      if (!file) return;
      const container = input.closest('.image-upload-container');
      const reader = new FileReader();
      reader.onload = function (event) {
        let preview = container.querySelector('img.public-file-preview');
        const placeholder = container.querySelector('.placeholder-icon');
        if (!preview) {
          preview = document.createElement('img');
          preview.className = 'public-file-preview';
          preview.style.cssText = 'width:100%;height:100%;object-fit:cover;position:absolute;inset:0;';
          if (placeholder) placeholder.replaceWith(preview);
          else container.insertBefore(preview, container.firstChild);
        }
        preview.src = event.target.result;
      };
      reader.readAsDataURL(file);
    });
  });
  document.querySelectorAll('.address-grid textarea').forEach(function(el) { el.setAttribute('rows', '4'); });
})();
</script>

