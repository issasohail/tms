        kwargs = super().get_form_kwargs()
        kwargs["lease"] = self.lease
        return kwargs

    def form_valid(self, form):
        obj = form.save(commit=False)
        obj.lease = self.lease
        obj.save()
        messages.success(self.request, "Security deposit transaction added.")
