{% load humanize %}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Invoice #{{ invoice.invoice_number }}</title>
  <style>
    @page {
      size: A4;
      margin: 16mm 14mm;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #111;
      font-size: 12px;
      line-height: 1.35;
    }

    .invoice-sheet {
      width: 100%;
    }

    .header {
      display: table;
      width: 100%;
      margin-bottom: 16px;
    }

    .header-left,
    .header-right {
      display: table-cell;
      vertical-align: top;
      width: 50%;
    }

    .header-right {
      text-align: right;
    }

    h1 {
      font-size: 24px;
      margin: 0 0 4px;
      letter-spacing: 0;
    }

    .muted {
      color: #555;
    }

    .to-box {
      border: 1px solid #d8dde3;
      padding: 10px;
      margin-bottom: 16px;
    }

    .to-grid {
      display: table;
      width: 100%;
    }

    .to-col {
      display: table-cell;
      width: 50%;
      vertical-align: top;
    }

    .to-col p,
    .description-line {
      margin: 0 0 5px;
    }

    .badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 8px;
      background: #f4c542;
      font-size: 10px;
      font-weight: bold;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      margin-top: 8px;
    }

    thead {
      display: table-header-group;
    }

    th,
    td {
      padding: 6px 5px;
      border-bottom: 1px solid #d8dde3;
      vertical-align: top;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    th {
      background: #f6f7f8;
      text-align: left;
      font-weight: bold;
    }

    .sn-col {
      width: 9%;
      color: #555;
    }

    .category-col {
      width: 28%;
    }

    .description-col {
      width: 40%;
    }

    .amount-col {
      width: 23%;
      text-align: right;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .main-row td {
      border-bottom: 0;
    }

    .description-row td {
      padding-top: 0;
    }

    .description-text {
      font-weight: normal;
      line-height: 1.45;
    }

    .totals {
      display: table;
      width: 100%;
      margin-top: 18px;
      font-size: 13px;
    }

    .total-left,
    .total-right {
      display: table-cell;
      width: 50%;
    }

    .total-right {
      text-align: right;
      font-weight: bold;
    }

    .payment-note {
      text-align: center;
      margin-top: 28px;
      color: #344054;
      font-size: 11px;
    }

    .footer {
      margin-top: 60px;
      text-align: center;
      font-size: 11px;
      color: #344054;
    }
  </style>
</head>
<body>
  <div class="invoice-sheet">
    <div class="header">
      <div class="header-left">
        <h1>INVOICE</h1>
        <div class="muted">#{{ invoice.invoice_number }}</div>
      </div>
      <div class="header-right">
        <p><strong>Date:</strong> {{ invoice.issue_date|date:"M d, Y" }}</p>
        <p><strong>Due:</strong> {{ invoice.due_date|date:"M d, Y" }}</p>
      </div>
    </div>

    <div class="to-box">
      <div class="to-grid">
        <div class="to-col">
          <p><strong>To:</strong></p>
          <p>{{ invoice.lease.tenant.first_name }} {{ invoice.lease.tenant.last_name }}{% if invoice.lease.tenant.phone %} - {{ invoice.lease.tenant.phone }}{% endif %}</p>
          <p>{{ invoice.lease.unit.unit_number }}, {{ invoice.lease.unit.property.property_name }}</p>
        </div>
        <div class="to-col">
          <p><strong>Lease Balance:</strong></p>
          <p>Rs.{{ invoice.lease.get_balance|floatformat:2|intcomma }}</p>
          <p><strong>Lease End:</strong> {{ invoice.lease.end_date|date:"M d, Y"|default:"-" }}</p>
          <p><strong>Invoice Status:</strong> <span class="badge">{{ invoice.get_status_display }}</span></p>
        </div>
      </div>
      <p class="description-line muted">
        <strong>Description:</strong> {{ combined_description|default:invoice.description|default:"-" }}
      </p>
    </div>

    <table>
      <thead>
        <tr>
          <th class="sn-col">S.n</th>
          <th class="category-col">Category</th>
          <th class="description-col">Description</th>
          <th class="amount-col">Amount</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
        <tr class="main-row">
          <td class="sn-col">{{ forloop.counter }}</td>
          <td class="category-col">{{ item.category.name|default:item.category|default:"-" }}</td>
          <td class="description-col"></td>
          <td class="amount-col">Rs.{{ item.amount|floatformat:2|intcomma }}</td>
        </tr>
        <tr class="description-row">
          <td class="sn-col"></td>
          <td colspan="2" class="description-text">{{ item.description|default:"" }}</td>
          <td class="amount-col"></td>
        </tr>
        {% empty %}
        <tr>
          <td colspan="4">No invoice items found.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="totals">
      <div class="total-left"><strong>Total:</strong> Rs.{{ computed_total|floatformat:2|intcomma }}</div>
      <div class="total-right">Rs.{{ computed_total|floatformat:2|intcomma }}</div>
    </div>

    <div class="payment-note">
      <p>Thank you for your business!</p>
      <p><strong>Payment Methods:</strong></p>
      <p>Bank Transfer (Account: 123456789)</p>
      <p>Cash</p>
    </div>

    <div class="footer">Tenant Management System &copy; 2026</div>
  </div>
</body>
</html>
