{% block extra_js %}
<script>
(function () {
  const nav = document.getElementById('ldTabNav');
  if (!nav) return;
  function activateTab(tabName) {
    const btn = nav.querySelector('.ld-tab-btn[data-tab="' + tabName + '"]');
    if (!btn) return;
    nav.querySelectorAll('.ld-tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.ld-tab-pane').forEach(p => p.classList.remove('active'));
    const t = document.getElementById('ld-tab-' + tabName);
    if (t) t.classList.add('active');
  }
  nav.addEventListener('click', function (e) {
    const btn = e.target.closest('.ld-tab-btn');
    if (!btn) return;
    activateTab(btn.dataset.tab);
  });

  document.querySelectorAll('.ld-tab-pane').forEach(function (pane) {
    if (pane.querySelector('.ld-mobile-top-link')) return;
    const heading = pane.querySelector('.ld-inner-head, .ld-renewal-head');
    if (!heading) return;
    const topLink = document.createElement('a');
    topLink.className = 'ld-mobile-top-link no-print';
    topLink.href = '#lease-detail-top';
    topLink.textContent = 'Top';
    topLink.setAttribute('aria-label', 'Back to top');
    const headingActions = heading.querySelector('.ld-heading-actions');
    (headingActions || heading).appendChild(topLink);
  });
  const params = new URLSearchParams(window.location.search);
  if (window.location.hash && window.location.hash.indexOf('#ld-tab-') === 0) {
    activateTab(window.location.hash.replace('#ld-tab-', ''));
  } else if (params.get('open_family_add') === '1') {
    activateTab('family');
  }
  if (params.get('open_family_add') === '1') {
    const addBox = document.getElementById('leaseFamilyAddBox');
    if (params.get('open_family_add') === '1' && addBox && window.bootstrap) {
      bootstrap.Collapse.getOrCreateInstance(addBox, { toggle: false }).show();
    }
  }
})();

(function () {
  const csrf = document.querySelector('[name=csrfmiddlewaretoken]')?.value || '';
  const existingForm = document.getElementById('leaseFamilyExistingForm');
  const tenantSelect = document.getElementById('leaseFamilyTenantSelect');
  const relationSelect = document.getElementById('leaseFamilyRelation');
  const newModalEl = document.getElementById('newFamilyMemberModal');
  const newForm = document.getElementById('newFamilyMemberForm');
  const errorBox = document.getElementById('newFamilyError');
  const searchHelp = document.getElementById('leaseFamilySearchHelp');
  let lastNoResultTerm = '';

  function esc(value) {
    return String(value || '').replace(/[&<>"']/g, function (ch) {
      return ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[ch]);
    });
  }

  function addFamilyRow(data) {
    const tbody = document.getElementById('leaseFamilyRows');
    if (!tbody) return;
    tbody.querySelectorAll('.ld-empty').forEach(row => row.closest('tr')?.remove());
    const serial = tbody.querySelectorAll('tr').length + 1;
    const row = document.createElement('tr');
    row.innerHTML = `
      <td class="ld-family-sn" data-label="S.N">${serial}</td>
      <td class="ld-family-name" data-label="Name"><a href="${esc(data.detail_url)}">${esc(data.tenant)}</a></td>
      <td class="ld-family-relation" data-label="Relationship">${esc(data.relation || '—')}</td>
      <td class="ld-family-cnic" data-label="CNIC">${esc(data.cnic || '—')}</td>
      <td class="ld-family-dob" data-label="DOB">${esc(data.dob || '—')}</td>
      <td class="ld-family-phone" data-label="Phone">${esc(data.phone || '—')}</td>
      <td class="ld-family-age" data-label="Age">${esc(data.age || '—')}</td>
      <td class="no-print ld-td-actions" data-label="Actions">
        <div class="d-flex flex-wrap gap-1">
          <a href="${esc(data.detail_url)}" class="btn btn-sm btn-dark">View</a>
          <a href="${esc(data.edit_url)}" class="btn btn-sm btn-primary">Edit</a>
          <form method="post" action="${esc(data.remove_url)}" onsubmit="return confirm('Remove this family relationship? Tenant record will remain.');">
            <input type="hidden" name="csrfmiddlewaretoken" value="${esc(csrf)}">
            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
          </form>
        </div>
      </td>
      <td class="ld-family-mobile-only ld-family-mobile-id" data-label="S.N - Name">#${serial} &middot; <a href="${esc(data.detail_url)}">${esc(data.tenant)}</a></td>
      <td class="ld-family-mobile-only ld-family-mobile-dob-age" data-label="DOB - Age">${esc(data.dob || '—')} &middot; ${esc(data.age || '—')}</td>
      <td class="ld-family-mobile-only ld-family-mobile-last-row no-print">
        <div class="ld-family-mobile-phone"><span class="ld-family-mobile-phone-label">Phone</span>${esc(data.phone || '—')}</div>
        <div class="ld-family-mobile-actions">
          <a href="${esc(data.detail_url)}" class="btn btn-sm btn-dark">View</a>
          <a href="${esc(data.edit_url)}" class="btn btn-sm btn-primary">Edit</a>
          <form method="post" action="${esc(data.remove_url)}" onsubmit="return confirm('Remove this family relationship? Tenant record will remain.');">
            <input type="hidden" name="csrfmiddlewaretoken" value="${esc(csrf)}">
            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
          </form>
        </div>
      </td>`;
    tbody.appendChild(row);
  }

  function splitFamilyName(term) {
    const clean = String(term || '').trim().replace(/\s+/g, ' ');
    if (!clean) return {full: '', first: '', last: ''};
    const parts = clean.split(' ');
    return {
      full: clean,
      first: parts.shift() || '',
      last: parts.join(' ') || ''
    };
  }

  function openNewFamilyModalFromTerm(term, showNotFoundMessage) {
    if (!newModalEl) return;
    const names = splitFamilyName(term);
    const selectedRelation = relationSelect?.value || '';
    if (selectedRelation) {
      document.getElementById('newFamilyRelation').value = selectedRelation;
    }
    document.getElementById('newFamilyFullName').value = names.full;
    document.getElementById('newFamilyFirstName').value = names.first;
    document.getElementById('newFamilyLastName').value = names.last;
    if (errorBox) {
      if (showNotFoundMessage && names.full) {
        errorBox.textContent = `"${names.full}" is not in the tenant list. Would you like to add this tenant?`;
        errorBox.classList.remove('d-none');
      } else {
        errorBox.classList.add('d-none');
        errorBox.textContent = '';
      }
    }
    new bootstrap.Modal(newModalEl).show();
  }

  if (tenantSelect && window.jQuery && jQuery.fn.select2) {
    jQuery(tenantSelect).select2({
      placeholder: 'Search tenant name, phone or CNIC',
      allowClear: true,
      width: '100%',
      minimumInputLength: 1,
      ajax: {
        url: tenantSelect.dataset.searchUrl,
        dataType: 'json',
        delay: 250,
        data: params => ({q: params.term || ''}),
        processResults: data => ({
          results: (data || []).map(item => ({
            id: item.id,
            text: [item.name, item.phone1, item.cnic].filter(Boolean).join(' - ')
          }))
        })
      },
      language: {
        inputTooShort: function () {
          return 'Type to search tenant.';
        },
        searching: function () {
          return 'Searching tenants...';
        },
        noResults: function () {
          const term = (jQuery('.select2-container--open .select2-search__field').val() || '').trim();
          if (term && term !== lastNoResultTerm) {
            lastNoResultTerm = term;
            if (searchHelp) {
              searchHelp.innerHTML = `<span class="text-danger">"${esc(term)}" is not in the list.</span> Add this person as a new family member.`;
            }
            window.setTimeout(function () {
              openNewFamilyModalFromTerm(term, true);
            }, 150);
          }
          return 'No tenant found. Opening Add New...';
        }
      }
    }).on('select2:open', function () {
      window.setTimeout(function () {
        const input = document.querySelector('.select2-container--open .select2-search__field');
        if (input) input.focus();
      }, 0);
    }).on('select2:select', function () {
      if (searchHelp) {
        searchHelp.textContent = 'Family members must exist in the Tenant table. If the name is not found, use Add New to create and link in one save.';
      }
      lastNoResultTerm = '';
    });
  }

  document.getElementById('openNewFamilyModalBtn')?.addEventListener('click', function () {
    let term = '';
    if (tenantSelect && window.jQuery && jQuery.fn.select2) {
      term = jQuery('.select2-container--open .select2-search__field').val() || '';
    }
    openNewFamilyModalFromTerm(term, false);
  });

  const familyPublicInput = document.getElementById('leaseFamilyPublicLinkInput');
  const generateFamilyLinkBtn = document.getElementById('generateFamilyPublicLinkBtn');
  const copyFamilyLinkBtn = document.getElementById('copyFamilyPublicLinkBtn');
  const whatsappFamilyLinkBtn = document.getElementById('whatsappFamilyPublicLinkBtn');
  const openFamilyLinkBtn = document.getElementById('openFamilyPublicLinkBtn');
  function setFamilyPublicLink(url) {
    if (familyPublicInput) familyPublicInput.value = url || '';
    if (openFamilyLinkBtn) {
      openFamilyLinkBtn.href = url || '#';
      openFamilyLinkBtn.classList.toggle('disabled', !url);
    }
    if (whatsappFamilyLinkBtn) {
      whatsappFamilyLinkBtn.href = url ? 'https://wa.me/?text=' + encodeURIComponent('Please update lease family information using this secure link:\n\n' + url) : '#';
      whatsappFamilyLinkBtn.classList.toggle('disabled', !url);
    }
  }
  generateFamilyLinkBtn?.addEventListener('click', function () {
    const btn = this;
    btn.disabled = true;
    const original = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Generating';
    fetch(btn.dataset.linkUrl, {headers: {'X-Requested-With': 'XMLHttpRequest'}})
      .then(response => response.json().then(payload => ({ok: response.ok, payload})))
      .then(({ok, payload}) => {
        if (!ok || !payload.ok) throw new Error(payload.error || 'Could not create public link.');
        setFamilyPublicLink(payload.url);
        familyPublicInput?.select();
      })
      .catch(error => alert(error.message))
      .finally(() => {
        btn.disabled = false;
        btn.innerHTML = original;
      });
  });
  copyFamilyLinkBtn?.addEventListener('click', function () {
    const url = familyPublicInput?.value || '';
    if (!url) {
      generateFamilyLinkBtn?.click();
      return;
    }
    if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(() => {
        const original = copyFamilyLinkBtn.innerHTML;
        copyFamilyLinkBtn.innerHTML = '<i class="fas fa-check me-1"></i> Copied';
        setTimeout(() => { copyFamilyLinkBtn.innerHTML = original; }, 1500);
      })
      .catch(error => alert(error.message));
    } else {
      window.prompt('Copy public family link:', url);
    }
  });

  existingForm?.addEventListener('submit', function (event) {
    event.preventDefault();
    const data = new FormData(existingForm);
    fetch(existingForm.action, {
      method: 'POST',
      headers: {'X-CSRFToken': csrf, 'X-Requested-With': 'XMLHttpRequest'},
      body: data
    })
    .then(response => response.json().then(payload => ({ok: response.ok, payload})))
    .then(({ok, payload}) => {
      if (!ok || !payload.ok) throw new Error(payload.error || 'Could not add family member.');
      addFamilyRow({
        ...payload,
        detail_url: "{% url 'tenants:tenant_detail' 0 %}".replace('/0/', '/' + payload.tenant_id + '/'),
        edit_url: "{% url 'tenants:tenant_update' 0 %}".replace('/0/', '/' + payload.tenant_id + '/'),
        remove_url: "{% url 'leases:lease_family_remove' lease.pk 0 %}".replace('/0/remove/', '/' + payload.id + '/remove/')
      });
      existingForm.reset();
      if (tenantSelect && window.jQuery && jQuery.fn.select2) jQuery(tenantSelect).val(null).trigger('change');
    })
    .catch(error => alert(error.message));
  });

  newForm?.addEventListener('submit', function (event) {
    event.preventDefault();
    const saveBtn = document.getElementById('newFamilySaveBtn');
    if (errorBox) {
      errorBox.classList.add('d-none');
      errorBox.textContent = '';
    }
    if (saveBtn) saveBtn.disabled = true;
    fetch(newForm.action, {
      method: 'POST',
      headers: {'X-CSRFToken': csrf, 'X-Requested-With': 'XMLHttpRequest'},
      body: new FormData(newForm)
    })
    .then(response => response.json().then(payload => ({ok: response.ok, payload})))
    .then(({ok, payload}) => {
      if (!ok || !payload.ok) throw new Error(payload.error || 'Could not save family member.');
      addFamilyRow(payload);
      bootstrap.Modal.getInstance(newModalEl)?.hide();
      newForm.reset();
    })
    .catch(error => {
      if (errorBox) {
        errorBox.textContent = error.message;
        errorBox.classList.remove('d-none');
      } else {
        alert(error.message);
      }
    })
    .finally(() => {
      if (saveBtn) saveBtn.disabled = false;
    });
  });
})();

function openRenewalMedia(btn) {
  const urls = (btn.dataset.urls || '').split('|').filter(Boolean);
  if (!urls.length) return;
  const main   = document.getElementById('renewalMediaMain');
  const thumbs = document.getElementById('renewalMediaThumbs');
  main.src = urls[0];
  thumbs.innerHTML = '';
  urls.forEach(function(u) {
    const img = document.createElement('img');
    img.src = u;
    img.className = 'img-thumbnail';
    img.style.cssText = 'width:80px;height:80px;object-fit:cover;cursor:pointer;';
    img.addEventListener('click', function() { main.src = u; });
    thumbs.appendChild(img);
  });
  if (window.bootstrap && bootstrap.Modal)
    new bootstrap.Modal(document.getElementById('renewalMediaModal')).show();
}

(function () {
  const group = document.querySelector('.ld-police-group');
  if (!group) return;
  const url = group.dataset.policeUrl;
  const csrf = document.querySelector('[name=csrfmiddlewaretoken]')?.value || '';
  let cached = null;
  let pending = null;

  function getLink() {
    if (cached) return Promise.resolve(cached);
    if (pending) return pending;
    pending = fetch(url, {
      method: 'POST',
      headers: {'X-CSRFToken': csrf, 'X-Requested-With': 'XMLHttpRequest'},
      body: new FormData(),
      credentials: 'same-origin'
    })
      .then(function (response) { return response.json(); })
      .then(function (data) {
        if (!data.ok) throw new Error(data.error || 'Could not create police link.');
        cached = data;
        return data;
      })
      .finally(function () { pending = null; });
    return pending;
  }

  const openBtn = group.querySelector('.ld-police-open');
  const copyBtn = group.querySelector('.ld-police-copy');
  const waBtn = group.querySelector('.ld-police-wa');

  openBtn.addEventListener('click', function () {
    const original = openBtn.innerHTML;
    openBtn.disabled = true;
    openBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Police Report';
    getLink()
      .then(function (data) { window.open(data.url, '_blank'); })
      .catch(function (e) { alert(e.message); })
      .finally(function () {
        openBtn.disabled = false;
        openBtn.innerHTML = original;
      });
  });

  copyBtn.addEventListener('click', function () {
    getLink()
      .then(function (data) { return navigator.clipboard.writeText(data.url); })
      .then(function () {
        const original = copyBtn.innerHTML;
        copyBtn.innerHTML = '<i class="fas fa-check"></i>';
        setTimeout(function () { copyBtn.innerHTML = original; }, 1600);
      })
      .catch(function (e) { alert(e.message || 'Copy failed.'); });
  });

  waBtn.addEventListener('click', function () {
    getLink()
      .then(function (data) { window.open('https://wa.me/?text=' + encodeURIComponent(data.message), '_blank'); })
      .catch(function (e) { alert(e.message); });
  });
})();

(function () {
  const waMainBtn = document.getElementById('waMainBtn');
  const waApiCheckbox = document.getElementById('waSendViaApi');
  if (waMainBtn && waApiCheckbox) {
    const manualHref = waMainBtn.getAttribute('href');
    const apiUrl = "{% url 'whatsapp:send_object_message' 'lease' lease.pk 'text' %}";
    waMainBtn.addEventListener('click', function (event) {
      if (!waApiCheckbox.checked) {
        waMainBtn.setAttribute('href', manualHref);
        return true;
      }
      event.preventDefault();
      waMainBtn.style.pointerEvents = 'none';
      const original = waMainBtn.innerHTML;
      waMainBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending';
      const csrf = document.querySelector('[name=csrfmiddlewaretoken]')?.value || '';
      fetch(apiUrl, {
        method: 'POST',
        headers: {'X-CSRFToken': csrf, 'X-Requested-With': 'XMLHttpRequest'},
        credentials: 'same-origin'
      })
        .then(response => response.json().then(payload => ({ok: response.ok, payload})))
        .then(({ok, payload}) => {
          if (!ok || payload.ok === false) throw new Error(payload.error || 'WhatsApp API send failed.');
          alert('WhatsApp sent via API.');
        })
        .catch(error => alert(error.message))
        .finally(() => {
          waMainBtn.style.pointerEvents = '';
          waMainBtn.innerHTML = original;
        });
    });
  }
})();

(function () {
  function esc(value) {
    return String(value || '').replace(/[&<>"']/g, function (ch) {
      return ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[ch]);
    });
  }

  document.querySelectorAll('.ld-image-preview-link').forEach(function (link) {
    link.addEventListener('click', function (event) {
      const src = link.dataset.previewSrc || link.getAttribute('href');
      if (!src) return;
      event.preventDefault();
      const title = link.dataset.previewTitle || link.querySelector('.ld-doc-label')?.textContent || 'Image Preview';
      document.getElementById('imagePreviewTitle').textContent = title;
      document.getElementById('imagePreviewMain').src = src;
      document.getElementById('imagePreviewDownload').href = src;
      const meta = [
        ['Type', link.dataset.previewType],
        ['Registration', link.dataset.previewRegistration],
        ['Make / Model', link.dataset.previewMakeModel],
        ['Owner', link.dataset.previewOwner],
        ['Parking', link.dataset.previewParking]
      ].filter(row => row[1]);
      document.getElementById('imagePreviewMeta').innerHTML = meta.map(row => (
        '<div><span>' + esc(row[0]) + '</span>' + esc(row[1]) + '</div>'
      )).join('');
      if (window.bootstrap) {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('imagePreviewModal')).show();
      }
    });
  });

  const vehicleEditModalEl = document.getElementById('vehicleEditModal');
  const vehicleEditForm = document.getElementById('vehicleEditForm');
  const vehicleEditError = document.getElementById('vehicleEditError');
  function setVehicleEditError(message) {
    if (!vehicleEditError) return;
    vehicleEditError.textContent = message || '';
    vehicleEditError.classList.toggle('d-none', !message);
  }
  document.querySelectorAll('.vehicle-edit-btn').forEach(function (button) {
    button.addEventListener('click', function () {
      setVehicleEditError('');
      fetch(button.dataset.editUrl, {headers: {'X-Requested-With': 'XMLHttpRequest'}, credentials: 'same-origin'})
        .then(response => response.json().then(payload => ({ok: response.ok, payload})))
        .then(({ok, payload}) => {
          if (!ok || !payload.ok) throw new Error(payload.error || 'Could not load vehicle.');
          vehicleEditForm.action = button.dataset.editUrl;
          const v = payload.vehicle || {};
          const typeSelect = document.getElementById('vehicleEditType');
          typeSelect.innerHTML = (payload.vehicle_types || []).map(item => (
            '<option value="' + esc(item.id) + '"' + (String(item.id) === String(payload.vehicle_type_id) ? ' selected' : '') + '>' + esc(item.name) + '</option>'
          )).join('');
          document.getElementById('vehicleEditReg').value = v.registration_number || '';
          document.getElementById('vehicleEditMake').value = v.make || '';
          document.getElementById('vehicleEditModel').value = v.model || '';
          document.getElementById('vehicleEditColor').value = v.color || '';
          document.getElementById('vehicleEditYear').value = v.year || '';
          document.getElementById('vehicleEditOwner').value = v.owner_name || '';
          document.getElementById('vehicleEditCnic').value = v.owner_cnic || '';
          document.getElementById('vehicleEditParking').value = v.parking_slot || '';
          document.getElementById('vehicleEditNotes').value = v.notes || '';
          document.getElementById('vehicleEditActive').checked = !!v.is_active;
          if (window.bootstrap) bootstrap.Modal.getOrCreateInstance(vehicleEditModalEl).show();
        })
        .catch(error => alert(error.message));
    });
  });
  vehicleEditForm?.addEventListener('submit', function (event) {
    event.preventDefault();
    setVehicleEditError('');
    const saveBtn = document.getElementById('vehicleEditSaveBtn');
    if (saveBtn) saveBtn.disabled = true;
    fetch(vehicleEditForm.action, {
      method: 'POST',
      headers: {
        'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]')?.value || '',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: new FormData(vehicleEditForm),
      credentials: 'same-origin'
    })
      .then(response => response.json().then(payload => ({ok: response.ok, payload})))
      .then(({ok, payload}) => {
        if (!ok || !payload.ok) throw new Error(payload.error || 'Could not save vehicle.');
        window.location.reload();
      })
      .catch(error => setVehicleEditError(error.message))
      .finally(() => {
        if (saveBtn) saveBtn.disabled = false;
      });
  });
})();

document.getElementById('copyMaintenanceLinkBtn')?.addEventListener('click', function () {
  const link = this.dataset.maintenanceLink || '';
  if (!link) return;
  navigator.clipboard.writeText(link).then(() => {
    const original = this.innerHTML;
    this.innerHTML = '<i class="fas fa-check"></i> Copied';
