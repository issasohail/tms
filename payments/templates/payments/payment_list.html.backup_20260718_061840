<script>
const PAYMENT_LIST_PAYMENT_WHATSAPP_API_URL_TEMPLATE = "{% url 'whatsapp:send_object_message' 'payment' 0 'receipt' %}";

function paymentListCsrfToken() {
  const m = document.cookie.match(/(^|;)\s*csrftoken=([^;]+)/);
  return m ? decodeURIComponent(m[2]) : "";
}

function paymentListPaymentApiUrl(objectId) {
  return PAYMENT_LIST_PAYMENT_WHATSAPP_API_URL_TEMPLATE.replace("/0/", "/" + encodeURIComponent(objectId) + "/");
}

function paymentListWhatsAppApiErrorMessage(payload, fallback) {
  const debug = (payload && payload.debug) || {};
  const lines = [payload?.error || fallback || "API send failed"];
  if (debug.log_id) lines.push("Log ID: " + debug.log_id);
  if (debug.template_name) lines.push("Template: " + debug.template_name);
  if (debug.language_code) lines.push("Language: " + debug.language_code);
  if (debug.body_parameter_count !== undefined) lines.push("Body params: " + debug.body_parameter_count);
  if (debug.body_parameters && debug.body_parameters.length) lines.push("Values: " + debug.body_parameters.join(" | "));
  if (debug.button_parameter) lines.push("Button: " + debug.button_parameter);
  if (debug.meta_error_code) lines.push("Meta code: " + debug.meta_error_code);
  if (debug.meta_error_subcode) lines.push("Meta subcode: " + debug.meta_error_subcode);
  if (debug.meta_error_details) lines.push("Meta detail: " + debug.meta_error_details);
  if (debug.meta_fbtrace_id) lines.push("fbtrace_id: " + debug.meta_fbtrace_id);
  return lines.join("\n");
}

function showPaymentListToast(message, variant) {
  let wrap = document.getElementById("paymentListToastContainer");
  if (!wrap) {
    wrap = document.createElement("div");
    wrap.id = "paymentListToastContainer";
    wrap.className = "position-fixed top-0 end-0 p-3";
    wrap.style.zIndex = "1080";
    document.body.appendChild(wrap);
  }
  const toast = document.createElement("div");
  toast.className = "alert alert-" + (variant || "success") + " shadow-sm mb-2 py-2 px-3 small";
  toast.setAttribute("role", "status");
  toast.textContent = message;
  wrap.appendChild(toast);
  setTimeout(() => {
    toast.style.transition = "opacity .25s ease";
    toast.style.opacity = "0";
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}

function showPaymentListWhatsAppApiMessage(title, message) {
  let modalEl = document.getElementById("paymentListWhatsappApiMessageModal");
  if (!modalEl) {
    modalEl = document.createElement("div");
    modalEl.id = "paymentListWhatsappApiMessageModal";
    modalEl.className = "modal fade";
    modalEl.tabIndex = -1;
    modalEl.innerHTML = `
      <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header py-2">
            <h5 class="modal-title h6 mb-0"></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <textarea class="form-control small" rows="12" readonly></textarea>
          </div>
          <div class="modal-footer py-2">
            <button type="button" class="btn btn-sm btn-outline-secondary js-copy-message">Copy</button>
            <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal">OK</button>
          </div>
        </div>
      </div>`;
    document.body.appendChild(modalEl);
    modalEl.querySelector(".js-copy-message").addEventListener("click", async function() {
      const textArea = modalEl.querySelector("textarea");
      textArea.select();
      try {
        await navigator.clipboard.writeText(textArea.value);
      } catch (_) {
        document.execCommand("copy");
      }
      this.textContent = "Copied";
      setTimeout(() => { this.textContent = "Copy"; }, 1200);
    });
  }
  modalEl.querySelector(".modal-title").textContent = title;
  modalEl.querySelector("textarea").value = message;
  if (window.bootstrap && bootstrap.Modal) {
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
  } else {
    console.error(message);
    showPaymentListToast(message.split("\n")[0] || title, "danger");
  }
}

document.addEventListener("click", async function(e){
  const a = e.target.closest(".btn-wa-receipt");
  if (!a) return;

  e.preventDefault();
  e.stopImmediatePropagation();

  const apiUrl = a.dataset.waUrl;
  if (!apiUrl) return;

  try {
    const useApi = document.getElementById("payment-use-whatsapp-api")?.checked;
    const objectId = a.dataset.apiObjectId;
    if (useApi && objectId) {
      let apiResponse;
      let apiData = {};
      try {
        apiResponse = await fetch(paymentListPaymentApiUrl(objectId), {
          method: "POST",
          headers: { "X-CSRFToken": paymentListCsrfToken(), "X-Requested-With": "XMLHttpRequest" },
          credentials: "same-origin"
        });
        apiData = await apiResponse.json().catch(() => ({}));
      } catch (networkErr) {
        showPaymentListWhatsAppApiMessage("WhatsApp API Error", "Failed to send via WhatsApp API:\n" + networkErr.message);
        return;
      }
      if (!apiResponse.ok || apiData.ok === false) {
        showPaymentListWhatsAppApiMessage("WhatsApp API Error", "Failed to send via WhatsApp API:\n" + paymentListWhatsAppApiErrorMessage(apiData, `HTTP ${apiResponse.status}`));
        return;
      }
      showPaymentListToast("Receipt sent via WhatsApp API.");
      return;
    }
    if (useApi && !objectId) {
      alert("This payment list row does not have a direct WhatsApp API send yet. Opening WhatsApp instead.");
    }

    const r = await fetch(apiUrl, { headers: { "X-Requested-With": "XMLHttpRequest" } });
    const data = await r.json();

    const phoneRaw = (data.phone || "").toString().trim();
    const msg = (data.message || "").toString();

    if (!phoneRaw) { alert("No phone number."); return; }

    // normalize phone for wa.me (remove non-digits, drop leading 0, add 92 if needed)
    let digits = phoneRaw.replace(/\D/g,'');
    if (digits.startsWith("0")) digits = "92" + digits.slice(1);
    if (!digits.startsWith("92") && digits.length <= 12) digits = "92" + digits; // your default Pakistan behavior

    const waUrl = `https://wa.me/${digits}?text=${encodeURIComponent(msg)}`;
    window.open(waUrl, "_blank");
  } catch (err) {
    console.error(err);
    alert("Failed to open WhatsApp: " + err.message);
  }
}, true);
</script>
<script>
  document.addEventListener("click", async function(e){
    const btn = e.target.closest(".btn-split-edit");
    if(!btn) return;

    const paymentDetailId = btn.dataset.allocationId;
    const modalEl = document.getElementById("splitModal");
    const form = document.getElementById("splitForm");

    form.querySelector("[name=payment_detail_id]").value = paymentDetailId;

    // Prefill
    const url = new URL("{% url 'payments:payment_detail_prefill_api' %}", window.location.origin);
    url.searchParams.set("payment_detail_id", paymentDetailId);

    const r = await fetch(url.toString());
    const data = await r.json();

    form.querySelector("[name=lease_amount]").value = data.lease_amount || "0.00";
    form.querySelector("[name=security_amount]").value = data.security_amount || "0.00";
    form.querySelector("[name=security_type]").value = data.security_type || "PAYMENT";

    new bootstrap.Modal(modalEl).show();
  });

  document.addEventListener("submit", function(e){
    if(e.target.id !== "splitForm") return;
    e.preventDefault();

    fetch("{% url 'payments:payment_detail_update_api' %}", {
      method: "POST",
      headers: { "X-CSRFToken": document.querySelector("[name=csrfmiddlewaretoken]").value },
      body: new FormData(e.target)
    }).then(async (r) => {
      if (!r.ok) {
        const err = await r.json().catch(()=>null);
        alert(err?.error || "Failed to save split.");
        return;
      }
      location.reload();
    });
  });
</script>
