      <div id="endLeaseChecklistError" class="small text-danger mt-2 d-none">Answer both questions before proceeding.</div>
    </div>
    <div class="card-footer py-2 text-end">
      <button type="button" class="btn btn-sm btn-secondary" id="endLeaseChecklistCancel">Cancel</button>
      <button type="button" class="btn btn-sm btn-primary" id="endLeaseChecklistProceed">Proceed to Review</button>
    </div>
  </div>
</div>
{% endif %}

{% if lease.status == "active" %}
<script>
(function () {
  var form = document.getElementById('endLeaseForm');
  if (!form) return;
  var previewBtn = document.getElementById('endLeasePreviewBtn');
  var confirmBtn = document.getElementById('endLeaseConfirmBtn');
  var action = document.getElementById('endLeaseAction');
  var previewBox = document.getElementById('endLeasePreview');
  var errorBox = document.getElementById('endLeaseError');
  var debugBox = document.getElementById('endLeaseDebug');
  var endpoint = form.getAttribute('action');
  var checklistPrompt = document.getElementById('endLeaseChecklistPrompt');
  var inspectionChoice = document.getElementById('endLeaseInspectionChoice');
  var keysChoice = document.getElementById('endLeaseKeysChoice');
  var inspectionChargeInput = document.getElementById('endLeaseInspectionChargeInput');
  var keyChargeInput = document.getElementById('endLeaseKeyChargeInput');
  var settlementDraftKey = 'tms:end-lease-draft:{{ lease.pk }}';

  function persistSettlementDraft() {
    var draft = {};
    new FormData(form).forEach(function(value, key) {
      if (key !== 'csrfmiddlewaretoken' && key !== 'action') draft[key] = value;
    });
    draft.inspection_choice = inspectionChoice.value;
    draft.keys_choice = keysChoice.value;
    sessionStorage.setItem(settlementDraftKey, JSON.stringify(draft));
  }

  function restoreSettlementDraft() {
    var raw = sessionStorage.getItem(settlementDraftKey);
    if (!raw) return false;
    try {
      var draft = JSON.parse(raw);
      Object.keys(draft).forEach(function(key) {
        var field = form.elements.namedItem(key);
        if (!field || key === 'inspection_choice' || key === 'keys_choice') return;
        if (field.type === 'checkbox') field.checked = Boolean(draft[key]);
        else field.value = draft[key];
      });
      setChecklistChoice('inspection', draft.inspection_choice || draft.inspection_complete || '');
      setChecklistChoice('keys', draft.keys_choice || draft.keys_returned || '');
      document.getElementById('endLeaseInspectionAnswer').value = inspectionChoice.value;
      document.getElementById('endLeaseKeysAnswer').value = keysChoice.value;
      inspectionChargeInput.value = document.getElementById('endLeaseInspectionCharge').value;
      keyChargeInput.value = document.getElementById('endLeaseKeyCharge').value;
      return Boolean(inspectionChoice.value && keysChoice.value);
    } catch (ignore) {
      return false;
    }
  }
  document.getElementById('endLeaseDebugDetails').addEventListener('toggle', function() {
    document.getElementById('endLeaseDebugToggleLabel').textContent = this.open ? 'Hide Debug' : 'Show Debug';
  });

  function closeChecklistPrompt() {
    checklistPrompt.classList.add('d-none');
  }
  function refreshChecklistNotices() {
    document.getElementById('endLeaseInspectionChargeNotice').classList.toggle('d-none', inspectionChoice.value !== 'no');
    document.getElementById('endLeaseKeysChargeNotice').classList.toggle('d-none', keysChoice.value !== 'no');
  }
  function setChecklistChoice(group, value) {
    var input = group === 'inspection' ? inspectionChoice : keysChoice;
    input.value = value;
    document.querySelectorAll('.checklist-choice[data-choice-group="' + group + '"]').forEach(function(button) {
      var selected = button.dataset.choiceValue === value;
      button.classList.toggle('opacity-50', !selected);
      button.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });
    refreshChecklistNotices();
  }
  document.querySelectorAll('.checklist-choice').forEach(function(button) {
    button.addEventListener('click', function() {
      setChecklistChoice(this.dataset.choiceGroup, this.dataset.choiceValue);
      document.getElementById('endLeaseChecklistError').classList.add('d-none');
    });
  });
  inspectionChargeInput.addEventListener('input', function() {
    document.getElementById('endLeaseInspectionCharge').value = this.value;
  });
  keyChargeInput.addEventListener('input', function() {
    document.getElementById('endLeaseKeyCharge').value = this.value;
  });
  document.getElementById('endLeaseChecklistClose').addEventListener('click', closeChecklistPrompt);
  document.getElementById('endLeaseChecklistCancel').addEventListener('click', closeChecklistPrompt);
  document.getElementById('endLeaseChecklistProceed').addEventListener('click', function() {
    var promptError = document.getElementById('endLeaseChecklistError');
    if (!inspectionChoice.value || !keysChoice.value) {
      promptError.classList.remove('d-none');
      return;
    }
    promptError.classList.add('d-none');
    document.getElementById('endLeaseInspectionAnswer').value = inspectionChoice.value;
    document.getElementById('endLeaseKeysAnswer').value = keysChoice.value;
    document.getElementById('endLeaseInspectionCharge').value = inspectionChargeInput.value;
    document.getElementById('endLeaseKeyCharge').value = keyChargeInput.value;
    closeChecklistPrompt();
    window.reviewEndLeaseSettlement(null, true);
  });

  function debug(message) {
    var stamp = new Date().toLocaleTimeString();
    debugBox.textContent += '\n[' + stamp + '] ' + message;
    debugBox.scrollTop = debugBox.scrollHeight;
    if (window.console && console.log) console.log('[End Lease] ' + message);
  }
  debugBox.textContent = 'JavaScript loaded. Endpoint: ' + endpoint;
  window.addEventListener('error', function (event) {
    debug('Browser error: ' + (event.message || 'unknown error'));
  });
  window.addEventListener('unhandledrejection', function (event) {
    debug('Promise error: ' + String(event.reason || 'unknown rejection'));
  });

  function pkr(value) {
    var number = Number(value || 0);
    return 'Rs. ' + number.toLocaleString('en-PK', {minimumFractionDigits: 2, maximumFractionDigits: 2});
  }
  function safe(value) {
    return String(value || '').replace(/[&<>"']/g, '');
  }
  function ensureSettlementElement(id, tagName, className) {
    var element = document.getElementById(id);
    if (element) return element;
    element = document.createElement(tagName || 'div');
    element.id = id;
    if (className) element.className = className;
    previewBox.insertBefore(element, previewBox.firstChild);
    debug('Recreated missing preview element: ' + id);
    return element;
  }
  function invalidatePreview() {
    action.value = 'preview';
    persistSettlementDraft();
    previewBox.classList.add('d-none');
    confirmBtn.classList.add('d-none');
    previewBtn.classList.remove('d-none');
  }
  function settlementRow(row, index, invoiceId) {
    return '<tr data-item-id="' + row.id + '" data-invoice-id="' + invoiceId + '" data-category="' + safe(row.category) +
      '" data-description="' + safe(row.description) + '" data-amount="' + safe(row.amount) + '">' +
      '<td>' + index + '</td><td>' + safe(row.category) + '</td><td>' + safe(row.description) + '</td>' +
      '<td class="text-end">' + pkr(row.amount) + '</td><td>' +
      '<div class="d-flex flex-nowrap gap-1"><button type="button" class="btn btn-sm btn-primary settlement-edit">Edit</button>' +
      '<button type="button" class="btn btn-sm btn-danger settlement-delete">Delete</button></div></td></tr>';
  }
  function editSettlementRow(row, isNew) {
    var category = isNew ? 'Other Charges' : (row.dataset.category || 'Other Charges');
    var description = isNew ? '' : (row.dataset.description || '');
    var amount = isNew ? '0.00' : String(row.dataset.amount || '0.00').replace(/,/g, '');
    var categories = [];
    try { categories = JSON.parse(previewBox.dataset.categories || '[]'); } catch (ignore) {}
    if (category && categories.indexOf(category) === -1) categories.push(category);
    var categoryOptions = categories.map(function(name) {
      return '<option value="' + safe(name) + '"' + (name === category ? ' selected' : '') + '>' + safe(name) + '</option>';
    }).join('');
    row.innerHTML = '<td>' + (isNew ? 'New' : row.children[0].textContent) + '</td>' +
      '<td><select class="form-select form-select-sm settlement-category">' + categoryOptions + '</select></td>' +
      '<td><input class="form-control form-control-sm settlement-description" value="' + safe(description) + '"></td>' +
      '<td><input type="number" min="0" step="0.01" class="form-control form-control-sm text-end settlement-amount" value="' + safe(amount) + '"></td>' +
      '<td><div class="d-flex flex-nowrap gap-1"><button type="button" class="btn btn-sm btn-success settlement-save">Save</button>' +
      '<button type="button" class="btn btn-sm btn-secondary settlement-cancel">Cancel</button></div></td>';
    row.dataset.newItem = isNew ? '1' : '0';
    var categorySelect = row.querySelector('.settlement-category');
    if (window.jQuery && jQuery.fn.select2) {
      jQuery(categorySelect).select2({
        tags: true,
        width: '100%',
        dropdownParent: jQuery('#endLeaseModal'),
        createTag: function(params) {
          var term = String(params.term || '').trim();
          return term ? {id: term, text: term, newTag: true} : null;
        }
      });
    }
    row.querySelector('.settlement-amount').focus();
  }
  function mutateSettlement(row, requestedAction) {
    var data = new FormData(form);
    data.set('action', requestedAction);
    if (row.dataset.invoiceId) data.set('invoice_id', row.dataset.invoiceId);
    if (row.dataset.itemId) data.set('item_id', row.dataset.itemId);
    if (requestedAction !== 'delete_item') {
      var categorySelect = row.querySelector('.settlement-category');
      var categoryValue = String(categorySelect.value || '').trim();
      if (!categoryValue) {
        errorBox.textContent = 'Enter the new category name.';
        errorBox.classList.remove('d-none');
        return Promise.resolve();
      }
      data.set('category', categoryValue);
      data.set('description', row.querySelector('.settlement-description').value);
      data.set('amount', row.querySelector('.settlement-amount').value);
    }
    return fetch(endpoint, {
      method: 'POST',
      headers: {'X-CSRFToken': form.querySelector('[name="csrfmiddlewaretoken"]').value, 'X-Requested-With': 'XMLHttpRequest'},
      body: data,
      credentials: 'same-origin'
    }).then(function(response) {
      return response.json().then(function(payload) {
        if (!response.ok || !payload.ok) throw new Error(payload.error || 'Invoice line could not be saved.');
        action.value = 'preview';
        return window.reviewEndLeaseSettlement();
      });
    }).catch(function(error) {
      errorBox.textContent = error.message;
      errorBox.classList.remove('d-none');
      debug('Invoice line action failed: ' + error.message);
    });
  }
  form.querySelectorAll('input:not([name="csrfmiddlewaretoken"]), textarea, select').forEach(function (input) {
    if (input.name !== 'action' && input.name !== 'send_whatsapp') {
      input.addEventListener('change', invalidatePreview);
    }
  });

  window.reviewEndLeaseSettlement = function (event, checklistAnswered) {
    if (event) event.preventDefault();
    if (!checklistAnswered && (
      !document.getElementById('endLeaseInspectionAnswer').value ||
      !document.getElementById('endLeaseKeysAnswer').value
    )) {
      checklistPrompt.classList.remove('d-none');
      return false;
    }
    debug('Review clicked. End date: ' + (form.querySelector('[name="end_date"]').value || '(blank)'));
    persistSettlementDraft();
    errorBox.classList.add('d-none');
    previewBtn.disabled = true;
    var original = previewBtn.innerHTML;
    previewBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Calculating';
    var data = new FormData(form);
    data.set('action', 'preview');
    debug('POST ' + endpoint + ' using AJAX preview.');
    fetch(endpoint, {
      method: 'POST',
      headers: {
        'X-CSRFToken': form.querySelector('[name="csrfmiddlewaretoken"]').value,
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: data,
      credentials: 'same-origin'
    })
      .then(function (response) {
        debug('HTTP response: ' + response.status + ' ' + response.statusText);
        return response.json().then(function (payload) {
          return {ok: response.ok, payload: payload};
        });
      })
      .then(function (responseData) {
        var payload = responseData.payload;
        if (!responseData.ok || !payload.ok) {
          throw new Error(payload.error || 'Could not calculate the settlement.');
        }
        debug('Preview received. Settlement invoices: ' + payload.future_invoices.length + '.');
        var daysEl = document.getElementById('endLeaseDays');
        if (daysEl) daysEl.textContent = payload.billable_days + '/' + payload.days_in_month + ' billed · ' + payload.proration_interval_label;
        else debug('Missing preview element: endLeaseDays');
        [
          ['endLeaseGross', pkr(payload.gross_balance)],
          ['endLeaseSecurity', pkr(payload.security_applied)]
        ].forEach(function (entry) {
          var element = document.getElementById(entry[0]);
          if (element) element.textContent = entry[1];
          else debug('Missing preview element: ' + entry[0]);
        });
        var outcomeRow = document.getElementById('endLeaseOutcomeRow');
        var outcomeLabel = document.getElementById('endLeaseOutcomeLabel');
        var outcomeValue = document.getElementById('endLeaseOutcomeValue');
        if (Number(payload.amount_payable) > 0) {
          outcomeRow.className = 'table-warning';
          outcomeLabel.textContent = 'Tenant payable';
          outcomeValue.textContent = pkr(payload.amount_payable);
        } else if (Number(payload.refund_due) > 0) {
          outcomeRow.className = 'table-success';
          outcomeLabel.textContent = 'Refund due';
          outcomeValue.textContent = pkr(payload.refund_due);
        } else {
          outcomeRow.className = 'table-success';
          outcomeLabel.textContent = 'Account settled';
          outcomeValue.textContent = pkr(0);
        }
        var futureBox = document.getElementById('endLeaseFutureInvoices');
        if (!futureBox) {
          futureBox = document.createElement('div');
          futureBox.id = 'endLeaseFutureInvoices';
          futureBox.className = 'alert alert-secondary py-2 small mb-2';
          previewBox.insertBefore(futureBox, previewBox.querySelector('.table-responsive'));
          debug('Recreated missing preview element: endLeaseFutureInvoices');
        }
        if (payload.future_invoices.length) {
          futureBox.innerHTML = payload.future_invoices.map(function (invoice) {
            return '<div class="settlement-invoice-row d-flex align-items-center gap-2 border rounded bg-white mt-1 px-2 py-1">' +
              '<span class="badge bg-secondary">' + safe(invoice.settlement_bucket) + '</span>' +
              '<span class="flex-grow-1"><strong>#' + safe(invoice.number) + '</strong> · ' + safe(invoice.issue_date) +
              ' · ' + safe(invoice.status) + ' · <strong>' + pkr(invoice.amount) + '</strong></span>' +
              '<a class="btn btn-sm btn-primary" target="_blank" href="' + safe(invoice.detail_url) + '">Detail</a></div>';
          }).join('');
          futureBox.classList.remove('d-none');
        } else {
          futureBox.innerHTML = '<strong>No invoices are included in this settlement review.</strong>';
          futureBox.classList.remove('d-none');
        }

        previewBox.classList.remove('d-none');
        action.value = 'confirm';
        previewBtn.classList.add('d-none');
        confirmBtn.classList.remove('d-none');
      })
      .catch(function (error) {
        debug('Preview failed: ' + error.message + (error.stack ? '\n' + error.stack : ''));
        errorBox.textContent = error.message;
        errorBox.classList.remove('d-none');
      })
      .finally(function () {
        previewBtn.disabled = false;
        previewBtn.innerHTML = original;
      });
    return false;
  };

  form.addEventListener('submit', function (event) {
    if (action.value !== 'confirm') {
      event.preventDefault();
      window.reviewEndLeaseSettlement(event);
      return;
    }
    sessionStorage.removeItem(settlementDraftKey);
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ending Lease';
  });

  window.addEventListener('message', function(event) {
    if (event.origin !== window.location.origin || !event.data || event.data.type !== 'tms-settlement-refresh') return;
    if (String(event.data.leaseId) !== '{{ lease.pk }}') return;
    if (window.bootstrap && bootstrap.Modal) {
      bootstrap.Modal.getOrCreateInstance(document.getElementById('endLeaseModal')).show();
    }
    window.reviewEndLeaseSettlement(null, true);
  });
  window.addEventListener('storage', function(event) {
    if (event.key !== 'tms:settlement-refresh:{{ lease.pk }}' || !event.newValue) return;
    if (window.bootstrap && bootstrap.Modal) {
      bootstrap.Modal.getOrCreateInstance(document.getElementById('endLeaseModal')).show();
    }
    window.reviewEndLeaseSettlement(null, true);
  });

  var returnParams = new URLSearchParams(window.location.search);
  if (returnParams.get('settlement_return') === '1' && window.opener && !window.opener.closed) {
    window.opener.postMessage({type: 'tms-settlement-refresh', leaseId: '{{ lease.pk }}'}, window.location.origin);
    window.close();
  } else if (returnParams.get('open_end_lease') === '1' || sessionStorage.getItem(settlementDraftKey)) {
    window.setTimeout(function() {
      var ready = restoreSettlementDraft();
      if (window.bootstrap && bootstrap.Modal) {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('endLeaseModal')).show();
      }
      if (ready) window.reviewEndLeaseSettlement(null, true);
    }, 0);
  }
})();
</script>
{% endif %}

