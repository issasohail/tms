+            self._mock_service(mocked_cls)
+            send_monthly_billing_item(self.item)
+            self.assertEqual(mocked_cls.return_value.send_invoice.call_count, 1)
+
+        self.item.refresh_from_db()
+        self.assertEqual(self.item.status, "sent")
