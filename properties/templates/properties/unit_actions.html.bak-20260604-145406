<div class="d-flex actions-wrap">
  <a href="{% url 'properties:unit_detail' record.pk %}" class="btn btn-sm btn-info action-btn btn-view">
    <i class="fas fa-eye"></i><span class="btn-text ms-1">View</span>
  </a>

  <a href="{% url 'properties:unit_update' record.pk %}" class="btn btn-sm btn-warning action-btn btn-edit">
    <i class="fas fa-edit"></i><span class="btn-text ms-1">Edit</span>
  </a>

  <a href="{% url 'properties:unit_delete' record.pk %}" class="btn btn-sm btn-danger action-btn btn-delete">
    <i class="fas fa-trash"></i><span class="btn-text ms-1">Delete</span>
  </a>

  {% if record.status != "maintenance" and not record.has_active_lease and not record.has_active_lease_history and record.interest_type_id %}
    <button type="button"
            class="btn btn-sm btn-success action-btn vacant-notice-btn"
            data-unit-id="{{ record.pk }}"
            data-unit-title="{{ record.property.property_name }} - {{ record.unit_number }} Vacant Notice"
            data-leads-url="{% url 'properties:unit_vacant_notice_leads' record.pk %}"
            title="Vacant Notice">
      <i class="fab fa-whatsapp"></i><span class="btn-text ms-1">Vacant Notice</span>
    </button>
  {% else %}
    <button type="button"
            class="btn btn-sm btn-secondary action-btn"
            title="{% if record.has_active_lease_history %}Current lease history covers today{% elif record.has_active_lease %}Current lease covers today{% elif record.status == 'maintenance' %}Unit is disabled/maintenance{% else %}No lead type selected{% endif %}"
            data-bs-toggle="tooltip"
            disabled>
      <i class="fab fa-whatsapp"></i><span class="btn-text ms-1">Vacant Notice</span>
    </button>
  {% endif %}
</div>
