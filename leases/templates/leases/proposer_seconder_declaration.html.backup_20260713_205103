<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:{% if history.print_on_legal_page %}Legal{% else %}Letter{% endif %} portrait;margin:.5in}*{box-sizing:border-box}body{font-family:"Times New Roman",serif;font-size:10.75pt;line-height:1.3;color:#111;margin:0}.page-title{text-align:center;font-size:16pt;font-weight:bold;margin:0 0 12pt;border-bottom:2px solid #222;padding-bottom:6pt}.party-card{border:1px solid #555;margin:0 0 14pt;padding:0 12pt 10pt}.party-heading{margin:0 -12pt 8pt;padding:6pt 10pt;font-size:12pt;font-weight:bold;background:#eee;border-bottom:1px solid #777}.declaration{margin:0 0 7pt;text-align:justify}.details{width:100%;border-collapse:collapse;table-layout:fixed;margin:6pt 0 9pt}.details th,.details td{border:1px solid #666;padding:5pt;vertical-align:middle;overflow-wrap:anywhere}.details th{background:#f2f2f2;font-size:8.5pt}.details td{font-size:9.5pt;font-weight:bold}.signature-row{font-size:10.5pt;white-space:nowrap;margin-top:8pt}.footer{text-align:center;font-size:8.5pt;color:#444;margin-top:5pt}
</style></head><body><div class="page-title">{{ signature_config.heading|default:"Proposer and Seconder Declaration" }}</div>
{% for section in declaration_sections %}<section class="party-card"><div class="party-heading">{{ section.heading }}</div>{% for paragraph in section.paragraphs %}<p class="declaration">{{ paragraph|safe }}</p>{% endfor %}<table class="details"><tr><th>Full Name</th><th>CNIC</th><th>Phone Number</th><th>Relationship to Tenant</th></tr><tr><td>{{ section.party.name|default:"________________" }}</td><td>{{ section.party.cnic|default:"________________" }}</td><td>{{ section.party.phone|default:"________________" }}</td><td>{{ section.party.relationship|default:"________________" }}</td></tr></table><div class="signature-row">{% if signature_config.show_thumb_impression %}Signature: __________________ &nbsp;&nbsp; Date: ______________ &nbsp;&nbsp; Thumb Impression: ______________{% else %}Signature: ____________________________ &nbsp;&nbsp;&nbsp;&nbsp; Date: ____________________________{% endif %}</div></section>{% endfor %}{% if signature_config.footer_text %}<p class="footer">{{ signature_config.footer_text }}</p>{% endif %}</body></html>