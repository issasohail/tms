{% extends 'base.html' %}
{% load static %}
{% load crispy_forms_tags %}

{% block title %}{% if form.instance.pk %}Update{% else %}Create{% endif %} Tenant{% endblock %}
{% block main_container_class %}container-fluid px-0{% endblock %}
{% block content %}
<div class="tenant-detail-compact td-form-page" id="tenantFormTop">
  <form method="post" enctype="multipart/form-data" id="tenantForm" class="td-form-layout" novalidate>
    {% csrf_token %}
  <div class="td-form-header">
    <div>
      <h2 class="td-title mb-1">{% if form.instance.pk %}Update Tenant{% else %}Create Tenant{% endif %}</h2>
      <div class="small text-muted">Tenant information, documents, preferences, address, and family records.</div>
    </div>

    {% if form.interested_in %}
      <div class="td-header-preferences">
        <div class="td-header-pref-title"><i class="fas fa-home me-1"></i> Preferences</div>
        <div class="td-form-interest-grid td-header-interest-grid">
          {% for choice in form.interested_in %}<label>{{ choice.tag }} {{ choice.choice_label }}</label>{% empty %}<span class="text-muted small">No options configured.</span>{% endfor %}
        </div>
        <div class="td-form-errors">{{ form.interested_in.errors }}</div>
      </div>
    {% endif %}

    <div class="td-hero-actions d-flex flex-wrap gap-2 justify-content-end">
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="history.back()"><i class="fas fa-arrow-left me-1"></i> Go Back</button>
      <button type="submit" form="tenantForm" class="btn btn-sm btn-success"><i class="fas fa-save me-1"></i> Save</button>
      <a href="{% if form.instance.pk %}{% url 'tenants:tenant_detail' form.instance.pk %}{% else %}{% url 'tenants:tenant_list' %}{% endif %}" class="btn btn-sm btn-outline-dark"><i class="fas fa-times me-1"></i> Cancel</a>
    </div>
  </div>

    <div class="d-none">
      {% if form.photo_crop %}{{ form.photo_crop }}{% endif %}
      {% if form.cnic_front_crop %}{{ form.cnic_front_crop }}{% endif %}
      {% if form.cnic_back_crop %}{{ form.cnic_back_crop }}{% endif %}

      {# Keep removed police fields posted so TenantForm does not fail required validation. #}
      {% if form.police_verification_status %}
        <input type="hidden" name="{{ form.police_verification_status.html_name }}" value="{{ form.instance.police_verification_status|default:'not_started' }}">
      {% endif %}
      {% if form.police_verification_date and form.instance.police_verification_date %}
        <input type="hidden" name="{{ form.police_verification_date.html_name }}" value="{{ form.instance.police_verification_date|date:'Y-m-d' }}">
      {% endif %}
      {% if form.police_verification_follow_up_date and form.instance.police_verification_follow_up_date %}
        <input type="hidden" name="{{ form.police_verification_follow_up_date.html_name }}" value="{{ form.instance.police_verification_follow_up_date|date:'Y-m-d' }}">
      {% endif %}
      {% if form.police_verification_remarks %}
        <input type="hidden" name="{{ form.police_verification_remarks.html_name }}" value="{{ form.instance.police_verification_remarks|default:'' }}">
      {% endif %}
      {% if form.police_verified_by and form.instance.police_verified_by_id %}
        <input type="hidden" name="{{ form.police_verified_by.html_name }}" value="{{ form.instance.police_verified_by_id }}">
      {% endif %}
    </div>

    {% if form.errors %}
      <div class="alert alert-danger py-2">
        <strong>Please fix the highlighted fields.</strong>
        {{ form.non_field_errors }}
        {% for field in form %}
          {% for error in field.errors %}<div>{{ field.label }}: {{ error }}</div>{% endfor %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="td-hero td-card td-form-documents-card card border-0 shadow-sm mb-3">
      <div class="card-header"><h6 class="mb-0"><i class="far fa-id-card text-secondary me-2"></i>Documents</h6></div>
      <div class="card-body py-3">
        <div class="td-form-doc-grid">
          <div class="td-form-doc-slot">
            <div class="td-form-doc-label">Photo</div>
            <label class="td-form-doc-preview image-upload-container" for="{{ form.photo.id_for_label }}">
              {% if form.instance.photo %}<img src="{{ form.instance.photo.url }}" class="public-file-preview" alt="Photo">{% else %}<i class="fas fa-user fa-2x"></i>{% endif %}
              {{ form.photo }}
            </label>
            <label class="td-form-upload-btn" for="{{ form.photo.id_for_label }}"><i class="fas fa-upload me-1"></i> Upload</label>
          </div>
          <div class="td-form-doc-slot">
            <div class="td-form-doc-label">CNIC Front</div>
            <label class="td-form-doc-preview image-upload-container" for="{{ form.cnic_front.id_for_label }}">
              {% if form.instance.cnic_front %}<img src="{{ form.instance.cnic_front.url }}" class="public-file-preview" alt="CNIC Front">{% else %}<i class="fas fa-id-card fa-2x"></i>{% endif %}
              {{ form.cnic_front }}
            </label>
            <label class="td-form-upload-btn" for="{{ form.cnic_front.id_for_label }}"><i class="fas fa-upload me-1"></i> Upload</label>
          </div>
          <div class="td-form-doc-slot">
            <div class="td-form-doc-label">CNIC Back</div>
            <label class="td-form-doc-preview image-upload-container" for="{{ form.cnic_back.id_for_label }}">
              {% if form.instance.cnic_back %}<img src="{{ form.instance.cnic_back.url }}" class="public-file-preview" alt="CNIC Back">{% else %}<i class="fas fa-id-card fa-2x"></i>{% endif %}
              {{ form.cnic_back }}
            </label>
            <label class="td-form-upload-btn" for="{{ form.cnic_back.id_for_label }}"><i class="fas fa-upload me-1"></i> Upload</label>
          </div>
        </div>
      </div>
    </div>

    <div class="card td-card td-form-personal-card shadow-sm mb-3">
      <div class="card-header"><h6 class="mb-0"><i class="far fa-user text-secondary me-2"></i>Personal Information</h6></div>
      <div class="card-body p-0">
        <div class="td-form-grid td-form-personal-grid">
          <div class="td-form-cell">{{ form.prefix.label_tag }}{{ form.prefix }}<div class="td-form-errors">{{ form.prefix.errors }}</div></div>
          <div class="td-form-cell">{{ form.first_name.label_tag }}{{ form.first_name }}<div class="td-form-errors">{{ form.first_name.errors }}</div></div>
          <div class="td-form-cell">{{ form.relation.label_tag }}{{ form.relation }}<div class="td-form-errors">{{ form.relation.errors }}</div></div>
          <div class="td-form-cell">{{ form.last_name.label_tag }}{{ form.last_name }}<div class="td-form-errors">{{ form.last_name.errors }}</div></div>
          <div class="td-form-cell">{{ form.number_of_family_member.label_tag }}{{ form.number_of_family_member }}<div class="td-form-errors">{{ form.number_of_family_member.errors }}</div></div>
          <div class="td-form-cell">{{ form.is_active.label_tag }}{{ form.is_active }}<div class="td-form-errors">{{ form.is_active.errors }}</div></div>
          <div class="td-form-cell">{{ form.cnic.label_tag }}{{ form.cnic }}<div class="td-form-errors">{{ form.cnic.errors }}</div></div>
          <div class="td-form-cell">{{ form.date_of_birth.label_tag }}{{ form.date_of_birth }}<div class="td-form-errors">{{ form.date_of_birth.errors }}</div></div>
          <div class="td-form-cell">
            {{ form.gender.label_tag }}
            {% with gender_value=form.gender.value|stringformat:"s" %}
              <select name="{{ form.gender.html_name }}" id="{{ form.gender.id_for_label }}">
                <option value="">Select</option>
                <option value="M" {% if gender_value == "M" or gender_value == "Male" or gender_value == "male" %}selected{% endif %}>Male</option>
                <option value="F" {% if gender_value == "F" or gender_value == "Female" or gender_value == "female" %}selected{% endif %}>Female</option>
              </select>
            {% endwith %}
            <div class="td-form-errors">{{ form.gender.errors }}</div>
          </div>
          <div class="td-form-cell">{{ form.occupation.label_tag }}{{ form.occupation }}<div class="td-form-errors">{{ form.occupation.errors }}</div></div>
          <div class="td-form-cell">{{ form.nationality.label_tag }}{{ form.nationality }}<div class="td-form-errors">{{ form.nationality.errors }}</div></div>
          <div class="td-form-cell">{{ form.city.label_tag }}{{ form.city }}<div class="td-form-errors">{{ form.city.errors }}</div></div>
          <div class="td-form-cell">{{ form.province.label_tag }}{{ form.province }}<div class="td-form-errors">{{ form.province.errors }}</div></div>
          <div class="td-form-cell">{{ form.country.label_tag }}{{ form.country }}<div class="td-form-errors">{{ form.country.errors }}</div></div>
          <div class="td-form-cell td-form-cell-email">{{ form.email.label_tag }}{{ form.email }}<div class="td-form-errors">{{ form.email.errors }}</div></div>
          <div class="td-form-cell td-form-cell-notes">{{ form.notes.label_tag }}{{ form.notes }}<div class="td-form-errors">{{ form.notes.errors }}</div></div>
        </div>
      </div>
    </div>

    <div class="card td-card td-form-contact-card shadow-sm mb-3">
      <div class="card-header"><h6 class="mb-0"><i class="fas fa-phone text-secondary me-2"></i>Contact, Employer & References</h6></div>
      <div class="card-body p-0">
        <div class="td-form-grid td-form-contact-grid">
          <div class="td-form-cell">{{ form.phone.label_tag }}{{ form.phone }}<div class="td-form-errors">{{ form.phone.errors }}</div></div>
          <div class="td-form-cell">{{ form.phone2.label_tag }}{{ form.phone2 }}<div class="td-form-errors">{{ form.phone2.errors }}</div></div>
          <div class="td-form-cell">{{ form.phone3.label_tag }}{{ form.phone3 }}<div class="td-form-errors">{{ form.phone3.errors }}</div></div>
          <div class="td-form-cell">{{ form.employer_name.label_tag }}{{ form.employer_name }}</div>
          <div class="td-form-cell">{{ form.employer_phone.label_tag }}{{ form.employer_phone }}</div>
          <div class="td-form-cell">{{ form.emergency_contact_name.label_tag }}{{ form.emergency_contact_name }}</div>
          <div class="td-form-cell">{{ form.emergency_contact_phone.label_tag }}{{ form.emergency_contact_phone }}</div>
          <div class="td-form-cell">{{ form.emergency_contact_relation.label_tag }}{{ form.emergency_contact_relation }}</div>
          <div class="td-form-cell">{{ form.reference_name_1.label_tag }}{{ form.reference_name_1 }}</div>
          <div class="td-form-cell">{{ form.reference_phone_1.label_tag }}{{ form.reference_phone_1 }}</div>
          <div class="td-form-cell">{{ form.reference_relation_1.label_tag }}{{ form.reference_relation_1 }}</div>
          <div class="td-form-cell">{{ form.reference_name_2.label_tag }}{{ form.reference_name_2 }}</div>
          <div class="td-form-cell">{{ form.reference_phone_2.label_tag }}{{ form.reference_phone_2 }}</div>
          <div class="td-form-cell">{{ form.reference_relation_2.label_tag }}{{ form.reference_relation_2 }}</div>
        </div>
      </div>
    </div>

    <div class="card td-card td-form-address-card shadow-sm mb-3">
      <div class="card-header"><h6 class="mb-0"><i class="fas fa-map-marker-alt text-secondary me-2"></i>Addresses & Notes</h6></div>
      <div class="card-body p-0">
        <div class="td-form-grid-4 td-form-grid td-form-address-grid">
          <div class="td-form-cell td-address-long-field">{{ form.temporary_address.label_tag }}{{ form.temporary_address }}</div>
          <div class="td-form-cell td-address-long-field">{{ form.permanent_address.label_tag }}{{ form.permanent_address }}</div>
          <div class="td-form-cell td-address-long-field">{{ form.working_address.label_tag }}{{ form.working_address }}</div>
          <div class="td-form-cell td-address-long-field">{{ form.address.label_tag }}{{ form.address }}</div>
        </div>
      </div>
    </div>


    <div class="card td-card td-form-family-card shadow-sm mb-3">
      <div class="card-header d-flex align-items-center gap-2">
        <h6 class="mb-0"><i class="fas fa-users text-secondary me-2"></i>Family Members</h6>
        {% if form.instance.pk %}
          <button class="btn-add-family ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#tenantFamilyAddBox">
            <i class="fas fa-plus"></i> Add Member
          </button>
        {% else %}
          <button type="button" class="btn-add-family ms-auto" id="addFamilyMember"><i class="fas fa-plus"></i> Add Member</button>
        {% endif %}
      </div>
      <div class="card-body">
        {% if form.instance.pk %}
          <div class="collapse mb-2" id="tenantFamilyAddBox">
            <div class="border rounded bg-light p-2">
              <div class="td-family-hidden-lease">
                <select name="lease" form="tenantFamilyLinkForm">
                  {% if family_target_leases %}
                    {% for lease_option in family_target_leases %}
                      <option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>
                    {% endfor %}
                  {% elif form.instance.leases.all %}
                    {% for lease_option in form.instance.leases.all %}
                      <option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>
                    {% endfor %}
                  {% elif form.instance.lease_set.all %}
                    {% for lease_option in form.instance.lease_set.all %}
                      <option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>
                    {% endfor %}
                  {% endif %}
                </select>
                <select name="lease" form="tenantFamilyCreateForm">
                  {% if family_target_leases %}
                    {% for lease_option in family_target_leases %}<option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>{% endfor %}
                  {% elif form.instance.leases.all %}
                    {% for lease_option in form.instance.leases.all %}<option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>{% endfor %}
                  {% elif form.instance.lease_set.all %}
                    {% for lease_option in form.instance.lease_set.all %}<option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>{% endfor %}
                  {% endif %}
                </select>
              </div>
              <div class="td-family-add-line td-family-link-line mb-2">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}" form="tenantFamilyLinkForm">
                <div>
                  <label class="form-label small mb-1">Existing Tenant</label>
                  <select name="family_member" class="form-select form-select-sm select2" form="tenantFamilyLinkForm">
                    <option value="">Select tenant</option>
                    {% for item in tenant_family_options %}
                      <option value="{{ item.pk }}">{{ item.get_full_name }}{% if item.cnic %} - {{ item.cnic }}{% endif %}</option>
                    {% endfor %}
                  </select>
                </div>
                <div>
                  <label class="form-label small mb-1">Relationship</label>
                  <select name="relation" class="form-select form-select-sm" required form="tenantFamilyLinkForm">
                    <option value="">Select</option>
                    {% for item in relationship_types %}
                      <option value="{{ item.pk }}">{{ item.name }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div><button type="submit" class="btn btn-sm btn-success w-100" form="tenantFamilyLinkForm">Link</button></div>
              </div>
              <div class="td-family-create-wrap">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}" form="tenantFamilyCreateForm">
                <div class="td-family-add-line td-family-create-line td-family-create-row-1">
                  <div>
                    <label class="form-label small mb-1">New Family Member Name</label>
                    <input name="full_name" class="form-control form-control-sm" form="tenantFamilyCreateForm">
                  </div>
                  <div><label class="form-label small mb-1">CNIC</label><input name="cnic" class="form-control form-control-sm" form="tenantFamilyCreateForm"></div>
                </div>
                <div class="td-family-add-line td-family-create-line td-family-create-row-2">
                  <div><label class="form-label small mb-1">Phone</label><input name="phone" class="form-control form-control-sm" form="tenantFamilyCreateForm"></div>
                  <div>
                    <label class="form-label small mb-1">Relationship</label>
                    <select name="relation" class="form-select form-select-sm" required form="tenantFamilyCreateForm">
                      <option value="">Select</option>
                      {% for item in relationship_types %}
                        <option value="{{ item.pk }}">{{ item.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div><button type="submit" class="btn btn-sm btn-primary w-100" form="tenantFamilyCreateForm">Create</button></div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}

        {% if existing_family %}
          <div class="td-mobile-list td-mobile-people-list td-form-family-existing-list mb-2">
            {% for member in existing_family %}
              <div class="td-mobile-person-row">
                <div class="td-mobile-sn">{{ forloop.counter }}</div>
                <div class="td-mobile-photo">
                  {% if member.family_member.photo %}
                    <img src="{{ member.family_member.photo.url }}" alt="{{ member.family_member.get_full_name }}">
                  {% else %}
                    <span><i class="fas fa-user"></i></span>
                  {% endif %}
                </div>
                <div class="td-mobile-person-detail">
                  <div class="td-mobile-person-name">
                    <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="text-decoration-none">{{ member.family_member.get_full_name|truncatechars:22 }}</a>
                    {% if member.family_member.age %}<span>({{ member.family_member.age }})</span>{% endif %}
                  </div>
                  <div class="td-mobile-muted">{{ member.relation|default:"-" }}</div>
                  <div class="td-mobile-phone">{{ member.family_member.cnic|default:"-" }}{% if member.family_member.phone %} | {{ member.family_member.phone }}{% endif %}</div>
                  <div class="td-mobile-actions">
                    <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="btn btn-sm btn-outline-dark">Detail</a>
                    <a href="{% url 'tenants:tenant_update' member.family_member.pk %}" class="btn btn-sm btn-outline-primary">Edit</a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% elif family_members %}
          <div class="td-mobile-list td-mobile-people-list td-form-family-existing-list mb-2">
            {% for member in family_members %}
              <div class="td-mobile-person-row">
                <div class="td-mobile-sn">{{ forloop.counter }}</div>
                <div class="td-mobile-photo">
                  {% if member.family_member.photo %}
                    <img src="{{ member.family_member.photo.url }}" alt="{{ member.family_member.get_full_name }}">
                  {% else %}
                    <span><i class="fas fa-user"></i></span>
                  {% endif %}
                </div>
                <div class="td-mobile-person-detail">
                  <div class="td-mobile-person-name">
                    <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="text-decoration-none">{{ member.family_member.get_full_name|truncatechars:22 }}</a>
                    {% if member.family_member.age %}<span>({{ member.family_member.age }})</span>{% endif %}
                  </div>
                  <div class="td-mobile-muted">{{ member.relation|default:"-" }}</div>
                  <div class="td-mobile-phone">{{ member.family_member.cnic|default:"-" }}{% if member.family_member.phone %} | {{ member.family_member.phone }}{% endif %}</div>
                  <div class="td-mobile-actions">
                    <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="btn btn-sm btn-outline-dark">Detail</a>
                    <a href="{% url 'tenants:tenant_update' member.family_member.pk %}" class="btn btn-sm btn-outline-primary">Edit</a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if not form.instance.pk %}
          <div id="familyMemberRows" style="display:flex;flex-direction:column;gap:.6rem;"></div>
        {% endif %}
      </div>
    </div>

    <div class="card td-card td-form-vehicle-card shadow-sm mb-3">
      <div class="card-header d-flex align-items-center gap-2">
        <h6 class="mb-0"><i class="fas fa-car text-secondary me-2"></i>Vehicle Information</h6>
        {% if form.instance.pk and family_target_leases %}
          <button class="btn-add-family ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#tenantVehicleAddBox">
            <i class="fas fa-plus"></i> Add Vehicle
          </button>
        {% endif %}
      </div>
      <div class="card-body">
        {% if form.instance.pk and family_target_leases %}
          <div class="collapse mb-2" id="tenantVehicleAddBox">
            <div class="border rounded bg-light p-2">
              <div class="td-vehicle-add-wrap">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}" form="tenantVehicleAddForm">
                <div class="td-vehicle-add-line td-vehicle-add-topline">
                  <div>
                    <label class="form-label small mb-1">Lease</label>
                    <select name="lease" class="form-select form-select-sm" form="tenantVehicleAddForm">
                      {% for lease_option in family_target_leases %}
                        <option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div>
                    <label class="form-label small mb-1">Photo</label>
                    <input name="vehicle_photo" type="file" accept="image/*" class="form-control form-control-sm" form="tenantVehicleAddForm">
                  </div>
                </div>
                <div class="td-vehicle-add-line td-vehicle-add-gridline">
                  <div>
                    <label class="form-label small mb-1">Vehicle Type</label>
                    <select name="vehicle_type" class="form-select form-select-sm" required form="tenantVehicleAddForm">
                      <option value="">Select type</option>
                      {% for vehicle_type in vehicle_types %}
                        <option value="{{ vehicle_type.pk }}">{{ vehicle_type.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div><label class="form-label small mb-1">Registration #</label><input name="registration_number" class="form-control form-control-sm" required form="tenantVehicleAddForm"></div>
                  <div><label class="form-label small mb-1">Make</label><input name="make" class="form-control form-control-sm" form="tenantVehicleAddForm"></div>
                  <div><label class="form-label small mb-1">Model</label><input name="model" class="form-control form-control-sm" form="tenantVehicleAddForm"></div>
                  <div><label class="form-label small mb-1">Color</label><input name="color" class="form-control form-control-sm" form="tenantVehicleAddForm"></div>
                  <div><label class="form-label small mb-1">Year</label><input name="year" type="number" min="1900" class="form-control form-control-sm" form="tenantVehicleAddForm"></div>
                  <div><label class="form-label small mb-1">Owner</label><input name="owner_name" class="form-control form-control-sm" form="tenantVehicleAddForm"></div>
                  <div><label class="form-label small mb-1">Owner CNIC</label><input name="owner_cnic" class="form-control form-control-sm" form="tenantVehicleAddForm"></div>
                  <div><label class="form-label small mb-1">Parking</label><input name="parking_slot" class="form-control form-control-sm" form="tenantVehicleAddForm"></div>
                  <div><button type="submit" class="btn btn-sm btn-primary w-100" form="tenantVehicleAddForm">Save Vehicle</button></div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}

