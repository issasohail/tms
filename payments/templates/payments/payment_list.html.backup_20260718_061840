  #payment-filter-form .form-select-sm{
    height:28px; padding:.18rem .35rem; font-size:.78rem;
  }

  /* ================================================================
     MOBILE VIEW (<768px) — placed last so it wins the cascade over
     the !important rules above it at this width.
     Filters: fixed 3-per-row grid -> exactly 2 rows for the 6 fields.
     Table rows become cards (flex + order), no table-class/Python
     changes needed. Serial number, every column's data, and every
     action button all remain visible.
     ================================================================ */
  @media (max-width:767px){
    .payment-list-container{ font-size:10px; }
    .payment-page-compact .card .card-body{ overflow: hidden; }

    .payment-filter-grid{
      display:grid !important;
      grid-template-columns:repeat(2, 1fr) !important;
      gap:.35rem .3rem !important;
      overflow-x:visible;
