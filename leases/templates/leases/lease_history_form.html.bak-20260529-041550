{% extends 'base.html' %}
{% load humanize %}

{% block content %}
<div class="container mt-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0">Edit Lease History #{{ history.renewal_number }}</h2>
    <a href="{% url 'leases:lease_history_detail' lease.pk history.pk %}" class="btn btn-secondary btn-sm">Cancel</a>
  </div>

  {% if is_active_history %}
    <div class="alert alert-warning py-2">
      This is the active/current history. Saving financial or date changes will also update the master lease and recurring charges after confirmation.
    </div>
  {% else %}
    <div class="alert alert-info py-2">
      This is an old/inactive history. Saving changes here will not update the master lease or recurring charges.
    </div>
  {% endif %}

  {% if requires_active_confirmation %}
    <div class="alert alert-danger">
      <div class="fw-bold mb-1">Confirm active financial update</div>
      Review the recurring charge preview below. Paid invoices will not be changed unless you explicitly update existing invoice items.
    </div>
  {% endif %}

  {% if billing_plan %}
    <div class="card mb-3">
      <div class="card-header bg-dark text-white py-2 px-3">Recurring Charge Preview</div>
      <div class="card-body p-0">
        <table class="table table-sm table-bordered mb-0">
          <thead class="table-light">
            <tr>
              <th>Category</th>
              <th class="text-end">Before</th>
              <th class="text-end">After</th>
              <th>Start</th>
              <th>End</th>
            </tr>
          </thead>
          <tbody>
            {% for row in billing_plan.recurring %}
              <tr>
                <td>{{ row.category }}</td>
                <td class="text-end">Rs {{ row.before.amount|default:0|floatformat:0|intcomma }}</td>
                <td class="text-end">Rs {{ row.after.amount|default:0|floatformat:0|intcomma }}</td>
                <td>{{ row.after.start_date|date:"M d, Y" }}</td>
                <td>{{ row.after.end_date|date:"M d, Y"|default:"-" }}</td>
              </tr>
            {% empty %}
              <tr><td colspan="5" class="text-muted p-3">No recurring charge changes detected.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}

  <form method="post" enctype="multipart/form-data" novalidate>
    {% csrf_token %}
    {% if requires_active_confirmation %}
      <input type="hidden" name="confirm_active_financial" value="1">
      {% for field in form %}
        <input type="hidden" name="{{ field.html_name }}" value="{{ field.value|default_if_none:'' }}">
      {% endfor %}
    {% endif %}

    <div class="card">
      <div class="card-header bg-dark text-white py-2 px-3">History Terms</div>
      <div class="card-body">
        {% if form.non_field_errors %}
          <div class="alert alert-danger">{{ form.non_field_errors }}</div>
        {% endif %}
        <div class="row g-3">
          {% for field in form %}
            <div class="{% if field.name == 'notes' %}col-12{% else %}col-md-4{% endif %}">
              <label class="form-label small mb-1" for="{{ field.id_for_label }}">{{ field.label }}</label>
              {{ field }}
              {% for error in field.errors %}
                <div class="text-danger small">{{ error }}</div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="text-muted small">Existing invoice items are not changed from this screen.</div>
        <div class="d-flex gap-2">
          <a href="{% url 'leases:lease_history_detail' lease.pk history.pk %}" class="btn btn-secondary btn-sm">Cancel</a>
          <button type="submit" class="btn btn-primary btn-sm">
            {% if requires_active_confirmation %}Confirm & Save{% else %}Save History{% endif %}
          </button>
        </div>
      </div>
    </div>
  </form>
</div>
{% endblock %}
