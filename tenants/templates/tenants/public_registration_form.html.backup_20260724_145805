{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tenant Registration</title>
  <link rel="icon" href="{% static 'images/favicon.ico' %}">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #f0f2f5;
      color: #111827;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: .86rem;
      min-height: 100vh;
    }
    .public-tenant-page {
      max-width: 1520px;
      margin: 0 auto;
      padding: 1rem 1rem 2.5rem;
    }
    .public-header {
      display: grid;
      grid-template-columns: minmax(260px, 1fr) auto minmax(210px, auto);
      align-items: start;
      gap: .75rem;
      margin-bottom: .75rem;
    }
    .public-title {
      font-size: 1.45rem;
      font-weight: 800;
      color: #111827;
      line-height: 1.15;
      margin: 0 0 .2rem;
    }
    .public-subtitle {
      color: #4b5563;
      font-size: .8rem;
      line-height: 1.35;
    }
    .public-preferences-top {
      align-self: center;
      min-width: 360px;
    }
    .public-preferences-title {
      font-size: .78rem;
      font-weight: 800;
      text-transform: uppercase;
      color: #111827;
      margin-bottom: .25rem;
    }
    .public-actions {
      display: flex;
      gap: .45rem;
      justify-content: flex-end;
      align-self: center;
    }
    .btn-submit-main {
      border: 1px solid #198754;
      background: #198754;
      color: #fff;
      border-radius: .45rem;
      padding: .38rem .75rem;
      font-size: .78rem;
      font-weight: 800;
      min-height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .35rem;
      white-space: nowrap;
    }
    .btn-submit-main:hover { background: #157347; color: #fff; }
    .public-notice {
      border: 1px solid #fde68a;
      background: #fffbeb;
      color: #92400e;
      border-radius: .55rem;
      padding: .45rem .65rem;
      font-size: .76rem;
      font-weight: 700;
      margin-bottom: .75rem;
    }
    .reg-alert {
      background: #fef2f2;
      border: 1px solid #fca5a5;
      color: #dc2626;
      border-radius: .55rem;
      padding: .55rem .75rem;
      font-size: .8rem;
      margin-bottom: .75rem;
      font-weight: 700;
    }
    .td-layout-top {
      display: grid;
      grid-template-columns: minmax(430px, 42%) minmax(0, 58%);
      gap: .75rem;
      align-items: start;
      margin-bottom: .75rem;
    }
    .td-layout-address-family {
      display: grid;
      grid-template-columns: minmax(430px, 1fr) minmax(430px, 1fr);
      gap: .75rem;
      align-items: start;
      margin-bottom: .75rem;
    }
    .td-card {
      background: #fff;
      border: 1px solid #dfe5ec;
      border-radius: .65rem;
      box-shadow: 0 1px 3px rgba(15,23,42,.08);
      overflow: hidden;
    }
    .td-card-header {
      background: #fff;
      border-bottom: 1px solid #e5e7eb;
      padding: .62rem .85rem;
      display: flex;
      align-items: center;
      gap: .45rem;
    }
    .td-card-header h6 {
      font-size: .9rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .01rem;
      color: #111827;
      margin: 0;
    }
    .td-card-body { padding: 0; }
    .td-form-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .td-form-grid-8 {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .td-address-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .td-form-cell,
    .field-wrap {
      padding: .62rem .75rem;
      border-right: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
      min-width: 0;
    }
    .td-form-cell:nth-child(6n) { border-right: 0; }
    .td-form-grid-8 .td-form-cell:nth-child(6n) { border-right: 1px solid #e5e7eb; }
    .td-form-grid-8 .td-form-cell:nth-child(8n) { border-right: 0; }
    .td-address-grid .td-form-cell:nth-child(4n) { border-right: 0; }
    .td-form-cell label,
    .td-form-cell .field-label,
    .field-wrap label,
    .field-label {
      display: block;
      color: #111827;
      font-size: .72rem !important;
      font-weight: 800 !important;
      margin-bottom: .24rem !important;
      text-transform: none;
      letter-spacing: 0;
    }
    .td-form-cell input:not([type='checkbox']):not([type='radio']):not([type='file']),
    .td-form-cell select,
    .td-form-cell textarea,
    .field-wrap input:not([type='checkbox']):not([type='radio']):not([type='file']),
    .field-wrap select,
    .field-wrap textarea,
    .field-control {
      width: 100%;
      min-height: 32px;
      border: 1px solid #d1d5db;
      border-radius: .45rem;
      padding: .3rem .5rem;
      font-size: .8rem;
      background: #fff;
      color: #111827;
    }
    .td-form-cell textarea,
    .field-wrap textarea,
    textarea.field-control {
      min-height: 74px;
      resize: vertical;
      line-height: 1.35;
    }
    .td-address-grid textarea,
    .td-address-grid textarea.field-control {
      min-height: 112px;
    }
    .td-form-cell input:focus,
    .td-form-cell select:focus,
    .td-form-cell textarea:focus,
    .field-control:focus {
      outline: none;
      border-color: #0d6efd;
      box-shadow: 0 0 0 .14rem rgba(13,110,253,.13);
    }
    .td-form-errors {
      color: #dc2626;
      font-size: .72rem;
      margin-top: .2rem;
    }
    .span-15 { grid-column: span 1; }
    .span-2 { grid-column: span 2; }
    .span-3 { grid-column: span 3; }
    .span-4 { grid-column: span 4; }
    .span-rest { grid-column: span 3; }
    .td-checkbox-cell {
      display: flex;
      align-items: center;
      gap: .45rem;
      min-height: 69px;
    }
    .td-checkbox-cell input[type='checkbox'] { accent-color: #0d6efd; }
    .td-form-doc-grid {
      display: grid;
      grid-template-columns: 120px repeat(2, minmax(170px, 1fr));
      gap: .55rem;
      align-items: start;
      padding: .75rem .85rem;
    }
    .td-form-doc-slot { min-width: 0; }
    .td-form-doc-label {
      font-size: .72rem;
      font-weight: 800;
      color: #111827;
      margin-bottom: .25rem;
    }
    .td-form-doc-preview {
      position: relative;
      width: 100%;
      height: 120px;
      border: 1px solid #d1d5db;
      border-radius: .45rem;
      background: #f8fafc;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      cursor: pointer;
    }
    .td-form-doc-slot:first-child .td-form-doc-preview {
      width: 120px;
      height: 120px;
      border-radius: 20px;
    }
    .td-form-doc-preview img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .td-form-doc-preview input[type='file'] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      z-index: 3;
    }
    .td-form-upload-btn,
    .btn-add-family,
    .btn-remove-family {
      border-radius: .45rem;
      padding: .22rem .5rem;
      font-size: .72rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .28rem;
      cursor: pointer;
    }
    .td-form-upload-btn,
    .btn-add-family {
      margin-top: .3rem;
      width: 100%;
      border: 1px solid #0d6efd;
      color: #0d6efd;
      background: #fff;
      text-decoration: none;
    }
    .btn-add-family { width: auto; margin-top: 0; }
    .btn-remove-family {
      border: 1px solid #dc3545;
      color: #dc3545;
      background: #fff;
    }
    .interest-grid,
    .td-form-interest-grid {
      display: flex;
      flex-wrap: wrap;
      gap: .35rem;
      align-items: center;
    }
    .interest-item,
    .td-form-interest-grid label {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      padding: .25rem .7rem;
      border-radius: .4rem;
      background: #dbe8ff;
      color: #0d6efd;
      font-size: .76rem !important;
      font-weight: 800 !important;
      border: 1px solid #cfe0ff;
      margin: 0 !important;
      white-space: nowrap;
    }
    .interest-item input[type='checkbox'],
    .td-form-interest-grid input[type='checkbox'] { accent-color: #0d6efd; }
    .family-add-body {
      padding: .6rem .75rem;
      display: grid;
      gap: .55rem;
    }
    .family-member-card {
      border: 1px solid #dfe5ec;
      border-radius: .65rem;
      background: #fff;
      overflow: hidden;
      margin: .6rem .75rem 0;
    }
    .family-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .6rem;
      padding: .48rem .6rem;
      border-bottom: 1px solid #e5e7eb;
      background: #f8fafc;
    }
    .family-card-num {
      font-size: .74rem;
      font-weight: 800;
      color: #64748b;
    }
    .family-member-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .public-family-existing {
      display: grid;
      gap: .45rem;
      padding: .6rem .75rem 0;
    }
    .public-family-row {
      display: grid;
      grid-template-columns: 26px 52px minmax(0, 1fr) auto;
      gap: .5rem;
      align-items: center;
      border: 1px solid #e5e7eb;
      border-radius: .55rem;
      padding: .45rem;
    }
    .public-family-sn {
      color: #64748b;
      text-align: center;
      font-weight: 700;
    }
    .public-family-photo img,
    .public-family-photo span {
      width: 52px;
      height: 52px;
      border-radius: .45rem;
      object-fit: cover;
      border: 1px solid #d1d5db;
      background: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
    }
    .public-family-name { font-weight: 800; overflow-wrap: anywhere; }
    .public-family-muted { color: #64748b; font-size: .74rem; font-weight: 600; }
    .vehicle-card-body { padding: .6rem .75rem; display: grid; gap: .6rem; }
    .vehicle-row-card {
      border: 1px solid #dfe5ec;
      border-radius: .65rem;
      overflow: hidden;
      background: #fff;
    }
    .vehicle-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .public-footer {
      position: sticky;
      bottom: 0;
      z-index: 10;
      display: flex;
      justify-content: flex-end;
      gap: .45rem;
      padding: .65rem 0 0;
      background: linear-gradient(to top, #f0f2f5 70%, rgba(240,242,245,0));
    }
    @media (max-width: 1200px) {
      .public-header { grid-template-columns: 1fr; }
      .public-preferences-top { min-width: 0; }
      .public-actions { justify-content: flex-start; }
      .td-layout-top,
      .td-layout-address-family { grid-template-columns: 1fr; }
      .td-form-grid,
      .td-form-grid-8,
      .td-address-grid,
      .family-member-grid,
      .vehicle-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .td-form-cell:nth-child(n),
      .td-form-grid-8 .td-form-cell:nth-child(n),
      .td-address-grid .td-form-cell:nth-child(n) { border-right: 1px solid #e5e7eb; }
      .td-form-cell:nth-child(3n),
      .td-form-grid-8 .td-form-cell:nth-child(3n),
      .td-address-grid .td-form-cell:nth-child(3n) { border-right: 0; }
      .span-rest,
      .span-4,
      .span-3,
      .span-2 { grid-column: span 3; }
    }
    @media (max-width: 768px) {
      .public-tenant-page { padding: .7rem .55rem 2rem; font-size: .82rem; }

    /* Mobile: keep documents in one row with square photo and rectangular CNIC images. */
    .td-form-doc-grid {
      grid-template-columns: minmax(70px, .72fr) minmax(96px, 1.14fr) minmax(96px, 1.14fr) !important;
      gap: .38rem;
      padding: .55rem;
    }
    .td-form-doc-slot:first-child .td-form-doc-preview,
    .td-form-doc-preview {
      width: 100%;
      height: 76px;
      border-radius: .45rem;
    }
    .td-form-doc-label {
      font-size: .64rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* Mobile: move employer fields to the end of the contact/ref grid. */
    .td-form-grid-8 > .td-form-cell:nth-child(4),
    .td-form-grid-8 > .td-form-cell:nth-child(5) {
      order: 30;
    }

      .public-title { font-size: 1.18rem; }
      .public-actions { display: grid; grid-template-columns: 1fr; width: 100%; }
      .td-form-grid,
      .td-form-grid-8,
      .td-address-grid,
      .family-member-grid,
      .vehicle-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .td-form-cell:nth-child(n),
      .td-form-grid-8 .td-form-cell:nth-child(n),
      .td-address-grid .td-form-cell:nth-child(n) { border-right: 0; }
      .td-form-doc-grid { grid-template-columns: 86px repeat(2, minmax(0, 1fr)); padding: .65rem; }
      .td-form-doc-slot:first-child .td-form-doc-preview,
      .td-form-doc-preview { width: 100%; height: 86px; border-radius: .45rem; }
      .td-form-cell,
      .field-wrap { padding: .48rem .55rem; }
      .span-rest,
      .span-4,
      .span-3,
      .span-2 { grid-column: span 2; }
      .public-family-row { grid-template-columns: 24px minmax(0, 1fr) auto; }
      .public-family-photo { display: none; }
    }
    @media (max-width: 420px) {
      .td-form-grid,
      .td-form-grid-8,
      .td-address-grid,
      .family-member-grid,
      .vehicle-grid { grid-template-columns: 1fr; }
      .span-rest,
      .span-4,
      .span-3,
      .span-2 { grid-column: span 1; }
      .td-form-doc-grid { grid-template-columns: minmax(58px, .7fr) minmax(82px, 1.15fr) minmax(82px, 1.15fr) !important; gap: .3rem; }
      .td-form-doc-slot:first-child .td-form-doc-preview, .td-form-doc-preview { height: 68px; }
      .td-form-doc-label { text-align: center; font-size: .6rem; }
    }
  
    .public-family-main { min-width: 0; }
    .public-family-remove-request {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .28rem;
      padding: .24rem .48rem;
      border: 1px solid #fecaca;
      border-radius: .45rem;
      background: #fff7f7;
      color: #b91c1c;
      font-size: .7rem;
      font-weight: 800;
      white-space: nowrap;
      cursor: pointer;
      margin: 0;
    }
    .public-family-remove-request input { margin: 0; accent-color: #dc2626; }
    .public-family-remove-request:has(input:checked) {
      background: #fee2e2;
      border-color: #f87171;
      color: #991b1b;
    }

    @media (max-width: 520px) {
      .public-family-row {
        grid-template-columns: 22px 46px minmax(0, 1fr);
      }
      .public-family-remove-request {
        grid-column: 2 / -1;
        justify-self: start;
        margin-top: .15rem;
      }
    }


    /* Existing public family/vehicle records shown for update/remove requests. */
    .public-record-list {
      display: grid;
      gap: .55rem;
      padding: .6rem .75rem;
      border-bottom: 1px solid #e5e7eb;
      background: #fff;
    }
    .public-record-title {
      font-size: .72rem;
      font-weight: 800;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: .03rem;
      margin-bottom: -.15rem;
    }
    .public-family-row,
    .public-vehicle-row {
      display: grid;
      grid-template-columns: 28px 54px minmax(0, 1fr);
      gap: .55rem;
      align-items: center;
      border: 1px solid #e5e7eb;
      border-radius: .55rem;
      padding: .45rem;
      background: #fff;
    }
    .public-record-sn {
      color: #64748b;
      text-align: center;
      font-weight: 800;
    }
    .public-record-photo img,
    .public-record-photo span {
      width: 54px;
      height: 54px;
      border-radius: .45rem;
      object-fit: cover;
      border: 1px solid #d1d5db;
      background: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      font-size: .72rem;
      text-align: center;
    }
    .public-record-name {
      font-weight: 800;
      overflow-wrap: anywhere;
      line-height: 1.25;
    }
    .public-record-muted {
      color: #475569;
      font-size: .74rem;
      font-weight: 600;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .public-record-badge {
      display: inline-flex;
      align-items: center;
      padding: .08rem .35rem;
      border-radius: 999px;
      background: #e0e7ff;
      color: #3730a3;
      border: 1px solid #c7d2fe;
      font-size: .66rem;
      font-weight: 800;
      margin-left: .25rem;
    }
    .public-record-actions {
      grid-column: 3 / -1;
      display: grid;
      grid-template-columns: auto minmax(180px, 1fr) auto;
      gap: .35rem;
      align-items: center;
      margin-top: .15rem;
    }
    .public-record-action-row {
      display: contents;
    }
    .btn-record-small {
      border: 1px solid #0d6efd;
      color: #0d6efd;
      background: #fff;
      border-radius: .45rem;
      padding: .25rem .55rem;
      font-size: .72rem;
      font-weight: 800;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .25rem;
      white-space: nowrap;
    }
    .btn-record-small:hover { background: #eff6ff; color: #0b5ed7; }
    .btn-record-danger {
      border-color: #dc2626;
      color: #dc2626;
    }
    .btn-record-danger:hover { background: #fef2f2; color: #b91c1c; }
    .public-update-panel {
      grid-column: 1 / -1;
      border-top: 1px dashed #d1d5db;
      padding-top: .55rem;
      margin-top: .1rem;
    }
    .public-update-grid-family {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: .45rem;
    }
    .public-update-grid-vehicle {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: .45rem;
    }
    .public-record-empty {
      padding: .55rem .75rem;
      color: #64748b;
      font-size: .78rem;
      border-bottom: 1px solid #e5e7eb;
    }

    @media (max-width: 1200px) {
      .public-family-row,
      .public-vehicle-row { grid-template-columns: 28px 54px minmax(0, 1fr); }
      .public-record-actions { grid-column: 1 / -1; grid-template-columns: 1fr; }
      .public-record-action-row { display: grid; grid-template-columns: 1fr; gap: .35rem; }
      .public-record-actions { grid-column: 3 / -1; }
      .public-update-grid-family,
      .public-update-grid-vehicle { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 768px) {
      .public-family-row,
      .public-vehicle-row { grid-template-columns: 24px 46px minmax(0, 1fr); }
      .public-record-actions { grid-column: 1 / -1; grid-template-columns: 1fr; }
      .public-record-action-row { display: grid; grid-template-columns: 1fr; gap: .35rem; }
      .public-record-photo img,
      .public-record-photo span { width: 46px; height: 46px; }
      .public-record-actions { grid-column: 2 / -1; }
      .public-record-action-row { grid-template-columns: 1fr; }
      .public-update-grid-family,
      .public-update-grid-vehicle { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 420px) {
      .public-update-grid-family,
      .public-update-grid-vehicle { grid-template-columns: 1fr; }
    }


    /* Compact existing family and vehicle rows: keep actions on the right without extra vertical space. */
    @media (min-width: 901px) {
      .public-family-row,
      .public-vehicle-row {
        grid-template-columns: 28px 54px minmax(0, 1fr) minmax(420px, 46%);
        align-items: center;
      }

      .public-family-row .public-record-actions,
      .public-vehicle-row .public-record-actions {
        grid-column: 4;
        grid-row: 1;
        margin-top: 0;
        align-self: center;
        justify-self: stretch;
      }

      .public-family-row .public-record-actions {
        display: grid;
        grid-template-columns: auto auto;
        grid-template-rows: auto auto;
        gap: .32rem;
        justify-content: end;
        align-items: center;
      }

      .public-family-row .public-record-actions > .btn-record-small {
        grid-column: 1;
        grid-row: 1;
      }

      .public-family-row .public-record-actions .public-record-action-row {
        display: contents;
      }

      .public-family-row .public-record-actions .public-record-action-row input.field-control {
        grid-column: 1 / 3;
        grid-row: 2;
        justify-self: stretch;
        min-width: 360px;
      }

      .public-family-row .public-record-actions .public-record-action-row label.btn-record-small {
        grid-column: 2;
        grid-row: 1;
      }

      .public-vehicle-row .public-record-actions {
        display: grid;
        grid-template-columns: auto minmax(220px, 1fr) auto;
        gap: .32rem;
        align-items: center;
      }

      .public-vehicle-row .public-record-action-row {
        display: contents;
      }

      .public-vehicle-row .public-record-action-row input.field-control {
        min-width: 220px;
      }

      .public-update-panel {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 900px) {
      .public-family-row,
      .public-vehicle-row {
        grid-template-columns: 24px 46px minmax(0, 1fr);
      }
      .public-record-actions {
        grid-column: 2 / -1 !important;
        grid-row: auto !important;
        display: grid !important;
        grid-template-columns: 1fr !important;
        gap: .35rem !important;
      }
      .public-record-action-row {
        display: grid !important;
        grid-template-columns: 1fr !important;
        gap: .35rem !important;
      }
    }

    /* Add Vehicle should reveal a blank vehicle card only when clicked. */
    #vehicleRows:empty {
      display: none !important;
    }


    /* ------------------------------------------------------------------
       MOBILE ONLY refinements: keep desktop/tablet untouched.
       Existing family/vehicle rows use compact phone-card layout.
       Vehicle add form stays hidden until Add Vehicle is clicked, then
       opens as a two-column mobile form like the provided mockup.
       ------------------------------------------------------------------ */
    @media (max-width: 768px) {
      .td-card-header {
        padding: .55rem .65rem;
      }

      .td-card-header h6 {
        font-size: .82rem;
      }

      .btn-add-family {
        min-height: 30px;
        padding: .18rem .48rem;
        font-size: .7rem;
      }

      .public-record-list {
        padding: .5rem .55rem;
        gap: .45rem;
      }

      .public-family-row,
      .public-vehicle-row {
        grid-template-columns: 22px 44px minmax(0, 1fr);
        gap: .42rem;
        align-items: start;
        padding: .42rem;
        border-radius: .55rem;
      }

      .public-record-sn {
        align-self: center;
        font-size: .78rem;
      }

      .public-record-photo img,
      .public-record-photo span {
        width: 44px;
        height: 44px;
        font-size: .62rem;
      }

      .public-record-name {
        font-size: .86rem;
        line-height: 1.15;
      }

      .public-record-badge {
        font-size: .6rem;
        padding: .04rem .28rem;
        margin-left: .16rem;
        max-width: 78px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
      }

      .public-record-muted {
        font-size: .69rem;
        line-height: 1.22;
      }

      .public-family-row .public-record-actions,
      .public-vehicle-row .public-record-actions {
        grid-column: 1 / -1 !important;
        display: grid !important;
        grid-template-columns: 48px minmax(0, 1fr) 86px !important;
        gap: .28rem !important;
        align-items: center;
        margin-top: .2rem;
      }

      .public-family-row .public-record-action-row,
      .public-vehicle-row .public-record-action-row {
        display: contents !important;
      }

      .public-family-row .btn-record-small,
      .public-vehicle-row .btn-record-small {
        min-height: 30px;
        padding: .18rem .36rem;
        font-size: .68rem;
        line-height: 1;
        width: 100%;
      }

      .public-family-row .btn-record-small:not(.btn-record-danger),
      .public-vehicle-row .btn-record-small:not(.btn-record-danger) {
        font-size: 0;
      }

      .public-family-row .btn-record-small:not(.btn-record-danger) i,
      .public-vehicle-row .btn-record-small:not(.btn-record-danger) i {
        font-size: .78rem;
        margin: 0 !important;
      }

      .public-family-row .btn-record-danger,
      .public-vehicle-row .btn-record-danger {
        font-size: 0;
        gap: .18rem;
        color: #dc2626;
      }

      .public-family-row .btn-record-danger::after,
      .public-vehicle-row .btn-record-danger::after {
        content: 'Remove';
        font-size: .66rem;
        font-weight: 800;
      }

      .public-family-row .btn-record-danger input,
      .public-vehicle-row .btn-record-danger input {
        width: 12px;
        height: 12px;
        margin: 0 !important;
      }

      .public-family-row .public-record-action-row input.field-control,
      .public-vehicle-row .public-record-action-row input.field-control {
        min-height: 30px;
        height: 30px;
        padding: .24rem .4rem;
        font-size: .74rem;
      }

      .public-update-panel {
        grid-column: 1 / -1;
      }

      .vehicle-card-body {
        padding: .5rem .55rem;
      }

      #vehicleRows {
        padding: 0;
      }

      .vehicle-row-card {
        margin: .1rem 0 0;
        border-radius: .58rem;
      }

      .vehicle-row-card .family-card-header {
        padding: .42rem .5rem;
      }

      .vehicle-row-card .vehicle-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      }

      .vehicle-row-card .field-wrap {
        padding: .45rem .5rem;
      }

      .vehicle-row-card .field-wrap:has(input[type='file']) {
        grid-column: 1 / -1;
      }

      .vehicle-row-card .field-control {
        min-height: 31px;
        font-size: .78rem;
      }

      .public-footer {
        justify-content: stretch;
        padding: .55rem 0 0;
      }

      .public-footer .btn-submit-main {
        width: 100%;
      }
    }

    @media (max-width: 360px) {
      .public-family-row .public-record-actions,
      .public-vehicle-row .public-record-actions {
        grid-template-columns: 42px minmax(0, 1fr) 76px !important;
      }

      .public-family-row .btn-record-danger::after,
      .public-vehicle-row .btn-record-danger::after {
        content: 'Remove';
        font-size: .61rem;
      }
    }



    /* Dynamic Add Vehicle form: photo first, then compact 3-column field grid. */
    .vehicle-add-template-wrap {
      display: grid;
      gap: .5rem;
    }
    .vehicle-add-template-top {
      display: grid;
      grid-template-columns: minmax(220px, .55fr);
    }
    .vehicle-add-template-wrap .vehicle-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    @media (max-width: 768px) {
      .vehicle-add-template-top,
      .vehicle-add-template-wrap .vehicle-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 420px) {
      .vehicle-add-template-top,
      .vehicle-add-template-wrap .vehicle-grid {
        grid-template-columns: 1fr;
      }
    }



    /* Final mobile document override: keep all three uploads in one row. */
    @media (max-width: 768px) {
      .td-form-doc-grid {
        grid-template-columns: minmax(70px, .72fr) minmax(96px, 1.14fr) minmax(96px, 1.14fr) !important;
        gap: .38rem !important;
        padding: .55rem !important;
      }
      .td-form-doc-slot:first-child .td-form-doc-preview,
      .td-form-doc-preview {
        width: 100% !important;
        height: 76px !important;
        border-radius: .45rem !important;
      }
      .td-form-grid-8 > .td-form-cell:nth-child(4),
      .td-form-grid-8 > .td-form-cell:nth-child(5) {
        order: 30 !important;
      }
    }
    @media (max-width: 420px) {
      .td-form-doc-grid {
        grid-template-columns: minmax(58px, .7fr) minmax(82px, 1.15fr) minmax(82px, 1.15fr) !important;
        gap: .3rem !important;
      }
      .td-form-doc-slot:first-child .td-form-doc-preview,
      .td-form-doc-preview {
        height: 68px !important;
      }
    }


    /* Approved responsive registration layout: five compact cards on desktop, two on tablet, one on mobile. */
    .registration-five-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.65rem; align-items:start; margin-bottom:.8rem; }
    .registration-five-grid > .td-card { margin-bottom:0 !important; min-width:0; }
    .registration-five-grid .party-card-body { padding:.55rem; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.38rem; }
    .registration-five-grid .party-card-body .wide { grid-column:1/-1; }
    .registration-five-grid .party-docs { grid-column:1/-1; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.3rem; }
    .registration-five-grid .party-docs label { font-size:.62rem; font-weight:800; }
    .registration-five-grid .party-docs input { font-size:.62rem; padding:.18rem; }
    .registration-five-grid .vehicle-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .registration-five-grid .vehicle-add-template-top { margin-bottom:.35rem; }
    .personal-compact .notes-cell { grid-column:span 4; }
    .personal-compact textarea { min-height:32px !important; height:32px; resize:vertical; }
    .contact-compact .employer-address-cell { grid-column:span 2; }
    .family-member-grid { grid-template-columns:repeat(5,minmax(0,1fr)); }
    .family-doc-row { grid-column:1/-1; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.4rem; padding:.45rem; border-top:1px solid #e5e7eb; }
    .family-doc-row .field-wrap { border:0; padding:.25rem; }
    @media (max-width:1199px) {
      .registration-five-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .registration-five-grid > .td-card:first-child { grid-column:1/-1; }
      .registration-five-grid .vehicle-grid { grid-template-columns:repeat(5,minmax(0,1fr)); }
    }
    @media (max-width:767px) {
      .registration-five-grid { grid-template-columns:1fr; gap:.55rem; }
      .registration-five-grid > .td-card:first-child { grid-column:auto; }
      .registration-five-grid .vehicle-grid { grid-template-columns:repeat(3,minmax(0,1fr)) !important; }
      .registration-five-grid .party-card-body { grid-template-columns:repeat(3,minmax(0,1fr)); }
      .registration-five-grid .party-card-body .wide { grid-column:span 2; }
      .registration-five-grid .party-docs { grid-template-columns:repeat(3,minmax(0,1fr)); }
      .family-member-grid { grid-template-columns:repeat(3,minmax(0,1fr)) !important; }
      .family-doc-row { grid-template-columns:repeat(3,minmax(0,1fr)); }
      .personal-compact .notes-cell { grid-column:span 3; }
    }
    @media (max-width:420px) {
      .registration-five-grid .vehicle-grid, .registration-five-grid .party-card-body, .family-member-grid { grid-template-columns:repeat(3,minmax(0,1fr)) !important; }
      .field-wrap, .td-form-cell { padding:.38rem .34rem; }
      .field-label, .td-form-cell label { font-size:.61rem !important; }
      .field-control, .td-form-cell input, .td-form-cell select { font-size:.69rem !important; padding:.24rem .3rem !important; }
    }

    /* Mobile personal information: always keep a deliberate three-column grid.
       The generic <=420px rule above changes td-form-grid to one column.
       A notes cell spanning three columns would then create implicit, uneven
       columns, which squeezed Prefix/Last name/DOB into narrow slivers. */
    @media (max-width: 767px) {
      .td-form-grid.personal-compact {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        grid-auto-columns: minmax(0, 1fr);
      }
      .personal-compact > .td-form-cell {
        grid-column: span 1 !important;
        min-width: 0;
        overflow: hidden;
        border-right: 1px solid #e5e7eb !important;
      }
      .personal-compact > .td-form-cell:nth-child(3n) {
        border-right: 0 !important;
      }
      .personal-compact > .notes-cell {
        grid-column: 1 / -1 !important;
        border-right: 0 !important;
      }
      .personal-compact input:not([type='checkbox']):not([type='radio']):not([type='file']),
      .personal-compact select,
      .personal-compact textarea {
        min-width: 0 !important;
        width: 100% !important;
      }
      .personal-compact label {
        line-height: 1.15;
        min-height: 1.4em;
        overflow-wrap: normal;
        word-break: normal;
      }
    }

    @media (max-width: 360px) {
      .personal-compact > .td-form-cell { padding: .34rem .28rem; }
      .personal-compact label { font-size: .58rem !important; }
      .personal-compact input:not([type='checkbox']):not([type='radio']):not([type='file']),
      .personal-compact select,
      .personal-compact textarea {
        font-size: .66rem !important;
        padding: .22rem .25rem !important;
      }
    }

</style>
</head>
<body>
<div class="public-tenant-page" id="tenantRegistrationTop">
  <div class="public-header">
    <div>
      <h1 class="public-title">Confirm Tenant Details</h1>
      <div class="public-subtitle">Tenant information, documents, preferences, address, family records, and vehicles.</div>
    </div>

    {% if form.interested_in %}
      <div class="public-preferences-top">
        <div class="public-preferences-title"><i class="fas fa-home me-1"></i> Preferences</div>
        <div class="td-form-interest-grid">
          {% for choice in form.interested_in %}
            <label>{{ choice.tag }} {{ choice.choice_label }}</label>
          {% empty %}
            <span class="text-muted small">No options configured.</span>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="public-actions">
      <button type="submit" form="tenantRegistrationForm" class="btn-submit-main">
        <i class="fas fa-paper-plane"></i> Submit for Review
      </button>
    </div>
  </div>

  <div class="public-notice"><i class="fas fa-clock me-1"></i> Submitted changes require admin approval before they are saved.</div>

  <form method="post" enctype="multipart/form-data" id="tenantRegistrationForm" novalidate>
    {% csrf_token %}
    {% if form.police_verification_status %}
      <input type="hidden" name="{{ form.police_verification_status.html_name }}" value="{{ form.police_verification_status.value|default:'not_started' }}">
    {% endif %}
    {% if form.non_field_errors %}<div class="reg-alert">{{ form.non_field_errors }}</div>{% endif %}

    <div class="td-layout-top">
      <div class="td-card">
        <div class="td-card-header"><i class="fas fa-id-card text-secondary"></i><h6>Documents</h6></div>
        <div class="td-form-doc-grid">
          <div class="td-form-doc-slot">
            <div class="td-form-doc-label">Photo</div>
            <label class="td-form-doc-preview image-upload-container" for="{{ form.photo.id_for_label }}">
              {% if tenant.photo %}<img src="{{ tenant.photo.url }}" class="public-file-preview" alt="Photo">{% else %}<i class="fas fa-user fa-2x placeholder-icon"></i>{% endif %}
              {{ form.photo }}
            </label>
            <label class="td-form-upload-btn" for="{{ form.photo.id_for_label }}"><i class="fas fa-upload"></i> Upload</label>
          </div>
          <div class="td-form-doc-slot">
            <div class="td-form-doc-label">CNIC Front</div>
            <label class="td-form-doc-preview image-upload-container" for="{{ form.cnic_front.id_for_label }}">
              {% if tenant.cnic_front %}<img src="{{ tenant.cnic_front.url }}" class="public-file-preview" alt="CNIC Front">{% else %}<i class="fas fa-id-card fa-2x placeholder-icon"></i>{% endif %}
              {{ form.cnic_front }}
            </label>
            <label class="td-form-upload-btn" for="{{ form.cnic_front.id_for_label }}"><i class="fas fa-upload"></i> Upload</label>
          </div>
          <div class="td-form-doc-slot">
            <div class="td-form-doc-label">CNIC Back</div>
            <label class="td-form-doc-preview image-upload-container" for="{{ form.cnic_back.id_for_label }}">
              {% if tenant.cnic_back %}<img src="{{ tenant.cnic_back.url }}" class="public-file-preview" alt="CNIC Back">{% else %}<i class="fas fa-id-card fa-2x placeholder-icon"></i>{% endif %}
              {{ form.cnic_back }}
            </label>
            <label class="td-form-upload-btn" for="{{ form.cnic_back.id_for_label }}"><i class="fas fa-upload"></i> Upload</label>
          </div>
        </div>
      </div>

      <div class="td-card">
        <div class="td-card-header"><i class="far fa-user text-secondary"></i><h6>Personal Information</h6></div>
        <div class="td-card-body">
          <div class="td-form-grid personal-compact">
            <div class="td-form-cell">{{ form.prefix.label_tag }}{{ form.prefix }}<div class="td-form-errors">{{ form.prefix.errors }}</div></div>
            <div class="td-form-cell">{{ form.first_name.label_tag }}{{ form.first_name }}<div class="td-form-errors">{{ form.first_name.errors }}</div></div>
            <div class="td-form-cell">{{ form.relation.label_tag }}{{ form.relation }}<div class="td-form-errors">{{ form.relation.errors }}</div></div>
            <div class="td-form-cell">{{ form.last_name.label_tag }}{{ form.last_name }}<div class="td-form-errors">{{ form.last_name.errors }}</div></div>
            <div class="td-form-cell">{{ form.number_of_family_member.label_tag }}{{ form.number_of_family_member }}<div class="td-form-errors">{{ form.number_of_family_member.errors }}</div></div>
            <div class="td-form-cell">{{ form.cnic.label_tag }}{{ form.cnic }}<div class="td-form-errors">{{ form.cnic.errors }}</div></div>
            <div class="td-form-cell">{{ form.date_of_birth.label_tag }}{{ form.date_of_birth }}<div class="td-form-errors">{{ form.date_of_birth.errors }}</div></div>
            <div class="td-form-cell">{{ form.gender.label_tag }}{{ form.gender }}<div class="td-form-errors">{{ form.gender.errors }}</div></div>
            <div class="td-form-cell">{{ form.occupation.label_tag }}{{ form.occupation }}<div class="td-form-errors">{{ form.occupation.errors }}</div></div>
            <div class="td-form-cell">{{ form.nationality.label_tag }}{{ form.nationality }}<div class="td-form-errors">{{ form.nationality.errors }}</div></div>
            <div class="td-form-cell">{{ form.city.label_tag }}{{ form.city }}<div class="td-form-errors">{{ form.city.errors }}</div></div>

            <div class="td-form-cell">{{ form.province.label_tag }}{{ form.province }}<div class="td-form-errors">{{ form.province.errors }}</div></div>
            <div class="td-form-cell">{{ form.country.label_tag }}{{ form.country }}<div class="td-form-errors">{{ form.country.errors }}</div></div>
            <div class="td-form-cell span-15">{{ form.email.label_tag }}{{ form.email }}<div class="td-form-errors">{{ form.email.errors }}</div></div>
            <div class="td-form-cell notes-cell">{{ form.notes.label_tag }}{{ form.notes }}<div class="td-form-errors">{{ form.notes.errors }}</div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="td-card mb-3">
      <div class="td-card-header"><i class="fas fa-phone text-secondary"></i><h6>Contact, Employer &amp; References</h6></div>
      <div class="td-card-body">
        <div class="td-form-grid-8 contact-compact">
          <div class="td-form-cell">{{ form.phone.label_tag }}{{ form.phone }}<div class="td-form-errors">{{ form.phone.errors }}</div></div>
          <div class="td-form-cell">{{ form.phone2.label_tag }}{{ form.phone2 }}<div class="td-form-errors">{{ form.phone2.errors }}</div></div>
          <div class="td-form-cell">{{ form.phone3.label_tag }}{{ form.phone3 }}<div class="td-form-errors">{{ form.phone3.errors }}</div></div>
          <div class="td-form-cell">{{ form.employer_name.label_tag }}{{ form.employer_name }}<div class="td-form-errors">{{ form.employer_name.errors }}</div></div>
          <div class="td-form-cell">{{ form.employer_phone.label_tag }}{{ form.employer_phone }}<div class="td-form-errors">{{ form.employer_phone.errors }}</div></div>
          <div class="td-form-cell employer-address-cell">{{ form.employer_address.label_tag }}{{ form.employer_address }}<div class="td-form-errors">{{ form.employer_address.errors }}</div></div>
          <div class="td-form-cell">{{ form.emergency_contact_name.label_tag }}{{ form.emergency_contact_name }}<div class="td-form-errors">{{ form.emergency_contact_name.errors }}</div></div>
          <div class="td-form-cell">{{ form.emergency_contact_phone.label_tag }}{{ form.emergency_contact_phone }}<div class="td-form-errors">{{ form.emergency_contact_phone.errors }}</div></div>
          <div class="td-form-cell">{{ form.emergency_contact_relation.label_tag }}{{ form.emergency_contact_relation }}<div class="td-form-errors">{{ form.emergency_contact_relation.errors }}</div></div>

          <div class="td-form-cell">{{ form.reference_name_1.label_tag }}{{ form.reference_name_1 }}<div class="td-form-errors">{{ form.reference_name_1.errors }}</div></div>
          <div class="td-form-cell">{{ form.reference_phone_1.label_tag }}{{ form.reference_phone_1 }}<div class="td-form-errors">{{ form.reference_phone_1.errors }}</div></div>
          <div class="td-form-cell">{{ form.reference_relation_1.label_tag }}{{ form.reference_relation_1 }}<div class="td-form-errors">{{ form.reference_relation_1.errors }}</div></div>
          <div class="td-form-cell">{{ form.reference_name_2.label_tag }}{{ form.reference_name_2 }}<div class="td-form-errors">{{ form.reference_name_2.errors }}</div></div>
          <div class="td-form-cell">{{ form.reference_phone_2.label_tag }}{{ form.reference_phone_2 }}<div class="td-form-errors">{{ form.reference_phone_2.errors }}</div></div>
          <div class="td-form-cell">{{ form.reference_relation_2.label_tag }}{{ form.reference_relation_2 }}<div class="td-form-errors">{{ form.reference_relation_2.errors }}</div></div>
        </div>
      </div>
    </div>

    <div class="td-layout-address-family">
      <div class="td-card">
        <div class="td-card-header"><i class="fas fa-map-marker-alt text-secondary"></i><h6>Addresses</h6></div>
        <div class="td-card-body">
          <div class="td-address-grid">
            <div class="td-form-cell">{{ form.temporary_address.label_tag }}{{ form.temporary_address }}<div class="td-form-errors">{{ form.temporary_address.errors }}</div></div>
            <div class="td-form-cell">{{ form.permanent_address.label_tag }}{{ form.permanent_address }}<div class="td-form-errors">{{ form.permanent_address.errors }}</div></div>
            <div class="td-form-cell">{{ form.working_address.label_tag }}{{ form.working_address }}<div class="td-form-errors">{{ form.working_address.errors }}</div></div>
            <div class="td-form-cell">{{ form.address.label_tag }}{{ form.address }}<div class="td-form-errors">{{ form.address.errors }}</div></div>
          </div>
        </div>
      </div>

      <div class="td-card">
        <div class="td-card-header">
          <i class="fas fa-users text-secondary"></i><h6>Family Members</h6>
          <button type="button" class="btn-add-family ms-auto" id="addFamilyMember"><i class="fas fa-plus"></i> Add Member</button>
        </div>
        <div class="td-card-body">
          {% if existing_family %}
            <div class="public-record-list">
