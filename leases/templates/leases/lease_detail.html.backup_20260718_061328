{% extends 'base.html' %}
{% load humanize static %}

{% block extra_css %}
<style>
/* ============================================================
   LEASE DETAIL  v3  —  clean, spacious, readable
   ============================================================ */

.ld-page { padding: 16px 0 48px; font-size: 14px; }
.ld-page, .ld-page button, .ld-page input, .ld-page select, .ld-page textarea { font-family: inherit; }

/* ---- header: 4 fixed/flex sections ---- */
.ld-header-row {
  display: grid;
  grid-template-columns: auto 96px minmax(260px, 360px) minmax(300px, 1fr);
  grid-template-areas: "media vehicle info actions";
  align-items: stretch; gap: 12px;
  padding-bottom: 12px; margin-bottom: 14px; border-bottom: 1px solid #e5e7eb;
}

/* Section 1 — photo + cnic front/back (fixed) */
.ld-hdr-media { grid-area:media; display:flex; align-items:flex-start; gap:6px; }
.ld-doc-tile {
  width:96px; background:#eff6ff; border:2px solid #2563eb; border-radius:7px;
  padding:5px; text-align:center;
}
.ld-doc-tile a { display:block; text-decoration:none; }
.ld-doc-img {
  width:100%; height:64px; object-fit:cover; border-radius:4px; background:#fff;
}
.ld-doc-label {
  display:block; margin-top:4px; font-size:10px; font-weight:700; color:#1d4ed8;
  text-transform:uppercase; letter-spacing:.3px;
}
.ld-doc-empty {
  height:64px; display:flex; align-items:center; justify-content:center;
  background:#fff; border-radius:4px; color:#94a3b8; font-size:10px;
}

/* Section 2 — tenant / lease identity (fixed, bigger type) */
.ld-hdr-info {
  grid-area:info; min-width: 260px; max-width: 360px;
  display: flex; flex-direction: column; justify-content: center;
  border-left: 1px solid #e5e7eb; padding-left: 16px;
}
.ld-hdr-name { font-size: 19px; font-weight: 700; color: #111827; line-height: 1.3; margin: 0; }
.ld-hdr-name a { color: inherit; text-decoration: none; }
.ld-hdr-line2 { font-size: 15px; font-weight: 600; color: #374151; line-height: 1.35; }
.ld-hdr-line3 { font-size: 12px; color: #6b7280; margin-top: 4px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.ld-hdr-balance { font-size: 13px; font-weight: 700; color: #dc2626; margin-top: 3px; }

/* Section 3 — actions (fills remaining space, right aligned) */
.ld-hdr-actions {
  grid-area:actions; display: flex; align-content: center; align-items: center; justify-content: flex-start;
  flex-wrap: wrap; gap: 3px; min-width: 0;
}
.ld-hdr-actions .btn { font-size:10px; line-height:1.2; padding:4px 7px; white-space:nowrap; }
.ld-hdr-actions .btn-group { display:inline-flex; }
.ld-wa-btn { display:flex; align-items:center; gap:8px; }
.ld-wa-btn .ld-wa-api { display:flex; align-items:center; gap:4px; border-left:1px solid rgba(255,255,255,.4); padding-left:8px; font-weight:400; font-size:11px; }
.ld-wa-btn .ld-wa-api input { margin:0; }

/* Police report segmented button: report | copy | whatsapp, styled as one control */
.ld-police-group { display:flex; }
.ld-police-group .btn { border-right:1px solid rgba(255,255,255,.35); border-radius:0; }
.ld-police-group .btn:first-child { border-top-left-radius:var(--bs-btn-border-radius,.25rem); border-bottom-left-radius:var(--bs-btn-border-radius,.25rem); }
.ld-police-group .btn:last-child { border-right:0; border-top-right-radius:var(--bs-btn-border-radius,.25rem); border-bottom-right-radius:var(--bs-btn-border-radius,.25rem); }
.ld-police-open { padding-left:6px !important; padding-right:6px !important; }
.ld-police-copy, .ld-police-wa { min-width:25px; padding-left:5px !important; padding-right:5px !important; }

/* Section 4 — vehicle thumbnail (fixed) */
.ld-hdr-vehicle {
  grid-area:vehicle; text-align: center;
  border-left: 0; padding-left: 0;
}
.ld-hdr-vehicle .ld-doc-tile { width: 96px; }

.kv-danger  { color:#dc2626 !important; }
.kv-warning { color:#d97706 !important; }

/* ---- Badges ---- */
.ld-badge {
  display:inline-block; padding:2px 9px; border-radius:20px;
  font-size:11px; font-weight:600; letter-spacing:.2px;
}
.ld-badge-green  { background:#dcfce7; color:#15803d; }
.ld-badge-red    { background:#fee2e2; color:#b91c1c; }
.ld-badge-amber  { background:#fef9c3; color:#92400e; }
.ld-badge-blue   { background:#dbeafe; color:#1d4ed8; }
.ld-badge-gray   { background:#f3f4f6; color:#374151; }
.ld-badge-purple { background:#ede9fe; color:#6d28d9; }
.ld-police-verified    { background:#dcfce7; color:#15803d; }
.ld-police-rejected    { background:#fee2e2; color:#b91c1c; }
.ld-police-pending,
.ld-police-follow_up   { background:#fef9c3; color:#92400e; }
.ld-police-not_started { background:#f3f4f6; color:#6b7280; }

/* ---- Overview card ---- */
.ld-overview-card {
  background:#fff; border:1px solid #e5e7eb; border-radius:10px;
  margin-bottom:14px; overflow:hidden;
}
.ld-overview-card-header {
  background:#f8fafc; border-bottom:1px solid #e5e7eb;
  padding:9px 16px; font-size:13px; font-weight:700; color:#374151;
}

/* 6-col grid */
.ld-ov-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}
@media (min-width:640px)  { .ld-ov-grid { grid-template-columns: repeat(3,1fr); } }
@media (min-width:900px)  { .ld-ov-grid { grid-template-columns: repeat(6,1fr); } }

.ld-ov-col {
  padding: 14px 14px 14px 16px;
  border-right: 1px solid #f1f5f9;
}
.ld-ov-col:last-child { border-right: none; }

.ld-ov-head {
  font-size: 10px; font-weight: 700; color: #111827;
  text-transform: uppercase; letter-spacing: .6px;
  padding-bottom: 8px; margin-bottom: 8px;
  border-bottom: 1px solid #e5e7eb;
}

/* field rows inside each column */
.ld-f {
  margin-bottom: 9px;
}
.ld-f:last-child { margin-bottom: 0; }
.ld-f-label {
  font-size: 10px; color: #111827; font-weight: 600;
  text-transform: uppercase; letter-spacing: .3px;
  margin-bottom: 2px;
}
.ld-f-value {
  font-size: 13px; color: #111827; font-weight: 500; line-height: 1.35;
}
.ld-f-value a { color: #2563eb; text-decoration: none; }
.ld-f-value a:hover { text-decoration: underline; }
.ld-agreement-parties .ld-f-value a { color:#111827; }
.ld-f-value.val-danger  { color: #dc2626; font-weight: 700; }
.ld-f-value.val-success { color: #15803d; }

/* security deposit rows inside col 8 */
.dep-row {
  display:flex; justify-content:space-between;
  font-size:12px; padding:4px 7px; border-radius:4px; margin-bottom:2px;
}
.dep-row.dep-warn { background:#fef9c3; }
.dep-row.dep-ok   { background:#f0fdf4; }
.dep-k { color:#111827; font-weight:600; }
.dep-v { font-weight:600; }

/* ---- Tab nav ---- */
.ld-tab-nav {
  display: flex;
  flex-wrap: nowrap;
  gap: 5px;
  margin-bottom: 0;
  overflow-x: auto;
  scrollbar-width: thin;
}

.ld-tab-btn {
  flex: 1 0 135px;
  padding: 10px 8px;
  font-size: 13px; font-weight: 500; color: #6b7280;
  background: #f3f4f6; border: 1px solid #e5e7eb;
  border-bottom: none; border-radius: 7px 7px 0 0;
  cursor: pointer; text-align: center;
  transition: background .12s, color .12s;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  user-select: none;
}
.ld-tab-btn:hover  { background: #e5e7eb; color: #374151; }
.ld-tab-btn.active {
  background: #fff; color: #1d4ed8; font-weight: 700;
  border-color: #e5e7eb; border-bottom-color: #fff;
  position: relative; z-index: 1;
}
.ld-tab-content-wrap {
  background: #fff; border: 1px solid #e5e7eb;
  border-radius: 0 0 10px 10px; padding: 16px;
  margin-top: -1px; margin-bottom: 16px;
}
.ld-tab-pane        { display: none; }
.ld-tab-pane.active { display: block; }

/* ---- Inner cards (inside tabs) ---- */
.ld-inner-card {
  border: 1px solid #e5e7eb; border-radius: 7px;
  overflow: hidden; margin-bottom: 12px;
}
.ld-inner-card:last-child { margin-bottom: 0; }
.ld-inner-head {
  background: #f8fafc; border-bottom: 1px solid #e5e7eb;
  padding: 8px 13px; font-size: 12px; font-weight: 700; color: #374151;
  display: flex; justify-content: space-between; align-items: center;
}
.ld-inner-body { padding: 11px 13px; }

/* ---- kv rows inside tabs ---- */
.ld-row {
  display:flex; justify-content:space-between; align-items:baseline;
  padding:4px 0; border-bottom:.5px solid #f1f5f9; font-size:13px; gap:8px;
}
.ld-row:last-child { border-bottom:none; }
.ld-rk { color:#111827; font-weight:600; flex-shrink:0; min-width:130px; }
.ld-rv { color:#111827; font-weight:500; text-align:right; }

/* ---- layout helpers ---- */
.ld-g2 { display:grid; grid-template-columns:1fr; gap:12px; }
@media (min-width:576px) { .ld-g2 { grid-template-columns:1fr 1fr; } }
.ld-g3 { display:grid; grid-template-columns:1fr; gap:12px; }
@media (min-width:576px) { .ld-g3 { grid-template-columns:1fr 1fr; } }
@media (min-width:992px) { .ld-g3 { grid-template-columns:repeat(3,1fr); } }

/* ---- activity rows ---- */
.ld-act {
  display:flex; justify-content:space-between; align-items:center;
  padding:6px 0; border-bottom:.5px solid #f3f4f6; font-size:13px; gap:8px;
}
.ld-act:last-child { border-bottom:none; }
.ld-act-d  { font-size:11px; color:#6b7280; }
.ld-act-l  { color:#111827; }
.ld-act-a  { font-weight:600; white-space:nowrap; }
.ld-act-sn { font-size:11px; font-weight:700; color:#9ca3af; flex-shrink:0; }

/* ---- tables ---- */
.ld-tw { overflow-x:auto; -webkit-overflow-scrolling:touch; }
.ld-tbl {
  width:100%; border-collapse:collapse; font-size:13px; min-width:480px;
}
.ld-tbl th {
  background:#f8fafc; padding:7px 10px; font-size:11px; font-weight:700;
  color:#111827; border-bottom:1px solid #e5e7eb; text-align:left; white-space:nowrap;
}
.ld-tbl td { padding:7px 10px; border-bottom:.5px solid #f3f4f6; color:#111827; }
.ld-tbl tr:last-child td { border-bottom:none; }
.ld-renewal-actions .btn { padding:4px 7px; font-size:11px; line-height:1.2; }

.ld-empty { padding:14px 0; font-size:13px; color:#9ca3af; }
.ld-sec-title {
  font-size:11px; font-weight:700; color:#374151; margin-bottom:8px;
  text-transform:uppercase; letter-spacing:.4px;
}
.ld-file-form { display:grid; grid-template-columns:1fr; gap:8px; }
@media (min-width:768px) { .ld-file-form { grid-template-columns:1.5fr .8fr 1.2fr auto; align-items:end; } }
.ld-file-list { display:grid; gap:8px; }
.ld-file-row {
  display:grid; grid-template-columns:1fr; gap:8px;
  border:1px solid #e5e7eb; border-radius:7px; padding:9px; background:#fff;
}
.ld-file-serial { font-size:12px; font-weight:700; color:#6b7280; }
@media (min-width:860px) { .ld-file-row { grid-template-columns:34px minmax(220px, 1.5fr) 150px minmax(120px, .9fr) 115px auto; align-items:center; } }
.ld-file-name { font-size:13px; font-weight:700; overflow-wrap:anywhere; }
.ld-file-sub { font-size:11px; color:#6b7280; overflow-wrap:anywhere; }
.ld-file-actions { display:flex; flex-wrap:nowrap; gap:3px; justify-content:flex-end; white-space:nowrap; }
.ld-file-actions form { display:inline-flex; margin:0; }
.ld-file-action-btn { width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center; padding:0; }
.ld-file-actions .ld-file-action-btn i { color:#fff !important; font-size:12px; line-height:1; }
.ld-file-missing { font-size:10px; }
.ld-file-category-select { font-size:11px; padding:2px 5px; min-height:26px; }
.ld-file-category-display {
  border:0; background:transparent; padding:0; color:#111827;
  font-size:11px; font-weight:600; line-height:1.25; text-align:left; cursor:pointer;
}
.ld-file-category-display:hover { text-decoration:underline; }
.ld-file-upload-actions { display:flex; align-items:center; flex-wrap:nowrap; gap:5px; }
.ld-family-mobile-only { display:none; }
.ld-vehicle-photo-btn {
  display:inline-block;
  border:0;
  background:transparent;
  padding:0;
  color:#2563eb;
  font-weight:700;
  text-decoration:none;
  cursor:pointer;
}
.ld-vehicle-thumb {
  width:56px;
  height:42px;
  object-fit:cover;
  border-radius:5px;
  border:1px solid #e5e7eb;
}
.ld-image-preview-meta {
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));
  gap:6px;
  margin-top:10px;
}
.ld-image-preview-meta div {
  border:1px solid #e5e7eb;
  border-radius:6px;
  padding:6px 8px;
  background:#f8fafc;
  font-size:12px;
}
.ld-image-preview-meta span {
  display:block;
  color:#6b7280;
  font-size:10px;
  font-weight:700;
  text-transform:uppercase;
}


/* ============================================================
   MOBILE ONLY: 0–699px
   Tablet (700–999px) and desktop (1000px+) retain the current layout.
   ============================================================ */
.ld-mobile-section-nav { display:none; }
.ld-mobile-top-link { display:none; }

/* Tablet keeps text-only buttons (space is tight but not touch-critical). Mobile restores
   icons below, since icon + short label scans faster than text alone at small widths. */
@media (min-width: 700px) and (max-width: 999.98px) {
  .ld-header-row {
    grid-template-columns:auto minmax(260px,1fr) 96px;
    grid-template-areas:"media info vehicle" "actions actions actions";
  }
}
@media (max-width: 999.98px) {
  .ld-mobile-section-nav i,
  .ld-mobile-top-link i { display:none !important; }
}

@media (max-width: 699.98px) {
  html { scroll-behavior:smooth; }

  /* Tighter inner-card spacing so key/value rows don't read as empty space. */
  .ld-inner-head { padding:7px 10px; color:#000; font-weight:800; }
  .ld-sec-title { color:#000; font-weight:800; }
  .ld-inner-body { padding:8px 10px; }
  .ld-row { padding:3px 0; font-size:12.5px; }
  .ld-rk { min-width:0; flex:0 0 44%; }
  .ld-page { padding:8px 0 36px; font-size:14px; overflow-x:hidden; }
  #lease-detail-top { scroll-margin-top:72px; }

  /* Header becomes a compact vertical layout. */
  .ld-header-row {
    display:grid; grid-template-columns:repeat(4,minmax(0,1fr));
    grid-template-areas:"media media media vehicle" "info info info info" "actions actions actions actions";
    gap:7px;
    padding-bottom:10px; margin-bottom:10px;
  }
  .ld-hdr-media {
    width:100%; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px;
  }
  .ld-doc-tile, .ld-hdr-vehicle .ld-doc-tile { width:100%; min-width:0; }
  .ld-doc-img, .ld-doc-empty { height:68px; }
  .ld-hdr-info {
    min-width:0; max-width:none; width:100%;
    border-left:0; padding-left:0;
  }
  .ld-hdr-name { font-size:18px; }
  .ld-hdr-line2 { font-size:13px; }
  .ld-hdr-actions {
    width:100%; justify-content:flex-start; gap:3px;
  }
  .ld-hdr-actions .btn,
  .ld-hdr-actions .btn-group,
  .ld-hdr-actions .ld-wa-btn { font-size:10px; }
  .ld-hdr-actions .btn {
    min-height:0; padding:4px 7px;
    display:inline-flex; align-items:center; gap:5px;
  }
  .ld-hdr-actions .btn > i { display:inline-block !important; font-size:12px; }
  .ld-wa-btn { min-height:0; }
  .ld-wa-btn .ld-wa-api { font-size:10px; }
  .ld-police-group .btn { min-height:0; }
  .ld-police-copy, .ld-police-wa { min-width:25px; justify-content:center; }
  .ld-hdr-vehicle {
    width:100%; border-left:0; padding-left:0; text-align:left;
  }
  .ld-hdr-vehicle .ld-doc-tile { max-width:none; }

  /* Section chips: one horizontally scrollable row instead of a multi-row grid,
     so navigation no longer pushes real content below the fold. */
  .ld-mobile-section-nav {
    display:flex; flex-wrap:wrap; gap:4px;
    margin:0 0 8px; padding:5px;
    background:#fff; border:1px solid #e5e7eb; border-radius:8px;
    overflow:visible;
  }
  .ld-mobile-section-badge {
    flex:1 1 calc(25% - 4px);
    display:flex; align-items:center; justify-content:center;
    min-width:0; min-height:24px; padding:3px 5px;
    border:1px solid #bfdbfe; border-radius:16px;
    background:#eff6ff; color:#1d4ed8;
    font-size:9px; font-weight:700; line-height:1.05;
    text-align:center; text-decoration:none; white-space:normal;
  }

  /* Overview columns stack as individual cards. */
  .ld-overview-card { overflow:visible; background:transparent; border:0; }
  .ld-overview-card-header {
    border:1px solid #e5e7eb; border-radius:8px 8px 0 0;
  }
  .ld-ov-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
  .ld-ov-col {
    grid-column:1 / -1;
    background:#fff; border:1px solid #e5e7eb !important; border-radius:8px;
    padding:11px 12px; margin-top:0;
  }
  .ld-ov-head { color:#000; font-size:11px; font-weight:800; letter-spacing:.45px; }
  .ld-ov-col.ld-mobile-two-col,
  .ld-ov-col.ld-mobile-property-grid {
    display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px 10px;
  }
  .ld-ov-col.ld-mobile-property-grid { grid-template-columns:repeat(6,minmax(0,1fr)); }
  .ld-mobile-two-col .ld-ov-head,
  .ld-mobile-property-grid .ld-ov-head { grid-column:1 / -1; margin-bottom:0; }
  .ld-mobile-property-grid .ld-mobile-third { grid-column:span 2; }
  .ld-mobile-property-grid .ld-mobile-half { grid-column:span 3; }
  .ld-mobile-property-grid .ld-mobile-full { grid-column:1 / -1; }
  .ld-mobile-two-col .ld-f,
  .ld-mobile-property-grid .ld-f { margin-bottom:0; min-width:0; }
  .ld-agreement-parties .ld-f-value {
    font-size:11px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .ld-mobile-half-card { grid-column:span 1; display:block !important; }
  .ld-mobile-half-card .ld-ov-head { margin-bottom:7px; }
  .ld-mobile-half-card .ld-f { margin-bottom:7px; }
  .ld-mobile-half-card .dep-row { padding:3px 4px; gap:4px; }
  .ld-mobile-half-card .dep-v { text-align:right; }
  .ld-ov-head { margin-bottom:7px; }

  /* Desktop tab strip is replaced by the badge navigation above. */
  .ld-tab-nav { display:none !important; }
  .ld-tab-content-wrap {
    border:0; background:transparent; padding:0; margin:0;
  }
  .ld-tab-pane,
  .ld-tab-pane.active {
    display:block !important;
    position:relative;
    background:#fff; border:1px solid #e5e7eb; border-radius:8px;
    padding:12px; margin:0 0 10px;
    scroll-margin-top:72px;
  }
  .ld-mobile-top-link {
    display:inline-flex; align-items:center; justify-content:center;
    float:none; flex:0 0 auto; margin:0 0 0 auto; padding:3px 8px;
    border:1px solid #d1d5db; border-radius:16px;
    background:#fff; color:#475569; font-size:10px; font-weight:700;
    text-decoration:none;
  }
  .ld-tab-pane::after { content:""; display:block; clear:both; }

  /* Avoid wide renewal and detail tables breaking the viewport. Tables opted into
     .ld-mobile-cards render as a stack of cards instead of a scrolling table. */
  .ld-tw { width:100%; overflow-x:auto; }
  .ld-tbl { min-width:640px; }
  .ld-inner-card { clear:both; }

  .ld-tw.ld-mobile-cards { overflow-x:visible; }
  .ld-tw.ld-mobile-cards .ld-tbl { min-width:0 !important; width:100% !important; }
  .ld-mobile-cards thead { display:none; }
  .ld-mobile-cards tbody, .ld-mobile-cards tr, .ld-mobile-cards td { display:block; width:100%; }
  .ld-mobile-cards tr {
    border:1px solid #e5e7eb; border-radius:8px;
    padding:8px 10px; margin:0 0 8px; background:#fff;
  }
  .ld-mobile-cards tr:last-child { margin-bottom:0; }
  .ld-mobile-cards td {
    display:flex; align-items:flex-start; justify-content:space-between; gap:8px;
    padding:3px 0 !important; border:0 !important; font-size:12px; text-align:right;
  }
  .ld-mobile-cards td::before {
    content:attr(data-label); font-weight:600; color:#111827;
    text-align:left; flex:0 0 42%;
  }
  .ld-mobile-cards td.ld-empty { display:block; text-align:center; }
  .ld-mobile-cards td.ld-empty::before { content:none; }
  .ld-mobile-cards td.ld-td-actions { text-align:left; }
  .ld-mobile-cards td.ld-td-actions::before { content:none; }
  .ld-mobile-cards td.ld-td-actions > div { justify-content:flex-start; }

  /* Lease Renewal: same card stack, but fields lay out three-per-row. */
  .ld-mobile-cards-3col tr { display:grid; grid-template-columns:repeat(3,1fr); gap:7px 8px; }
  .ld-mobile-cards-3col td { display:block; text-align:left; padding:0 !important; font-size:11.5px; }
  .ld-mobile-cards-3col td::before {
    content:attr(data-label); display:block; text-align:left;
    font-weight:600; color:#111827; font-size:9.5px;
    text-transform:uppercase; letter-spacing:.02em; margin-bottom:1px;
  }
  .ld-mobile-cards-3col td.ld-td-actions {
    grid-column:1 / -1; margin-top:2px; padding-top:6px !important;
    border-top:1px dashed #e5e7eb;
  }
  .ld-mobile-cards-3col td.ld-td-actions::before { content:none; }
  .ld-mobile-cards-3col td.ld-empty { grid-column:1 / -1; }

  .ld-compact-mobile-table tr { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px 10px; }
  .ld-compact-mobile-table td { display:block; text-align:left; padding:0 !important; min-width:0; overflow-wrap:anywhere; }
  .ld-compact-mobile-table td::before {
    content:attr(data-label); display:block; text-align:left; margin-bottom:1px;
    font-size:9px; font-weight:600; color:#111827; text-transform:uppercase;
  }
  .ld-compact-mobile-table td.ld-td-actions { grid-column:1 / -1; padding-top:4px !important; }
  .ld-compact-mobile-table td.ld-td-actions::before { content:none; }
  .ld-compact-mobile-table .ld-vehicle-thumb { width:46px; height:34px; }

  .ld-family-table tr { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .ld-family-table .ld-family-sn,
  .ld-family-table .ld-family-name,
  .ld-family-table .ld-family-dob,
  .ld-family-table .ld-family-age { display:none !important; }
  .ld-family-table .ld-family-mobile-only { display:block !important; }
  .ld-family-table .ld-family-mobile-id { order:1; }
  .ld-family-table .ld-family-relation { order:2; }
  .ld-family-table .ld-family-cnic { order:3; }
  .ld-family-table .ld-family-mobile-dob-age { order:4; }
  .ld-family-table .ld-family-phone,
  .ld-family-table td.ld-td-actions { display:none !important; }
  .ld-family-table .ld-family-mobile-last-row {
    display:flex !important; grid-column:1 / -1; order:5;
    align-items:flex-end; justify-content:space-between; gap:8px;
    padding-top:2px !important;
  }
  .ld-family-mobile-last-row::before { content:none !important; }
  .ld-family-mobile-phone { min-width:0; }
  .ld-family-mobile-phone-label {
    display:block; margin-bottom:1px; color:#111827; font-size:9px;
    font-weight:600; text-transform:uppercase;
  }
  .ld-family-mobile-actions { display:flex; flex:0 0 auto; flex-wrap:nowrap; gap:4px; }

  .ld-family-heading { flex-wrap:nowrap !important; gap:3px !important; }
  .ld-family-heading > span { flex:0 0 auto; font-size:11px; }
  .ld-heading-actions { flex-wrap:nowrap !important; gap:3px !important; margin-left:auto; }
  .ld-heading-actions .btn { padding:3px 5px; font-size:9px; white-space:nowrap; }
  .ld-heading-actions .ld-mobile-top-link { margin-left:0; }

  .ld-cnic-front-label { font-size:8px; letter-spacing:0; white-space:nowrap; }

  .ld-renewal-head { flex-wrap:nowrap !important; margin-bottom:8px !important; }
  .ld-renewal-head .btn { flex:0 0 auto; padding:4px 7px; font-size:10px; white-space:nowrap; }
  .ld-renewal-actions { gap:3px !important; }
  .ld-renewal-actions .btn { padding:4px 7px; font-size:11px; line-height:1.2; }

  .ld-file-form { grid-template-columns:1fr 1fr; gap:5px 7px; margin-bottom:8px !important; }
  .ld-file-form > div:first-of-type { grid-column:1 / -1; }
  .ld-file-form label { font-size:10px; }
  .ld-file-row {
    position:relative; grid-template-columns:1fr 1fr; gap:5px 8px;
    padding:7px;
  }
  .ld-file-serial { position:absolute; top:7px; right:7px; font-size:10px; }
  .ld-file-row > div:nth-child(2) { grid-column:1 / -1; padding-right:24px; }
  .ld-file-row > div:nth-child(3) { grid-column:1 / -1; }
  .ld-file-name { font-size:11.5px; line-height:1.25; }
  .ld-file-sub { font-size:9.5px; line-height:1.25; }
  .ld-file-actions { grid-column:1 / -1; justify-content:flex-end; }
  .ld-file-action-btn { width:27px; height:27px; }
  .ld-file-upload-actions { grid-column:1 / -1; }
  #ld-tab-docs .ld-inner-body { padding:8px; }
}

/* Very narrow phones remain usable below the requested 360px baseline. */
@media (max-width: 359.98px) {
  .ld-hdr-actions .btn,
  .ld-hdr-actions .btn-group,
  .ld-hdr-actions .ld-wa-btn { font-size:10px; }
}

/* ============================================================
   PRINT
   ============================================================ */
@media print {
  nav, footer, .ld-hdr-actions, .ld-tab-nav,
  .viewport-bar, .no-print, .btn, button {
    display: none !important;
  }
  * {
    color: #000 !important;
    background: #fff !important;
    border-color: #bbb !important;
    box-shadow: none !important;
    -webkit-print-color-adjust: exact;
  }
  .ld-badge, .badge {
    background: #eee !important; color: #000 !important;
    border: 1px solid #999 !important;
  }
  .ld-tab-pane { display: block !important; }
  .ld-tab-content-wrap { border: 1px solid #bbb !important; }
  .ld-page { padding: 0 !important; }
  a { color: #000 !important; }
  a[href]:after { content: none; }
  .ld-inner-card, .ld-overview-card { page-break-inside: avoid; }
  .kv-danger, .kv-warning, .val-danger, .val-success { color: #000 !important; }
}
</style>
{% endblock %}

{% block content %}
<div class="ld-page" id="lease-detail-top">

  <!-- ============================================================
       HEADER — 4 sections: media | identity | actions | vehicle
  ============================================================ -->
  <div class="ld-header-row">

    <!-- Section 1: photo + CNIC front/back (fixed) -->
    <div class="ld-hdr-media">
      <div class="ld-doc-tile">
        {% if lease.tenant.photo %}
          <a href="{{ lease.tenant.photo.url }}" target="_blank">
            <img src="{{ lease.tenant.photo.url }}" alt="Tenant Photo" class="ld-doc-img">
            <span class="ld-doc-label">Photo</span>
          </a>
        {% else %}
          <div class="ld-doc-empty">No photo</div>
          <span class="ld-doc-label">Photo</span>
        {% endif %}
      </div>
      <div class="ld-doc-tile">
        {% if lease.tenant.cnic_front %}
          <a href="{{ lease.tenant.cnic_front.url }}" target="_blank">
            <img src="{{ lease.tenant.cnic_front.url }}" alt="CNIC Front" class="ld-doc-img">
            <span class="ld-doc-label ld-cnic-front-label">CNIC Front</span>
          </a>
        {% else %}
          <div class="ld-doc-empty">No file</div>
          <span class="ld-doc-label ld-cnic-front-label">CNIC Front</span>
        {% endif %}
      </div>
      <div class="ld-doc-tile">
        {% if lease.tenant.cnic_back %}
          <a href="{{ lease.tenant.cnic_back.url }}" target="_blank">
            <img src="{{ lease.tenant.cnic_back.url }}" alt="CNIC Back" class="ld-doc-img">
            <span class="ld-doc-label">CNIC Back</span>
          </a>
        {% else %}
          <div class="ld-doc-empty">No file</div>
          <span class="ld-doc-label">CNIC Back</span>
        {% endif %}
      </div>
    </div>

    <!-- Section 2: tenant / lease identity (fixed, bigger type) -->
    <div class="ld-hdr-info">
      <a href="{% url 'leases:lease_list' %}" style="font-size:11px;color:#6b7280;text-decoration:none;margin-bottom:4px;">&#8592; Back to leases</a>
      <h1 class="ld-hdr-name">
        <a href="{% url 'tenants:tenant_detail' lease.tenant.pk %}">{{ lease.tenant.get_full_name }}</a>
      </h1>
      <div class="small">Lease Term {{ lease.lease_months|default:11 }} Month</div>
      <div class="ld-hdr-line2">{{ lease.unit.property.property_name }} &middot; {{ lease.unit.unit_number }} &middot; {{ lease.start_date }} &ndash; {{ lease.end_date }}</div>
      <div class="ld-hdr-line3">
        <span>Lease #{{ lease.id }}</span>
        <span>&middot;</span>
        <span>Occupancy {{ occupancy_count }}</span>
        <span class="ld-badge {% if lease.status == 'active' %}ld-badge-green{% elif lease.status == 'expired' %}ld-badge-red{% else %}ld-badge-gray{% endif %}">
          {{ lease.get_status_display }}
        </span>
      </div>
      <div class="ld-hdr-balance">Balance Due: {{ balance_due|default:0|money:0 }}</div>
    </div>

    <!-- Section 3: actions (fills remaining space, right aligned) -->
    <div class="ld-hdr-actions no-print">
      {% if lease.status == "pending_approval" %}
        <form method="post" action="{% url 'leases:approve_pending_lease' lease.pk %}" class="d-inline">
          {% csrf_token %}
          <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-check"></i> Approve Lease</button>
        </form>
      {% endif %}

      <a href="{% url 'leases:lease_update' lease.pk %}" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i> Edit</a>
      <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#tenantRegistrationLinkBox" aria-expanded="false" aria-controls="tenantRegistrationLinkBox">
        <i class="fas fa-link"></i> Registration Link
      </button>
      {% if lease.status == "active" %}
        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#endLeaseModal">
          <i class="fas fa-door-open"></i> End Lease
        </button>
      {% elif lease.status == "ended" %}
        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rollbackEndLeaseModal">
          <i class="fas fa-undo"></i> Correct / Re-do Lease End
        </button>
      {% endif %}
      <a href="{% url 'leases:lease_renew' lease.pk %}" class="btn btn-sm btn-info"><i class="fas fa-sync-alt"></i> Renew</a>
      <a href="{% url 'leases:edit_clauses' lease.pk %}" class="btn btn-sm btn-primary"><i class="fas fa-eye"></i> Agreement</a>
      <a href="{% url 'leases:lease_print' lease.pk %}" class="btn btn-sm btn-secondary"><i class="fas fa-file-pdf"></i> PDF Lease</a>
      <a href="{% url 'leases:lease_ledger_by_pk' lease.pk %}" class="btn btn-sm btn-warning"><i class="fas fa-book"></i> Ledger</a>
      <a href="{% url 'leases:lease_late_fee_settings' lease.pk %}" class="btn btn-sm btn-warning"><i class="fas fa-clock"></i> Late Fee</a>
      <a href="{% url 'leases:lease_inspection_list' lease.pk %}" class="btn btn-sm btn-dark"><i class="fas fa-clipboard-check"></i> Inspection</a>

      <div class="btn btn-sm btn-success ld-wa-btn" style="cursor:default;">
        <a href="{% url 'leases:lease_welcome_whatsapp' lease.pk %}" id="waMainBtn" style="color:inherit;text-decoration:none;"><i class="fab fa-whatsapp"></i> WhatsApp</a>
        <span class="ld-wa-api">
          <input type="checkbox" id="waSendViaApi">
          <label for="waSendViaApi" style="margin:0;">Send via API</label>
        </span>
      </div>

      <div class="btn-group ld-police-group" role="group" aria-label="Police report actions" data-police-url="{% url 'leases:lease_police_verification_link' lease.pk %}">
        <button type="button" class="btn btn-sm btn-primary ld-police-open"><i class="fas fa-shield-alt"></i> Police Report</button>
        <button type="button" class="btn btn-sm btn-primary ld-police-copy" title="Copy public link"><i class="fas fa-copy"></i></button>
        <button type="button" class="btn btn-sm btn-primary ld-police-wa" title="Share via WhatsApp"><i class="fab fa-whatsapp"></i></button>
      </div>

      {% if lease.signed_agreement %}
        <a href="{{ lease.signed_agreement.url }}" target="_blank" class="btn btn-sm btn-success"><i class="fas fa-file-signature"></i> Signed Agreement</a>
      {% endif %}
      <a href="{% url 'leases:police_verification_summary_pdf' lease.pk %}" class="btn btn-sm btn-danger"><i class="fas fa-file-pdf"></i> Police PDF</a>
      {% if lease.generated_agreement_pdf %}
        <a href="#" onclick="sendEmail(); return false;" class="btn btn-sm btn-primary"><i class="fas fa-envelope"></i> Email</a>
        <a href="{% url 'leases:download_preview' lease.id %}" class="btn btn-sm btn-secondary"><i class="fas fa-download"></i> Download PDF</a>
      {% endif %}
      {% if lease.status == "active" %}
        <div class="btn-group" role="group" aria-label="Maintenance link actions">
          <button type="button" id="copyMaintenanceLinkBtn" class="btn btn-sm btn-secondary" data-maintenance-link="{{ public_maintenance_url }}">
            <i class="fas fa-link"></i> Maintenance Link
          </button>
          <a href="https://wa.me/?text={{ public_maintenance_whatsapp_text|urlencode }}" target="_blank" rel="noopener" class="btn btn-sm btn-success" title="Share maintenance link via WhatsApp">
            <i class="fab fa-whatsapp"></i>
          </a>
        </div>
      {% endif %}
      <a href="{% url 'leases:lease_delete' lease.pk %}" class="btn btn-sm btn-danger"><i class="fas fa-trash-alt"></i> Delete</a>
    </div>

    <!-- Section 4: vehicle thumbnail (fixed) -->
    <div class="ld-hdr-vehicle">
      {% with vehicle=lease_vehicles.first %}
      <div class="ld-doc-tile">
        {% if vehicle.vehicle_photo %}
          <a href="{{ vehicle.vehicle_photo.url }}"
             class="ld-image-preview-link"
             data-preview-title="Vehicle Photo"
             data-preview-type="{{ vehicle.vehicle_type.name }}"
             data-preview-registration="{{ vehicle.registration_number }}"
             data-preview-make-model="{{ vehicle.make|default:'' }}{% if vehicle.model %} / {{ vehicle.model }}{% endif %}"
             data-preview-owner="{{ vehicle.owner_name|default:'' }}"
             data-preview-parking="{{ vehicle.parking_slot|default:'' }}">
            <img src="{{ vehicle.vehicle_photo.url }}" alt="Vehicle" class="ld-doc-img">
            <span class="ld-doc-label">Vehicle</span>
          </a>
        {% else %}
          <a href="{% url 'leases:lease_detail' lease.pk %}#ld-tab-vehicles" style="text-decoration:none;">
            <div class="ld-doc-empty"><i class="fas fa-car" style="font-size:18px;color:#94a3b8;"></i></div>
            <span class="ld-doc-label">Vehicle</span>
          </a>
        {% endif %}
      </div>
      {% endwith %}
    </div>

  </div>

  <div class="collapse mb-3" id="tenantRegistrationLinkBox">
    <div class="card border-0 shadow-sm">
      <div class="card-body py-2">
        <div class="input-group input-group-sm flex-wrap">
          <span class="input-group-text fw-semibold">Tenant Update Link</span>
          <input id="leaseTenantRegistrationLink" type="text" class="form-control text-break" value="{{ registration_link }}" readonly onclick="this.select();">
          <button id="copyTenantRegistrationLinkBtn" class="btn btn-outline-primary" type="button">
            <i class="far fa-copy me-1"></i> Copy
          </button>
          <a class="btn btn-outline-success {% if not registration_whatsapp_url %}disabled{% endif %}" target="_blank" rel="noopener" href="{{ registration_whatsapp_url|default:'#' }}">
            <i class="fab fa-whatsapp me-1"></i> WhatsApp
          </a>
          <a href="{{ registration_link }}" target="_blank" rel="noopener" class="btn btn-outline-dark">
            <i class="fas fa-external-link-alt me-1"></i> Open
          </a>
          <a href="{% url 'tenants:registration_submission_list' %}" class="btn btn-outline-secondary">
            <i class="far fa-list-alt me-1"></i> Submissions
          </a>
        </div>
        <div class="form-text">Public link expires after {{ registration_link_days }} days. Submitted changes require admin approval.</div>
      </div>
    </div>
  </div>

  <nav class="ld-mobile-section-nav no-print" aria-label="Lease detail sections">
    <a class="ld-mobile-section-badge" href="#ld-tab-renewals">Lease Renewal</a>
    <a class="ld-mobile-section-badge" href="#ld-tab-unit">Unit / Meter</a>
    <a class="ld-mobile-section-badge" href="#ld-tab-family">Family</a>
    <a class="ld-mobile-section-badge" href="#ld-tab-vehicles">Vehicle</a>
    <a class="ld-mobile-section-badge" href="#ld-tab-notes">Terms / Notes</a>
    <a class="ld-mobile-section-badge" href="#ld-tab-activity">Activity</a>
    <a class="ld-mobile-section-badge" href="#ld-tab-docs">Documents</a>
    <a class="ld-mobile-section-badge" href="#ld-tab-inspections">Inspection</a>
  </nav>

  <!-- ============================================================
       OVERVIEW — 8 columns
  ============================================================ -->
  <div class="ld-overview-card">
    <div class="ld-overview-card-header">Property, Tenant &amp; Lease Overview</div>
    <div class="ld-ov-grid">

      <!-- COL 1: Property -->
      <div class="ld-ov-col ld-mobile-property-grid">
        <div class="ld-ov-head">Property</div>
        <div class="ld-f ld-mobile-third">
          <div class="ld-f-label">Property</div>
          <div class="ld-f-value">{{ lease.unit.property.property_name }}</div>
        </div>
        <div class="ld-f ld-mobile-third">
          <div class="ld-f-label">Unit</div>
          <div class="ld-f-value">{{ lease.unit.unit_number }}</div>
        </div>
        <div class="ld-f ld-mobile-third">
          <div class="ld-f-label">Agreement Date</div>
          <div class="ld-f-value">{{ lease.agreement_date|default:"&mdash;" }}</div>
        </div>
        <div class="ld-f ld-mobile-half">
          <div class="ld-f-label">Min Occupancy</div>
          <div class="ld-f-value">{{ lease.min_lease_occupancy_months|default:"&mdash;" }} months</div>
        </div>
        <div class="ld-f ld-mobile-half">
          <div class="ld-f-label">Meter Reading</div>
          <div class="ld-f-value">{{ lease.electricity_meter_reading|default:"&mdash;" }}</div>
        </div>
        <div class="ld-f ld-mobile-full">
          <div class="ld-f-label">Rent Due Day / Late Fee</div>
          <div class="ld-f-value">{{ lease.due_date|default:"&mdash;" }} &middot; {{ lease.late_fee|default:0|money:0 }}</div>
        </div>
      </div>

      <!-- COL 2: Agreement Parties -->
      <div class="ld-ov-col ld-mobile-two-col ld-agreement-parties">
        <div class="ld-ov-head d-flex justify-content-between align-items-center">Agreement Parties <a class="btn btn-sm btn-primary" href="{% url 'leases:edit_clauses' lease.pk %}{% if active_history %}?history={{ active_history.pk }}{% endif %}"><i class="fas fa-edit"></i> Edit</a></div>
        <div class="ld-f"><div class="ld-f-label">Proposer</div><div class="ld-f-value">{% if lease.proposer %}<a href="{% url 'tenants:tenant_detail' lease.proposer.pk %}">{{ lease.proposer.get_full_name }}</a>{% if lease.proposer_relationship %}<small class="d-block text-muted">{{ lease.proposer_relationship }}</small>{% endif %}{% else %}&mdash;{% endif %}</div></div>
        <div class="ld-f"><div class="ld-f-label">Seconder</div><div class="ld-f-value">{% if lease.seconder %}<a href="{% url 'tenants:tenant_detail' lease.seconder.pk %}">{{ lease.seconder.get_full_name }}</a>{% if lease.seconder_relationship %}<small class="d-block text-muted">{{ lease.seconder_relationship }}</small>{% endif %}{% else %}&mdash;{% endif %}</div></div>
        <div class="ld-f"><div class="ld-f-label">Witness 1</div><div class="ld-f-value">{% if active_history.witness1_tenant %}<a href="{% url 'tenants:tenant_detail' active_history.witness1_tenant.pk %}">{{ active_history.witness1_tenant.get_full_name }}</a>{% elif lease.witness1_tenant %}<a href="{% url 'tenants:tenant_detail' lease.witness1_tenant.pk %}">{{ lease.witness1_tenant.get_full_name }}</a>{% else %}&mdash;{% endif %}</div></div>
        <div class="ld-f"><div class="ld-f-label">Witness 2</div><div class="ld-f-value">{% if active_history.witness2_tenant %}<a href="{% url 'tenants:tenant_detail' active_history.witness2_tenant.pk %}">{{ active_history.witness2_tenant.get_full_name }}</a>{% elif lease.witness2_tenant %}<a href="{% url 'tenants:tenant_detail' lease.witness2_tenant.pk %}">{{ lease.witness2_tenant.get_full_name }}</a>{% else %}&mdash;{% endif %}</div></div>
      </div>

      <!-- COL 3: Rent & Charges -->
      <div class="ld-ov-col ld-mobile-two-col">
        <div class="ld-ov-head">Rent &amp; Charges</div>
        <div class="ld-f">
          <div class="ld-f-label">Monthly Rent</div>
          <div class="ld-f-value">{{ lease.monthly_rent|default:0|money:0 }}</div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Maintenance + Water</div>
          <div class="ld-f-value">{{ lease.society_maintenance|default:0|money:0 }} + {{ lease.water_charges|default:0|money:0 }}</div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Rent Increase %</div>
          <div class="ld-f-value">{{ lease.rent_increase_percent|default:0 }}%</div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Move-out Proration</div>
          <div class="ld-f-value">
            {{ lease.effective_proration_interval_label }}
            <small class="d-block text-muted">{% if lease.proration_interval_days %}Lease override{% else %}System default{% endif %}</small>
          </div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Total Payment</div>
          <div class="ld-f-value">{{ lease_total_payment|default:0|money:0 }}</div>
        </div>
      </div>

      <!-- COL 4: Installments -->
      <div class="ld-ov-col ld-mobile-two-col ld-mobile-half-card">
        <div class="ld-ov-head">Installments</div>
        <div class="ld-f">
          <div class="ld-f-label">Installment 1</div>
          <div class="ld-f-value">{{ lease.security_installment_1_amount|default:0|money:0 }} &middot; {{ lease.security_installment_1_date|default:"&mdash;" }}</div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Installment 2</div>
          <div class="ld-f-value">{{ lease.security_installment_2_amount|default:0|money:0 }} &middot; {{ lease.security_installment_2_date|default:"&mdash;" }}</div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Early Penalty</div>
          <div class="ld-f-value">{{ lease.early_termination_penalty|default:0|money:0 }}</div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Return Date / Amount</div>
          <div class="ld-f-value">{{ lease.security_deposit_return_date|default:"&mdash;" }} &middot; {{ lease.security_deposit_return_amount|default:0|money:0 }}</div>
        </div>
        <div class="ld-f">
          <div class="ld-f-label">Deposit Paid</div>
          <div class="ld-f-value">
            {% if deposit_is_paid %}
              <span class="ld-badge ld-badge-green">Yes</span>
            {% else %}
              <span class="ld-badge ld-badge-red">No</span>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- COL 5: Security Deposit Summary -->
      <div class="ld-ov-col ld-mobile-two-col ld-mobile-half-card">
        <div class="ld-ov-head">Security Deposit</div>
        <div class="ld-f">
          <div class="ld-f-label">Bill Water</div>
          <div class="ld-f-value">
            {% if lease.bill_water_charges %}
              <span class="ld-badge ld-badge-green">Yes</span>
            {% else %}
              <span class="ld-badge ld-badge-gray">No</span>
            {% endif %}
          </div>
        </div>
        <div style="margin-top:4px;">
          <div class="dep-row"><span class="dep-k">Required</span><span class="dep-v">{{ security_required|default:0|money:0 }}</span></div>
          <div class="dep-row"><span class="dep-k">Paid In</span><span class="dep-v">{{ security_paid_in|default:0|money:0 }}</span></div>
          <div class="dep-row"><span class="dep-k">Refunded</span><span class="dep-v">{{ security_refunded|default:0|money:0 }}</span></div>
          <div class="dep-row"><span class="dep-k">Damages</span><span class="dep-v">{{ security_damages|default:0|money:0 }}</span></div>
          <div class="dep-row dep-warn">
            <span class="dep-k" style="color:#92400e;font-weight:600;">To Collect</span>
            <span class="dep-v" style="color:#92400e;">{{ security_balance_to_collect|default:0|money:0 }}</span>
          </div>
          <div class="dep-row dep-ok">
            <span class="dep-k" style="color:#15803d;font-weight:600;">Currently Held</span>
            <span class="dep-v" style="color:#15803d;">{{ security_currently_held|default:0|money:0 }}</span>
          </div>
        </div>
      </div>

      <!-- COL 6: Inventory & Condition -->
      <div class="ld-ov-col ld-mobile-two-col">
        <div class="ld-ov-head">Inventory &amp; Condition</div>
        <div class="ld-f"><div class="ld-f-label">Ceiling Fans / Exhaust</div><div class="ld-f-value">{{ lease.inventory_ceiling_fans|default:"&mdash;" }} / {{ lease.inventory_exhaust_fans|default:"&mdash;" }}</div></div>
        <div class="ld-f"><div class="ld-f-label">Ceiling Lights</div><div class="ld-f-value">{{ lease.inventory_ceiling_lights|default:"&mdash;" }}</div></div>
        <div class="ld-f"><div class="ld-f-label">Stove / Wardrobes</div><div class="ld-f-value">{{ lease.inventory_stove|default:"&mdash;" }} / {{ lease.inventory_wardrobes|default:"&mdash;" }}</div></div>
        <div class="ld-f"><div class="ld-f-label">Keys</div><div class="ld-f-value">{{ lease.inventory_keys|default:"&mdash;" }}</div></div>
        <div class="ld-f"><div class="ld-f-label">Paint Condition</div><div class="ld-f-value">{{ lease.paint_condition|default:"&mdash;" }}</div></div>
      </div>

    </div><!-- /ld-ov-grid -->
  </div><!-- /ld-overview-card -->

  <!-- ============================================================
       TABS  (5: Renewals · Unit & Meter · Terms & Notes · Activity · Documents)
  ============================================================ -->
  <div class="ld-tabs-wrapper">

    <div class="ld-tab-nav no-print" id="ldTabNav">
      <button class="ld-tab-btn active" data-tab="renewals">Lease Renewals</button>
      <button class="ld-tab-btn" data-tab="unit">Unit &amp; Meter</button>
      <button class="ld-tab-btn" data-tab="family">Family</button>
      <button class="ld-tab-btn" data-tab="vehicles">Vehicles</button>
      <button class="ld-tab-btn" data-tab="notes">Terms &amp; Notes</button>
      <button class="ld-tab-btn" data-tab="activity">Activity</button>
      <button class="ld-tab-btn" data-tab="docs">Documents</button>
      <button class="ld-tab-btn" data-tab="inspections">Inspection Sheet</button>
    </div>

    <div class="ld-tab-content-wrap">

      <!-- ======== RENEWALS ======== -->
      <div class="ld-tab-pane active" id="ld-tab-renewals">
        <div class="d-flex justify-content-between align-items-center mb-3 no-print ld-renewal-head">
          <span class="ld-sec-title mb-0">Lease Renewal History</span>
          <a href="{% url 'leases:lease_renew' lease.pk %}" class="btn btn-sm btn-primary">
            Renew Lease
          </a>
        </div>
        <div class="ld-tw ld-mobile-cards ld-mobile-cards-3col">
          <table class="ld-tbl">
            <thead>
              <tr>
                <th>#</th>
                <th>Start</th>
                <th>End</th>
                <th>Rent</th>
                <th>Total Monthly</th>
                <th>Signed</th>
                <th class="no-print">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for renewal in renewals %}
                <tr>
                  <td data-label="#">
                    #{{ forloop.counter }}
                    {% if forloop.first %}
                      <span class="ld-badge ld-badge-blue ms-1">Original</span>
                    {% else %}
                      <span class="ld-badge ld-badge-purple ms-1">Renewal</span>
                    {% endif %}
                  </td>
                  <td data-label="Start">{{ renewal.start_date|date:"M d, Y" }}</td>
                  <td data-label="End">{{ renewal.end_date|date:"M d, Y" }}</td>
                  <td data-label="Rent">{{ renewal.monthly_rent|default:0|money:0 }}</td>
                  <td data-label="Total Monthly">{{ renewal.total_monthly_amount|default:0|money:0 }}</td>
                  <td data-label="Signed">
                    {% if renewal.is_agreement_signed %}
                      <span class="ld-badge ld-badge-green">Signed</span>
                    {% else %}
                      <span class="ld-badge ld-badge-amber">Pending</span>
                    {% endif %}
                  </td>
                  <td class="no-print ld-td-actions" data-label="Actions">
                    <div class="ld-renewal-actions" style="display:flex;flex-wrap:wrap;gap:4px;">
                      <a href="{% url 'leases:lease_history_detail' lease.pk renewal.pk %}" class="btn btn-dark">View</a>
                      <a href="{% url 'leases:lease_history_edit' lease.pk renewal.pk %}" class="btn btn-primary">Edit</a>
                      <a href="{% url 'leases:edit_clauses' lease.pk %}?history={{ renewal.pk }}" class="btn btn-secondary">Agreement</a>
                      <a href="{% url 'leases:photos_page' lease.pk %}" class="btn btn-dark">Photos</a>
                    </div>
                  </td>
                </tr>
              {% empty %}
                <tr><td colspan="7" class="ld-empty">No renewal history recorded.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <!-- ======== UNIT & METER ======== -->
      <div class="ld-tab-pane" id="ld-tab-unit">
        <div class="ld-g2">
          <div class="ld-inner-card">
            <div class="ld-inner-head">
              Current Unit / Room
              <div class="d-flex align-items-center gap-1">
                <a href="{% url 'smart_meter:move_lease_unit' lease.pk %}" class="btn btn-sm btn-primary py-0 px-2 no-print" style="font-size:11px;">Move Tenant</a>
                <a href="#lease-detail-top" class="ld-mobile-top-link no-print" style="float:none;margin:0;" aria-label="Back to top">Top</a>
              </div>
            </div>
            <div class="ld-inner-body">
              <div class="ld-row"><span class="ld-rk">Current Unit</span><span class="ld-rv"><a href="{% url 'properties:unit_detail' lease.current_unit.pk %}">{{ lease.current_unit.property.property_name }} {{ lease.current_unit.unit_number }}</a></span></div>
              <div class="ld-row"><span class="ld-rk">Lease Start</span><span class="ld-rv">{{ lease.start_date|date:"M d, Y" }}</span></div>
              <div class="ld-row"><span class="ld-rk">Lease End</span><span class="ld-rv">{{ lease.end_date|date:"M d, Y" }}</span></div>
            </div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Unit Move History</div>
            <div class="ld-tw ld-mobile-cards">
              <table class="ld-tbl" style="min-width:340px;">
                <thead><tr><th>Unit</th><th>Move In</th><th>Move Out</th><th>Notes</th></tr></thead>
                <tbody>
                  {% for occ in lease.unit_occupancies.all %}
                    <tr>
                      <td data-label="Unit"><a href="{% url 'properties:unit_detail' occ.unit.pk %}">{{ occ.unit }}</a></td>
                      <td data-label="Move In">{{ occ.move_in_date|date:"M d, Y" }}</td>
                      <td data-label="Move Out">{{ occ.move_out_date|date:"M d, Y"|default:"Current" }}</td>
                      <td data-label="Notes" style="color:#6b7280;font-size:11px;">{{ occ.notes|default:"&mdash;" }}</td>
                    </tr>
                  {% empty %}
                    <tr><td colspan="4" class="ld-empty">No move history.</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="ld-inner-card" style="margin-top:12px;">
          <div class="ld-inner-head">Meter Billing History / Usage Breakdown</div>
          <div class="ld-tw ld-mobile-cards">
            <table class="ld-tbl">
              <thead><tr><th>Meter</th><th>Unit</th><th>Installed</th><th>Removed</th><th class="text-end">Start Reading</th><th class="text-end">End Reading</th></tr></thead>
              <tbody>
                {% for inst in lease.meter_installations.all %}
                  <tr>
                    <td data-label="Meter"><a href="{% url 'smart_meter:meter_detail' inst.meter.pk %}">{{ inst.meter.meter_number }}</a></td>
                    <td data-label="Unit">{{ inst.unit }}</td>
                    <td data-label="Installed">{{ inst.start_date|date:"M d, Y" }}</td>
                    <td data-label="Removed">{{ inst.end_date|date:"M d, Y"|default:"Current" }}</td>
                    <td data-label="Start Reading" class="text-end">{{ inst.start_reading }}</td>
                    <td data-label="End Reading" class="text-end">{{ inst.end_reading|default:"&mdash;" }}</td>
                  </tr>
                {% empty %}
                  <tr><td colspan="6" class="ld-empty">No meter installations linked.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ======== FAMILY ======== -->
      <div class="ld-tab-pane" id="ld-tab-family">
        <div class="ld-inner-card">
          <div class="ld-inner-head d-flex justify-content-between align-items-center flex-wrap gap-2 ld-family-heading">
            <span>Family Members</span>
            <div class="d-flex flex-wrap gap-1 ld-heading-actions">
              <button type="button" class="btn btn-sm btn-success" data-bs-toggle="collapse" data-bs-target="#leaseFamilyPublicLinkBox">
                <i class="fas fa-link"></i> Public Link
              </button>
              <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#leaseFamilyAddBox">
                <i class="fas fa-plus"></i> Add Family
              </button>
            </div>
          </div>
          <div class="collapse" id="leaseFamilyPublicLinkBox">
            <div class="p-2 border-bottom bg-light">
              <div class="input-group input-group-sm">
                <span class="input-group-text fw-semibold">Family Update Link</span>
                <input id="leaseFamilyPublicLinkInput" type="text" class="form-control text-break" readonly onclick="this.select();" placeholder="Generate a public family link">
                <button class="btn btn-primary" type="button" id="generateFamilyPublicLinkBtn" data-link-url="{% url 'leases:lease_family_public_link' lease.pk %}">
                  <i class="fas fa-link me-1"></i> Generate
                </button>
                <button class="btn btn-primary" type="button" id="copyFamilyPublicLinkBtn">
                  <i class="far fa-copy me-1"></i> Copy
                </button>
                <a class="btn btn-success disabled" id="whatsappFamilyPublicLinkBtn" href="#" target="_blank" rel="noopener">
                  <i class="fab fa-whatsapp me-1"></i> WhatsApp
                </a>
                <a class="btn btn-dark disabled" id="openFamilyPublicLinkBtn" href="#" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i> Open
                </a>
              </div>
              <div class="form-text">Public link is valid for 48 hours. Submitted family changes require admin approval.</div>
            </div>
          </div>
          <div class="collapse" id="leaseFamilyAddBox">
            <div class="p-2 border-bottom bg-light">
              <form id="leaseFamilyExistingForm" method="post" action="{% url 'leases:lease_family_add' lease.pk %}" class="row g-2 align-items-end">
                {% csrf_token %}
                <div class="col-12 col-lg-6">
                  <label class="form-label small fw-semibold mb-1" for="leaseFamilyTenantSelect">Find Existing Tenant</label>
                  <select id="leaseFamilyTenantSelect" name="tenant_id" class="form-select form-select-sm" data-search-url="{% url 'leases:tenant_quick_search' %}">
                    <option value=""></option>
                  </select>
                </div>
                <div class="col-12 col-lg-3">
                  <label class="form-label small fw-semibold mb-1" for="leaseFamilyRelation">Relationship</label>
                  <select id="leaseFamilyRelation" name="relation" class="form-select form-select-sm" required>
                    <option value="">Select relationship</option>
                    {% for item in relationship_types %}
                      <option value="{{ item.id }}">{{ item.name }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-12 col-lg-3 d-flex flex-wrap gap-1">
                  <button type="submit" class="btn btn-sm btn-success flex-fill">Link Tenant</button>
                  <button type="button" class="btn btn-sm btn-primary flex-fill" id="openNewFamilyModalBtn">Add New</button>
                </div>
              </form>
              <div class="form-text" id="leaseFamilySearchHelp">Family members must exist in the Tenant table. If the name is not found, use Add New to create and link in one save.</div>
            </div>
          </div>
          <div class="ld-tw ld-mobile-cards ld-compact-mobile-table ld-family-table">
            <table class="ld-tbl">
              <thead>
                <tr>
                  <th>S.N</th>
                  <th>Name</th>
                  <th>Relationship</th>
                  <th>CNIC</th>
                  <th>DOB</th>
                  <th>Phone</th>
                  <th>Age</th>
                  <th class="no-print">Actions</th>
                </tr>
              </thead>
              <tbody id="leaseFamilyRows">
                {% for member in family_members %}
                  <tr>
                    <td class="ld-family-sn" data-label="S.N">{{ forloop.counter }}</td>
                    <td class="ld-family-name" data-label="Name"><a href="{% url 'tenants:tenant_detail' member.family_member.pk %}">{{ member.family_member.get_full_name }}</a></td>
                    <td class="ld-family-relation" data-label="Relationship">{{ member.relation }}</td>
                    <td class="ld-family-cnic" data-label="CNIC">{{ member.family_member.cnic|format_cnic|default:"&mdash;" }}</td>
                    <td class="ld-family-dob" data-label="DOB">{{ member.family_member.date_of_birth|date:"M d, Y"|default:"&mdash;" }}</td>
                    <td class="ld-family-phone" data-label="Phone">{{ member.family_member.phone|format_phone|default:"&mdash;" }}</td>
                    <td class="ld-family-age" data-label="Age">{{ member.family_member.age|default:"&mdash;" }}</td>
                    <td class="no-print ld-td-actions" data-label="Actions">
                      <div class="d-flex flex-wrap gap-1">
                        <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="btn btn-sm btn-dark">View</a>
                        <a href="{% url 'tenants:tenant_update' member.family_member.pk %}" class="btn btn-sm btn-primary">Edit</a>
                        <form method="post" action="{% url 'leases:lease_family_remove' lease.pk member.pk %}" onsubmit="return confirm('Remove this family relationship? Tenant record will remain.');">
                          {% csrf_token %}
                          <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                      </div>
                    </td>
                    <td class="ld-family-mobile-only ld-family-mobile-id" data-label="S.N - Name">
                      #{{ forloop.counter }} &middot; <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}">{{ member.family_member.get_full_name }}</a>
                    </td>
                    <td class="ld-family-mobile-only ld-family-mobile-dob-age" data-label="DOB - Age">
                      {{ member.family_member.date_of_birth|date:"M d, Y"|default:"&mdash;" }} &middot; {{ member.family_member.age|default:"&mdash;" }}
                    </td>
                    <td class="ld-family-mobile-only ld-family-mobile-last-row no-print">
                      <div class="ld-family-mobile-phone">
                        <span class="ld-family-mobile-phone-label">Phone</span>
                        {{ member.family_member.phone|format_phone|default:"&mdash;" }}
                      </div>
                      <div class="ld-family-mobile-actions">
                        <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="btn btn-sm btn-dark">View</a>
                        <a href="{% url 'tenants:tenant_update' member.family_member.pk %}" class="btn btn-sm btn-primary">Edit</a>
                        <form method="post" action="{% url 'leases:lease_family_remove' lease.pk member.pk %}" onsubmit="return confirm('Remove this family relationship? Tenant record will remain.');">
                          {% csrf_token %}
                          <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                {% empty %}
                  <tr><td colspan="8" class="ld-empty">No family members linked to this lease.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>


      <!-- ======== VEHICLES ======== -->
      <div class="ld-tab-pane" id="ld-tab-vehicles">
        <div class="ld-inner-card mb-3">
          <div class="ld-inner-head d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
              Tenant Vehicles
              {% if pending_vehicle_count %}
                <button type="button" class="btn btn-sm btn-warning py-0 px-2 ms-2 no-print" data-bs-toggle="collapse" data-bs-target="#pendingVehicleSubmissionCard" aria-expanded="false">
                  Pending {{ pending_vehicle_count }}
                </button>
              {% endif %}
            </span>
            <div class="d-flex flex-wrap gap-1">
              <button type="button" class="btn btn-sm btn-primary no-print" data-bs-toggle="collapse" data-bs-target="#leaseVehicleAddBox">
                <i class="fas fa-plus"></i> Add Vehicle
              </button>
            </div>
          </div>
          <div class="collapse" id="leaseVehicleAddBox">
            <div class="p-2 border-bottom bg-light">
              <form method="post" enctype="multipart/form-data" action="{% url 'leases:lease_vehicle_add' lease.pk %}" class="row g-2 align-items-end">
                {% csrf_token %}
                <div class="col-12 col-md-3">
                  <label class="form-label small mb-1">Vehicle Type</label>
                  <select name="vehicle_type" class="form-select form-select-sm" required>
                    <option value="">Select type</option>
                    {% for vehicle_type in vehicle_types %}
                      <option value="{{ vehicle_type.pk }}">{{ vehicle_type.name }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="col-12 col-md-3">
                  <label class="form-label small mb-1">Registration #</label>
                  <input name="registration_number" class="form-control form-control-sm" required>
                </div>
                <div class="col-6 col-md-2"><label class="form-label small mb-1">Make</label><input name="make" class="form-control form-control-sm"></div>
                <div class="col-6 col-md-2"><label class="form-label small mb-1">Model</label><input name="model" class="form-control form-control-sm"></div>
                <div class="col-6 col-md-2"><label class="form-label small mb-1">Color</label><input name="color" class="form-control form-control-sm"></div>
                <div class="col-6 col-md-2"><label class="form-label small mb-1">Year</label><input name="year" type="number" min="1900" class="form-control form-control-sm"></div>
                <div class="col-12 col-md-3"><label class="form-label small mb-1">Owner</label><input name="owner_name" class="form-control form-control-sm"></div>
                <div class="col-12 col-md-3"><label class="form-label small mb-1">Owner CNIC</label><input name="owner_cnic" class="form-control form-control-sm"></div>
                <div class="col-12 col-md-2"><label class="form-label small mb-1">Parking</label><input name="parking_slot" class="form-control form-control-sm"></div>
                <div class="col-12 col-md-3"><label class="form-label small mb-1">Vehicle Photo</label><input name="vehicle_photo" type="file" accept="image/*" class="form-control form-control-sm"></div>
                <div class="col-12 col-md-4"><label class="form-label small mb-1">Notes</label><input name="notes" class="form-control form-control-sm"></div>
                <div class="col-12 col-md-2"><button type="submit" class="btn btn-sm btn-success w-100">Save Vehicle</button></div>
              </form>
            </div>
          </div>
          <div class="ld-tw ld-mobile-cards ld-compact-mobile-table">
            <table class="ld-tbl" style="min-width:900px;">
              <thead>
                <tr>
                  <th>S.N</th>
                  <th>Type</th>
                  <th>Registration #</th>
                  <th>Make / Model</th>
                  <th>Color</th>
                  <th>Owner</th>
                  <th>Owner CNIC</th>
                  <th>Parking</th>
                  <th>Photos</th>
                  <th>Status</th>
                  <th class="no-print">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for vehicle in lease_vehicles %}
                  <tr id="vehicle-row-{{ vehicle.pk }}">
                    <td data-label="S.N">{{ forloop.counter }}</td>
                    <td data-label="Type">{{ vehicle.vehicle_type.name }}</td>
                    <td data-label="Registration #">{{ vehicle.registration_number }}</td>
                    <td data-label="Make / Model">{{ vehicle.make|default:"-" }}{% if vehicle.model %} / {{ vehicle.model }}{% endif %}</td>
                    <td data-label="Color">{{ vehicle.color|default:"-" }}</td>
                    <td data-label="Owner">{{ vehicle.owner_name|default:"-" }}</td>
                    <td data-label="Owner CNIC">{{ vehicle.owner_cnic|format_cnic|default:"-" }}</td>
                    <td data-label="Parking">{{ vehicle.parking_slot|default:"-" }}</td>
                    <td data-label="Photos">
                      {% if vehicle.vehicle_photo %}
                        <button type="button"
                                class="ld-vehicle-photo-btn ld-image-preview-link"
                                data-preview-src="{{ vehicle.vehicle_photo.url }}"
                                data-preview-title="Vehicle Photo"
                                data-preview-type="{{ vehicle.vehicle_type.name }}"
                                data-preview-registration="{{ vehicle.registration_number }}"
                                data-preview-make-model="{{ vehicle.make|default:'' }}{% if vehicle.model %} / {{ vehicle.model }}{% endif %}"
                                data-preview-owner="{{ vehicle.owner_name|default:'' }}"
                                data-preview-parking="{{ vehicle.parking_slot|default:'' }}">
                          <img src="{{ vehicle.vehicle_photo.url }}" alt="Vehicle" class="ld-vehicle-thumb">
                        </button>
                      {% endif %}
                      {% if vehicle.registration_book_photo %}<a href="{{ vehicle.registration_book_photo.url }}" target="_blank" class="ms-1">Book</a>{% endif %}
                      {% if not vehicle.vehicle_photo and not vehicle.registration_book_photo %}-{% endif %}
                    </td>
                    <td data-label="Status">
                      {% if vehicle.is_active %}
                        <span class="ld-badge ld-badge-green">Active</span>
                      {% else %}
                        <span class="ld-badge">Inactive</span>
                      {% endif %}
                    </td>
                    <td class="no-print ld-td-actions" data-label="Actions">
                      <div class="d-flex flex-wrap gap-1">
                        <button type="button"
                                class="btn btn-sm btn-primary vehicle-edit-btn"
                                data-edit-url="{% url 'leases:lease_vehicle_edit' lease.pk vehicle.pk %}">
                          Edit
                        </button>
                        <form method="post" action="{% url 'leases:lease_vehicle_delete' lease.pk vehicle.pk %}" onsubmit="return confirm('Remove this vehicle from active list? History will be preserved.');">
                          {% csrf_token %}
                          <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                {% empty %}
                  <tr><td colspan="11" class="ld-empty">No vehicle information recorded.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        {% if pending_vehicle_count %}
        <div class="ld-inner-card collapse" id="pendingVehicleSubmissionCard">
          <div class="ld-inner-head">Pending Vehicle Submissions</div>
          <div class="ld-tw ld-mobile-cards">
            <table class="ld-tbl" style="min-width:820px;">
              <thead>
                <tr>
                  <th>S.N</th>
                  <th>Reg #</th>
                  <th>Type</th>
                  <th>Owner</th>
                  <th>Source</th>
                  <th>Submitted</th>
                  <th>Status</th>
                  <th class="no-print">Action</th>
                </tr>
              </thead>
              <tbody>
                {% for submission in pending_vehicle_submissions %}
                  <tr>
                    <td data-label="S.N">{{ forloop.counter }}</td>
                    <td data-label="Reg #">{{ submission.registration_number }}</td>
                    <td data-label="Type">{{ submission.vehicle_type.name }}</td>
                    <td data-label="Owner">{{ submission.owner_name|default:"-" }}</td>
                    <td data-label="Source">{{ submission.source|default:"-" }}</td>
                    <td data-label="Submitted">{{ submission.submitted_at|date:"M d, Y H:i" }}</td>
                    <td data-label="Status">{{ submission.get_status_display }}</td>
                    <td class="no-print ld-td-actions" data-label="Action">
                      {% if submission.status == "pending" and submission.lease_id %}
                        <div class="d-flex flex-wrap gap-1">
                          <form method="post" action="{% url 'leases:approve_pending_vehicle_submission' submission.pk %}">
                            {% csrf_token %}
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                          </form>
                          <form method="post" action="{% url 'leases:reject_pending_vehicle_submission' submission.pk %}">
                            {% csrf_token %}
                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                          </form>
                        </div>
                      {% elif submission.status == "pending" %}
                        <span class="text-muted small">Waiting for lease assignment before approval.</span>
                      {% else %}
                        -
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        {% endif %}
      </div>

      <!-- ======== TERMS & NOTES ======== -->
      <div class="ld-tab-pane" id="ld-tab-notes">
        <div class="ld-g3">
          <div class="ld-inner-card">
            <div class="ld-inner-head">Terms</div>
            <div class="ld-inner-body" style="font-size:13px;">{{ lease.terms|default:"&mdash;" }}</div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Notes</div>
            <div class="ld-inner-body" style="font-size:13px;">{{ lease.notes|default:"&mdash;" }}</div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Return Notes</div>
            <div class="ld-inner-body" style="font-size:13px;">{{ lease.security_deposit_return_notes|default:"&mdash;" }}</div>
          </div>
        </div>
      </div>

      <!-- ======== ACTIVITY ======== -->
      <div class="ld-tab-pane" id="ld-tab-activity">
        <div class="ld-g2">
          <div class="ld-inner-card">
            <div class="ld-inner-head">Recent Payments</div>
            <div class="ld-inner-body">
              {% if recent_payments %}
                {% for p in recent_payments %}
                  <div class="ld-act">
                    <div class="d-flex align-items-baseline gap-2">
                      <span class="ld-act-sn">{{ forloop.counter }}.</span>
                      <div><div class="ld-act-d">{{ p.payment_date }}</div><div class="ld-act-l">{{ p.reference_number|default:"Payment" }}</div></div>
                    </div>
                    <div class="ld-act-a" style="color:#15803d;">{{ p.amount|money:0 }}</div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="ld-empty">No payments yet.</div>
              {% endif %}
            </div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Invoices</div>
            <div class="ld-inner-body">
              {% if invoices %}
                {% for inv in invoices %}
                  <div class="ld-act">
                    <div class="d-flex align-items-baseline gap-2">
                      <span class="ld-act-sn">{{ forloop.counter }}.</span>
                      <div><div class="ld-act-d">{{ inv.issue_date }}</div><div class="ld-act-l">{{ inv.description|default:"Invoice" }}</div></div>
                    </div>
                    <div class="ld-act-a" style="color:#dc2626;">{{ inv.amount|money:0 }}</div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="ld-empty">No invoices yet.</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- ======== DOCUMENTS ======== -->
      <div class="ld-tab-pane" id="ld-tab-docs">
        <div class="ld-inner-card">
          <div class="ld-inner-head">Lease Files</div>
          <div class="ld-inner-body">
            <form method="post" enctype="multipart/form-data" action="{% url 'leases:lease_file_upload' lease.pk %}" class="ld-file-form no-print mb-3">
              {% csrf_token %}
              <div>
                <label class="form-label small fw-semibold mb-1">Files</label>
                <input type="file" name="files" multiple class="form-control form-control-sm" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.heic,.heif">
              </div>
              <div>
                <label class="form-label small fw-semibold mb-1">Category</label>
                <select name="category" class="form-select form-select-sm">
                  {% for category in lease_document_categories %}
                    <option value="{{ category.code }}">{{ category.name }}</option>
                  {% endfor %}
                </select>
              </div>
              <div>
                <label class="form-label small fw-semibold mb-1">Description</label>
                <input type="text" name="description" class="form-control form-control-sm" maxlength="300">
              </div>
              <div class="ld-file-upload-actions">
                <button type="submit" class="btn btn-sm btn-primary">Upload</button>
                <button type="submit" form="leaseFilesShareAllForm" class="btn btn-sm btn-primary" title="Share all active files on WhatsApp">
                  <i class="fab fa-whatsapp me-1"></i> Share All Files
                </button>
              </div>
            </form>
            <form id="leaseFilesShareAllForm" method="post" action="{% url 'leases:lease_files_share_all' lease.pk %}" class="d-none">
              {% csrf_token %}
            </form>

            <div class="ld-file-list">
              {% for doc in lease_documents %}
                <div class="ld-file-row">
                  <div class="ld-file-serial">#{{ forloop.counter }}</div>
                  <div>
                    <div class="ld-file-name">
                      <i class="fas fa-file me-1"></i>{{ doc.display_name|default:doc.original_filename }}
                      {% if not doc.file_exists %}<span class="badge bg-warning text-dark ld-file-missing ms-1">file missing</span>{% endif %}
                    </div>
                    {% if doc.display_name and doc.display_name != doc.original_filename %}
                      <div class="ld-file-sub">{{ doc.original_filename }}</div>
                    {% endif %}
                  </div>
                  <div class="ld-file-category-editor">
                    <button type="button" class="ld-file-category-display no-print" title="Click to change category">{{ doc.category_label }}</button>
                    <select class="form-select form-select-sm ld-file-category-select no-print d-none" data-doc-category-url="{% url 'leases:lease_file_category_update' doc.pk %}">
                      {% for category in lease_document_categories %}
                        <option value="{{ category.code }}" {% if doc.category == category.code %}selected{% endif %}>{{ category.name }}</option>
                      {% endfor %}
                    </select>
                    <span class="ld-badge ld-badge-gray d-none d-print-inline">{{ doc.category_label }}</span>
                    {% if doc.lease_history %}<div class="ld-file-sub">{{ doc.lease_history.history_label }}</div>{% endif %}
                  </div>
                  <div class="ld-file-sub">{{ doc.description|default:"No description" }}</div>
                  <div class="ld-file-sub">
                    {{ doc.uploaded_at|date:"M d, Y H:i" }}<br>
                    {{ doc.uploaded_by|default:"System" }}
                  </div>
                  <div class="ld-file-actions no-print">
                    {% if doc.file_exists %}
                      <a class="btn btn-sm btn-secondary ld-file-action-btn" target="_blank" rel="noopener" href="{% url 'leases:lease_file_view' doc.pk %}" title="View">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a class="btn btn-sm btn-success ld-file-action-btn" href="{% url 'leases:lease_file_download' doc.pk %}" title="Download">
                        <i class="fas fa-download ld-file-icon-download"></i>
                      </a>
                    {% else %}
                      <button class="btn btn-sm btn-secondary ld-file-action-btn" type="button" disabled title="File missing">
                        <i class="fas fa-exclamation-triangle"></i>
                      </button>
                    {% endif %}
                    <form method="post" action="{% url 'leases:lease_file_share_one' doc.pk %}">
                      {% csrf_token %}
                      <button type="submit" class="btn btn-sm btn-primary ld-file-action-btn" title="Share on WhatsApp">
                        <i class="fab fa-whatsapp ld-file-icon-whatsapp"></i>
                      </button>
                    </form>
                    <form method="post" action="{% url 'leases:lease_file_deactivate' doc.pk %}" onsubmit="return confirm('Delete this file from the active list?');">
                      {% csrf_token %}
                      <button type="submit" class="btn btn-sm btn-danger ld-file-action-btn" title="Delete">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </div>
              {% empty %}
                <div class="ld-empty">No lease files uploaded yet.</div>
              {% endfor %}
            </div>
          </div>
        </div>

      </div>

      <!-- ======== INSPECTION SHEETS ======== -->
      <div class="ld-tab-pane" id="ld-tab-inspections">
        <div class="ld-inner-card">
          <div class="ld-inner-head">
            <span>Lease Inspection Sheets</span>
            <div class="d-flex flex-wrap gap-1 no-print">
              <a class="btn btn-sm btn-primary" href="{% url 'leases:lease_inspection_create' lease.pk %}">Create Inspection</a>
              <a class="btn btn-sm btn-dark" href="{% url 'leases:inspection_compare' lease.pk %}">Compare</a>
            </div>
          </div>
          <div class="ld-tw ld-mobile-cards">
            <table class="ld-tbl">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Template</th>
                  <th>Status</th>
                  <th>Complete</th>
                  <th class="no-print">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for inspection in lease.inspections.all %}
                  <tr>
                    <td data-label="Date">{{ inspection.inspection_date }}</td>
                    <td data-label="Type">{{ inspection.inspection_type }}</td>
                    <td data-label="Template">{{ inspection.inspection_template|default:"&mdash;" }}</td>
                    <td data-label="Status"><span class="ld-badge ld-badge-gray">{{ inspection.get_status_display }}</span></td>
                    <td data-label="Complete">{{ inspection.completion_percent }}%</td>
                    <td class="no-print ld-td-actions" data-label="Actions">
                      <div class="d-flex flex-wrap gap-1">
                        <a class="btn btn-sm btn-dark" href="{% url 'leases:inspection_detail' inspection.pk %}">View</a>
                        <a class="btn btn-sm btn-primary" href="{% url 'leases:inspection_edit' inspection.pk %}">Edit</a>
                        <a class="btn btn-sm btn-secondary" href="{% url 'leases:inspection_pdf' inspection.pk %}">Print</a>
                        <form method="post" action="{% url 'leases:inspection_public_link' inspection.pk %}">
                          {% csrf_token %}
                          <button class="btn btn-sm btn-success" type="submit">Public Link</button>
                        </form>
                        <form method="post" action="{% url 'leases:inspection_send_sheet' inspection.pk %}" target="_blank">
                          {% csrf_token %}
                          <button class="btn btn-sm btn-success" type="submit"><i class="fab fa-whatsapp"></i> Send Sheet</button>
                        </form>
                        <form method="post" action="{% url 'leases:inspection_approve' inspection.pk %}">
                          {% csrf_token %}
                          <button class="btn btn-sm btn-success" type="submit">Approve</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                {% empty %}
                  <tr><td colspan="6" class="ld-empty">No inspection sheets yet.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div><!-- /ld-tab-content-wrap -->
  </div><!-- /ld-tabs-wrapper -->

</div><!-- /ld-page -->

