{% extends 'base.html' %}

{% block title %}Tenant Registration Update{% endblock %}

{% block content %}
<div class="container mt-3" style="max-width: 760px;">
  <div class="card">
    <div class="card-header bg-dark text-white py-2 px-3">
      Confirm Tenant Details
    </div>
    <div class="card-body">
      <p class="small text-muted mb-3">
        Please review and submit updates for {{ tenant.get_full_name }}. Admin approval is required before changes are saved.
      </p>
      <form method="post" novalidate>
        {% csrf_token %}
        {% if form.non_field_errors %}
          <div class="alert alert-danger">{{ form.non_field_errors }}</div>
        {% endif %}
        <div class="row g-3">
          {% for field in form %}
            <div class="{% if field.name == 'address' %}col-12{% else %}col-md-6{% endif %}">
              {% if field.field.widget.input_type == "checkbox" %}
                <div class="form-check mt-4">
                  {{ field }}
                  <label class="form-check-label small" for="{{ field.id_for_label }}">{{ field.label }}</label>
                </div>
              {% else %}
                <label class="form-label small mb-1" for="{{ field.id_for_label }}">{{ field.label }}</label>
                {{ field }}
              {% endif %}
              {% for error in field.errors %}
                <div class="text-danger small">{{ error }}</div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
        <hr>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
          <h6 class="mb-0">Family Members</h6>
          <button type="button" class="btn btn-outline-primary btn-sm" id="addFamilyMember">Add Family Member</button>
        </div>
        <div id="familyMemberRows" class="d-grid gap-2"></div>
        <template id="familyMemberTemplate">
          <div class="border rounded p-2 family-member-card">
            <div class="row g-2">
              <div class="col-12 col-md-4">
                <label class="form-label small mb-1">Name</label>
                <input type="text" class="form-control form-control-sm" data-field="name">
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label small mb-1">Father/Husband Name</label>
                <input type="text" class="form-control form-control-sm" data-field="father_husband_name">
              </div>
              <div class="col-6 col-md-4">
                <label class="form-label small mb-1">CNIC</label>
                <input type="text" class="form-control form-control-sm" data-field="cnic">
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small mb-1">DOB</label>
                <input type="date" class="form-control form-control-sm" data-field="dob">
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Phone</label>
                <input type="text" class="form-control form-control-sm" data-field="phone">
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Occupation</label>
                <input type="text" class="form-control form-control-sm" data-field="occupation">
              </div>
              <div class="col-10 col-md-2">
                <label class="form-label small mb-1">Relationship</label>
                <select class="form-select form-select-sm" data-field="relationship">
                  <option value="spouse">Spouse</option>
                  <option value="son">Son</option>
                  <option value="daughter">Daughter</option>
                  <option value="father">Father</option>
                  <option value="mother">Mother</option>
                  <option value="brother">Brother</option>
                  <option value="sister">Sister</option>
                  <option value="uncle">Uncle</option>
                  <option value="aunt">Aunt</option>
                  <option value="grandfather">Grandfather</option>
                  <option value="grandmother">Grandmother</option>
                  <option value="cousin">Cousin</option>
                  <option value="nephew">Nephew</option>
                  <option value="niece">Niece</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="col-2 col-md-1 d-flex align-items-end">
                <button type="button" class="btn btn-outline-danger btn-sm w-100 remove-family-member">Remove</button>
              </div>
            </div>
          </div>
        </template>
        <div class="d-flex justify-content-end mt-3">
          <button type="submit" class="btn btn-primary btn-sm">Submit for Review</button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
(function () {
  const rows = document.getElementById("familyMemberRows");
  const template = document.getElementById("familyMemberTemplate");
  const addButton = document.getElementById("addFamilyMember");
  if (!rows || !template || !addButton) return;

  function renumber() {
    rows.querySelectorAll(".family-member-card").forEach(function (card, index) {
      card.querySelectorAll("[data-field]").forEach(function (field) {
        field.name = "family-" + index + "-" + field.dataset.field;
      });
    });
  }

  addButton.addEventListener("click", function () {
    rows.appendChild(template.content.cloneNode(true));
    renumber();
  });

  rows.addEventListener("click", function (event) {
    const remove = event.target.closest(".remove-family-member");
    if (!remove) return;
    remove.closest(".family-member-card").remove();
    renumber();
  });
})();
</script>
{% endblock %}
