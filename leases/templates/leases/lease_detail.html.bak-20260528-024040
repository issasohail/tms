    </div><!-- /ld-ov-grid -->
  </div><!-- /ld-overview-card -->

  <!-- ============================================================
       TABS  (5: Renewals · Unit & Meter · Terms & Notes · Activity · Documents)
  ============================================================ -->
  <div class="ld-tabs-wrapper">

    <div class="ld-tab-nav no-print" id="ldTabNav">
      <button class="ld-tab-btn active" data-tab="renewals">Lease Renewals</button>
      <button class="ld-tab-btn" data-tab="unit">Unit &amp; Meter</button>
      <button class="ld-tab-btn" data-tab="notes">Terms &amp; Notes</button>
      <button class="ld-tab-btn" data-tab="activity">Activity</button>
      <button class="ld-tab-btn" data-tab="docs">Documents</button>
    </div>

    <div class="ld-tab-content-wrap">

      <!-- ======== RENEWALS ======== -->
      <div class="ld-tab-pane active" id="ld-tab-renewals">
        <div class="d-flex justify-content-between align-items-center mb-3 no-print">
          <span class="ld-sec-title mb-0">Lease Renewal History</span>
          <a href="{% url 'leases:lease_renew' lease.pk %}" class="btn btn-sm btn-primary">
            <i class="fas fa-sync-alt me-1"></i> Renew Lease
          </a>
        </div>
        <div class="ld-tw">
          <table class="ld-tbl">
            <thead>
              <tr>
                <th>#</th>
                <th>Start</th>
                <th>End</th>
                <th>Rent</th>
                <th>Total Monthly</th>
                <th>Signed</th>
                <th>Files</th>
                <th class="no-print">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for renewal in renewals %}
                <tr>
                  <td>
                    #{{ forloop.counter }}
                    {% if forloop.first %}
                      <span class="ld-badge ld-badge-blue ms-1">Original</span>
                    {% else %}
                      <span class="ld-badge ld-badge-purple ms-1">Renewal</span>
                    {% endif %}
                  </td>
                  <td>{{ renewal.start_date|date:"M d, Y" }}</td>
                  <td>{{ renewal.end_date|date:"M d, Y" }}</td>
                  <td>{{ renewal.monthly_rent|default:0|money:0 }}</td>
                  <td>{{ renewal.total_monthly_amount|default:0|money:0 }}</td>
                  <td>
                    {% if renewal.is_agreement_signed %}
                      <span class="ld-badge ld-badge-green">Signed</span>
                    {% else %}
                      <span class="ld-badge ld-badge-amber">Pending</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if renewal.generated_agreement_pdf %}
                      <a href="{{ renewal.generated_agreement_pdf.url }}" target="_blank">PDF</a>
                    {% endif %}
                    {% if renewal.generated_agreement_docx %}
                      <a href="{{ renewal.generated_agreement_docx.url }}" target="_blank" class="ms-1">DOCX</a>
                    {% endif %}
                    {% if renewal.signed_copy %}
                      <a href="{{ renewal.signed_copy.url }}" target="_blank" class="ms-1">Signed</a>
                    {% endif %}
                    {% if not renewal.generated_agreement_pdf and not renewal.generated_agreement_docx and not renewal.signed_copy %}
                      &mdash;
                    {% endif %}
                  </td>
                  <td class="no-print">
                    <div style="display:flex;flex-wrap:wrap;gap:4px;">
                      <a href="{% url 'leases:lease_history_detail' lease.pk renewal.pk %}" class="btn btn-outline-dark">View</a>
                      <a href="{% url 'leases:lease_history_edit' lease.pk renewal.pk %}" class="btn btn-outline-primary">Edit</a>
                      <a href="{% url 'leases:edit_clauses' lease.pk %}?history={{ renewal.pk }}" class="btn btn-outline-secondary">Clauses</a>
                      <a href="{% url 'leases:renewal_agreement' lease.pk renewal.pk %}" class="btn btn-outline-dark">Generate PDF</a>
                      <a href="{% url 'leases:renewal_upload_signed' lease.pk renewal.pk %}" class="btn btn-outline-success">Upload Signed</a>
                      <a href="{% url 'leases:history_media_page' lease.pk renewal.pk %}" class="btn btn-outline-dark">Photos</a>
                    </div>
                  </td>
                </tr>
              {% empty %}
                <tr><td colspan="8" class="ld-empty">No renewal history recorded.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <!-- ======== UNIT & METER ======== -->
      <div class="ld-tab-pane" id="ld-tab-unit">
        <div class="ld-g2">
          <div class="ld-inner-card">
            <div class="ld-inner-head">
              Current Unit / Room
              <a href="{% url 'smart_meter:move_lease_unit' lease.pk %}" class="btn btn-sm btn-primary py-0 px-2 no-print" style="font-size:11px;">Move Tenant</a>
            </div>
            <div class="ld-inner-body">
              <div class="ld-row"><span class="ld-rk">Current Unit</span><span class="ld-rv"><a href="{% url 'properties:unit_detail' lease.current_unit.pk %}">{{ lease.current_unit.property.property_name }} {{ lease.current_unit.unit_number }}</a></span></div>
              <div class="ld-row"><span class="ld-rk">Lease Start</span><span class="ld-rv">{{ lease.start_date|date:"M d, Y" }}</span></div>
              <div class="ld-row"><span class="ld-rk">Lease End</span><span class="ld-rv">{{ lease.end_date|date:"M d, Y" }}</span></div>
            </div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Unit Move History</div>
            <div class="ld-tw">
              <table class="ld-tbl" style="min-width:340px;">
                <thead><tr><th>Unit</th><th>Move In</th><th>Move Out</th><th>Notes</th></tr></thead>
                <tbody>
                  {% for occ in lease.unit_occupancies.all %}
                    <tr>
                      <td><a href="{% url 'properties:unit_detail' occ.unit.pk %}">{{ occ.unit }}</a></td>
                      <td>{{ occ.move_in_date|date:"M d, Y" }}</td>
                      <td>{{ occ.move_out_date|date:"M d, Y"|default:"Current" }}</td>
                      <td style="color:#6b7280;font-size:11px;">{{ occ.notes|default:"&mdash;" }}</td>
                    </tr>
                  {% empty %}
                    <tr><td colspan="4" class="ld-empty">No move history.</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="ld-inner-card" style="margin-top:12px;">
          <div class="ld-inner-head">Meter Billing History / Usage Breakdown</div>
          <div class="ld-tw">
            <table class="ld-tbl">
              <thead><tr><th>Meter</th><th>Unit</th><th>Installed</th><th>Removed</th><th class="text-end">Start Reading</th><th class="text-end">End Reading</th></tr></thead>
              <tbody>
                {% for inst in lease.meter_installations.all %}
                  <tr>
                    <td><a href="{% url 'smart_meter:meter_detail' inst.meter.pk %}">{{ inst.meter.meter_number }}</a></td>
                    <td>{{ inst.unit }}</td>
                    <td>{{ inst.start_date|date:"M d, Y" }}</td>
                    <td>{{ inst.end_date|date:"M d, Y"|default:"Current" }}</td>
                    <td class="text-end">{{ inst.start_reading }}</td>
                    <td class="text-end">{{ inst.end_reading|default:"&mdash;" }}</td>
                  </tr>
                {% empty %}
                  <tr><td colspan="6" class="ld-empty">No meter installations linked.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ======== TERMS & NOTES ======== -->
      <div class="ld-tab-pane" id="ld-tab-notes">
        <div class="ld-g3">
          <div class="ld-inner-card">
            <div class="ld-inner-head">Terms</div>
            <div class="ld-inner-body" style="font-size:13px;">{{ lease.terms|default:"&mdash;" }}</div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Notes</div>
            <div class="ld-inner-body" style="font-size:13px;">{{ lease.notes|default:"&mdash;" }}</div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Return Notes</div>
            <div class="ld-inner-body" style="font-size:13px;">{{ lease.security_deposit_return_notes|default:"&mdash;" }}</div>
          </div>
        </div>
      </div>

      <!-- ======== ACTIVITY ======== -->
      <div class="ld-tab-pane" id="ld-tab-activity">
        <div class="ld-g2">
          <div class="ld-inner-card">
            <div class="ld-inner-head">Recent Payments</div>
            <div class="ld-inner-body">
              {% if recent_payments %}
                {% for p in recent_payments %}
                  <div class="ld-act">
                    <div><div class="ld-act-d">{{ p.payment_date }}</div><div class="ld-act-l">{{ p.reference_number|default:"Payment" }}</div></div>
                    <div class="ld-act-a" style="color:#15803d;">{{ p.amount|money:0 }}</div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="ld-empty">No payments yet.</div>
              {% endif %}
            </div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Invoices</div>
            <div class="ld-inner-body">
              {% if invoices %}
                {% for inv in invoices %}
                  <div class="ld-act">
                    <div><div class="ld-act-d">{{ inv.issue_date }}</div><div class="ld-act-l">{{ inv.description|default:"Invoice" }}</div></div>
                    <div class="ld-act-a" style="color:#dc2626;">{{ inv.amount|money:0 }}</div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="ld-empty">No invoices yet.</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- ======== DOCUMENTS ======== -->
      <div class="ld-tab-pane" id="ld-tab-docs">
        <div class="ld-g2">
          <div class="ld-inner-card">
            <div class="ld-inner-head">Signed Copy</div>
            <div class="ld-inner-body">
              {% if lease.signed_copy %}
                <a href="{{ lease.signed_copy.url }}" target="_blank" class="btn btn-sm btn-success no-print"><i class="fas fa-download"></i> Download Signed Copy</a>
              {% else %}
                <span class="ld-badge ld-badge-red"><i class="fas fa-times-circle me-1"></i> Not Uploaded</span>
              {% endif %}
            </div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-head">Generated Agreement PDF</div>
            <div class="ld-inner-body d-flex flex-wrap gap-2 align-items-center">
              <a href="{% url 'leases:download_preview' lease.id %}" class="btn btn-sm btn-dark no-print"><i class="fas fa-download"></i> Download Preview PDF</a>
              {% if lease.generated_agreement_pdf %}
                <a href="{{ lease.generated_agreement_pdf.url }}" target="_blank" class="btn btn-sm btn-success no-print"><i class="fas fa-file-pdf"></i> View Generated PDF</a>
              {% else %}
                <span class="ld-badge ld-badge-red"><i class="fas fa-times-circle me-1"></i> Not Generated</span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

    </div><!-- /ld-tab-content-wrap -->
  </div><!-- /ld-tabs-wrapper -->

</div><!-- /ld-page -->

<!-- Renewal media modal -->
<div class="modal fade" id="renewalMediaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12 col-md-9">
            <img id="renewalMediaMain" src="" alt="Media" class="img-fluid w-100 rounded border" style="max-height:75vh;object-fit:contain;">
          </div>
          <div class="col-12 col-md-3">
            <div id="renewalMediaThumbs" class="d-flex flex-wrap gap-2"></div>
          </div>
        </div>
      </div>
      <div class="modal-footer justify-content-between">
        <small class="text-muted">Click thumbnail to switch</small>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
(function () {
  const nav = document.getElementById('ldTabNav');
  if (!nav) return;
  nav.addEventListener('click', function (e) {
    const btn = e.target.closest('.ld-tab-btn');
    if (!btn) return;
    nav.querySelectorAll('.ld-tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.ld-tab-pane').forEach(p => p.classList.remove('active'));
    const t = document.getElementById('ld-tab-' + btn.dataset.tab);
    if (t) t.classList.add('active');
  });
})();

function openRenewalMedia(btn) {
  const urls = (btn.dataset.urls || '').split('|').filter(Boolean);
  if (!urls.length) return;
  const main   = document.getElementById('renewalMediaMain');
  const thumbs = document.getElementById('renewalMediaThumbs');
  main.src = urls[0];
  thumbs.innerHTML = '';
  urls.forEach(function(u) {
    const img = document.createElement('img');
    img.src = u;
    img.className = 'img-thumbnail';
    img.style.cssText = 'width:80px;height:80px;object-fit:cover;cursor:pointer;';
    img.addEventListener('click', function() { main.src = u; });
    thumbs.appendChild(img);
  });
  if (window.bootstrap && bootstrap.Modal)
    new bootstrap.Modal(document.getElementById('renewalMediaModal')).show();
}
</script>
{% endblock %}
