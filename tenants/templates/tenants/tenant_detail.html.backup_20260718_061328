            </div>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle td-table mb-0">
                <thead>
                  <tr>
                    <th>S.N</th>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  {% for invoice in invoices %}
                    {% if forloop.counter == 6 %}
                      </tbody><tbody class="collapse td-more-invoices-desktop">
                    {% endif %}
                    <tr>
                      <td>{{ forloop.counter }}</td>
                      <td><a href="{% url 'invoices:invoice_detail' invoice.pk %}" class="text-decoration-none">{{ invoice.invoice_number|default:invoice.pk }}</a></td>
                      <td>{% if invoice.issue_date %}{{ invoice.issue_date|date:"M d, Y" }}{% else %}-{% endif %}</td>
                      <td class="text-end"><a href="{% url 'invoices:invoice_detail' invoice.pk %}" class="text-decoration-none">{{ invoice.amount|money:2 }}</a></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
              {% if invoices|length > 5 %}
                <button class="btn btn-sm btn-outline-secondary td-more-btn mt-2" type="button" data-bs-toggle="collapse" data-bs-target=".td-more-invoices-desktop">More</button>
              {% endif %}
            </div>
          {% else %}
            <p class="mb-0 small text-muted">No invoices found.</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-4" id="tenantPayments">
      <div class="card td-card shadow-sm h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
            <a href="{% url 'payments:payment_list' %}?tenant={{ tenant.pk }}" class="td-section-title-link">
              <i class="fas fa-wallet me-2"></i>Payments
            </a>
          </h6>
          <a href="#tenantDetailTop" class="td-scroll-top">Top</a>
          <a href="/payments/create/?tenant={{ tenant.id }}{% if tenant.lease %}&lease={{ tenant.lease.id }}{% endif %}" class="btn btn-sm btn-success">
            <i class="fas fa-money-bill-wave me-1"></i> Add
          </a>
        </div>
        <div class="card-body py-2">
          {% if payments %}
            <div class="td-mobile-list td-mobile-money-list">
              {% for payment in payments %}
                <div class="td-mobile-money-row td-payment-row {% if forloop.counter > 5 %}collapse td-more-payments{% endif %}">
                  <span class="td-mobile-sn">{{ forloop.counter }}</span>
                  <span class="td-mobile-date">{% if payment.payment_date %}{{ payment.payment_date|date:"M d, Y" }}{% else %}-{% endif %}</span>
                  <a href="{% url 'payments:payment_detail' payment.pk %}" class="td-mobile-amount text-decoration-none">{{ payment.amount|money:2 }}</a>
                </div>
              {% endfor %}
              {% if payments|length > 5 %}
                <button class="btn btn-sm btn-outline-secondary td-more-btn" type="button" data-bs-toggle="collapse" data-bs-target=".td-more-payments">More</button>
              {% endif %}
            </div>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle td-table mb-0">
                <thead>
                  <tr>
                    <th>S.N</th>
                    <th>Payment #</th>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  {% for payment in payments %}
                    {% if forloop.counter == 6 %}
                      </tbody><tbody class="collapse td-more-payments-desktop">
                    {% endif %}
                    <tr>
                      <td>{{ forloop.counter }}</td>
                      <td><a href="{% url 'payments:payment_detail' payment.pk %}" class="text-decoration-none">{{ payment.payment_number|default:payment.pk }}</a></td>
                      <td>{% if payment.payment_date %}{{ payment.payment_date|date:"M d, Y" }}{% else %}-{% endif %}</td>
                      <td class="text-end">{{ payment.amount|money:2 }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
              {% if payments|length > 5 %}
                <button class="btn btn-sm btn-outline-secondary td-more-btn mt-2" type="button" data-bs-toggle="collapse" data-bs-target=".td-more-payments-desktop">More</button>
              {% endif %}
            </div>
          {% else %}
            <p class="mb-0 small text-muted">No payments found.</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-4" id="tenantFamily">
      <div class="card td-card shadow-sm h-100">
        <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
          <h6 class="mb-0"><i class="fas fa-users me-2"></i>Family Members</h6>
          <a href="#tenantDetailTop" class="td-scroll-top">Top</a>
          <div class="d-flex gap-1 small flex-wrap">
            <span class="badge bg-primary-subtle text-primary border">Adults: {{ family_adults|default:0 }}</span>
            <span class="badge bg-info-subtle text-info-emphasis border">Children: {{ family_children|default:0 }}</span>
            <span class="badge bg-dark-subtle text-dark border">Total: {{ family_total|default:0 }}</span>
            {% if family_target_leases %}
              <button class="btn btn-sm btn-outline-primary py-0" type="button" data-bs-toggle="collapse" data-bs-target="#tenantFamilyAddBox">Add</button>
            {% endif %}
          </div>
        </div>
        <div class="card-body py-2">
          {% if family_target_leases %}
            <div class="collapse mb-2" id="tenantFamilyAddBox">
              <div class="border rounded bg-light p-2">
                <form method="post" action="{% url 'tenants:tenant_family_add' tenant.pk %}" class="row g-2 align-items-end mb-2">
                  {% csrf_token %}
                  <div class="col-12">
                    <label class="form-label small mb-1">Lease</label>
                    <select name="lease" class="form-select form-select-sm">
                      {% for lease_option in family_target_leases %}
                        <option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-12">
                    <label class="form-label small mb-1">Existing Tenant</label>
                    <select name="family_member" class="form-select form-select-sm select2">
                      <option value="">Select tenant</option>
                      {% for item in tenant_family_options %}
                        <option value="{{ item.pk }}">{{ item.get_full_name }}{% if item.cnic %} - {{ item.cnic|format_cnic }}{% endif %}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-8">
                    <label class="form-label small mb-1">Relationship</label>
                    <select name="relation" class="form-select form-select-sm" required>
                      <option value="">Select</option>
                      {% for item in relationship_types %}
                        <option value="{{ item.pk }}">{{ item.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-4">
                    <button type="submit" class="btn btn-sm btn-success w-100">Link</button>
                  </div>
                </form>
                <form method="post" enctype="multipart/form-data" action="{% url 'tenants:tenant_family_create_and_add' tenant.pk %}" class="row g-2 align-items-end">
                  {% csrf_token %}
                  <div class="col-12">
                    <label class="form-label small mb-1">Lease</label>
                    <select name="lease" class="form-select form-select-sm">
                      {% for lease_option in family_target_leases %}
                        <option value="{{ lease_option.pk }}">{{ lease_option.unit.property.property_name }} / {{ lease_option.unit.unit_number }} - {{ lease_option.get_status_display }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-12"><label class="form-label small mb-1">New Family Member Name</label><input name="full_name" class="form-control form-control-sm"></div>
                  <div class="col-6"><label class="form-label small mb-1">CNIC</label><input name="cnic" class="form-control form-control-sm"></div>
                  <div class="col-6"><label class="form-label small mb-1">Phone</label><input name="phone" class="form-control form-control-sm"></div>
                  <div class="col-8">
                    <label class="form-label small mb-1">Relationship</label>
                    <select name="relation" class="form-select form-select-sm" required>
                      <option value="">Select</option>
                      {% for item in relationship_types %}
                        <option value="{{ item.pk }}">{{ item.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-4"><button type="submit" class="btn btn-sm btn-primary w-100">Create</button></div>
                </form>
              </div>
            </div>
          {% endif %}
          {% if family_members %}

            <div class="td-mobile-list td-mobile-people-list">
              {% for member in family_members %}
                <div class="td-mobile-person-row">
                  <div class="td-mobile-sn">{{ forloop.counter }}</div>
                  <div class="td-mobile-photo">
                    {% if member.family_member.photo %}
                      <img src="{{ member.family_member.photo.url }}" alt="{{ member.family_member.get_full_name }}">
                    {% else %}
                      <span><i class="fas fa-user"></i></span>
                    {% endif %}
                  </div>
                  <div class="td-mobile-person-detail">
                    <div class="td-mobile-person-name">
                      <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="text-decoration-none">
                        {{ member.family_member.get_full_name|truncatechars:15 }}
                      </a>
                      {% if member.family_member.age %}<span>({{ member.family_member.age }})</span>{% endif %}
                    </div>
                    <div class="td-mobile-muted">{{ member.relation|default:"-" }}</div>
                    <div class="td-mobile-phone">
                      {% include "tenants/_whatsapp_phone_link.html" with phone=member.family_member.phone label=member.family_member.phone name=member.family_member.get_full_name only %}
                    </div>
                    {% if family_target_lease_count > 1 and member.lease %}
                      <div class="td-mobile-muted">
                        {{ member.lease.unit.property.property_name|default:"-" }} / {{ member.lease.unit.unit_number|default:"-" }}
                      </div>
                    {% endif %}
                    <div class="td-mobile-actions">
                      <a href="{% url 'tenants:tenant_detail' member.family_member.pk %}" class="btn btn-sm btn-outline-dark">View</a>
                      <a href="{% url 'tenants:tenant_update' member.family_member.pk %}" class="btn btn-sm btn-outline-primary">Edit</a>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="mb-0 small text-muted">No family members recorded.</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="card td-card shadow-sm mb-3" id="tenantVehicles">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h6 class="mb-0"><i class="fas fa-car me-2"></i>Tenant Vehicles</h6>
      <a href="#tenantDetailTop" class="td-scroll-top">Top</a>
      {% if family_target_leases %}
        <button class="btn btn-sm btn-outline-primary py-0" type="button" data-bs-toggle="modal" data-bs-target="#tenantVehicleAddModal">Add</button>
      {% endif %}
    </div>
    <div class="card-body py-2">
      {% if tenant_vehicles %}
        <div class="td-mobile-list td-mobile-vehicle-list">
          {% for vehicle in tenant_vehicles %}
            <div class="td-mobile-person-row">
              <div class="td-mobile-sn">{{ forloop.counter }}</div>
              <div class="td-mobile-photo">
                {% if vehicle.vehicle_photo %}
                  <a href="{{ vehicle.vehicle_photo.url }}" data-fancybox="tenant-vehicles" data-caption="{{ vehicle }}">
                    <img src="{{ vehicle.vehicle_photo.url }}" alt="{{ vehicle }}">
                  </a>
                {% else %}
                  <span><i class="fas fa-car"></i></span>
                {% endif %}
              </div>
              <div class="td-mobile-person-detail">
                <div class="td-mobile-person-name">
                  {{ vehicle.vehicle_type.name|default:"Vehicle" }} <span>{{ vehicle.registration_number }}</span>
                </div>
                <div class="td-mobile-muted">
                  {{ vehicle.color|default:"-" }}{% if vehicle.make or vehicle.model %}, {{ vehicle.make|default:"-" }}{% if vehicle.model %} / {{ vehicle.model }}{% endif %}{% endif %}
                </div>
                {% if family_target_lease_count > 1 and vehicle.lease %}
                  <div class="td-mobile-muted">
                    {{ vehicle.lease.unit.property.property_name|default:"-" }} / {{ vehicle.lease.unit.unit_number|default:"-" }}
                  </div>
                {% endif %}
                <div class="td-mobile-actions">
                  <a href="{% url 'leases:lease_vehicle_edit' vehicle.lease.pk vehicle.pk %}" class="btn btn-sm btn-outline-primary">Edit</a>
                  <form method="post" action="{% url 'leases:lease_vehicle_delete' vehicle.lease.pk vehicle.pk %}" onsubmit="return confirm('Remove this vehicle from active list? History will be preserved.');">
                    {% csrf_token %}
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle td-table mb-0">
            <thead>
              <tr>
                <th>S.N</th>
                <th>Type</th>
                <th>Registration #</th>
                <th>Make / Model</th>
                <th>Owner</th>
                <th>Parking</th>
                <th>Lease</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {% for vehicle in tenant_vehicles %}
                <tr>
                  <td>{{ forloop.counter }}</td>
                  <td>{{ vehicle.vehicle_type.name }}</td>
                  <td>{{ vehicle.registration_number }}</td>
                  <td>{{ vehicle.make|default:"-" }}{% if vehicle.model %} / {{ vehicle.model }}{% endif %}</td>
                  <td>{{ vehicle.owner_name|default:"-" }}</td>
                  <td>{{ vehicle.parking_slot|default:"-" }}</td>
                  <td><a href="{% url 'leases:lease_detail' vehicle.lease.pk %}">{{ vehicle.lease.unit.property.property_name }} / {{ vehicle.lease.unit.unit_number }}</a></td>
                  <td>
                    {% if vehicle.is_active %}
                      <span class="badge bg-success">Active</span>
                    {% else %}
                      <span class="badge bg-secondary">Inactive</span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="mb-0 small text-muted">No vehicle information recorded.</p>
      {% endif %}
    </div>
  </div>

  {# ====================== LEASE HISTORY ====================== #}
  <div class="card td-card shadow-sm td-leases-card mb-3" id="tenantLeases">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><i class="far fa-building text-primary me-2"></i>Leases</h6>
          <a href="#tenantDetailTop" class="td-scroll-top">Top</a>
          <a class="btn btn-sm btn-outline-primary py-0" href="{% url 'leases:lease_create' %}?tenant={{ tenant.id }}">Add</a>
        </div>
        <div class="card-body py-2">
          {% if leases %}
            <div class="td-mobile-list td-mobile-lease-list">
              <div class="td-mobile-total-balance">
                <span>Total Lease Balance</span>
                <strong>{{ leases_total_balance|default:0|money:2 }}</strong>
              </div>
              {% for lease in leases %}
                <div class="td-mobile-lease-row">
                  <div class="td-mobile-lease-top">
                    <span>{{ forloop.counter }}</span>
                    <a href="{% url 'leases:lease_detail' lease.pk %}" class="text-decoration-none">
                      {{ lease.unit.property.property_name|default:"-" }} / {{ lease.unit.unit_number|default:"-" }}
                    </a>
                    <span class="badge bg-{% if lease.is_active %}success{% else %}secondary{% endif %}">
                      {% if lease.is_active %}Active{% else %}Inactive{% endif %}
                    </span>
                  </div>
                  <div class="td-mobile-muted">
                    {{ lease.start_date|date:"M d, Y" }} - {{ lease.end_date|date:"M d, Y"|default:"Ongoing" }}
                  </div>
                  <div class="td-mobile-lease-money">
                    <span>Monthly: {{ lease.get_total_payment|money:2 }}</span>
                    <span>Total: {{ lease.tenant_detail_total_balance|default:0|money:2 }}</span>
                  </div>
                  {% if lease.tenant_detail_security_balance %}
                    <div class="td-mobile-muted">
                      Lease {{ lease.tenant_detail_lease_balance|default:0|money:2 }} | Sec {{ lease.tenant_detail_security_balance|default:0|money:2 }}
                    </div>
                  {% endif %}
                  <div class="td-mobile-actions">
                    <a href="{% url 'leases:lease_detail' lease.pk %}" class="btn btn-sm btn-primary">Detail</a>
                    <a href="{% url 'leases:lease_ledger_by_pk' lease.pk %}" class="btn btn-sm btn-dark">Ledger</a>
                    <a href="{% url 'payments:payment_create' %}?tenant={{ tenant.id }}&lease={{ lease.id }}" class="btn btn-sm btn-outline-primary">Payment</a>
                  </div>
                </div>
              {% endfor %}
            </div>
            {% with all_leases=leases %}{% include "partials/_tenant_leases_table.html" %}{% endwith %}
          {% elif tenant.lease_set.all %}
            {% with all_leases=tenant.lease_set.all %}{% include "partials/_tenant_leases_table.html" %}{% endwith %}
          {% elif tenant.leases.all %}
            {% with all_leases=tenant.leases.all %}{% include "partials/_tenant_leases_table.html" %}{% endwith %}
          {% else %}
            <p class="mb-0 small text-muted">No leases found.</p>
          {% endif %}
        </div>
  </div>


</div>
{% endblock %}

