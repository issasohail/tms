      templateResult: function (item) {
        if (!item.id) return item.text;
        const detail = [item.property, item.unit].filter(Boolean).join(" / ");
        return detail ? item.text + " - " + detail : item.text;
      }
    });

    $tenantJump.on("select2:select", function (event) {
      const item = event.params && event.params.data;
      if (item && item.detail_url) {
        window.location.href = item.detail_url;
      }
    });

    $tenantJump.on("select2:open", function () {
      setTimeout(function () {
        const input = document.querySelector(".select2-container--open .select2-search__field");
        if (input) input.focus();
      }, 0);
    });
  }

  document.addEventListener("click", function (event) {
    const btn = event.target.closest("[data-copy-target]");
    if (!btn) return;

    const input = document.querySelector(btn.dataset.copyTarget);
    if (!input) return;

    const original = btn.innerHTML;
    const value = input.value || "";

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(value).then(function () {
        btn.innerHTML = "Copied";
        setTimeout(function () { btn.innerHTML = original; }, 1200);
      });
    } else {
      input.select();
      document.execCommand("copy");
    }
  });


  /* INLINE UPDATE JS: appended only; existing tenant_detail JS above is unchanged. */
  (function () {
    const canInlineUpdate = "{% if can_inline_update_tenant %}1{% else %}0{% endif %}" === "1";
    if (!canInlineUpdate) return;

    const inlineUrl = "{% url 'tenants:tenant_inline_update' tenant.pk %}";
    const documentUrl = "{% url 'tenants:tenant_document_replace' tenant.pk %}";

    function getCookie(name) {
      const value = `; ${document.cookie}`;
      const parts = value.split(`; ${name}=`);
      if (parts.length === 2) return parts.pop().split(';').shift();
      return '';
    }

    const csrftoken = getCookie('csrftoken');

    const labelToField = {
      "CNIC": "cnic",
      "Occupation": "occupation",
      "Nationality": "nationality",
      "Family Members": "number_of_family_member",
      "Email": "email",
      "Temporary Address": "temporary_address",
      "Permanent Address": "permanent_address",
      "Working Address": "working_address",
      "Notes": "notes"
    };

    document.querySelectorAll('.td-info-grid > div, .td-address-grid > div').forEach(function (cell) {
      const label = (cell.querySelector('span') || {}).textContent || '';
      const field = labelToField[label.trim()];
      const valueEl = cell.querySelector('strong');
      if (!field || !valueEl) return;
      valueEl.dataset.inlineField = field;
      valueEl.dataset.inlineType = ['temporary_address', 'permanent_address', 'working_address', 'notes'].includes(field) ? 'textarea' : 'text';
      valueEl.classList.add('td-inline-editable');
      valueEl.title = 'Click to edit';
    });

    function setStatus(el, text, className) {
      let status = el.parentElement.querySelector('.td-inline-status');
      if (!status) {
        status = document.createElement('span');
        status.className = 'td-inline-status';
        el.insertAdjacentElement('afterend', status);
      }
      status.textContent = text;
      status.className = 'td-inline-status ' + className;
      if (text !== 'Saving...') setTimeout(function () { status.textContent = ''; }, 1400);
    }

    async function saveInline(el, value) {
      setStatus(el, 'Saving...', 'td-inline-saving');
      const body = new FormData();
      body.append('field', el.dataset.inlineField);
      body.append('value', value);
      const response = await fetch(inlineUrl, { method: 'POST', headers: {'X-CSRFToken': csrftoken}, body });
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.error || 'Could not save');
      el.innerHTML = data.display || '-';
      setStatus(el, 'Saved', 'td-inline-saved');
    }

    document.addEventListener('click', function (event) {
      const el = event.target.closest('[data-inline-field]');
      if (!el || el.dataset.editing === '1') return;
      el.dataset.editing = '1';
      const original = el.textContent.trim() === '-' ? '' : el.textContent.trim();
      const type = el.dataset.inlineType || 'text';
      const editor = document.createElement(type === 'textarea' ? 'textarea' : 'input');
      editor.className = 'td-inline-editor';
      editor.value = original;
      el.innerHTML = '';
      el.appendChild(editor);
      editor.focus();
      editor.select();

      async function finish(save) {
        const value = editor.value.trim();
        el.dataset.editing = '0';
        if (!save || value === original) {
          el.innerHTML = original || '-';
          return;
        }
        el.innerHTML = value || '-';
        try { await saveInline(el, value); }
        catch (error) { el.innerHTML = original || '-'; setStatus(el, error.message, 'td-inline-error'); }
      }

      editor.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && type !== 'textarea') { e.preventDefault(); finish(true); }
        if (e.key === 'Escape') { e.preventDefault(); finish(false); }
      });
      editor.addEventListener('blur', function () { finish(true); });
    });

    async function compressImage(file, maxSize, quality) {
      if (!file.type || !file.type.startsWith('image/')) return file;
      const bitmap = await createImageBitmap(file);
      let width = bitmap.width;
      let height = bitmap.height;
      const ratio = Math.min(1, maxSize / Math.max(width, height));
      width = Math.round(width * ratio);
      height = Math.round(height * ratio);
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(bitmap, 0, 0, width, height);
      const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', quality));
      return new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), { type: 'image/jpeg' });
    }

    document.addEventListener('click', function (event) {
      const btn = event.target.closest('[data-document-replace]');
      if (!btn) return;
      event.preventDefault();
      event.stopPropagation();
      const input = document.querySelector('[data-document-input="' + btn.dataset.documentReplace + '"]');
      if (input) input.click();
    });

    document.querySelectorAll('[data-document-input]').forEach(function (input) {
      input.addEventListener('change', async function () {
        const file = input.files && input.files[0];
        if (!file) return;
        const field = input.dataset.documentInput;
        const btn = document.querySelector('[data-document-replace="' + field + '"]');
        const oldText = btn ? btn.textContent : '';
        if (btn) btn.textContent = 'Uploading...';
        try {
          const compressed = await compressImage(file, 1600, 0.82);
          const body = new FormData();
          body.append('field', field);
          body.append('file', compressed);
          const response = await fetch(documentUrl, { method: 'POST', headers: {'X-CSRFToken': csrftoken}, body });
          const data = await response.json();
          if (!response.ok || !data.ok) throw new Error(data.error || 'Upload failed');
          const zone = document.querySelector('[data-tenant-document-zone][data-field="' + field + '"]');
          if (zone) {
            const current = zone.querySelector('[data-document-preview="' + field + '"]');
            const img = document.createElement('img');
            img.src = data.url + '?v=' + Date.now();
            img.alt = data.label || field;
            img.dataset.documentPreview = field;
            if (field === 'photo') img.className = 'td-avatar';
            if (current) current.replaceWith(img);
            const link = zone.querySelector('a');
            if (link) link.href = data.url;
          }
          if (btn) btn.textContent = 'Replaced';
          setTimeout(function () { if (btn) btn.textContent = oldText || 'Replace'; }, 1200);
        } catch (error) {
          alert(error.message);
          if (btn) btn.textContent = oldText || 'Replace';
        } finally {
          input.value = '';
        }
      });
    });
  })();
</script>

