{% extends 'base.html' %}
{% load render_table from django_tables2 %}
{% load static %}
<link rel="stylesheet" href="{% static 'properties/css/tables.css' %}">

{% block title %}Units{% endblock %}


{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Units</h2>
    <div class="d-flex gap-2">
        <a href="{% url 'properties:unit_create' %}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add Unit
        </a>
        <button type="button"
                class="btn btn-success"
                id="vacantSummaryMessageBtn"
                data-summary-url="{% url 'properties:unit_vacant_summary_message' %}?{{ request.GET.urlencode }}">
            <i class="fab fa-whatsapp me-1"></i> Vacant Summary
        </button>
        
        {% include "includes/export_buttons.html" %}
    </div>
</div>

<!-- Filter form -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label for="id_property" class="form-label">Property</label>
                <select name="property" id="id_property" class="form-select" onchange="this.form.submit()">
                    <option value="">All Properties</option>
                    {% for property in all_properties %}
                        <option value="{{ property.id }}"
                            {% if request.GET.property|stringformat:"s" == property.id|stringformat:"s" %}selected{% endif %}>
                            {{ property.property_name }} - ({{ property.unit_count }} units)
                        </option>
                    {% empty %}
                        <option value="">No properties available</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label for="id_status" class="form-label">Status</label>
                <select name="status" id="id_status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="vacant" {% if current_status == "vacant" %}selected{% endif %}>Vacant</option>
                    <option value="occupied" {% if current_status == "occupied" %}selected{% endif %}>Occupied</option>
                    <option value="ending_soon" {% if current_status == "ending_soon" %}selected{% endif %}>Lease Ending Soon</option>
                    <option value="maintenance" {% if current_status == "maintenance" %}selected{% endif %}>Maintenance / Disabled</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary mt-3">Filter</button>
                {% if request.GET.property or request.GET.status %}
                    <a href="?" class="btn btn-outline-secondary mt-3">Clear</a>
                {% endif %}
            </div>
        </form>
    </div>
</div>


    {% csrf_token %}
<div class="table-responsive">
    {% render_table table %}
</div>

<div class="modal fade" id="vacantNoticeModal" tabindex="-1" aria-labelledby="vacantNoticeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="vacantNoticeModalLabel">Vacant Notice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-2">
                <div id="vacantNoticeStatus" class="small text-muted">Loading...</div>
                <div id="vacantNoticeLeads" class="table-responsive d-none"></div>
            </div>
        </div>
    </div>
</div>


    {% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}
{% block extra_js %}
<script>
document.addEventListener("DOMContentLoaded", function () {
    const selectAll = document.getElementById('select-all');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('input[name="selected_units"]');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });
    }

    document.querySelectorAll("td[data-editable='true']").forEach(td => {
        td.addEventListener("dblclick", function () {
            const field = td.dataset.field;
            const id = td.dataset.id;
            const current = td.innerText.trim();

            const input = document.createElement("input");
            input.type = "text";
            input.value = current;
            input.className = "form-control";
            td.innerHTML = "";
            td.appendChild(input);
            input.focus();

            input.addEventListener("blur", function () {
                fetch("{% url 'properties:unit_inline_update' %}", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRFToken": getCookie("csrftoken")
                    },
                    body: JSON.stringify({
                        id: id,
                        field: field,
                        value: input.value
                    })
                }).then(res => res.json()).then(data => {
                    td.innerText = data.new_value || input.value;
                }).catch(err => {
                    console.error(err);
                    td.innerText = current;
                });
            });
        });
    });

    const modalEl = document.getElementById("vacantNoticeModal");
    const modalTitle = document.getElementById("vacantNoticeModalLabel");
    const statusEl = document.getElementById("vacantNoticeStatus");
    const leadsEl = document.getElementById("vacantNoticeLeads");
    const noticeModal = modalEl ? new bootstrap.Modal(modalEl) : null;

    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });

    const vacantSummaryButton = document.getElementById("vacantSummaryMessageBtn");
    if (vacantSummaryButton) {
        vacantSummaryButton.addEventListener("click", function () {
            vacantSummaryButton.disabled = true;
            fetch(vacantSummaryButton.dataset.summaryUrl, {
                headers: {"X-Requested-With": "XMLHttpRequest"}
            })
            .then(function (response) {
                return response.json().then(function (payload) {
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.error || "Could not build vacant summary.");
                    }
                    return payload;
                });
            })
            .then(function (payload) {
                window.open(payload.whatsapp_url, "_blank");
            })
            .catch(function (error) {
                alert(error.message);
            })
            .finally(function () {
                vacantSummaryButton.disabled = false;
            });
        });
    }

    document.querySelectorAll(".vacant-notice-btn").forEach(function (button) {
        button.addEventListener("click", function () {
            if (!noticeModal) return;
            modalTitle.textContent = button.dataset.unitTitle || "Vacant Notice";
            statusEl.textContent = "Loading...";
            statusEl.classList.remove("d-none");
            leadsEl.classList.add("d-none");
            leadsEl.innerHTML = "";
            noticeModal.show();

            fetch(button.dataset.leadsUrl, {
                headers: {"X-Requested-With": "XMLHttpRequest"}
            })
            .then(function (response) {
                if (!response.ok) throw new Error("Could not load matching tenants.");
                return response.json();
            })
            .then(function (data) {
                renderVacantNoticeLeads(data);
            })
            .catch(function (error) {
                statusEl.textContent = error.message;
            });
        });
    });

    function renderVacantNoticeLeads(data) {
        const tenants = data.tenants || [];
        const interestTypeName = data.unit && data.unit.interest_type ? data.unit.interest_type.name : "this lead type";
        if (!tenants.length) {
            statusEl.textContent = "No tenants found for " + interestTypeName + ".";
            leadsEl.classList.add("d-none");
            return;
        }

        statusEl.classList.add("d-none");
        leadsEl.classList.remove("d-none");
        leadsEl.innerHTML = `
            <table class="table table-sm table-bordered align-middle mb-0 vacant-leads-table">
                <thead class="table-light">
                    <tr>
                        <th style="width:56px;">Photo</th>
                        <th>Tenant</th>
                        <th style="width:170px;">Phone</th>
                        <th>Interested In</th>
                        <th style="width:210px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    ${tenants.map(function (tenant) { return leadRowHtml(tenant, data.interest_types || []); }).join("")}
                </tbody>
            </table>
        `;

        leadsEl.querySelectorAll(".lead-phone-input").forEach(function (input) {
            input.addEventListener("blur", function () {
                saveTenantLeadField(input.dataset.updateUrl, "phone", input.value)
                    .then(function (payload) {
                        updateRowAfterSave(input.closest("tr"), payload.tenant);
                    })
                    .catch(function (error) {
                        alert(error.message);
                    });
            });
        });

        leadsEl.querySelectorAll(".lead-interest-check").forEach(function (checkbox) {
            checkbox.addEventListener("change", function () {
                const row = checkbox.closest("tr");
                const checked = Array.from(row.querySelectorAll(".lead-interest-check:checked")).map(function (item) {
                    return item.value;
                });
                saveTenantLeadField(checkbox.dataset.updateUrl, "interested_in", checked)
                    .then(function (payload) {
                        updateRowAfterSave(row, payload.tenant);
                    })
                    .catch(function (error) {
                        alert(error.message);
                    });
            });
        });

        leadsEl.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    }

    function leadRowHtml(tenant, allInterestTypes) {
        const photo = tenant.photo_url
            ? `<img src="${escapeAttr(tenant.photo_url)}" alt="" class="rounded" style="width:42px;height:42px;object-fit:cover;">`
            : `<div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center" style="width:42px;height:42px;"><i class="fas fa-user"></i></div>`;
        const badges = interestBadgesHtml(tenant.interested_in || []);
        const checks = allInterestTypes.map(function (item) {
            const checked = (tenant.interested_in || []).some(function (current) { return String(current.id) === String(item.id); });
            return `
                <label class="form-check form-check-inline mb-1 small">
                    <input class="form-check-input lead-interest-check"
                           type="checkbox"
                           value="${item.id}"
                           data-update-url="${escapeAttr(tenant.tenant_inline_update_url)}"
                           ${checked ? "checked" : ""}>
                    ${escapeHtml(item.name)}
                </label>
            `;
        }).join("");
        const waDisabled = tenant.phone ? "" : "disabled";
        const waTitle = tenant.phone ? "WhatsApp" : "No phone number";
        const waHref = tenant.phone ? tenant.whatsapp_url : "#";
        return `
            <tr data-message="${escapeAttr(tenant.whatsapp_message || "")}">
                <td>${photo}</td>
                <td>
                    <div class="fw-semibold">${escapeHtml(tenant.full_name || "")}</div>
                    <div class="lead-interest-badges mt-1">${badges}</div>
                </td>
                <td>
                    <input type="text"
                           class="form-control form-control-sm lead-phone-input"
                           value="${escapeAttr(tenant.phone || "")}"
                           data-update-url="${escapeAttr(tenant.tenant_inline_update_url)}">
                </td>
                <td>
                    <div class="lead-interest-checks">${checks}</div>
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="${escapeAttr(tenant.tenant_detail_url)}" class="btn btn-sm btn-info" target="_blank" rel="noopener">
                            <i class="fas fa-eye"></i> View
                        </a>
                        <a href="${escapeAttr(tenant.tenant_edit_url)}" class="btn btn-sm btn-warning" target="_blank" rel="noopener">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a href="${escapeAttr(waHref)}"
                           class="btn btn-sm btn-success lead-wa-btn ${waDisabled}"
                           target="_blank"
                           rel="noopener"
                           title="${waTitle}"
                           data-bs-toggle="tooltip">
                            <i class="fab fa-whatsapp"></i> WhatsApp
                        </a>
                    </div>
                </td>
            </tr>
        `;
    }

    function saveTenantLeadField(url, field, value) {
        return fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-CSRFToken": getCookie("csrftoken"),
                "X-Requested-With": "XMLHttpRequest"
            },
            body: JSON.stringify({field: field, value: value})
        }).then(function (response) {
            return response.json().then(function (payload) {
                if (!response.ok || !payload.success) {
                    throw new Error(payload.error || "Could not save tenant.");
                }
                return payload;
            });
        });
    }

    function updateRowAfterSave(row, tenant) {
        if (!row || !tenant) return;
        const phoneInput = row.querySelector(".lead-phone-input");
        const whatsappButton = row.querySelector(".lead-wa-btn");
        const badges = row.querySelector(".lead-interest-badges");
        if (phoneInput) {
            phoneInput.value = tenant.phone || "";
        }
        if (badges) {
            badges.innerHTML = interestBadgesHtml(tenant.interested_in || []);
        }
        if (whatsappButton) {
            const message = row.dataset.message || "";
            const phone = tenant.phone || "";
            if (phone) {
                whatsappButton.href = buildWhatsAppUrl(phone, message);
                whatsappButton.classList.remove("disabled");
                whatsappButton.title = "WhatsApp";
            } else {
                whatsappButton.href = "#";
                whatsappButton.classList.add("disabled");
                whatsappButton.title = "No phone number";
            }
        }
    }

    function interestBadgesHtml(items) {
        if (!items.length) return '<span class="text-muted small">-</span>';
        return items.map(function (item) {
            return `<span class="badge bg-light text-dark border me-1">${escapeHtml(item.name)}</span>`;
        }).join("");
    }

    function buildWhatsAppUrl(phone, message) {
        let digits = String(phone || "").replace(/\D/g, "");
        const defaultCode = "{{ GLOBAL_SETTINGS.country_code|default:'+92'|escapejs }}".replace(/\D/g, "");
        if (!digits) return "#";
        if (digits.startsWith("00")) digits = digits.slice(2);
        if (digits.startsWith("0") && defaultCode) {
            digits = defaultCode + digits.slice(1);
        } else if (defaultCode && !digits.startsWith(defaultCode)) {
            digits = defaultCode + digits;
        }
        return "https://wa.me/" + encodeURIComponent(digits) + "?text=" + encodeURIComponent(message || "");
    }

    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== "") {
            const cookies = document.cookie.split(";");
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + "=")) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }

    function escapeHtml(value) {
        return String(value || "").replace(/[&<>"']/g, function (char) {
            return {"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"}[char];
        });
    }

    function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#096;");
    }
});

    
</script>
{% endblock %}
