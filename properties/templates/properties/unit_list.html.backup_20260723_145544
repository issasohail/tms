/* ==========================================================================
   TABLET + MOBILE SHARED CARD LAYOUT (<= 999.98px)
   Table becomes a stack of cards; one field per row via ::before labels.
   Selectors use the real column classes from tables.py.
   ========================================================================== */
@media (max-width: 999.98px) {
    .unit-page-header {
        align-items: flex-start !important;
        flex-direction: column;
    }
    .unit-page-actions {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr));
