{% extends 'base.html' %}
{% load humanize static %}

{% block extra_css %}
<style>
/* ============================================================
   LEASE DETAIL — Option 5 Minimal Clean
   Responsive: 360px → 414px → 768px → 1024px+
   ============================================================ */

/* ---- Page scaffold ---- */
.ld-page { padding: 10px 12px 32px; }

/* ---- Title zone ---- */
.ld-title-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 10px;
}
.ld-title {
  font-size: 16px;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
  margin: 0;
}
.ld-title span.ld-occ {
  font-size: 12px;
  font-weight: 400;
  color: #6b7280;
}
.ld-subtitle {
  font-size: 11px;
  color: #6b7280;
  margin-top: 3px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}

/* ---- Action buttons ---- */
.ld-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

/* ---- KPI strip ---- */
.ld-kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-bottom: 10px;
}
@media (min-width: 480px) {
  .ld-kpi-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 768px) {
  .ld-kpi-grid { grid-template-columns: repeat(6, 1fr); }
}
.ld-kpi {
  background: #fff;
  border: 0.5px solid #e5e7eb;
  border-radius: 8px;
  padding: 9px 11px;
}
.ld-kpi-label {
  font-size: 10px;
  color: #6b7280;
  font-weight: 500;
  margin-bottom: 3px;
}
.ld-kpi-value {
  font-size: 14px;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}
.ld-kpi-sub {
  font-size: 9px;
  color: #9ca3af;
  margin-top: 2px;
}
.ld-kpi-value.text-danger { color: #dc2626 !important; }
.ld-kpi-value.text-warning { color: #d97706 !important; }

/* ---- Overview card ---- */
.ld-overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px 16px;
}
@media (min-width: 576px) {
  .ld-overview-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 992px) {
  .ld-overview-grid { grid-template-columns: repeat(4, 1fr); }
}
.ld-field-label {
  font-size: 10px;
  color: #6b7280;
  margin-bottom: 1px;
}
.ld-field-value {
  font-size: 11px;
  color: #111827;
  font-weight: 500;
}

/* ---- Tab nav grid ---- */
.ld-tab-nav {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4px;
  margin-bottom: 0;
}
@media (min-width: 480px) {
  .ld-tab-nav { grid-template-columns: repeat(4, 1fr); }
}
@media (min-width: 768px) {
  .ld-tab-nav { grid-template-columns: repeat(8, 1fr); }
}
.ld-tab-btn {
  padding: 8px 6px;
  font-size: 11px;
  font-weight: 500;
  color: #6b7280;
  background: #f3f4f6;
  border: 0.5px solid #e5e7eb;
  border-radius: 6px;
  cursor: pointer;
  text-align: center;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  user-select: none;
}
.ld-tab-btn:hover {
  background: #e5e7eb;
  color: #374151;
}
.ld-tab-btn.active {
  background: #dbeafe;
  color: #1d4ed8;
  border-color: #bfdbfe;
  font-weight: 600;
}

/* ---- Tab content wrapper ---- */
.ld-tab-content-wrap {
  background: #fff;
  border: 0.5px solid #e5e7eb;
  border-radius: 0 0 8px 8px;
  border-top: none;
  padding: 12px;
  margin-bottom: 16px;
}

/* The gap between tab-nav and content - connect them visually */
.ld-tabs-wrapper {
  margin-bottom: 0;
}
.ld-tab-nav {
  border-radius: 8px 8px 0 0;
  /* override individual item top radii on edges */
}
/* Connect tab bar visually to content */
.ld-tab-nav .ld-tab-btn:first-child { border-bottom-left-radius: 0; }
.ld-tab-nav .ld-tab-btn:last-child { border-bottom-right-radius: 0; }

/* ---- Tab pane visibility ---- */
.ld-tab-pane { display: none; }
.ld-tab-pane.active { display: block; }

/* ---- Inner cards (inside tabs) ---- */
.ld-inner-card {
  border: 0.5px solid #e5e7eb;
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 10px;
}
.ld-inner-card:last-child { margin-bottom: 0; }
.ld-inner-header {
  background: #f8fafc;
  border-bottom: 0.5px solid #e5e7eb;
  padding: 6px 11px;
  font-size: 10px;
  font-weight: 700;
  color: #374151;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ld-inner-body { padding: 8px 11px; }

/* ---- Key-value rows ---- */
.ld-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 3px 0;
  border-bottom: 0.5px solid #f9fafb;
  font-size: 11px;
  gap: 8px;
}
.ld-row:last-child { border-bottom: none; }
.ld-row-key {
  color: #6b7280;
  font-weight: 500;
  flex-shrink: 0;
  min-width: 100px;
}
.ld-row-val {
  color: #111827;
  font-weight: 500;
  text-align: right;
}

/* ---- Two/three col layouts inside tabs ---- */
.ld-grid-2 {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}
@media (min-width: 576px) {
  .ld-grid-2 { grid-template-columns: 1fr 1fr; }
}
.ld-grid-3 {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}
@media (min-width: 576px) {
  .ld-grid-3 { grid-template-columns: 1fr 1fr; }
}
@media (min-width: 992px) {
  .ld-grid-3 { grid-template-columns: repeat(3, 1fr); }
}

/* ---- Deposit summary ---- */
.ld-deposit-wrap {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
@media (min-width: 576px) {
  .ld-deposit-wrap { grid-template-columns: 190px 1fr; }
}
.ld-dep-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 4px;
  margin-bottom: 2px;
}
.ld-dep-row.warn { background: #fef9c3; }
.ld-dep-row.ok   { background: #f0fdf4; }
.ld-dep-label { color: #6b7280; }
.ld-dep-value { font-weight: 600; }

/* ---- Activity rows ---- */
.ld-act-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 5px 0;
  border-bottom: 0.5px solid #f3f4f6;
  font-size: 11px;
  gap: 6px;
}
.ld-act-row:last-child { border-bottom: none; }
.ld-act-date { font-size: 10px; color: #6b7280; white-space: nowrap; }
.ld-act-label { color: #111827; }
.ld-act-amount { font-weight: 600; white-space: nowrap; }

/* ---- Inventory grid ---- */
.ld-inv-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3px 16px;
}

/* ---- Responsive tables inside tabs ---- */
.ld-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.ld-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
  min-width: 480px;
}
.ld-table th {
  background: #f8fafc;
  padding: 5px 9px;
  font-size: 10px;
  font-weight: 600;
  color: #6b7280;
  border-bottom: 0.5px solid #e5e7eb;
  text-align: left;
  white-space: nowrap;
}
.ld-table td {
  padding: 5px 9px;
  border-bottom: 0.5px solid #f3f4f6;
  color: #111827;
}
.ld-table tr:last-child td { border-bottom: none; }

/* ---- Badges ---- */
.ld-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 10px;
  font-weight: 500;
}
.ld-badge-green  { background: #dcfce7; color: #166534; }
.ld-badge-red    { background: #fee2e2; color: #991b1b; }
.ld-badge-amber  { background: #fef9c3; color: #854d0e; }
.ld-badge-blue   { background: #dbeafe; color: #1d4ed8; }
.ld-badge-gray   { background: #f3f4f6; color: #374151; }

/* ---- Police verification badge helper ---- */
.ld-police-verified { background: #dcfce7; color: #166534; }
.ld-police-rejected { background: #fee2e2; color: #991b1b; }
.ld-police-pending, .ld-police-follow_up { background: #fef9c3; color: #854d0e; }
.ld-police-not_started { background: #f3f4f6; color: #374151; }

/* ---- Bootstrap card overrides to match style ---- */
.card.ld-card {
  border: 0.5px solid #e5e7eb;
  border-radius: 8px;
  margin-bottom: 10px;
}
.card.ld-card .card-header {
  background: #f8fafc;
  border-bottom: 0.5px solid #e5e7eb;
  padding: 7px 12px;
  font-size: 11px;
  font-weight: 700;
  color: #374151;
  border-radius: 8px 8px 0 0 !important;
}
.card.ld-card .card-body {
  padding: 10px 12px;
}

/* ---- Witness layout ---- */
.ld-witness-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 16px;
}

/* ---- Renewal action buttons inside table ---- */
.ld-renewal-actions { display: flex; flex-wrap: wrap; gap: 3px; }

/* ---- Section title inside tab pane ---- */
.ld-section-title {
  font-size: 10px;
  font-weight: 700;
  color: #374151;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

/* ---- No data placeholder ---- */
.ld-empty {
  padding: 10px 0;
  font-size: 11px;
  color: #9ca3af;
}
</style>
{% endblock %}

{% block content %}
<div class="ld-page">

  <!-- ============================================================
       TITLE + ACTIONS
  ============================================================ -->
  <div class="ld-title-row">
    <div>
      <h1 class="ld-title">
        Lease #{{ lease.id }} — {{ lease.unit.property.property_name }} {{ lease.unit.unit_number }}
        <span class="ld-occ">(Occupancy: {{ occupancy_count }})</span>
      </h1>
      <div class="ld-subtitle">
        <span>{{ lease.tenant.get_full_name }}</span>
        <span>·</span>
        <span>{{ lease.start_date }} – {{ lease.end_date }}</span>
        <span class="ld-badge {% if lease.status == 'active' %}ld-badge-green{% elif lease.status == 'expired' %}ld-badge-red{% else %}ld-badge-gray{% endif %}">
          {{ lease.get_status_display }}
        </span>
      </div>
    </div>

    <div class="ld-actions">
      <a href="{% url 'leases:lease_list' %}" class="btn btn-sm btn-secondary">← Back</a>

      {% if lease.signed_agreement %}
        <a href="{{ lease.signed_agreement.url }}" target="_blank" class="btn btn-sm btn-success">
          <i class="fas fa-file-signature"></i> Signed Agreement
        </a>
      {% else %}
        <button class="btn btn-sm btn-secondary" disabled>
          <i class="fas fa-file-signature"></i> No Signed Agreement
        </button>
      {% endif %}

      <a href="{% url 'leases:lease_update' lease.pk %}" class="btn btn-sm btn-primary">
        <i class="fas fa-edit"></i> Edit
      </a>
      <a href="{% url 'leases:lease_renew' lease.pk %}" class="btn btn-sm btn-success">
        <i class="fas fa-sync-alt"></i> Renew
      </a>
      <a href="{% url 'leases:lease_security_list' lease.id %}" class="btn btn-sm btn-warning">
        <i class="fas fa-piggy-bank"></i> Deposit Ledger
      </a>
      <a href="{% url 'leases:lease_ledger_by_pk' lease.pk %}" class="btn btn-sm btn-warning">
        <i class="fas fa-book"></i> Ledger
      </a>
      <a href="{% url 'leases:lease_welcome_whatsapp' lease.pk %}" class="btn btn-sm btn-success">
        <i class="fab fa-whatsapp"></i> WA
      </a>
      <a href="{% url 'leases:lease_print' lease.pk %}" class="btn btn-sm btn-secondary">
        <i class="fas fa-print"></i> Print
      </a>
      {% if lease.generated_agreement_pdf %}
        <button onclick="sendEmail()" class="btn btn-sm btn-info">
          <i class="fas fa-envelope"></i> Email
        </button>
        <a href="{% url 'leases:download_preview' lease.id %}" class="btn btn-sm btn-dark">
          <i class="fas fa-download"></i> PDF
        </a>
      {% endif %}
      <a href="{% url 'leases:edit_clauses' lease.pk %}" class="btn btn-sm btn-primary">
        <i class="fas fa-eye"></i> View Agreement
      </a>
      <a href="{% url 'leases:lease_delete' lease.pk %}" class="btn btn-sm btn-danger">
        <i class="fas fa-trash-alt"></i> Delete
      </a>
    </div>
  </div>

  <!-- ============================================================
       KPI STRIP
  ============================================================ -->
  <div class="ld-kpi-grid">
    <div class="ld-kpi">
      <div class="ld-kpi-label">Monthly Rent</div>
      <div class="ld-kpi-value">{{ lease.monthly_rent|default:0|money:0 }}</div>
      <div class="ld-kpi-sub">+ {{ lease.society_maintenance|default:0|money:0 }} maint.</div>
    </div>
    <div class="ld-kpi">
      <div class="ld-kpi-label">Balance Due</div>
      <div class="ld-kpi-value text-danger">{{ balance_due|default:0|money:0 }}</div>
      <div class="ld-kpi-sub">outstanding</div>
    </div>
    <div class="ld-kpi">
      <div class="ld-kpi-label">Security Required</div>
      <div class="ld-kpi-value text-warning">{{ security_required|default:0|money:0 }}</div>
      <div class="ld-kpi-sub">{{ security_currently_held|default:0|money:0 }} held</div>
    </div>
    <div class="ld-kpi">
      <div class="ld-kpi-label">Lease Period</div>
      <div class="ld-kpi-value" style="font-size: 12px;">{{ lease.start_date }} – {{ lease.end_date }}</div>
      <div class="ld-kpi-sub">Min {{ lease.min_lease_occupancy_months|default:"—" }} months</div>
    </div>
    <div class="ld-kpi">
      <div class="ld-kpi-label">Police Verification</div>
      <div class="ld-kpi-value" style="font-size: 12px;">
        <span class="ld-badge ld-police-{{ lease.police_verification_status|default:'not_started' }}">
          {{ lease.get_police_verification_status_display }}
        </span>
      </div>
      <div class="ld-kpi-sub">Follow-up: {{ lease.police_verification_follow_up_date|date:"M d, Y"|default:"—" }}</div>
    </div>
    <div class="ld-kpi">
      <div class="ld-kpi-label">Documents</div>
      <div class="ld-kpi-value" style="font-size: 12px;">
        {% if lease.signed_agreement and lease.generated_agreement_pdf %}
          <span class="ld-badge ld-badge-green">All uploaded</span>
        {% else %}
          <span class="ld-badge ld-badge-red">
            {% if not lease.signed_agreement and not lease.generated_agreement_pdf %}2{% elif not lease.signed_agreement or not lease.generated_agreement_pdf %}1{% endif %} missing
          </span>
        {% endif %}
      </div>
      <div class="ld-kpi-sub">
        {% if not lease.signed_agreement %}Signed · {% endif %}
        {% if not lease.generated_agreement_pdf %}Agreement PDF{% endif %}
      </div>
    </div>
  </div>

  <!-- ============================================================
       OVERVIEW CARD
  ============================================================ -->
  <div class="card ld-card mb-2">
    <div class="card-header">Property, Tenant &amp; Lease Overview</div>
    <div class="card-body">
      <div class="ld-overview-grid">
        <div>
          <div class="ld-field-label">Property</div>
          <div class="ld-field-value">{{ lease.unit.property.property_name }}</div>
        </div>
        <div>
          <div class="ld-field-label">Unit</div>
          <div class="ld-field-value">{{ lease.unit.unit_number }}</div>
        </div>
        <div>
          <div class="ld-field-label">Start Date</div>
          <div class="ld-field-value">{{ lease.start_date }}</div>
        </div>
        <div>
          <div class="ld-field-label">End Date</div>
          <div class="ld-field-value">{{ lease.end_date }}</div>
        </div>
        <div>
          <div class="ld-field-label">Tenant</div>
          <div class="ld-field-value">{{ lease.tenant.get_full_name }}</div>
        </div>
        <div>
          <div class="ld-field-label">Tenant CNIC</div>
          <div class="ld-field-value">{{ lease.tenant.cnic|default:"—" }}</div>
        </div>
        <div>
          <div class="ld-field-label">Tenant Phone</div>
          <div class="ld-field-value">
            {% if lease.tenant.phone %}
              <a href="tel:{{ lease.tenant.phone }}">{{ lease.tenant.phone }}</a>
            {% else %}—{% endif %}
          </div>
        </div>
        <div>
          <div class="ld-field-label">Status</div>
          <div class="ld-field-value">
            <span class="ld-badge {% if lease.status == 'active' %}ld-badge-green{% elif lease.status == 'expired' %}ld-badge-red{% else %}ld-badge-gray{% endif %}">
              {{ lease.get_status_display }}
            </span>
          </div>
        </div>
        <div>
          <div class="ld-field-label">Monthly Rent</div>
          <div class="ld-field-value">{{ lease.monthly_rent|default:0|money:0 }}</div>
        </div>
        <div>
          <div class="ld-field-label">Society Maintenance</div>
          <div class="ld-field-value">{{ lease.society_maintenance|default:0|money:0 }}</div>
        </div>
        <div>
          <div class="ld-field-label">Security Deposit</div>
          <div class="ld-field-value">{{ lease.security_deposit|default:0|money:0 }}</div>
        </div>
        <div>
          <div class="ld-field-label">Balance</div>
          <div class="ld-field-value" style="color: #dc2626; font-weight: 700;">{{ balance_due|default:0|money:0 }}</div>
        </div>
        <div>
          <div class="ld-field-label">Rent Due Day</div>
          <div class="ld-field-value">{{ lease.due_date|default:"—" }}</div>
        </div>
        <div>
          <div class="ld-field-label">Late Fee</div>
          <div class="ld-field-value">{{ lease.late_fee|default:0|money:0 }}</div>
        </div>
        <div>
          <div class="ld-field-label">Rent Increase %</div>
          <div class="ld-field-value">{{ lease.rent_increase_percent|default:0 }}%</div>
        </div>
        <div>
          <div class="ld-field-label">Agreement Date</div>
          <div class="ld-field-value">{{ lease.agreement_date|default:"—" }}</div>
        </div>
        <div>
          <div class="ld-field-label">Min Occupancy</div>
          <div class="ld-field-value">{{ lease.min_lease_occupancy_months|default:"—" }} months</div>
        </div>
        <div>
          <div class="ld-field-label">Total Payment</div>
          <div class="ld-field-value">{{ lease.total_payment|default:0|money:0 }}</div>
        </div>
        <div>
          <div class="ld-field-label">Meter Reading</div>
          <div class="ld-field-value">{{ lease.electricity_meter_reading|default:"—" }}</div>
        </div>
        <div>
          <div class="ld-field-label">Police Verified Date</div>
          <div class="ld-field-value">{{ lease.police_verification_date|date:"M d, Y"|default:"—" }}</div>
        </div>
      </div>
      {% if lease.police_verification_remarks %}
        <div class="mt-2" style="font-size: 11px;"><strong>Police Remarks:</strong> {{ lease.police_verification_remarks|linebreaksbr }}</div>
      {% endif %}
    </div>
  </div>

  <!-- ============================================================
       TAB NAVIGATION (multi-line grid, responsive)
  ============================================================ -->
  <div class="ld-tabs-wrapper">
    <div class="ld-tab-nav" id="ldTabNav">
      <button class="ld-tab-btn active" data-tab="renewals">Lease Renewals</button>
      <button class="ld-tab-btn" data-tab="unit">Unit &amp; Meter</button>
      <button class="ld-tab-btn" data-tab="security">Security Deposit</button>
      <button class="ld-tab-btn" data-tab="people">Family &amp; Witnesses</button>
      <button class="ld-tab-btn" data-tab="financial">Financial &amp; Inventory</button>
      <button class="ld-tab-btn" data-tab="notes">Terms &amp; Notes</button>
      <button class="ld-tab-btn" data-tab="activity">Activity</button>
      <button class="ld-tab-btn" data-tab="docs">Documents</button>
    </div>

    <!-- Tab content wrapper -->
    <div class="ld-tab-content-wrap">

      <!-- ======== TAB: LEASE RENEWALS ======== -->
      <div class="ld-tab-pane active" id="ld-tab-renewals">
        {% include 'leases/renewal_history_table.html' with lease=lease renewals=renewals %}
      </div>

      <!-- ======== TAB: UNIT & METER ======== -->
      <div class="ld-tab-pane" id="ld-tab-unit">
        <div class="ld-grid-2">

          <!-- Current Unit -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">
              Current Unit / Room
              <a href="{% url 'smart_meter:move_lease_unit' lease.pk %}" class="btn btn-sm btn-primary py-0 px-2" style="font-size: 10px;">Move Tenant</a>
            </div>
            <div class="ld-inner-body">
              <div class="ld-row">
                <span class="ld-row-key">Current Unit</span>
                <span class="ld-row-val">
                  <a href="{% url 'properties:unit_detail' lease.current_unit.pk %}">
                    {{ lease.current_unit.property.property_name }} {{ lease.current_unit.unit_number }}
                  </a>
                </span>
              </div>
              <div class="ld-row">
                <span class="ld-row-key">Lease Start</span>
                <span class="ld-row-val">{{ lease.start_date|date:"M d, Y" }}</span>
              </div>
              <div class="ld-row">
                <span class="ld-row-key">Lease End</span>
                <span class="ld-row-val">{{ lease.end_date|date:"M d, Y" }}</span>
              </div>
            </div>
          </div>

          <!-- Unit Move History -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Unit Move History</div>
            <div class="ld-table-wrap">
              <table class="ld-table" style="min-width: 340px;">
                <thead>
                  <tr>
                    <th>Unit</th>
                    <th>Move In</th>
                    <th>Move Out</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody>
                  {% for occupancy in lease.unit_occupancies.all %}
                    <tr>
                      <td><a href="{% url 'properties:unit_detail' occupancy.unit.pk %}">{{ occupancy.unit }}</a></td>
                      <td>{{ occupancy.move_in_date|date:"M d, Y" }}</td>
                      <td>{{ occupancy.move_out_date|date:"M d, Y"|default:"Current" }}</td>
                      <td style="font-size: 10px; color: #6b7280;">{{ occupancy.notes|default:"—" }}</td>
                    </tr>
                  {% empty %}
                    <tr><td colspan="4" class="ld-empty">No move history recorded.</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Meter Billing History -->
        <div class="ld-inner-card">
          <div class="ld-inner-header">Meter Billing History / Usage Breakdown</div>
          <div class="ld-table-wrap">
            <table class="ld-table">
              <thead>
                <tr>
                  <th>Meter</th>
                  <th>Unit</th>
                  <th>Installed</th>
                  <th>Removed</th>
                  <th class="text-end">Start Reading</th>
                  <th class="text-end">End Reading</th>
                </tr>
              </thead>
              <tbody>
                {% for installation in lease.meter_installations.all %}
                  <tr>
                    <td><a href="{% url 'smart_meter:meter_detail' installation.meter.pk %}">{{ installation.meter.meter_number }}</a></td>
                    <td>{{ installation.unit }}</td>
                    <td>{{ installation.start_date|date:"M d, Y" }}</td>
                    <td>{{ installation.end_date|date:"M d, Y"|default:"Current" }}</td>
                    <td class="text-end">{{ installation.start_reading }}</td>
                    <td class="text-end">{{ installation.end_reading|default:"—" }}</td>
                  </tr>
                {% empty %}
                  <tr><td colspan="6" class="ld-empty">No meter installations linked to this lease.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ======== TAB: SECURITY DEPOSIT ======== -->
      <div class="ld-tab-pane" id="ld-tab-security">
        <div class="ld-deposit-wrap">
          <!-- Summary figures -->
          <div>
            <div class="ld-section-title">Summary</div>
            <div class="ld-dep-row"><span class="ld-dep-label">Required</span><span class="ld-dep-value">{{ security_required|default:0|money:0 }}</span></div>
            <div class="ld-dep-row"><span class="ld-dep-label">Paid In</span><span class="ld-dep-value">{{ security_paid_in|default:0|money:0 }}</span></div>
            <div class="ld-dep-row"><span class="ld-dep-label">Refunded</span><span class="ld-dep-value">{{ security_refunded|default:0|money:0 }}</span></div>
            <div class="ld-dep-row"><span class="ld-dep-label">Used for Damages</span><span class="ld-dep-value">{{ security_damages|default:0|money:0 }}</span></div>
            <div class="ld-dep-row warn">
              <span class="ld-dep-label" style="color: #854d0e; font-weight: 600;">Balance to Collect</span>
              <span class="ld-dep-value" style="color: #854d0e;">{{ security_balance_to_collect|default:0|money:0 }}</span>
            </div>
            <div class="ld-dep-row ok">
              <span class="ld-dep-label" style="color: #166534; font-weight: 600;">Currently Held</span>
              <span class="ld-dep-value" style="color: #166534;">{{ security_currently_held|default:0|money:0 }}</span>
            </div>
            <div class="mt-2" style="font-size: 10px; color: #6b7280;">
              {% if lease.security_deposit_paid %}
                Deposit marked as <strong>paid</strong>.
              {% else %}
                Deposit <strong>not marked as paid</strong>.
              {% endif %}
            </div>
          </div>

          <!-- Ledger table -->
          <div>
            <div class="ld-section-title">Security Deposit Ledger</div>
            {% if deposit_transactions %}
              <div class="ld-table-wrap">
                <table class="ld-table">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Type</th>
                      <th>Description</th>
                      <th class="text-end">Amount</th>
                      <th class="text-end">Deposit Balance</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for t in deposit_transactions %}
                      <tr>
                        <td>{{ t.date|date:"M d, Y" }}</td>
                        <td>{{ t.type }}</td>
                        <td>{{ t.description }}</td>
                        <td class="text-end">
                          {% if t.amount > 0 %}
                            <span style="color: #166534;">+{{ t.amount|intcomma }}</span>
                          {% else %}
                            <span style="color: #dc2626;">{{ t.amount|intcomma }}</span>
                          {% endif %}
                        </td>
                        <td class="text-end">{{ t.balance|intcomma }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% else %}
              <div class="ld-empty">No security deposit transactions yet.</div>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- ======== TAB: FAMILY & WITNESSES ======== -->
      <div class="ld-tab-pane" id="ld-tab-people">
        <div class="ld-grid-2">

          <!-- Family Members -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Family Members</div>
            <div class="ld-inner-body">
              {% if family_members %}
                <div class="ld-table-wrap">
                  <table class="ld-table" style="min-width: 280px;">
                    <thead>
                      <tr><th>Name</th><th>Relation</th><th>Phone</th><th></th></tr>
                    </thead>
                    <tbody>
                      {% for m in family_members %}
                        <tr>
                          <td>{{ m.tenant.get_full_name }}</td>
                          <td>{{ m.relation|default:"—" }}</td>
                          <td>
                            {% if m.tenant.phone %}
                              <a href="tel:{{ m.tenant.phone }}">{{ m.tenant.phone }}</a>
                            {% else %}—{% endif %}
                          </td>
                          <td>
                            <a href="{% url 'tenants:tenant_detail' m.tenant.pk %}" class="btn btn-sm btn-secondary py-0 px-2" style="font-size: 10px;">Detail</a>
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% else %}
                <div class="ld-empty">No family members recorded.</div>
              {% endif %}
            </div>
          </div>

          <!-- Witnesses -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Witnesses</div>
            <div class="ld-inner-body">
              <div class="ld-witness-grid">
                <div>
                  <div class="ld-row"><span class="ld-row-key">Witness 1 Name</span><span class="ld-row-val">{{ lease.witness1_name|default:"—" }}</span></div>
                  <div class="ld-row"><span class="ld-row-key">Witness 1 CNIC</span><span class="ld-row-val">{{ lease.witness1_cnic|default:"—" }}</span></div>
                </div>
                <div>
                  <div class="ld-row"><span class="ld-row-key">Witness 2 Name</span><span class="ld-row-val">{{ lease.witness2_name|default:"—" }}</span></div>
                  <div class="ld-row"><span class="ld-row-key">Witness 2 CNIC</span><span class="ld-row-val">{{ lease.witness2_cnic|default:"—" }}</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ======== TAB: FINANCIAL & INVENTORY ======== -->
      <div class="ld-tab-pane" id="ld-tab-financial">
        <div class="ld-grid-2">

          <!-- Security installments -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Security Installments &amp; Return</div>
            <div class="ld-inner-body">
              <div class="ld-row"><span class="ld-row-key">Installment 1 Amount</span><span class="ld-row-val">{{ lease.security_installment_1_amount|default:0|money:0 }}</span></div>
              <div class="ld-row"><span class="ld-row-key">Installment 1 Date</span><span class="ld-row-val">{{ lease.security_installment_1_date|default:"—" }}</span></div>
              <div class="ld-row"><span class="ld-row-key">Installment 2 Amount</span><span class="ld-row-val">{{ lease.security_installment_2_amount|default:0|money:0 }}</span></div>
              <div class="ld-row"><span class="ld-row-key">Installment 2 Date</span><span class="ld-row-val">{{ lease.security_installment_2_date|default:"—" }}</span></div>
              <div class="ld-row"><span class="ld-row-key">Return Date</span><span class="ld-row-val">{{ lease.security_deposit_return_date|default:"—" }}</span></div>
              <div class="ld-row"><span class="ld-row-key">Return Amount</span><span class="ld-row-val">{{ lease.security_deposit_return_amount|default:0|money:0 }}</span></div>
              <div class="ld-row"><span class="ld-row-key">Early Termination Penalty</span><span class="ld-row-val">{{ lease.early_termination_penalty|default:0|money:0 }}</span></div>
              <div class="ld-row">
                <span class="ld-row-key">Deposit Paid</span>
                <span class="ld-row-val">
                  {% if lease.security_deposit_paid %}
                    <span class="ld-badge ld-badge-green">Yes</span>
                  {% else %}
                    <span class="ld-badge ld-badge-red">No</span>
                  {% endif %}
                </span>
              </div>
            </div>
          </div>

          <!-- Inventory -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Inventory</div>
            <div class="ld-inner-body">
              <div class="ld-inv-grid">
                <div>
                  <div class="ld-row"><span class="ld-row-key">Ceiling Fans</span><span class="ld-row-val">{{ lease.inventory_ceiling_fans|default:"—" }}</span></div>
                  <div class="ld-row"><span class="ld-row-key">Exhaust Fans</span><span class="ld-row-val">{{ lease.inventory_exhaust_fans|default:"—" }}</span></div>
                  <div class="ld-row"><span class="ld-row-key">Ceiling Lights</span><span class="ld-row-val">{{ lease.inventory_ceiling_lights|default:"—" }}</span></div>
                </div>
                <div>
                  <div class="ld-row"><span class="ld-row-key">Stove</span><span class="ld-row-val">{{ lease.inventory_stove|default:"—" }}</span></div>
                  <div class="ld-row"><span class="ld-row-key">Wardrobes</span><span class="ld-row-val">{{ lease.inventory_wardrobes|default:"—" }}</span></div>
                  <div class="ld-row"><span class="ld-row-key">Keys</span><span class="ld-row-val">{{ lease.inventory_keys|default:"—" }}</span></div>
                </div>
              </div>
              <div class="ld-row mt-1"><span class="ld-row-key">Paint Condition</span><span class="ld-row-val">{{ lease.paint_condition|default:"—" }}</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ======== TAB: TERMS & NOTES ======== -->
      <div class="ld-tab-pane" id="ld-tab-notes">
        <div class="ld-grid-3">
          <div class="ld-inner-card">
            <div class="ld-inner-header">Terms</div>
            <div class="ld-inner-body" style="font-size: 11px;">{{ lease.terms|default:"—" }}</div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-header">Notes</div>
            <div class="ld-inner-body" style="font-size: 11px;">{{ lease.notes|default:"—" }}</div>
          </div>
          <div class="ld-inner-card">
            <div class="ld-inner-header">Return Notes</div>
            <div class="ld-inner-body" style="font-size: 11px;">{{ lease.security_deposit_return_notes|default:"—" }}</div>
          </div>
        </div>
      </div>

      <!-- ======== TAB: ACTIVITY ======== -->
      <div class="ld-tab-pane" id="ld-tab-activity">
        <div class="ld-grid-2">

          <!-- Recent Payments -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Recent Payments</div>
            <div class="ld-inner-body">
              {% if recent_payments %}
                {% for p in recent_payments %}
                  <div class="ld-act-row">
                    <div>
                      <div class="ld-act-date">{{ p.payment_date }}</div>
                      <div class="ld-act-label">{{ p.reference_number|default:"Payment" }}</div>
                    </div>
                    <div class="ld-act-amount" style="color: #166534;">{{ p.amount|money:0 }}</div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="ld-empty">No payments yet.</div>
              {% endif %}
            </div>
          </div>

          <!-- Invoices -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Invoices</div>
            <div class="ld-inner-body">
              {% if invoices %}
                {% for inv in invoices %}
                  <div class="ld-act-row">
                    <div>
                      <div class="ld-act-date">{{ inv.issue_date }}</div>
                      <div class="ld-act-label">{{ inv.description|default:"Invoice" }}</div>
                    </div>
                    <div class="ld-act-amount" style="color: #dc2626;">{{ inv.amount|money:0 }}</div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="ld-empty">No invoices yet.</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- ======== TAB: DOCUMENTS ======== -->
      <div class="ld-tab-pane" id="ld-tab-docs">
        <div class="ld-grid-2">

          <!-- Signed Copy -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Signed Copy</div>
            <div class="ld-inner-body">
              {% if lease.signed_copy %}
                <a href="{{ lease.signed_copy.url }}" target="_blank" class="btn btn-sm btn-success">
                  <i class="fas fa-download"></i> Download Signed Copy
                </a>
              {% else %}
                <span class="ld-badge ld-badge-red"><i class="fas fa-times-circle me-1"></i> Not Uploaded</span>
              {% endif %}
            </div>
          </div>

          <!-- Generated Agreement PDF -->
          <div class="ld-inner-card">
            <div class="ld-inner-header">Generated Agreement PDF</div>
            <div class="ld-inner-body d-flex flex-wrap gap-2 align-items-center">
              <a href="{% url 'leases:download_preview' lease.id %}" class="btn btn-sm btn-dark">
                <i class="fas fa-download"></i> Download Preview PDF
              </a>
              {% if lease.generated_agreement_pdf %}
                <a href="{{ lease.generated_agreement_pdf.url }}" target="_blank" class="btn btn-sm btn-success">
                  <i class="fas fa-file-pdf"></i> View Generated PDF
                </a>
              {% else %}
                <span class="ld-badge ld-badge-red"><i class="fas fa-times-circle me-1"></i> Not Generated</span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

    </div><!-- /ld-tab-content-wrap -->
  </div><!-- /ld-tabs-wrapper -->

</div><!-- /ld-page -->
{% endblock %}

{% block extra_js %}
<script>
(function () {
  const nav = document.getElementById('ldTabNav');
  if (!nav) return;

  nav.addEventListener('click', function (e) {
    const btn = e.target.closest('.ld-tab-btn');
    if (!btn) return;

    // deactivate all buttons
    nav.querySelectorAll('.ld-tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    // hide all panes
    document.querySelectorAll('.ld-tab-pane').forEach(p => p.classList.remove('active'));

    // show target pane
    const target = document.getElementById('ld-tab-' + btn.dataset.tab);
    if (target) target.classList.add('active');
  });
})();
</script>
{% endblock %}
