    #payment-filter-form .form-control-sm,
    #payment-filter-form .form-select-sm,
    #payment-filter-form .select2,
    #payment-filter-form .select2-selection--single{ width:100% !important; min-width:0 !important; }
    .select2-container{ max-width:100% !important; }

  }
</style>


<style>
  /* ============================================================
     Payment List — scoped visual overrides
     All selectors scoped under .payment-list-dense where possible
     ============================================================ */

  /* --- Source badges (Src column) --- */
  .payment-list-dense .badge {
    border-radius: 2rem;
    font-size: 0.68rem;
    padding: 2px 8px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  /* "Payment" badge */
  .payment-list-dense .badge.bg-primary,
  .payment-list-dense .badge[class*="bg-primary"] {
    background-color: #e8f0fe !important;
    color: #1a56db !important;
  }
  /* "Payment + Split" badge */
  .payment-list-dense .badge.bg-warning,
  .payment-list-dense .badge[class*="bg-warning"] {
    background-color: #fef3c7 !important;
    color: #92400e !important;
  }

  /* --- Row striping & hover --- */
  .payment-list-dense tbody tr:nth-child(even) {
    background-color: #f9fafb;
  }
  .payment-list-dense tbody tr:hover {
    background-color: #eff6ff;
    transition: background-color 0.15s ease;
  }

  /* --- Balance columns: positive / negative coloring --- */
  .payment-list-dense td.text-success,
  .payment-list-dense td .text-success {
    color: #16a34a !important;
    font-weight: 600;
  }
  .payment-list-dense td.text-danger,
  .payment-list-dense td .text-danger {
    color: #dc2626 !important;
    font-weight: 600;
  }

  /* --- Split sub-row breakdown text (Lease: ... | Security: ...) --- */
  .payment-list-dense td small,
  .payment-list-dense td .split-breakdown {
    font-size: 0.68rem !important;
    color: #6b7280 !important;
    display: block;
    margin-top: 2px;
    line-height: 1.3;
  }

  /* --- Date column: slightly muted --- */
  .payment-list-dense td.col-date,
  .payment-list-dense td:nth-child(6) {
    color: #6b7280;
    font-size: 0.82rem;
  }

  /* --- Action buttons: tighter spacing --- */
  .payment-list-dense td:last-child {
    white-space: nowrap;
  }
  .payment-list-dense td:last-child .btn,
  .payment-list-dense td:last-child a.btn {
    padding: 3px 5px;
    font-size: 0.75rem;
    margin: 0 1px;
  }

  /* --- Totals card: accent left border --- */
  #total-card {
    border-left: 3px solid #1a56db;
    background-color: #f0f4ff;
  }
  #total-card .total-amount-display {
    color: #1a56db;
  }

  /* --- Table header: slightly stronger style --- */
  .payment-list-dense thead th {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #374151;
    background-color: #f3f4f6;
    border-bottom: 2px solid #e5e7eb;
    white-space: nowrap;
  }
</style>
